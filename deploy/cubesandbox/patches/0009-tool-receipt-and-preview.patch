+func waitToolExit(ctx context.Context, r Request, output *toolOutput, exits <-chan containerd.ExitStatus) (containerd.ExitStatus, bool, string) {
+	complete := output.complete
+	for {
+		h, at := output.resultState()
+		if !at.IsZero() {
+			if !validResult(h, r) {
+				return containerd.ExitStatus{}, false, "tool_output_invalid"
