@@ -0,0 +1,52 @@
+package sandbox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	cubebox "github.com/tencentcloud/CubeSandbox/CubeMaster/api/services/cubebox/v1"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet/grpcconn"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+)
+
+// Forward to the recorded node and return only its durable acknowledgement.
+// Master/Redis receipt times never become a new retention deadline.
+func RenewManagedAllocation(ctx context.Context, id string, deadline int64, executionBoot string, observedAt int64) (int64, error) {
+	r, err := allocation.Default().Get(ctx, id)
+	if err != nil {
+		return 0, err
+	}
+	if r == nil || r.Closed || r.Phase != "ready" || r.NotAfter != deadline || observedAt <= 0 || executionBoot == "" {
+		return 0, errors.New("allocation not renewable")
+	}
+	host, ok := localcache.GetNode(r.NodeID)
+	if !ok || !host.Healthy {
+		return 0, errors.New("allocation node unavailable")
+	}
+	conn, err := grpcconn.GetWorkerConn(ctx, cubelet.GetCubeletAddr(host.HostIP()))
+	if err != nil {
+		return 0, err
+	}
+	defer conn.Close()
+	reply, err := cubebox.NewCubeboxMgrClient(conn.Value()).ManageAllocation(ctx, &cubebox.AllocationRequest{AllocationId: r.ID, Digest: r.Digest, CreateBefore: r.NotAfter, ExpectedBoot: r.NodeBoot, ObservedAt: observedAt, ExecutionBoot: executionBoot})
+	if err != nil {
+		return 0, err
+	}
+	if reply.Failure != "" {
+		return 0, errors.New(reply.Failure)
+	}
+	var state struct {
+		ID     string `json:"allocationID"`
+		Closed bool   `json:"closed"`
+		Until  int64  `json:"retainUntil"`
+	}
+	if err = json.Unmarshal(reply.Record, &state); err != nil {
+		return 0, err
+	}
+	if state.ID != id || state.Closed || state.Until <= observedAt {
+		return 0, errors.New("retention acknowledgement invalid")
+	}
+	return state.Until, nil
+}
