diff --git a/Cubelet/pkg/allocation/retention.go b/Cubelet/pkg/allocation/retention.go
new file mode 100644
index 0000000..232ed35
--- /dev/null
+++ b/Cubelet/pkg/allocation/retention.go
@@ -0,0 +1,126 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"encoding/binary"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+)
+
+var ErrStaleActivity = errors.New("retention activity is stale")
+
+func idleKey(r *Record) []byte {
+	k := make([]byte, 8+len(r.ID))
+	binary.BigEndian.PutUint64(k, uint64(r.RetainUntil))
+	copy(k[8:], r.ID)
+	return k
+}
+
+// The existing synchronous allocation journal is the sole retention clock.
+// Replays retain their original time and cannot renew a later incarnation.
+func (m *Manager) Renew(i Identity, observedAt int64) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	return m.Store.Update(i.ID, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed {
+			return nil, ErrClosed
+		}
+		if i.BootID != m.BootID || r.StartedBoot != i.BootID || r.Digest != i.Digest || r.NotAfter != i.NotAfter {
+			return nil, ErrConflict
+		}
+		if r.RetentionWindow <= 0 || r.Phase != "ready" {
+			return nil, ErrConflict
+		}
+		if observedAt <= 0 || observedAt > now+5000 || now-observedAt > 45000 {
+			return nil, ErrStaleActivity
+		}
+		until := observedAt + r.RetentionWindow
+		if until > r.RetainUntil {
+			r.RetainUntil = until
+		}
+		return r, nil
+	})
+}
+
+// Real accepted Tool activity uses the node's clock. Diagnostic probes never call it.
+func (s *Store) Touch(id string) error {
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed {
+			return nil, ErrClosed
+		}
+		if r.RetentionWindow > 0 && now+r.RetentionWindow > r.RetainUntil {
+			r.RetainUntil = now + r.RetentionWindow
+		}
+		return r, nil
+	})
+	return err
+}
+
+func (s *Store) Due(limit int) ([]Record, error) {
+	if limit < 1 || limit > 1024 {
+		return nil, errors.New("invalid retention page")
+	}
+	var result []Record
+	err := s.db.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now := s.now().UnixMilli()
+		if v := b.Get(floor); len(v) == 8 && int64(binary.BigEndian.Uint64(v)) > now {
+			now = int64(binary.BigEndian.Uint64(v))
+		}
+		c := b.Bucket(idleExpiry).Cursor()
+		for k, id := c.First(); k != nil && len(result) < limit; k, id = c.Next() {
+			if int64(binary.BigEndian.Uint64(k[:8])) > now {
+				break
+			}
+			r, err := decode(b.Bucket(records).Get(id))
+			if err != nil {
+				return err
+			}
+			if r != nil {
+				result = append(result, *r)
+			}
+		}
+		return nil
+	})
+	return result, err
+}
+
+// Caller holds the Tool-admission mutex. Only this atomic recheck closes an
+// expired allocation; a previously enumerated deadline is never sufficient.
+func (s *Store) BeginExpiry(id string) (bool, error) {
+	closed := false
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.RetentionWindow > 0 && r.RetainUntil <= now && r.Phase != "absent" {
+			r.Closed = true
+			r.Phase = "closing"
+			closed = true
+		}
+		return r, nil
+	})
+	return closed, err
+}
+
+// Keep one failed physical cleanup from starving later expired allocations.
+func (s *Store) DeferExpiry(id string) error {
