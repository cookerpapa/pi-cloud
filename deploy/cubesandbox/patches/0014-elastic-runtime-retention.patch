+func TestRetentionExpirySharesToolAdmission(t *testing.T) {
+	entered, release, delivered := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result {
+		close(entered)
+		<-release
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { close(delivered); return nil }))
+	var activity atomic.Int32
+	m.RuntimeActivity = func(string) error { activity.Add(1); return nil }
+	r := request()
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	<-entered
+	closed, err := m.RetireIdleRuntime(r.SandboxID, func() (bool, error) { t.Fatal("live Tool expired"); return true, nil })
+	if closed || err != nil || activity.Load() < 2 {
+		t.Fatal(closed, err, activity.Load())
+	}
+	close(release)
+	<-delivered
+	closed, err = m.RetireIdleRuntime(r.SandboxID, func() (bool, error) { return true, nil })
+	if !closed || err != nil {
+		t.Fatal(closed, err)
+	}
+	next := request()
+	next.SandboxID = r.SandboxID
+	next.Source.Offset = "1000"
+	if why := m.Submit(m.BootID, next); why != "runtime_quarantined" {
+		t.Fatal(why)
+	}
+	m.Close()
+}
+
+func TestRetentionPersistenceFailureRejectsBeforeStartingTool(t *testing.T) {
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result {
+		t.Error("Tool ran without retention admission")
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	m.RuntimeActivity = func(string) error { return errors.New("metadata unavailable") }
+	if why := m.Submit(m.BootID, request()); why != "runtime_retention_unavailable" {
+		t.Fatal(why)
+	}
+}
