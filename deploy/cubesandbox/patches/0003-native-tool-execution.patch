+    async fn managed_execution_preserves_refusal_and_never_invents_ack_on_http_failure() {
+        let id = "aabbccddeeff00112233445566778899";
+        for status in [StatusCode::OK, StatusCode::BAD_GATEWAY] {
+            let app = Router::new().route("/cube/sandbox/execution/:action", post(move |Json(body): Json<Value>| async move {
+                assert_eq!(body["sandboxID"], id);
+                assert_eq!(body["nodeID"], "node-1");
+                (status, Json(serde_json::json!({"accepted": false, "operationID": "op-1", "rejection": "node_unavailable"})))
+            }));
+            let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let address = listener.local_addr().unwrap();
+            let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap(); });
+            let service = SandboxService::new(CubeMasterClient::new(format!("http://{address}"), reqwest::Client::new()), "cubebox".into(), "cube.app".into());
+            for action in ["submit", "probe"] {
+            let result = service.managed_execution(id, action, serde_json::json!({"nodeID":"node-1", "sandboxID":"overridden"})).await;
+            if status == StatusCode::OK {
+                assert_eq!(result.unwrap()["accepted"], false);
+            } else { assert!(result.is_err()); }
+            }
+            assert!(service.managed_execution(id, "rerun", serde_json::json!({})).await.is_err());
+            assert!(service.managed_execution("partial", "submit", serde_json::json!({})).await.is_err());
+            server.abort();
+        }
+    }
