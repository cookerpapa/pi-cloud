new file mode 100644
index 0000000..08f84af
--- /dev/null
+++ b/CubeMaster/pkg/service/httpservice/cube/managed_execution.go
@@ -0,0 +1,95 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/api/services/cubebox/v1"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet/grpcconn"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/sandboxid"
+)
+
+type managedExecutionRequest struct {
+	Source             json.RawMessage `json:"source"`
+	SandboxID          string          `json:"sandboxID"`
+	NodeID             string          `json:"nodeID"`
+	BootID             string          `json:"bootID"`
+	OperationID        string          `json:"operationID"`
+	ProbeID            string          `json:"probeID"`
+	RunID              string          `json:"runID"`
+	WriterID           string          `json:"writerID"`
+	Payload            json.RawMessage `json:"payload"`
+	CompletionContext  json.RawMessage `json:"completionContext"`
+	TimeoutMS          int64           `json:"timeoutMs"`
+	MaximumOutputBytes int64           `json:"maximumOutputBytes"`
+}
+
+func handleManagedExecution(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 2*1024*1024)
+	var input managedExecutionRequest
+	if json.NewDecoder(c.Request.Body).Decode(&input) != nil || !sandboxid.IsFullID(input.SandboxID) || input.NodeID == "" {
+		c.JSON(400, gin.H{"error": "invalid_execution_request"})
+		return
+	}
+	node, ok := localcache.GetNode(input.NodeID)
+	if !ok || !node.Healthy {
+		// The request has not reached an execution endpoint.
+		c.JSON(200, gin.H{"accepted": false, "operationID": input.OperationID, "bootID": input.BootID, "rejection": "node_unavailable", "enabled": false, "stopped": false})
+		return
+	}
+	timeout := 5 * time.Second
+	if c.Param("action") == "stop" {
+		timeout = 20 * time.Second
+	}
+	if c.Param("action") == "probe" {
+		timeout = 9 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), timeout)
+	defer cancel()
+	connection, err := grpcconn.GetWorkerConn(ctx, cubelet.GetCubeletAddr(node.IP))
+	if err != nil {
+		c.JSON(502, gin.H{"error": "execution_endpoint_unavailable"})
+		return
+	}
+	defer connection.Close()
+	client := cubebox.NewCubeboxMgrClient(connection.Value())
+	switch c.Param("action") {
+	case "probe":
+		response, err := client.ProbeExecution(ctx, &cubebox.ExecutionProbeRequest{SandboxId: input.SandboxID, BootId: input.BootID, ProbeId: input.ProbeID, RunId: input.RunID, WriterId: input.WriterID, CompletionContext: input.CompletionContext})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_probe_unavailable"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "probeID": response.ProbeId, "accepted": response.Accepted, "rejection": response.Rejection, "output": json.RawMessage(response.Output), "failure": response.Failure})
+	case "capabilities":
+		response, err := client.ExecutionCapabilities(ctx, &cubebox.ExecutionCapabilitiesRequest{SandboxId: input.SandboxID})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_capabilities_unavailable"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "protocolVersion": response.ProtocolVersion, "enabled": response.Enabled, "runtimeBlocked": response.RuntimeBlocked})
+	case "submit":
+		response, err := client.SubmitTool(ctx, &cubebox.SubmitToolRequest{SourcePosition: input.Source, SandboxId: input.SandboxID, BootId: input.BootID, OperationId: input.OperationID, RunId: input.RunID, WriterId: input.WriterID, Payload: input.Payload, CompletionContext: input.CompletionContext, TimeoutMs: input.TimeoutMS, MaximumOutputBytes: input.MaximumOutputBytes})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_handoff_unknown"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "operationID": response.OperationId, "accepted": response.Accepted, "rejection": response.Rejection})
+	case "stop":
+		response, err := client.StopExecutionScope(ctx, &cubebox.StopExecutionScopeRequest{SourcePosition: input.Source, SandboxId: input.SandboxID, BootId: input.BootID, RunId: input.RunID, WriterId: input.WriterID, OperationId: input.OperationID})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_stop_unconfirmed"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "stopped": response.Stopped, "failure": response.Failure})
+	default:
+		c.JSON(404, gin.H{"error": "unknown_execution_action"})
+	}
+}
diff --git a/CubeMaster/pkg/service/httpservice/cube/managed_execution_test.go b/CubeMaster/pkg/service/httpservice/cube/managed_execution_test.go
new file mode 100644
index 0000000..8c2fd41
--- /dev/null
+++ b/CubeMaster/pkg/service/httpservice/cube/managed_execution_test.go
@@ -0,0 +1,43 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"bytes"
+	"encoding/json"
+	"github.com/agiledragon/gomonkey/v2"
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/node"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestManagedExecutionRejectsPartialIdentityBeforeNodeRouting(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	app := gin.New()
+	app.POST("/execution/:action", handleManagedExecution)
+	response := httptest.NewRecorder()
+	request := httptest.NewRequest("POST", "/execution/submit", bytes.NewBufferString(`{"sandboxID":"partial","nodeID":"node-1"}`))
+	app.ServeHTTP(response, request)
+	if response.Code != 400 {
+		t.Fatalf("status %d", response.Code)
+	}
+}
+func TestManagedExecutionMissingNodeExplicitlyRefusesWithoutClaimingCompletion(t *testing.T) {
+	patch := gomonkey.ApplyFunc(localcache.GetNode, func(string) (*node.Node, bool) { return nil, false })
+	defer patch.Reset()
+	gin.SetMode(gin.TestMode)
+	app := gin.New()
+	app.POST("/execution/:action", handleManagedExecution)
+	response := httptest.NewRecorder()
+	request := httptest.NewRequest("POST", "/execution/submit", bytes.NewBufferString(`{"sandboxID":"aabbccddeeff00112233445566778899","nodeID":"node-1","operationID":"op-1","bootID":"boot-1"}`))
+	app.ServeHTTP(response, request)
+	var body map[string]interface{}
+	if json.Unmarshal(response.Body.Bytes(), &body) != nil {
+		t.Fatal("invalid response")
+	}
+	if response.Code != 200 || body["accepted"] != false || body["operationID"] != "op-1" || body["stopped"] != false {
+		t.Fatalf("unexpected refusal %v", body)
+	}
+}
