+
+func TestOrderedClosureRejectsDelayedOldOwnerAndPreservesSibling(t *testing.T) {
+	started := make(chan struct{}, 2)
+	var calls atomic.Int32
+	m := New(driverFunc(func(ctx context.Context, r Request, _ func(json.RawMessage)) Result {
+		calls.Add(1)
+		started <- struct{}{}
+		<-ctx.Done()
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	old := request()
+	closePosition := old.Source
+	closePosition.Offset = "101"
+	if err := m.Stop(context.Background(), m.BootID, old.SandboxID, old.RunID, "", "", closePosition); err != nil {
+		t.Fatal(err)
+	}
+	if why := m.Submit(m.BootID, old); why != "execution_position_stale" {
+		t.Fatal(why)
+	}
+	sibling := request()
+	sibling.Source.Offset = "102"
+	if why := m.Submit(m.BootID, sibling); why != "" {
+		t.Fatal(why)
+	}
+	await(t, started)
+	// A replayed old Stop cannot regress progress or cancel another Run in the same VM.
+	if err := m.Stop(context.Background(), m.BootID, old.SandboxID, old.RunID, "", "", closePosition); err != nil {
+		t.Fatal(err)
+	}
+	m.mu.Lock()
+	op := m.operations[key(sibling.SandboxID, sibling.OperationID)]
+	high := m.positions[old.SandboxID].partitions[0]
+	m.mu.Unlock()
+	select {
+	case <-op.stopped:
+		t.Fatal("old closure cancelled sibling")
+	default:
+	}
+	if high != 102 || calls.Load() != 1 {
+		t.Fatal("progress regressed or old Tool executed")
+	}
+	if err := m.Stop(context.Background(), m.BootID, sibling.SandboxID, sibling.RunID, "", "", sibling.Source); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestMoreThan65536ClosuresRetainOnlyLiveRuntimePositions(t *testing.T) {
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result { return Result{} }),
+		deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	r := request()
+	for i := 0; i < 70000; i++ {
+		p := r.Source
+		p.Offset = strconv.Itoa(i)
+		if err := m.Stop(context.Background(), m.BootID, r.SandboxID, uuid.NewString(), "", "", p); err != nil {
+			t.Fatal(err)
+		}
+	}
+	m.mu.Lock()
+	count := len(m.positions)
+	partitions := len(m.positions[r.SandboxID].partitions)
+	retained := len(m.operations)
+	m.mu.Unlock()
+	if count != 1 || partitions != 1 || retained != 0 || !m.Accepting() {
+		t.Fatal("history exhausted admission")
+	}
+	r.Source.Offset = "70000"
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	if why := m.Submit(m.BootID, r); why != "execution_position_stale" {
+		t.Fatal(why)
+	}
+	m.mu.Lock()
+	retained = len(m.operations)
+	m.mu.Unlock()
+	if retained != 0 {
+		t.Fatal("completed identity retained")
+	}
+	m.ForgetRuntime(r.SandboxID)
+	fresh := request()
+	fresh.SandboxID = "fresh-vm"
+	if why := m.Submit(m.BootID, fresh); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	m.mu.Lock()
+	count = len(m.positions)
+	m.mu.Unlock()
+	if count != 1 {
+		t.Fatal("removed VM position retained")
+	}
+}
+func TestPartitionsAreIndependentButStreamIdentityCannotChange(t *testing.T) {
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result { return Result{} }),
+		deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	r := request()
+	if err := m.Stop(context.Background(), m.BootID, r.SandboxID, r.RunID, "", "", r.Source); err != nil {
+		t.Fatal(err)
+	}
+	r.Source.Partition = 1
+	r.Source.Offset = "0"
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	r.OperationID = uuid.NewString()
+	r.Source.Topic = "different-log"
+	if why := m.Submit(m.BootID, r); why != "execution_stream_changed" {
+		t.Fatal(why)
+	}
+	r.Source.Topic = "session-log-v13"
+	for _, value := range []string{"", "-1", "+1", "01", "9223372036854775808"} {
+		r.Source.Offset = value
+		if why := m.Submit(m.BootID, r); why != "invalid_execution_position" {
+			t.Fatal(value, why)
+		}
+	}
+}
