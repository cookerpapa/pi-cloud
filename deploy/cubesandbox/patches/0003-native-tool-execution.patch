+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cubebox
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/google/uuid"
+	api "github.com/tencentcloud/CubeSandbox/Cubelet/api/services/cubebox/v1"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/execution"
+	"testing"
+)
+
+type probeDriver struct{}
+
+func (probeDriver) Run(_ context.Context, r execution.Request, _ func(json.RawMessage)) execution.Result {
+	output, _ := json.Marshal(map[string]string{"type": "worker.probe_result", "probeId": r.OperationID, "guestBootId": uuid.NewString()})
+	return execution.Result{Output: output}
+}
+
+type probeDelivery struct{}
+
+func (probeDelivery) Progress(execution.Request, json.RawMessage)                        {}
+func (probeDelivery) Deliver(context.Context, execution.Request, execution.Result) error { return nil }
+
+func TestExecutionProbeDirectDoesNotDependOnKafkaCompletionReadiness(t *testing.T) {
+	s := &service{executions: execution.New(probeDriver{}, probeDelivery{})}
+	defer s.executions.Close()
+	req := &api.ExecutionProbeRequest{SandboxId: "vm", BootId: s.executions.BootID, ProbeId: uuid.NewString()}
+	reply, err := s.ProbeExecution(context.Background(), req)
+	if err != nil || !reply.Accepted || len(reply.Output) == 0 || reply.ProbeId != req.ProbeId {
+		t.Fatalf("direct probe: %+v %v", reply, err)
+	}
+	req.CompletionContext = []byte(`{"kind":"execution_probe"}`)
+	reply, err = s.ProbeExecution(context.Background(), req)
+	if err != nil || reply.Accepted || reply.Rejection != "execution_unavailable" {
+		t.Fatalf("missing Kafka: %+v %v", reply, err)
+	}
+	req.CompletionContext = nil
+	req.BootId = uuid.NewString()
+	reply, err = s.ProbeExecution(context.Background(), req)
+	if err != nil || reply.Accepted || reply.Rejection != "executor_replaced" {
+		t.Fatalf("replacement: %+v %v", reply, err)
+	}
+}
+
+func TestOrderedStopRequiresSourceAndAdvertisesMatchedProtocol(t *testing.T) {
+	s := &service{executions: execution.New(probeDriver{}, probeDelivery{})}
+	defer s.executions.Close()
+	capabilities, err := s.ExecutionCapabilities(context.Background(), &api.ExecutionCapabilitiesRequest{SandboxId: "vm"})
+	if err != nil || capabilities.ProtocolVersion != 3 {
+		t.Fatalf("capabilities: %+v %v", capabilities, err)
+	}
+	r := &api.StopExecutionScopeRequest{SandboxId: "vm", BootId: s.executions.BootID, RunId: uuid.NewString()}
+	reply, err := s.StopExecutionScope(context.Background(), r)
+	if err != nil || reply.Stopped {
+		t.Fatalf("old transport accepted: %+v %v", reply, err)
+	}
+	r.SourcePosition = []byte(`{"topic":"session-log-v13","partition":0,"offset":"101"}`)
+	reply, err = s.StopExecutionScope(context.Background(), r)
+	if err != nil || !reply.Stopped {
+		t.Fatalf("ordered stop: %+v %v", reply, err)
+	}
+}
