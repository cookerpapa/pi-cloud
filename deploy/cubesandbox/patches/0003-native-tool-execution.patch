@@ -0,0 +1,94 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cubebox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/api/services/cubebox/v1"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/execution"
+)
+
+func (s *service) resolveExecutionTask(ctx context.Context, r execution.Request) (execution.ResolvedTask, error) {
+	box, err := s.cubeboxMgr.cubeboxManger.Get(ctx, r.SandboxID)
+	if err != nil {
+		return execution.ResolvedTask{}, err
+	}
+	container := box.FirstContainer()
+	if container == nil || container.Container == nil {
+		return execution.ResolvedTask{}, errors.New("runtime container unavailable")
+	}
+	namespace := box.Namespace
+	if namespace == "" {
+		namespace = namespaces.Default
+	}
+	task, err := container.Container.Task(namespaces.WithNamespace(ctx, namespace), nil)
+	if err != nil {
+		return execution.ResolvedTask{}, err
+	}
+	return execution.ResolvedTask{Task: task, Namespace: namespace}, nil
+}
+func (s *service) ExecutionCapabilities(ctx context.Context, r *cubebox.ExecutionCapabilitiesRequest) (*cubebox.ExecutionCapabilitiesResponse, error) {
+	if s.executions == nil {
+		return &cubebox.ExecutionCapabilitiesResponse{}, nil
+	}
+	if s.completions != nil {
+		bounded, cancel := context.WithTimeout(ctx, 3*time.Second)
+		defer cancel()
+		_ = s.completions.EnsureReady(bounded)
+	}
+	return &cubebox.ExecutionCapabilitiesResponse{BootId: s.executions.BootID, ProtocolVersion: 3, Enabled: s.executions.Accepting() && s.completions != nil && s.completions.Ready(), RuntimeBlocked: s.executions.Unsafe(r.SandboxId)}, nil
+}
+
+func (s *service) ProbeExecution(ctx context.Context, r *cubebox.ExecutionProbeRequest) (*cubebox.ExecutionProbeResponse, error) {
+	if s.executions == nil || (len(r.CompletionContext) > 0 && (s.completions == nil || !s.completions.Ready())) {
+		return &cubebox.ExecutionProbeResponse{ProbeId: r.ProbeId, Rejection: "execution_unavailable"}, nil
+	}
+	result, rejection := s.executions.Probe(ctx, r.BootId, execution.Request{
+		SandboxID: r.SandboxId, OperationID: r.ProbeId, RunID: r.RunId, WriterID: r.WriterId, CompletionContext: r.CompletionContext,
+	})
+	return &cubebox.ExecutionProbeResponse{BootId: s.executions.BootID, ProbeId: r.ProbeId, Accepted: rejection == "", Rejection: rejection, Output: result.Output, Failure: result.Failure}, nil
+}
+
+func (s *service) Close() error {
+	if s.executions != nil {
+		s.executions.Close()
+	}
+	if s.completions != nil {
+		s.completions.Close()
+	}
+	return nil
+}
+func (s *service) SubmitTool(_ context.Context, r *cubebox.SubmitToolRequest) (*cubebox.SubmitToolResponse, error) {
+	if s.executions == nil || s.completions == nil || !s.completions.Ready() {
+		return &cubebox.SubmitToolResponse{OperationId: r.OperationId, Rejection: "execution_unavailable"}, nil
+	}
+	var source execution.Position
+	if json.Unmarshal(r.SourcePosition, &source) != nil {
+		return &cubebox.SubmitToolResponse{OperationId: r.OperationId, Rejection: "invalid_execution_position"}, nil
+	}
+	request := execution.Request{Source: source, SandboxID: r.SandboxId, OperationID: r.OperationId, RunID: r.RunId, WriterID: r.WriterId, Payload: r.Payload, CompletionContext: r.CompletionContext, Timeout: time.Duration(r.TimeoutMs) * time.Millisecond, MaximumOutputBytes: r.MaximumOutputBytes}
+	rejection := s.executions.Submit(r.BootId, request)
+	return &cubebox.SubmitToolResponse{BootId: s.executions.BootID, OperationId: r.OperationId, Accepted: rejection == "", Rejection: rejection}, nil
+}
+func (s *service) StopExecutionScope(ctx context.Context, r *cubebox.StopExecutionScopeRequest) (*cubebox.StopExecutionScopeResponse, error) {
+	if s.executions == nil {
+		return &cubebox.StopExecutionScopeResponse{Failure: "execution_disabled"}, nil
+	}
+	ctx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	var source execution.Position
+	if json.Unmarshal(r.SourcePosition, &source) != nil {
+		return &cubebox.StopExecutionScopeResponse{Failure: "invalid_execution_position"}, nil
+	}
+	err := s.executions.Stop(ctx, r.BootId, r.SandboxId, r.RunId, r.WriterId, r.OperationId, source)
+	reply := &cubebox.StopExecutionScopeResponse{BootId: s.executions.BootID, Stopped: err == nil}
+	if err != nil {
+		reply.Failure = "scope_stop_unconfirmed"
+	}
+	return reply, nil
+}
