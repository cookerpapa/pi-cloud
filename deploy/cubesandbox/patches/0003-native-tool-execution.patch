+    pub async fn managed_execution(
+        &self,
+        sandbox_id: &str,
+        action: &str,
+        mut body: serde_json::Value,
+    ) -> AppResult<serde_json::Value> {
+        if sandbox_id.len() != 32
+            || !sandbox_id.bytes().all(|b| b.is_ascii_hexdigit())
+            || !matches!(action, "capabilities" | "submit" | "stop" | "probe")
+            || !body.is_object()
+        {
+            return Err(AppError::BadRequest("Invalid execution handoff".into()));
+        }
+        body.as_object_mut()
+            .unwrap()
+            .insert("sandboxID".into(), sandbox_id.to_ascii_lowercase().into());
+        self.cubemaster
+            .managed_execution(action, &body)
+            .await
+            .map_err(internal_error)
+    }
