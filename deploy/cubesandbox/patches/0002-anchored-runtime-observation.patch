+    pub async fn observe_sandbox(
+        &self,
+        sandbox_id: &str,
+        node_id: &str,
+    ) -> AppResult<crate::models::SandboxObservation> {
+        use crate::models::{SandboxObservation, SandboxPresence};
+        if sandbox_id.len() != 32
+            || !sandbox_id.bytes().all(|b| b.is_ascii_hexdigit())
+            || node_id.is_empty()
+            || node_id.len() > 256
+        {
+            return Err(AppError::BadRequest(
+                "Exact sandbox and node identity are required".into(),
+            ));
+        }
+        let sandbox_id = sandbox_id.to_ascii_lowercase();
+        let mut observation = SandboxObservation {
+            sandbox_id: sandbox_id.clone(),
+            node_id: node_id.into(),
+            presence: SandboxPresence::Unavailable,
+            state: SandboxState::Unknown,
+        };
+        match self
+            .cubemaster
+            .observe_sandbox(&sandbox_id, node_id, &self.instance_type)
+            .await
+        {
+            Ok(response)
+                if is_success_ret_code(response.ret.ret_code)
+                    && response.data.len() == 1
+                    && response.data[0].sandbox_id == sandbox_id =>
+            {
+                observation.presence = SandboxPresence::Present;
+                observation.state = match response.data[0].status {
+                    1 => SandboxState::Running,
+                    2 => SandboxState::Stopped,
+                    4 => SandboxState::Pausing,
+                    5 => SandboxState::Paused,
+                    _ => SandboxState::Unknown,
+                };
+            }
+            Err(CubeMasterError::Api {
+                ret_code: 130406, ..
+            }) => observation.presence = SandboxPresence::Absent,
+            _ => {}
+        }
+        Ok(observation)
+    }
