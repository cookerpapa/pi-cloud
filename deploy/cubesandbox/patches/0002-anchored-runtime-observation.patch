+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+package cubes
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	cubeboxstore "github.com/tencentcloud/CubeSandbox/Cubelet/pkg/store/cubebox"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+)
+
+const observedID = "aabbccddeeff00112233445566778899"
+
+func observationFixture(t *testing.T) *local {
+	t.Helper()
+	db, err := utils.NewCubeStoreExt(t.TempDir(), "observe.db", 1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	return &local{db: db, cubeboxStore: cubeboxstore.NewStore(db)}
+}
+
+func TestObserveRetainedMetadataIsNotAbsence(t *testing.T) {
+	l := observationFixture(t)
+	if err := l.db.SetWithTx(cubeboxstore.DBBucketSandbox, observedID, []byte(`{"id":"retained"}`), nil); err != nil {
+		t.Fatal(err)
+	}
+	box, err := l.Observe(context.Background(), observedID)
+	if box != nil || err == nil || errors.Is(err, utils.ErrorKeyNotFound) || !strings.Contains(err.Error(), "recovery") {
+		t.Fatalf("unrecovered metadata must be unavailable, got box=%v error=%v", box, err)
+	}
+}
+
+func TestObserveRequiresRuntimeEvidenceOnCatalogMiss(t *testing.T) {
+	l := observationFixture(t)
+	_, err := l.Observe(context.Background(), observedID)
+	if err == nil || errors.Is(err, utils.ErrorKeyNotFound) || !strings.Contains(err.Error(), "unavailable") {
+		t.Fatalf("missing runtime inspector cannot prove absence: %v", err)
+	}
+}
+
+func TestObserveReturnsRecoveredIdentity(t *testing.T) {
+	l := observationFixture(t)
+	box := &cubeboxstore.CubeBox{Metadata: cubeboxstore.Metadata{ID: observedID, SandboxID: observedID}}
+	l.cubeboxStore.Add(box)
+	got, err := l.Observe(context.Background(), observedID)
+	if err != nil || got != box {
+		t.Fatalf("lost recovered identity: %v", err)
+	}
+}
