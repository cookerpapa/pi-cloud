+	"github.com/tencentcloud/CubeSandbox/Cubelet/api/services/cubebox/v1"
+	cubeboxstore "github.com/tencentcloud/CubeSandbox/Cubelet/pkg/store/cubebox"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+)
+
+type observationCatalog struct {
+	fakeCubeboxAPI
+	failure error
+}
+
+func (f *observationCatalog) Observe(context.Context, string) (*cubeboxstore.CubeBox, error) {
+	return nil, f.failure
+}
+
+func TestExactObservationDoesNotSwallowRecoveryFailure(t *testing.T) {
+	for _, absent := range []bool{false, true} {
+		failure := errors.New("runtime metadata recovery incomplete")
+		if absent {
+			failure = utils.ErrorKeyNotFound
+		}
+		s := &service{cubeboxMgr: &local{cubeboxManger: &observationCatalog{failure: failure}}}
+		id := "aabbccddeeff00112233445566778899"
+		response, err := s.List(context.Background(), &cubebox.ListCubeSandboxRequest{Id: &id})
+		if absent {
+			if err != nil || response == nil || len(response.Items) != 0 {
+				t.Fatalf("bad confirmed absence: %v %v", response, err)
+			}
+		} else if !errors.Is(err, failure) || response != nil {
+			t.Fatalf("recovery failure became a missing runtime: %v %v", response, err)
+		}
+	}
+}
