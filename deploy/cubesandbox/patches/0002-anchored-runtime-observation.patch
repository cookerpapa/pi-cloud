+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+package cubes
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/containerd/containerd/api/services/tasks/v1"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/errdefs"
+	"github.com/containerd/errdefs/pkg/errgrpc"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/sandboxid"
+	cubeboxstore "github.com/tencentcloud/CubeSandbox/Cubelet/pkg/store/cubebox"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+)
+
+// Observe addresses one known runtime. Cache recovery and runtime transport
+// failures are unavailability, never evidence that allocation can be released.
+func (l *local) Observe(ctx context.Context, id string) (*cubeboxstore.CubeBox, error) {
+	box, err := l.Get(ctx, id)
+	if err == nil || !errors.Is(err, utils.ErrorKeyNotFound) {
+		return box, err
+	}
+	if !sandboxid.IsFullID(id) {
+		return nil, fmt.Errorf("absence observation requires a full sandbox ID")
+	}
+	id = strings.ToLower(id)
+	_, err = l.db.Get(cubeboxstore.DBBucketSandbox, id)
+	if err == nil {
+		return nil, fmt.Errorf("sandbox metadata exists but runtime recovery is incomplete")
+	}
+	if !errors.Is(err, utils.ErrorKeyNotFound) && !errors.Is(err, utils.ErrorBucketNotFound) {
+		return nil, fmt.Errorf("sandbox metadata observation failed: %w", err)
+	}
+	if l.client == nil {
+		return nil, fmt.Errorf("sandbox runtime observation is unavailable")
+	}
+	spaces, err := l.client.NamespaceService().List(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("sandbox namespaces could not be observed: %w", err)
+	}
+	for _, space := range spaces {
+		ns := namespaces.WithNamespace(ctx, space)
+		if _, err = l.client.ContainerService().Get(ns, id); err == nil {
+			return nil, fmt.Errorf("sandbox container remains outside the recovered catalog")
+		} else if !errdefs.IsNotFound(err) {
+			return nil, fmt.Errorf("sandbox container observation failed: %w", err)
+		}
+		if _, err = l.client.TaskService().Get(ns, &tasks.GetRequest{ContainerID: id}); err == nil {
+			return nil, fmt.Errorf("sandbox task remains outside the recovered catalog")
+		} else if !errdefs.IsNotFound(errgrpc.ToNative(err)) {
+			return nil, fmt.Errorf("sandbox task observation failed: %w", err)
+		}
+	}
+	return nil, utils.ErrorKeyNotFound
+}
