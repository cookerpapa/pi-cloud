diff --git a/CubeMaster/pkg/templatecenter/cleanup_node_routing_mysql_test.go b/CubeMaster/pkg/templatecenter/cleanup_node_routing_mysql_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..86c2f1858238d4eacaed1cc18a9c2d32e5a9801f
--- /dev/null
+++ b/CubeMaster/pkg/templatecenter/cleanup_node_routing_mysql_test.go
@@ -0,0 +1,118 @@
+package templatecenter
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/node"
+	errorcodev1 "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/errorcode/v1"
+	imagev1 "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/images/v1"
+	"gorm.io/driver/mysql"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func TestArtifactCleanupNodeRoutingMySQL(t *testing.T) {
+	dsn := os.Getenv("PI_CLOUD_TEMPLATE_CLEANUP_MYSQL_DSN")
+	if dsn == "" {
+		t.Skip("disposable MySQL DSN required")
+	}
+	db, err := gorm.Open(mysql.Open(dsn), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	oldDB, oldDestroy, oldLocal, oldAddr := store.db, deleteImageOnCubelet, requestTemplateCenterArtifactDelete, getCubeletAddrForDelete
+	t.Cleanup(func() {
+		store.db = oldDB
+		deleteImageOnCubelet = oldDestroy
+		requestTemplateCenterArtifactDelete = oldLocal
+		getCubeletAddrForDelete = oldAddr
+	})
+	store.db = db
+	getCubeletAddrForDelete = func(ip string) string { return ip + ":9999" }
+	tables := []any{&models.RootfsArtifact{}, &models.ArtifactNodePlacement{}, &models.TemplateDefinition{}, &models.TemplateReplica{}, &models.TemplateImageJob{}, &models.SnapshotRecord{}}
+	if err := db.AutoMigrate(tables...); err != nil {
+		t.Fatal(err)
+	}
+	nodes := map[string]*node.Node{}
+	installCleanupNodes(t, nodes)
+	for _, scenario := range []string{"shared-reference", "missing-node", "rpc-failure", "node-pin", "current-address"} {
+		t.Run(scenario, func(t *testing.T) {
+			for _, table := range tables {
+				if err := db.Session(&gorm.Session{AllowGlobalUpdate: true}).Unscoped().Delete(table).Error; err != nil {
+					t.Fatal(err)
+				}
+			}
+			delete(nodes, "node-a")
+			if scenario != "missing-node" {
+				nodes["node-a"] = &node.Node{InsID: "node-a", IP: "10.0.0.9"}
+			}
+			artifact := models.RootfsArtifact{ArtifactID: "rfs-routing-owned", Status: ArtifactStatusReady}
+			if err := db.Create(&artifact).Error; err != nil {
+				t.Fatal(err)
+			}
+			if err := db.Create(&models.ArtifactNodePlacement{ArtifactID: artifact.ArtifactID, NodeID: "node-a", NodeIP: "10.0.0.1"}).Error; err != nil {
+				t.Fatal(err)
+			}
+			if scenario == "shared-reference" {
+				if err := db.Create(&models.TemplateDefinition{TemplateID: "tpl-keep", RootfsArtifactID: artifact.ArtifactID, Status: StatusReady}).Error; err != nil {
+					t.Fatal(err)
+				}
+			}
+			remoteCalls, notifyCalls := 0, 0
+			deleteImageOnCubelet = func(ctx context.Context, addr string, req *imagev1.DestroyImageRequest) (*imagev1.DestroyImageResponse, error) {
+				remoteCalls++
+				if addr != "10.0.0.9:9999" {
+					t.Fatalf("artifact used historical address %s", addr)
+				}
+				if scenario == "rpc-failure" {
+					return nil, context.DeadlineExceeded
+				}
+				if scenario == "node-pin" {
+					return &imagev1.DestroyImageResponse{Ret: &errorcodev1.Ret{RetCode: errorcodev1.ErrorCode_Conflict}}, nil
+				}
+				return &imagev1.DestroyImageResponse{Ret: &errorcodev1.Ret{RetCode: errorcodev1.ErrorCode_Success}}, nil
+			}
+			requestTemplateCenterArtifactDelete = func(ctx context.Context, id string) error {
+				notifyCalls++
+				if id != artifact.ArtifactID {
+					t.Fatal("wrong artifact")
+				}
+				return db.Where("artifact_id = ?", id).Unscoped().Delete(&models.RootfsArtifact{}).Error
+			}
+			if err := cleanupArtifactFully(context.Background(), artifact.ArtifactID, "cubebox", ""); err != nil {
+				t.Fatal(err)
+			}
+			var remaining models.RootfsArtifact
+			err := db.Where("artifact_id = ?", artifact.ArtifactID).First(&remaining).Error
+			var placements int64
+			if err := db.Model(&models.ArtifactNodePlacement{}).Where("artifact_id = ?", artifact.ArtifactID).Count(&placements).Error; err != nil {
+				t.Fatal(err)
+			}
+			if scenario == "current-address" {
+				if !errors.Is(err, gorm.ErrRecordNotFound) || placements != 0 || remoteCalls != 1 || notifyCalls != 1 {
+					t.Fatalf("successful cleanup did not converge: err=%v placements=%d remote=%d local=%d", err, placements, remoteCalls, notifyCalls)
+				}
+				return
+			}
+			expected := ArtifactStatusCleanupPending
+			if scenario == "shared-reference" {
+				expected = ArtifactStatusReady
+			}
+			if err != nil || remaining.Status != expected || placements != 1 || notifyCalls != 0 {
+				t.Fatalf("unconfirmed/in-use artifact lost evidence: err=%v status=%s placements=%d local=%d", err, remaining.Status, placements, notifyCalls)
+			}
+			if (scenario == "missing-node" || scenario == "shared-reference") && remoteCalls != 0 {
+				t.Fatalf("unexpected remote destruction: %d", remoteCalls)
+			}
+		})
+	}
+}
diff --git a/CubeMaster/pkg/templatecenter/cleanup_node_routing_test.go b/CubeMaster/pkg/templatecenter/cleanup_node_routing_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..53c1d586ff88dc68dccbe24ffd46992aced73713
--- /dev/null
+++ b/CubeMaster/pkg/templatecenter/cleanup_node_routing_test.go
@@ -0,0 +1,155 @@
+package templatecenter
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+
+	"github.com/agiledragon/gomonkey/v2"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/node"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	cubeboxv1 "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	errorcodev1 "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/errorcode/v1"
+)
+
+func installCleanupNodes(t *testing.T, nodes map[string]*node.Node) {
+	t.Helper()
+	patches := gomonkey.NewPatches()
+	patches.ApplyFunc(localcache.GetNode, func(id string) (*node.Node, bool) { n, ok := nodes[id]; return n, ok })
+	t.Cleanup(patches.Reset)
+}
+
+func captureCleanupCalls(t *testing.T) *[]string {
+	t.Helper()
+	previousCall, previousAddress := cleanupTemplateOnCubelet, getCubeletAddrForDelete
+	t.Cleanup(func() { cleanupTemplateOnCubelet = previousCall; getCubeletAddrForDelete = previousAddress })
+	getCubeletAddrForDelete = func(ip string) string { return ip + ":9999" }
+	calls := []string{}
+	cleanupTemplateOnCubelet = func(ctx context.Context, addr string, req *cubeboxv1.CleanupTemplateRequest) (*cubeboxv1.CleanupTemplateResponse, error) {
+		calls = append(calls, addr)
+		if req.GetTemplateID() != "tpl-owned" {
+			t.Fatalf("unexpected cleanup identity %q", req.GetTemplateID())
+		}
+		return &cubeboxv1.CleanupTemplateResponse{Ret: &errorcodev1.Ret{RetCode: errorcodev1.ErrorCode_Success}}, nil
+	}
+	return &calls
+}
+
+func TestTemplateCleanupUsesCurrentNodeAfterAddressChange(t *testing.T) {
+	installCleanupNodes(t, map[string]*node.Node{"node-a": {InsID: "node-a", IP: "10.0.0.9"}})
+	calls := captureCleanupCalls(t)
+	if err := cleanupTemplateReplicasWithLocators(context.Background(), "tpl-owned", []templateCleanupLocator{{NodeID: "node-a", NodeIP: "10.0.0.1"}}, ""); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(*calls, []string{"10.0.0.9:9999"}) {
+		t.Fatalf("used historical endpoint: %v", *calls)
+	}
+}
+
+func TestTemplateCleanupDeduplicatesNodeNotAddress(t *testing.T) {
+	installCleanupNodes(t, map[string]*node.Node{"node-a": {InsID: "node-a", IP: "10.0.0.8"}, "node-b": {InsID: "node-b", IP: "10.0.0.9"}})
+	calls := captureCleanupCalls(t)
+	locators := []templateCleanupLocator{{NodeID: "node-a", NodeIP: "10.0.0.1"}, {NodeID: "node-a", NodeIP: "10.0.0.2"}, {NodeID: "node-b", NodeIP: "10.0.0.1"}}
+	if err := cleanupTemplateReplicasWithLocators(context.Background(), "tpl-owned", locators, ""); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(*calls, []string{"10.0.0.8:9999", "10.0.0.9:9999"}) {
+		t.Fatalf("unexpected physical targets: %v", *calls)
+	}
+	targets := &templateCleanupTargets{}
+	for _, l := range locators {
+		targets.addLocator(l)
+	}
+	if len(targets.Locators) != 2 {
+		t.Fatalf("replica/job observations created %d targets", len(targets.Locators))
+	}
+}
+
+func TestTemplateCleanupUnresolvedNodePreservesMetadata(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		locator templateCleanupLocator
+		nodes   map[string]*node.Node
+	}{
+		{"missing registration", templateCleanupLocator{NodeID: "node-a", NodeIP: "10.0.0.1"}, nil},
+		{"IP alone", templateCleanupLocator{NodeIP: "10.0.0.1"}, nil},
+		{"empty current address", templateCleanupLocator{NodeID: "node-a", NodeIP: "10.0.0.1"}, map[string]*node.Node{"node-a": {InsID: "node-a"}}},
+		{"mismatched registration", templateCleanupLocator{NodeID: "node-a", NodeIP: "10.0.0.1"}, map[string]*node.Node{"node-a": {InsID: "node-b", IP: "10.0.0.9"}}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			installCleanupNodes(t, tt.nodes)
+			calls := captureCleanupCalls(t)
+			previousArtifact, previousMetadata, previousJobs := runArtifactCleanup, runMetadataCleanup, runTemplateJobCleanup
+			t.Cleanup(func() {
+				runArtifactCleanup = previousArtifact
+				runMetadataCleanup = previousMetadata
+				runTemplateJobCleanup = previousJobs
+			})
+			laterCalls := 0
+			runArtifactCleanup = func(context.Context, string, *templateCleanupTargets) error { laterCalls++; return nil }
+			runMetadataCleanup = func(context.Context, string) error { laterCalls++; return nil }
+			runTemplateJobCleanup = func(context.Context, string) error { laterCalls++; return nil }
+			err := deleteTemplateWithTargets(context.Background(), "tpl-owned", &templateCleanupTargets{Jobs: []models.TemplateImageJob{{TemplateID: "tpl-owned"}}, Locators: []templateCleanupLocator{tt.locator}}, DeleteTemplateOptions{})
+			if err == nil || len(*calls) != 0 || laterCalls != 0 {
+				t.Fatalf("unresolved target advanced cleanup: err=%v calls=%v later=%d", err, *calls, laterCalls)
+			}
+		})
+	}
+}
+
+func TestTemplateCleanupPreservesCancellationAndRPCFailure(t *testing.T) {
+	for _, cause := range []error{context.Canceled, context.DeadlineExceeded, errors.New("cubelet unavailable")} {
+		t.Run(cause.Error(), func(t *testing.T) {
+			installCleanupNodes(t, map[string]*node.Node{"node-a": {InsID: "node-a", IP: "10.0.0.9"}})
+			captureCleanupCalls(t)
+			cleanupTemplateOnCubelet = func(ctx context.Context, addr string, req *cubeboxv1.CleanupTemplateRequest) (*cubeboxv1.CleanupTemplateResponse, error) {
+				if addr != "10.0.0.9:9999" {
+					t.Fatalf("wrong endpoint %s", addr)
+				}
+				return nil, cause
+			}
+			err := cleanupTemplateReplicasWithLocators(context.Background(), "tpl-owned", []templateCleanupLocator{{NodeID: "node-a", NodeIP: "10.0.0.1"}}, "")
+			if !errors.Is(err, cause) {
+				t.Fatalf("lost cleanup failure: %v", err)
+			}
+		})
+	}
+}
+
+func TestArtifactCleanupUsesRegisteredNode(t *testing.T) {
+	installCleanupNodes(t, map[string]*node.Node{"node-a": {InsID: "node-a", IP: "10.0.0.9"}})
+	target := placementToNode(&models.ArtifactNodePlacement{NodeID: "node-a", NodeIP: "10.0.0.1"})
+	if target == nil || target.ID() != "node-a" || target.HostIP() != "10.0.0.9" {
+		t.Fatalf("wrong artifact cleanup target: %+v", target)
+	}
+	for _, p := range []*models.ArtifactNodePlacement{nil, {NodeID: "gone", NodeIP: "10.0.0.1"}, {NodeIP: "10.0.0.1"}} {
+		if placementToNode(p) != nil {
+			t.Fatal("unresolved artifact placement must remain pending")
+		}
+	}
+}
+
+func TestReplicaCleanupFilterDoesNotFollowReusedAddress(t *testing.T) {
+	installCleanupNodes(t, map[string]*node.Node{"node-a": {InsID: "node-a", IP: "10.0.0.8"}, "node-b": {InsID: "node-b", IP: "10.0.0.9"}})
+	calls := captureCleanupCalls(t)
+	err := cleanupTemplateReplicasOnNodes(context.Background(), "tpl-owned", []models.TemplateReplica{{NodeID: "node-a", NodeIP: "10.0.0.1"}, {NodeID: "node-b", NodeIP: "10.0.0.8"}}, []*node.Node{{InsID: "node-a", IP: "10.0.0.8"}}, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(*calls, []string{"10.0.0.8:9999"}) {
+		t.Fatalf("address equality selected a different physical node: %v", *calls)
+	}
+}
+
+func TestTemplateCleanupRetainsInUseTemplate(t *testing.T) {
+	calls := captureCleanupCalls(t)
+	patches := gomonkey.NewPatches()
+	patches.ApplyFunc(isTemplateInUse, func(context.Context, string, string) (bool, error) { return true, nil })
+	t.Cleanup(patches.Reset)
+	err := deleteTemplateWithTargets(context.Background(), "tpl-owned", &templateCleanupTargets{Definition: &models.TemplateDefinition{TemplateID: "tpl-owned", Status: StatusReady}, Locators: []templateCleanupLocator{{NodeID: "node-a", NodeIP: "10.0.0.1"}}}, DeleteTemplateOptions{})
+	if !errors.Is(err, ErrTemplateInUse) || len(*calls) != 0 {
+		t.Fatalf("in-use template reached physical cleanup: %v, %v", err, *calls)
+	}
+}
