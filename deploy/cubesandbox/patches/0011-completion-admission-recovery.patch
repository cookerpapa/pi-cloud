+// Recover the existing result-delivery process before accepting new work. An
+// idle child's exit must not require new VM discovery to enable Tools again.
+// Healthy admission stays memory-only; recovery never replays a guest command.
+func (s *service) completionReady(ctx context.Context) bool {
+	if ctx.Err() != nil || s.completions == nil {
+		return false
+	}
+	if s.completions.Ready() {
+		return true
+	}
+	bounded, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	return s.completions.EnsureReady(bounded) == nil && bounded.Err() == nil
+}
