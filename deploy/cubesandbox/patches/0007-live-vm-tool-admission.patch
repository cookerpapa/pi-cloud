+func TestRemovedRuntimeCannotRecreateAdmissionState(t *testing.T) {
+	var present atomic.Bool
+	present.Store(true)
+	var calls atomic.Int32
+	r := request()
+	m := New(catalogDriver{
+		driverFunc: func(context.Context, Request, func(json.RawMessage)) Result {
+			calls.Add(1)
+			return Result{}
+		},
+		present: func(id string) bool { return id != r.SandboxID || present.Load() },
+	}, deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	present.Store(false) // Native catalog deletion precedes confirmed absence.
+	m.ForgetRuntime(r.SandboxID)
+	r.OperationID = uuid.NewString()
+	r.Source.Offset = "101"
+	for i := 0; i < 100; i++ {
+		if why := m.Submit(m.BootID, r); why != "execution_unavailable" {
+			t.Fatal(why)
+		}
+		if why := m.Cancel(m.BootID, r); why != "execution_unavailable" {
+			t.Fatal(why)
+		}
+	}
+	m.mu.Lock()
+	positions, operations, active := len(m.positions), len(m.operations), m.active
+	m.mu.Unlock()
+	if positions != 0 || operations != 0 || active != 0 || calls.Load() != 1 {
+		t.Fatal("removed identity acquired state or work", positions, operations, active, calls.Load())
+	}
+	fresh := request()
+	fresh.SandboxID = "another-live-vm"
+	if why := m.Submit(m.BootID, fresh); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	if calls.Load() != 2 || !m.Accepting() {
+		t.Fatal("missing VM blocked another VM")
+	}
+}
+
+func TestCatalogCheckAndPositionAdmissionJoinConfirmedAbsence(t *testing.T) {
+	for _, method := range []string{"submit", "cancel"} {
+		t.Run(method, func(t *testing.T) {
+			var present atomic.Bool
+			present.Store(true)
+			checked, release := make(chan struct{}), make(chan struct{})
+			var checkOnce, releaseOnce sync.Once
+			m := New(catalogDriver{
+				driverFunc: func(ctx context.Context, _ Request, _ func(json.RawMessage)) Result {
+					<-ctx.Done()
+					return Result{}
+				},
+				present: func(string) bool {
+					value := present.Load()
+					checkOnce.Do(func() { close(checked); <-release })
+					return value
+				},
+			}, deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+			defer func() { releaseOnce.Do(func() { close(release) }); m.Close() }()
+			r := request()
+			admit := m.Submit
+			if method == "cancel" {
+				admit = m.Cancel
+			}
+			admitted := make(chan string, 1)
+			go func() { admitted <- admit(m.BootID, r) }()
+			await(t, checked)
+			present.Store(false)
+			forgetting, forgotten := make(chan struct{}), make(chan struct{})
+			go func() { close(forgetting); m.ForgetRuntime(r.SandboxID); close(forgotten) }()
+			await(t, forgetting)
+			select {
+			case <-forgotten:
+				t.Fatal("absence crossed an unsettled admission")
+			case <-time.After(20 * time.Millisecond):
+			}
+			releaseOnce.Do(func() { close(release) })
+			select {
+			case why := <-admitted:
+				if why != "" {
+					t.Fatal(why)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("admission did not settle")
+			}
+			await(t, forgotten)
+			m.wg.Wait()
+			if why := admit(m.BootID, r); why != "execution_unavailable" {
+				t.Fatal(why)
+			}
+			m.mu.Lock()
+			positions, operations, active := len(m.positions), len(m.operations), m.active
+			m.mu.Unlock()
+			if positions != 0 || operations != 0 || active != 0 {
+				t.Fatal("forgotten identity was recreated", positions, operations, active)
+			}
+		})
+	}
+}
