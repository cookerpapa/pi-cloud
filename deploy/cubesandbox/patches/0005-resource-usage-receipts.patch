@@ -0,0 +1,311 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package cubebox
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"net/url"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	containerd "github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/cookerpapa/pi-cloud/resource-metering"
+	"github.com/google/uuid"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/allocation"
+	cubeboxstore "github.com/tencentcloud/CubeSandbox/Cubelet/pkg/store/cubebox"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/cube/internals/cubes"
+	"github.com/tencentcloud/CubeSandbox/pkgs/CubeLog"
+	cubebox "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+)
+
+type resourceMetering struct {
+	service         *service
+	journal         *resourceusage.Journal
+	endpoint, token string
+	wake            chan struct{}
+	mu              sync.Mutex
+	lifecycle       map[string]string
+	captureFailures atomic.Uint64
+	collectionMu    sync.Mutex
+	completedCycles atomic.Uint64
+	collectionReady bool
+}
+
+func (s *service) startResourceMetering(ctx context.Context, db resourceusage.Database) error {
+	endpoint := os.Getenv("PI_CLOUD_RESOURCE_METERING_URL")
+	file := os.Getenv("PI_CLOUD_RESOURCE_METERING_KEY_FILE")
+	source := os.Getenv("PI_CLOUD_RESOURCE_METERING_SOURCE_ID")
+	if endpoint == "" && file == "" && source == "" {
+		return nil
+	}
+	parsed, err := url.Parse(endpoint)
+	if err != nil || parsed.Host == "" || parsed.User != nil || parsed.RawQuery != "" || parsed.Fragment != "" || (parsed.Scheme != "http" && parsed.Scheme != "https") || file == "" || source == "" {
+		return errors.New("invalid resource metering configuration")
+	}
+	raw, err := os.ReadFile(file)
+	if err != nil {
+		return errors.New("resource metering credential unavailable")
+	}
+	token := strings.TrimSpace(string(raw))
+	if token == "" {
+		return errors.New("empty resource metering credential")
+	}
+	journal, err := resourceusage.New(db, source, uuid.NewString(), time.Now())
+	if err != nil {
+		return err
+	}
+	meter := &resourceMetering{service: s, journal: journal, endpoint: endpoint, token: token, wake: make(chan struct{}, 1), lifecycle: map[string]string{}}
+	s.resourceMetering = meter
+	for _, metric := range []prometheus.Collector{
+		prometheus.NewGaugeFunc(prometheus.GaugeOpts{Name: "picloud_resource_metering_pending", Help: "Durable resource receipts awaiting accounting acknowledgement."}, func() float64 {
+			n, err := journal.PendingCount()
+			if err != nil {
+				return math.NaN()
+			}
+			return float64(n)
+		}),
+		prometheus.NewCounterFunc(prometheus.CounterOpts{Name: "picloud_resource_metering_capture_failures_total", Help: "Resource observation capture failures; never VM liveness authority."}, func() float64 { return float64(meter.captureFailures.Load()) }),
+		prometheus.NewCounterFunc(prometheus.CounterOpts{Name: "picloud_resource_metering_collection_cycles_total", Help: "Completed resource sweeps with available observations and durable capture.", ConstLabels: prometheus.Labels{"source_id": source, "boot_id": journal.BootID}}, func() float64 { return float64(meter.completedCycles.Load()) }),
+		prometheus.NewGaugeFunc(prometheus.GaugeOpts{Name: "picloud_resource_metering_delivery_barrier", Help: "Completed source cycles at a coherent empty-outbox boundary; NaN while busy or unconfirmed. Accounting delivery evidence only.", ConstLabels: prometheus.Labels{"source_id": source, "boot_id": journal.BootID}}, meter.deliveryBarrier),
+	} {
+		if err := prometheus.Register(metric); err != nil {
+			CubeLog.Warn("Resource metering metric registration unavailable")
+		}
+	}
+
+	if registry, ok := s.cubeboxMgr.cubeboxManger.(cubes.CubeboxEventListenerRegistry); ok {
+		registry.Register(meter)
+	}
+	go meter.collectLoop(ctx)
+	go meter.deliverLoop(ctx)
+	return nil
+}
+
+func (m *resourceMetering) OnCubeboxEvent(_ context.Context, event *cubes.CubeboxEvent) error {
+	if event == nil || event.Cubebox == nil || event.Cubebox.MainStatus() == nil {
+		return nil
+	}
+	event.Cubebox.MetaLock.Lock()
+	managed := event.Cubebox.Labels["picloud.managed"] == "true" && event.Cubebox.Labels["picloud.tenant_id"] != ""
+	event.Cubebox.MetaLock.Unlock()
+	if !managed {
+		return nil
+	}
+	mainStatus := event.Cubebox.MainStatus()
+	if mainStatus == nil { return nil }
+	status := mainStatus.Get()
+	signature := fmt.Sprintf("%d/%d/%d/%d/%d", status.State(), status.StartedAt, status.FinishedAt, status.PausedAt, status.PausingAt)
+	m.mu.Lock()
+	previous := m.lifecycle[event.Cubebox.ID]
+	m.lifecycle[event.Cubebox.ID] = signature
+	m.mu.Unlock()
+	if signature != previous {
+		select {
+		case m.wake <- struct{}{}:
+		default:
+		}
+	}
+	return nil
+}
+
+// Meter the accepted workload allocation, excluding host/VMM overhead and
+// snapshot rounding. Actual physical running evidence is sampled separately.
+func declaredComputeQuantity(box *cubeboxstore.CubeBox) (resourceusage.Quantity, bool) {
+	result := resourceusage.Quantity{Kind: "compute"}
+	for _, container := range box.AllContainers() {
+		container.MetaLock.Lock()
+		requested := container.Config.GetResources()
+		cpu, cpuErr := resource.ParseQuantity(requested.GetCpu())
+		memory, memErr := resource.ParseQuantity(requested.GetMem())
+		container.MetaLock.Unlock()
+		if cpuErr != nil || memErr != nil || cpu.Sign() <= 0 || memory.Sign() <= 0 {
+			return result, false
+		}
+		cores, bytes := cpu.MilliValue(), memory.Value()
+		if cores <= 0 || bytes <= 0 || cores > math.MaxInt64-result.CPUMillis || bytes > math.MaxInt64-result.MemoryBytes {
+			return result, false
+		}
+		result.CPUMillis += cores
+		result.MemoryBytes += bytes
+	}
+	return result, result.CPUMillis > 0 && result.MemoryBytes > 0
+}
+
+func (m *resourceMetering) sample(ctx context.Context, box *cubeboxstore.CubeBox, now time.Time) (resourceusage.Sample, bool) {
+	box.MetaLock.Lock()
+	labels := box.Labels
+	identity := resourceusage.Identity{Kind: "compute", ResourceID: box.Annotations["pi-cloud.allocation.id"], TenantID: labels["picloud.tenant_id"], WorkspaceID: labels["picloud.workspace_id"]}
+	managed := labels["picloud.managed"] == "true"
+	box.MetaLock.Unlock()
+	quantity, validQuantity := declaredComputeQuantity(box)
+	if !validQuantity || !managed || identity.ResourceID == "" || allocation.SandboxID(identity.ResourceID) != box.ID || identity.TenantID == "" || identity.WorkspaceID == "" || quantity.CPUMillis <= 0 || quantity.MemoryBytes <= 0 || box.MainStatus() == nil {
+		return resourceusage.Sample{}, false
+	}
+	status := box.MainStatus().Get()
+	observation := resourceusage.Sample{Resource: identity, Quantity: quantity, Incarnation: fmt.Sprint(status.StartedAt), At: now.UnixMilli(), StartedAt: status.StartedAt / int64(time.Millisecond), State: "unknown"}
+	switch status.State() {
+	case cubebox.ContainerState_CONTAINER_RUNNING:
+		// Cached lifecycle state alone is insufficient to accrue another interval.
+		first := box.FirstContainer()
+		if first == nil || first.Container == nil {
+			return observation, true
+		}
+		scope, cancel := context.WithTimeout(namespaces.WithNamespace(ctx, box.Namespace), 2*time.Second)
+		defer cancel()
+		task, err := first.Container.Task(scope, nil)
+		if err != nil {
+			return observation, true
+		}
+		physical, err := task.Status(scope)
+		if err == nil && physical.Status == containerd.Running && !status.RollingBack {
+			observation.State = "running"
+		}
+	case cubebox.ContainerState_CONTAINER_PAUSED:
+		observation.State = "paused"
+		// PausedAt is written after snapshot packaging; the VM stopped earlier.
+		// Without the exact physical stop time, the trailing interval is unknown.
+		// Later paused samples consume no compute time.
+
+	case cubebox.ContainerState_CONTAINER_EXITED:
+		observation.State = "absent"
+		// FinishedAt also contains recovery/TaskOOM observation times. It has
+		// no provenance proving the actual exit instant, so keep the tail unknown.
+	}
+	return observation, true
+}
+
+func (m *resourceMetering) collect(ctx context.Context) {
+	m.collectionMu.Lock()
+	defer m.collectionMu.Unlock()
+	m.collectionReady = false
+	now := time.Now()
+	known, err := m.journal.Cursors()
+	if err != nil {
+		m.captureFailures.Add(1)
+		CubeLog.Warn("Resource metering cursor read unavailable")
+		return
+	}
+	observed := map[string]resourceusage.Sample{}
+	present := map[string]bool{}
+	complete := true
+	for _, box := range m.service.cubeboxMgr.cubeboxManger.List() {
+		present[box.ID] = true
+		sample, ok := m.sample(ctx, box, now)
+		if ok {
+			observed[sample.Resource.ResourceID] = sample
+		} else {
+			box.MetaLock.Lock()
+			managed := box.Labels["picloud.managed"] == "true" && box.Annotations["pi-cloud.allocation.id"] != ""
+			box.MetaLock.Unlock()
+			if managed {
+				complete = false
+			}
+		}
+	}
+	m.mu.Lock()
+	for id := range m.lifecycle {
+		if !present[id] {
+			delete(m.lifecycle, id)
+		}
+	}
+	m.mu.Unlock()
+	for _, cursor := range known {
+		if _, ok := observed[cursor.Resource.ResourceID]; ok {
+			continue
+		}
+		if cursor.State == "absent" {
+			continue
+		}
+		scope, cancel := context.WithTimeout(ctx, 2*time.Second)
+		_, err := m.service.cubeboxMgr.cubeboxManger.Observe(scope, allocation.SandboxID(cursor.Resource.ResourceID))
+		cancel()
+		state := "unknown"
+		if errors.Is(err, utils.ErrorKeyNotFound) {
+			state = "absent"
+		}
+		observed[cursor.Resource.ResourceID] = resourceusage.Sample{Resource: cursor.Resource, Quantity: cursor.Quantity, Incarnation: cursor.Incarnation, At: now.UnixMilli(), State: state}
+	}
+	failed := false
+	for id, sample := range observed {
+		if sample.State == "unknown" {
+			complete = false
+		}
+		sample.Clock = now
+		if err := m.journal.Capture(sample); err != nil {
+			failed = true
+			continue
+		}
+		if sample.State == "absent" {
+			m.mu.Lock()
+			delete(m.lifecycle, allocation.SandboxID(id))
+			m.mu.Unlock()
+		}
+	}
+	if failed {
+		m.captureFailures.Add(1)
+		CubeLog.Warn("Resource metering capture deferred; lifecycle cleanup remains available")
+	} else if complete {
+		m.completedCycles.Add(1)
+		m.collectionReady = true
+	}
+}
+
+func (m *resourceMetering) deliveryBarrier() float64 {
+	// A scrape never delays the collector. Holding this lock only while reading
+	// the durable count prevents pairing an old pending=0 with a newer cycle.
+	if !m.collectionMu.TryLock() {
+		return math.NaN()
+	}
+	defer m.collectionMu.Unlock()
+	if !m.collectionReady {
+		return math.NaN()
+	}
+	pending, err := m.journal.PendingCount()
+	if err != nil || pending != 0 {
+		return math.NaN()
+	}
+	return float64(m.completedCycles.Load())
+}
+
+func (m *resourceMetering) collectLoop(ctx context.Context) {
+	ticker := time.NewTicker(30 * time.Second)
+	defer ticker.Stop()
+	m.collect(ctx)
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			m.collect(ctx)
+		case <-m.wake:
+			// Lifecycle hints coalesce; current native state is always reread.
+			m.collect(ctx)
+		}
+	}
+}
+func (m *resourceMetering) deliverLoop(ctx context.Context) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	var lastWarning time.Time
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+		if err := m.journal.Deliver(ctx, m.endpoint, m.token); err != nil && time.Since(lastWarning) >= 30*time.Second {
+			CubeLog.Warn("Resource receipt delivery pending")
+			lastWarning = time.Now()
+		}
+	}
+}
