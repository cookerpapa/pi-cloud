@@ -0,0 +1,42 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: MIT
+package cubebox
+
+import (
+	"context"
+	cubeboxstore "github.com/tencentcloud/CubeSandbox/Cubelet/pkg/store/cubebox"
+	protocol "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	"testing"
+	"time"
+)
+
+func TestMeteringUsesAcceptedCapacityWithoutPlatformOverhead(t *testing.T) {
+	box := &cubeboxstore.CubeBox{Metadata: cubeboxstore.Metadata{ResourceWithOverHead: &cubeboxstore.ResourceWithOverHead{VmCpuQ: resource.MustParse("3"), VmMemQ: resource.MustParse("3Gi")}}}
+	box.AddContainer(&cubeboxstore.Container{Metadata: cubeboxstore.Metadata{ID: "user", Config: &protocol.ContainerConfig{Resources: &protocol.Resource{Cpu: "2", Mem: "2Gi"}}}})
+	got, ok := declaredComputeQuantity(box)
+	if !ok || got.CPUMillis != 2000 || got.MemoryBytes != 2<<30 {
+		t.Fatalf("overhead entered user metering: %+v %v", got, ok)
+	}
+	box.AddContainer(&cubeboxstore.Container{Metadata: cubeboxstore.Metadata{ID: "other", Config: &protocol.ContainerConfig{Resources: &protocol.Resource{Cpu: "500m", Mem: "256Mi"}}}})
+	got, ok = declaredComputeQuantity(box)
+	if !ok || got.CPUMillis != 2500 || got.MemoryBytes != 2<<30+256<<20 {
+		t.Fatalf("accepted allocations were not summed: %+v %v", got, ok)
+	}
+	box.AddContainer(&cubeboxstore.Container{Metadata: cubeboxstore.Metadata{ID: "broken"}})
+	if _, ok := declaredComputeQuantity(box); ok {
+		t.Fatal("missing accepted resource metadata was treated as zero")
+	}
+}
+
+func TestMeteringDoesNotBillPausePackagingAsRunningTime(t *testing.T) {
+	now := time.Now()
+	allocation := "11111111-1111-4111-8111-111111111111"
+	sandbox := "11111111111141118111111111111111"
+	box := &cubeboxstore.CubeBox{Metadata: cubeboxstore.Metadata{ID: sandbox, Annotations: map[string]string{"pi-cloud.allocation.id": allocation}, Labels: map[string]string{"picloud.managed": "true", "picloud.tenant_id": "22222222-2222-4222-8222-222222222222", "picloud.workspace_id": "33333333-3333-4333-8333-333333333333"}}}
+	box.AddContainer(&cubeboxstore.Container{IsPod: true, Metadata: cubeboxstore.Metadata{ID: sandbox, Config: &protocol.ContainerConfig{Resources: &protocol.Resource{Cpu: "2", Mem: "2Gi"}}}, Status: cubeboxstore.StoreStatus(cubeboxstore.Status{StartedAt: now.Add(-time.Minute).UnixNano(), PausedAt: now.UnixNano()})})
+	sample, ok := (&resourceMetering{}).sample(context.Background(), box, now)
+	if !ok || sample.State != "paused" || sample.EndedAt != 0 {
+		t.Fatalf("logical pause timestamp became physical stop evidence: %+v %v", sample, ok)
+	}
+}
