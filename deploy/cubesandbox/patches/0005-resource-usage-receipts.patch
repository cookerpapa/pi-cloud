index 0000000000000000000000000000000000000000..ef580f0c3ae3b9374370f04a25e5d389b71c610a
--- /dev/null
+++ b/Cubelet/pkg/resourceusage/delivery.go
@@ -0,0 +1,52 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package resourceusage
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+)
+
+var receiptHTTPClient = &http.Client{Timeout: 10 * time.Second, Transport: &http.Transport{}, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+
+func (j *Journal) Deliver(ctx context.Context, endpoint, token string) error {
+	rows, err := j.Batch(128)
+	if err != nil || len(rows) == 0 {
+		return err
+	}
+	events := make([]json.RawMessage, len(rows))
+	for i, row := range rows {
+		events[i] = row.Body
+	}
+	body, err := json.Marshal(struct {
+		Events []json.RawMessage `json:"events"`
+	}{events})
+	if err != nil {
+		return err
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	request.Header.Set("Authorization", "Bearer "+token)
+	request.Header.Set("Content-Type", "application/json")
+	// This is private infrastructure delivery, never a public model proxy route.
+
+	response, err := receiptHTTPClient.Do(request)
+	if err != nil {
+		return errors.New("resource receiver unavailable")
+	}
+	defer response.Body.Close()
+	var ack struct {
+		Accepted int `json:"accepted"`
+	}
+	if response.StatusCode != http.StatusOK || json.NewDecoder(io.LimitReader(response.Body, 8192)).Decode(&ack) != nil || ack.Accepted != len(rows) {
+		return errors.New("resource batch not acknowledged")
+	}
+	return j.Acknowledge(rows)
+}
diff --git a/Cubelet/pkg/resourceusage/journal.go b/Cubelet/pkg/resourceusage/journal.go
new file mode 100644
index 0000000000000000000000000000000000000000..3156b46e6060c9534d2f2284a7375b868a4abc19
--- /dev/null
+++ b/Cubelet/pkg/resourceusage/journal.go
@@ -0,0 +1,303 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package resourceusage
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"time"
+
+	"github.com/google/uuid"
+	bolt "go.etcd.io/bbolt"
+)
+
+type Database interface {
+	Update(func(*bolt.Tx) error) error
+	View(func(*bolt.Tx) error) error
+}
+type Identity struct {
+	Kind        string `json:"kind"`
+	ResourceID  string `json:"resourceId"`
+	TenantID    string `json:"tenantId"`
+	WorkspaceID string `json:"workspaceId"`
+}
+type Quantity struct {
+	Kind          string `json:"kind"`
+	CPUMillis     int64  `json:"cpuMillis,omitempty"`
+	MemoryBytes   int64  `json:"memoryBytes,omitempty"`
+	CapacityBytes int64  `json:"capacityBytes,omitempty"`
+}
+type Event struct {
+	Version      int      `json:"version"`
+	EventID      string   `json:"eventId"`
+	Resource     Identity `json:"resource"`
+	SourceID     string   `json:"sourceId"`
+	SourceBootID string   `json:"sourceBootId"`
+	Incarnation  string   `json:"incarnation"`
+	From         string   `json:"from"`
+	To           string   `json:"to"`
+	Quality      string   `json:"quality"`
+	Reason       string   `json:"reason,omitempty"`
+	State        string   `json:"state"`
+	Quantity     Quantity `json:"quantity"`
+}
+type Sample struct {
+	Resource    Identity
+	Quantity    Quantity
+	Incarnation string
+	State       string
+	At          int64
+	// Native physical timestamps are optional evidence, not inferred deadlines.
+	StartedAt       int64
+	EndedAt         int64
+	UncertainReason string
+}
+type Cursor struct {
+	Resource    Identity `json:"resource"`
+	Quantity    Quantity `json:"quantity"`
+	Incarnation string   `json:"incarnation"`
+	State       string   `json:"state"`
+	At          int64    `json:"at"`
+	BootID      string   `json:"bootId"`
+}
+type Journal struct {
+	db               Database
+	SourceID, BootID string
+	BootAt           int64
+}
+
+var root = []byte("pi-cloud.resource-usage.v1")
+var cursors = []byte("cursors")
+var pending = []byte("pending")
+var pendingCount = []byte("pending-count")
+var ErrFull = errors.New("resource receipt buffer is full")
+
+const MaxPending = 65536
+const MaximumObservedInterval = 90 * time.Second
+
+func New(db Database, sourceID, bootID string, now time.Time) (*Journal, error) {
+	if db == nil || sourceID == "" || bootID == "" {
+		return nil, errors.New("resource metering configuration missing")
+	}
+	j := &Journal{db: db, SourceID: sourceID, BootID: bootID, BootAt: now.UnixMilli()}
+	err := db.Update(func(tx *bolt.Tx) error {
+		if tx.DB().NoSync {
+			return errors.New("resource receipts require synchronous metadata")
+		}
+		b, err := tx.CreateBucketIfNotExists(root)
+		if err != nil {
+			return err
+		}
+		if _, err = b.CreateBucketIfNotExists(cursors); err != nil {
+			return err
+		}
+		pb, err := b.CreateBucketIfNotExists(pending)
+		if err != nil {
+			return err
+		}
+		if b.Get(pendingCount) == nil {
+			if pb.Stats().KeyN != 0 {
+				return errors.New("resource counter missing")
+			}
+			return b.Put(pendingCount, make([]byte, 8))
+		}
+		return nil
+	})
+	return j, err
+}
+func key(r Identity) []byte     { return []byte(r.Kind + ":" + r.ResourceID) }
+func timestamp(ms int64) string { return time.UnixMilli(ms).UTC().Format("2006-01-02T15:04:05.000Z") }
+func (j *Journal) Cursors() ([]Cursor, error) {
+	rows := []Cursor{}
+	err := j.db.View(func(tx *bolt.Tx) error {
+		return tx.Bucket(root).Bucket(cursors).ForEach(func(_, v []byte) error {
+			var c Cursor
+			if err := json.Unmarshal(v, &c); err != nil {
+				return err
+			}
+			rows = append(rows, c)
+			return nil
+		})
+	})
+	return rows, err
+}
+func active(state string) bool { return state == "running" || state == "retained" }
+func (j *Journal) Capture(s Sample) error {
+	if s.Resource.ResourceID == "" || s.Incarnation == "" || s.At <= 0 || s.Resource.Kind != s.Quantity.Kind {
+		return errors.New("invalid resource observation")
+	}
+	if _, err := uuid.Parse(s.Resource.TenantID); err != nil {
+		return err
+	}
+	if _, err := uuid.Parse(s.Resource.WorkspaceID); err != nil {
+		return err
+	}
+	return j.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(root)
+		cb, pb := b.Bucket(cursors), b.Bucket(pending)
+		var old Cursor
+		raw := cb.Get(key(s.Resource))
+		if raw != nil {
+			if err := json.Unmarshal(raw, &old); err != nil {
+				return err
+			}
+			if old.Resource != s.Resource {
+				return errors.New("resource owner changed")
+			}
+		}
+		next := Cursor{Resource: s.Resource, Quantity: s.Quantity, Incarnation: s.Incarnation, State: s.State, At: s.At, BootID: j.BootID}
+		from, to := s.At, s.At
+		quality, reason := "confirmed", ""
+		emit := false
+		if raw == nil {
+			if !active(s.State) {
+				return nil
+			}
+			// Start at first capture. No retrospective charge for pre-existing VMs.
+			emit = true
+		} else {
+			from = old.At
+			to = max(s.At, old.At)
+			next.At = to
+			switch {
+			case s.At < old.At:
+				quality, reason, emit = "unconfirmed", "clock_changed", true
+			case s.UncertainReason != "":
+				quality, reason, emit = "unconfirmed", s.UncertainReason, true
+			case old.BootID != j.BootID:
+				quality, reason, emit = "unconfirmed", "source_restarted", to > from
+			case s.Incarnation != old.Incarnation:
+				// A verified native resume from a known paused state can start
+				// at the new physical timestamp. Other replacements leave a gap.
+				if old.State == "paused" && active(s.State) && s.StartedAt >= old.At && s.StartedAt <= s.At {
+					from = s.StartedAt
+					emit = to > from
+				} else {
+					quality, reason, emit = "unconfirmed", "instance_changed", to > from
+				}
+			case s.Quantity != old.Quantity:
+				quality, reason, emit = "unconfirmed", "observation_unavailable", to > from
+			case active(old.State) && active(s.State) && to-from <= MaximumObservedInterval.Milliseconds():
+				emit = to > from
+			case active(old.State) && (s.State == "paused" || s.State == "absent") && s.EndedAt >= from && s.EndedAt <= to:
+				to = s.EndedAt
+				emit = to > from
+			case old.State == s.State && !active(s.State) && s.State != "unknown":
+				// Confirmed paused/absent resources consume no compute time.
+			default:
+				quality, reason, emit = "unconfirmed", "observation_unavailable", to > from
+			}
+		}
+		if emit {
+			countRaw := b.Get(pendingCount)
+			if len(countRaw) != 8 {
+				return errors.New("resource counter invalid")
+			}
+			count := binary.BigEndian.Uint64(countRaw)
+			if count >= MaxPending {
+				return ErrFull
+			}
+			event := Event{Version: 1, EventID: uuid.NewString(), Resource: s.Resource, SourceID: j.SourceID, SourceBootID: j.BootID,
+				Incarnation: s.Incarnation, From: timestamp(from), To: timestamp(to), Quality: quality, Reason: reason, State: s.State, Quantity: s.Quantity}
+			body, err := json.Marshal(event)
+			if err != nil {
+				return err
+			}
+			seq, err := pb.NextSequence()
+			if err != nil {
+				return err
+			}
+			k := make([]byte, 8)
+			binary.BigEndian.PutUint64(k, seq)
+			if err = pb.Put(k, body); err != nil {
+				return err
+			}
+			n := make([]byte, 8)
+			binary.BigEndian.PutUint64(n, count+1)
+			if err = b.Put(pendingCount, n); err != nil {
+				return err
+			}
+		}
+		body, err := json.Marshal(next)
+		if err != nil {
+			return err
+		}
+		return cb.Put(key(s.Resource), body)
+	})
+}
+
+type Pending struct {
+	Key  []byte
+	Body []byte
+}
+
+func (j *Journal) Batch(limit int) ([]Pending, error) {
+	rows := []Pending{}
+	err := j.db.View(func(tx *bolt.Tx) error {
+		c := tx.Bucket(root).Bucket(pending).Cursor()
+		for k, v := c.First(); k != nil && len(rows) < limit; k, v = c.Next() {
+			rows = append(rows, Pending{Key: append([]byte(nil), k...), Body: append([]byte(nil), v...)})
+		}
+		return nil
+	})
+	return rows, err
+}
+
+func (j *Journal) PendingCount() (uint64, error) {
+	var count uint64
+	err := j.db.View(func(tx *bolt.Tx) error {
+		raw := tx.Bucket(root).Get(pendingCount)
+		if len(raw) != 8 {
+			return errors.New("resource counter invalid")
+		}
+		count = binary.BigEndian.Uint64(raw)
+		return nil
+	})
+	return count, err
+}
+func (j *Journal) Acknowledge(rows []Pending) error {
+	return j.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(root)
+		pb := b.Bucket(pending)
+		raw := b.Get(pendingCount)
+		if len(raw) != 8 {
+			return errors.New("resource counter invalid")
+		}
+		count := binary.BigEndian.Uint64(raw)
+		for _, r := range rows {
+			if raw := pb.Get(r.Key); raw != nil {
+				if string(raw) != string(r.Body) {
+					return errors.New("resource acknowledgement changed")
+				}
+				if count == 0 {
+					return errors.New("resource counter underflow")
+				}
+				if err := pb.Delete(r.Key); err != nil {
+					return err
+				}
+				count--
+			}
+		}
+		// Closed cursors are tiny and are retained while any delivery remains.
+		// This never collects allocation/Volume ownership or permits replay.
+		if count == 0 {
+			cb := tx.Bucket(root).Bucket(cursors)
+			c := cb.Cursor()
+			for k, v := c.First(); k != nil; k, v = c.Next() {
+				var row Cursor
+				if err := json.Unmarshal(v, &row); err != nil {
+					return err
+				}
+				if row.State == "absent" {
+					if err := c.Delete(); err != nil {
+						return err
+					}
+				}
+			}
+		}
+		n := make([]byte, 8)
+		binary.BigEndian.PutUint64(n, count)
+		return b.Put(pendingCount, n)
+	})
+}
diff --git a/Cubelet/pkg/resourceusage/journal_test.go b/Cubelet/pkg/resourceusage/journal_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b5806256e157d0e6937fffdf347950fb5eccb0c2
--- /dev/null
+++ b/Cubelet/pkg/resourceusage/journal_test.go
@@ -0,0 +1,201 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package resourceusage
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	bolt "go.etcd.io/bbolt"
+)
+
+func fixture(t *testing.T) (*Journal, *bolt.DB, Sample) {
+	t.Helper()
+	db, err := bolt.Open(filepath.Join(t.TempDir(), "meter.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	journal, err := New(db, "node-owned", "boot-a", time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return journal, db, Sample{Resource: Identity{Kind: "compute", ResourceID: uuid.NewString(), TenantID: uuid.NewString(), WorkspaceID: uuid.NewString()}, Quantity: Quantity{Kind: "compute", CPUMillis: 2000, MemoryBytes: 2 << 30}, Incarnation: "vm-1", State: "running", At: 1_800_000_000_000}
+}
+func events(t *testing.T, j *Journal) []Event {
+	t.Helper()
+	rows, err := j.Batch(128)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := []Event{}
+	for _, row := range rows {
+		var event Event
+		if err = json.Unmarshal(row.Body, &event); err != nil {
+			t.Fatal(err)
+		}
+		result = append(result, event)
+	}
+	return result
+}
+func capture(t *testing.T, j *Journal, s Sample) {
+	t.Helper()
+	if err := j.Capture(s); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPauseResumeAndRestartDoNotChargeUnknownIntervals(t *testing.T) {
+	j, db, s := fixture(t)
+	capture(t, j, s)
+	s.At += 30_000
+	capture(t, j, s)
+	s.EndedAt = s.At + 5_000
+	s.At += 10_000
+	s.State = "paused"
+	capture(t, j, s)
+	s.At += 30_000
+	capture(t, j, s)
+	s.Incarnation = "vm-2"
+	s.State = "running"
+	s.StartedAt = s.At + 5_000
+	s.At += 10_000
+	capture(t, j, s)
+	rows := events(t, j)
+	if len(rows) != 4 {
+		t.Fatalf("unexpected paid intervals: %+v", rows)
+	}
+	durations := []time.Duration{0, 30 * time.Second, 5 * time.Second, 5 * time.Second}
+	for i, row := range rows {
+		a, _ := time.Parse(time.RFC3339Nano, row.From)
+		b, _ := time.Parse(time.RFC3339Nano, row.To)
+		if row.Quality != "confirmed" || b.Sub(a) != durations[i] {
+			t.Fatalf("wrong interval: %+v", row)
+		}
+	}
+	restored, err := New(db, "node-owned", "boot-b", time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.At += 30_000
+	capture(t, restored, s)
+	rows = events(t, restored)
+	if rows[4].Quality != "unconfirmed" || rows[4].Reason != "source_restarted" {
+		t.Fatalf("restart guessed duration: %+v", rows[4])
+	}
+	s.At += 30_000
+	capture(t, restored, s)
+	if got := events(t, restored)[5]; got.Quality != "confirmed" {
+		t.Fatalf("fresh observation did not resume accounting: %+v", got)
+	}
+}
+
+func TestDelayedObservationAndChangedInstancePreserveGaps(t *testing.T) {
+	j, _, s := fixture(t)
+	capture(t, j, s)
+	s.At += 120_000
+	capture(t, j, s)
+	s.At += 1000
+	s.Incarnation = "replaced"
+	capture(t, j, s)
+	s.At -= 10_000
+	capture(t, j, s)
+	rows := events(t, j)
+	for _, row := range rows[1:] {
+		if row.Quality != "unconfirmed" {
+			t.Fatalf("guessed gap: %+v", row)
+		}
+	}
+	cursors, err := j.Cursors()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cursors[0].At < s.At {
+		t.Fatal("clock floor moved backwards")
+	}
+	changed := s
+	changed.Resource.TenantID = uuid.NewString()
+	if j.Capture(changed) == nil {
+		t.Fatal("changed resource ownership accepted")
+	}
+}
+
+func TestDeliveryKeepsLostAcknowledgementsAndNeverFollowsRedirects(t *testing.T) {
+	j, _, s := fixture(t)
+	capture(t, j, s)
+	s.At += 30_000
+	capture(t, j, s)
+	original, _ := j.Batch(128)
+	accepted := false
+	attempts := 0
+	receiver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		if r.Header.Get("Authorization") != "Bearer owned-key" {
+			t.Error("missing source credential")
+		}
+		if !accepted {
+			w.WriteHeader(503)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]int{"accepted": 2})
+	}))
+	defer receiver.Close()
+	if j.Deliver(context.Background(), receiver.URL, "owned-key") == nil {
+		t.Fatal("outage acknowledged")
+	}
+	pending, _ := j.Batch(128)
+	if string(pending[0].Body) != string(original[0].Body) {
+		t.Fatal("retry receipt changed")
+	}
+	redirect := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Redirect(w, r, receiver.URL, 307) }))
+	defer redirect.Close()
+	if j.Deliver(context.Background(), redirect.URL, "owned-key") == nil || attempts != 1 {
+		t.Fatal("receipt credential followed a redirect")
+	}
+	accepted = true
+	if err := j.Deliver(context.Background(), receiver.URL, "owned-key"); err != nil {
+		t.Fatal(err)
+	}
+	pending, _ = j.Batch(128)
+	if len(pending) != 0 {
+		t.Fatal("acknowledged receipts not collected")
+	}
+	// ACK loss can repeat local collection too; it must not underflow the count.
+	if err := j.Acknowledge(original); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestUnknownClosureDoesNotInventAStopTime(t *testing.T) {
+	j, _, s := fixture(t)
+	capture(t, j, s)
+	s.At += 30_000
+	capture(t, j, s)
+	s.At += 15_000
+	s.State = "absent"
+	capture(t, j, s)
+	rows := events(t, j)
+	if rows[2].Quality != "unconfirmed" {
+		t.Fatal("absence invented exact usage")
+	}
+	batch, _ := j.Batch(128)
+	if err := j.Acknowledge(batch); err != nil {
+		t.Fatal(err)
+	}
+	cursors, _ := j.Cursors()
+	if len(cursors) != 0 {
+		t.Fatal("closed accounting cursor retained after delivery")
+	}
+	// A remaining inactive native catalog entry cannot create endless zero rows.
+	capture(t, j, s)
+	if len(events(t, j)) != 0 {
+		t.Fatal("inactive catalog recreated billing")
+	}
+}
diff --git a/Cubelet/services/cubebox/resource_metering.go b/Cubelet/services/cubebox/resource_metering.go
