+		if result.Failure != "" {
+			cancelled <- result
+			return nil
+		}
+		if r.MaximumOutputBytes <= 8*1024*1024 {
+			return nil
+		}
+		deliveryStarted <- struct{}{}
+		select {
+		case <-releaseDelivery:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}))
+	defer func() { release.Do(func() { close(releaseDelivery) }); m.Close() }()
+	for i := 0; i < 8; i++ {
