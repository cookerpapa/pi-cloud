--- /dev/null
+++ b/Cubelet/pkg/execution/probe.go
@@ -0,0 +1,100 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+type probe struct{ cancel context.CancelFunc }
+
+// Probe shares the native driver, but has no Tool ledger, effect authority or
+// quarantine power. A bounded optional completion uses the existing delivery port.
+func (m *Manager) Probe(parent context.Context, boot string, r Request) (Result, string) {
+	if boot != m.BootID {
+		return Result{}, "executor_replaced"
+	}
+	if r.SandboxID == "" || len(r.SandboxID) > 128 || len(r.CompletionContext) > 4096 {
+		return Result{}, "invalid_probe"
+	}
+	if id, err := uuid.Parse(r.OperationID); err != nil || id.String() != r.OperationID {
+		return Result{}, "invalid_probe"
+	}
+	async := len(r.CompletionContext) > 0
+	if async && (!json.Valid(r.CompletionContext) || r.RunID == "" || r.WriterID == "") {
+		return Result{}, "invalid_probe"
+	}
+	for _, id := range []string{r.RunID, r.WriterID} {
+		if id != "" {
+			if parsed, err := uuid.Parse(id); err != nil || parsed.String() != id {
+				return Result{}, "invalid_probe"
+			}
+		}
+	}
+	if async {
+		parent = context.Background()
+	}
+	ctx, cancel := context.WithTimeout(parent, 5*time.Second)
+	id := key(r.SandboxID, r.OperationID)
+	m.mu.Lock()
+	rejection := ""
+	if m.closed || len(m.probes) >= 4 {
+		rejection = "probe_capacity"
+	}
+	if m.unsafeRuntimes[r.SandboxID] {
+		rejection = "runtime_quarantined"
+	}
+	// Probes are fixed read-only diagnostics. They neither advance admission
+	// positions nor require a lifetime history of closed Run identities.
+	if _, exists := m.probes[id]; exists {
+		rejection = "probe_duplicate"
+	}
+	if rejection != "" {
+		m.mu.Unlock()
+		cancel()
+		return Result{}, rejection
+	}
+	m.probes[id] = probe{cancel: cancel}
+	m.wg.Add(1)
+	m.mu.Unlock()
+	r.Probe, r.Timeout, r.MaximumOutputBytes = true, 5*time.Second, 4096
+	r.Payload, _ = json.Marshal(map[string]string{"mode": "probe", "probeId": r.OperationID})
+	r.CompletionContext = append(json.RawMessage(nil), r.CompletionContext...)
+	run := func() Result {
+		defer m.wg.Done()
+		defer cancel()
+		defer func() { m.mu.Lock(); delete(m.probes, id); m.mu.Unlock() }()
+		result := m.driver.Run(ctx, r, func(json.RawMessage) {})
+		// Loss of a diagnostic process is never authority to quarantine a VM.
+		result.Quarantine = false
+		if ctx.Err() != nil {
+			return Result{Failure: "probe_expired"}
+		}
+		var reply struct {
+			Type        string `json:"type"`
+			ProbeID     string `json:"probeId"`
+			GuestBootID string `json:"guestBootId"`
+		}
+		if result.Failure == "" {
+			if json.Unmarshal(result.Output, &reply) != nil || reply.Type != "worker.probe_result" || reply.ProbeID != r.OperationID {
+				return Result{Failure: "probe_reply_invalid"}
+			}
+			if id, err := uuid.Parse(reply.GuestBootID); err != nil || id.String() != reply.GuestBootID {
+				return Result{Failure: "probe_reply_invalid"}
+			}
+		}
+		if async && result.Failure == "" {
+			_ = m.delivery.Deliver(ctx, r, result)
+		}
+		return result
+	}
+	if async {
+		go run()
+		return Result{}, ""
+	}
+	return run(), ""
+}
