+package execution
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestRawTransportWaitsForReadinessAndReceiptsCompleteResult(t *testing.T) {
+	output := newToolOutput(1024, func(json.RawMessage) {})
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	input, stop := rawTerminalInput(ctx, output, []byte(`{"mode":"operation"}`), "", nil)
+	defer stop()
+	received := make(chan []byte, 1)
+	go func() { data, _ := io.ReadAll(input); received <- data }()
+	select {
+	case <-received:
+		t.Fatal("input sent before ready")
+	default:
+	}
+	if _, err := output.Write([]byte("{\"type\":\"scope.ready\"}\n{\"type\":\"worker.operation_result\",\"response\":{}")); err != nil {
+		t.Fatal(err)
+	}
+	if len(output.resultBytes()) != 0 {
+		t.Fatal("incomplete output accepted")
+	}
+	if _, err := output.Write([]byte("}\n")); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case data := <-received:
+		if string(data) != "{\"mode\":\"operation\"}\n{\"type\":\"scope.received\"}\n" {
+			t.Fatalf("unexpected input %s", data)
+		}
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+}
+
+func TestLargeResultSurvivesSubsequentFrameBufferReuse(t *testing.T) {
+	result := []byte(`{"type":"worker.operation_result","data":"` + strings.Repeat("x", 1024*1024) + `"}`)
+	output := newToolOutput(int64(len(result)+1), func(json.RawMessage) {})
+	for offset := 0; offset < len(result); offset += 4096 {
+		end := offset + 4096
+		if end > len(result) {
+			end = len(result)
+		}
+		if _, err := output.Write(result[offset:end]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := output.Write([]byte("\n")); err != nil {
+		t.Fatal(err)
+	}
+	delivered := output.resultBytes()
+	if _, err := output.Write([]byte("{\"operationId\":\"later-progress\"}\n")); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(delivered, result) || !bytes.Equal(output.resultBytes(), result) {
+		t.Fatal("final result buffer was reused")
+	}
+}
+func TestResultFramingRejectsOverflowAndDuplicateFinal(t *testing.T) {
+	overflow := newToolOutput(8, func(json.RawMessage) {})
+	if _, err := overflow.Write([]byte("123456789")); err == nil {
+		t.Fatal("accepted overflow")
+	}
+	output := newToolOutput(1024, func(json.RawMessage) {})
+	frame := []byte("{\"type\":\"worker.operation_result\"}\n")
+	if _, err := output.Write(frame); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := output.Write(frame); err == nil {
+		t.Fatal("accepted duplicate result")
+	}
+}
