+	"os"
+	"os/exec"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+type adapterProcess struct {
+	cmd        *exec.Cmd
+	input      io.WriteCloser
+	generation string
+	ready      chan struct{}
+	readyOnce  sync.Once
+	accepting  atomic.Bool
+}
+type pendingDelivery struct {
+	generation string
+	done       chan error
+}
+
+// ProcessDelivery is a fixed trusted host plugin, not another execution owner.
+// The plugin handles images/Kafka and acknowledges immutable final delivery.
+// Its loss never starts a guest command again.
+type ProcessDelivery struct {
+	command []string
+	mu      sync.Mutex
+	write   sync.Mutex
+	process *adapterProcess
+	pending map[string]pendingDelivery
+	closed  bool
+}
+
+func NewProcessDelivery(command []string) *ProcessDelivery {
+	return &ProcessDelivery{command: append([]string(nil), command...), pending: make(map[string]pendingDelivery)}
+}
+
+func (p *ProcessDelivery) Start() error {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	child, err := p.ensure()
+	if err != nil {
+		return err
+	}
+	if err = p.waitReady(ctx, child); err != nil {
+		p.stop(child)
+	}
+	return err
+}
+func (p *ProcessDelivery) waitReady(ctx context.Context, child *adapterProcess) error {
+	select {
+	case <-child.ready:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	if !child.accepting.Load() {
+		return errors.New("completion adapter is not ready")
+	}
+	return nil
+}
+func (p *ProcessDelivery) Ready() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return !p.closed && p.process != nil && p.process.accepting.Load()
+}
+func (p *ProcessDelivery) EnsureReady(ctx context.Context) error {
+	child, err := p.ensure()
+	if err != nil {
+		return err
+	}
+	return p.waitReady(ctx, child)
+}
+func (p *ProcessDelivery) ensure() (*adapterProcess, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || len(p.command) == 0 {
+		return nil, errors.New("completion adapter unavailable")
+	}
+	if p.process != nil {
+		return p.process, nil
+	}
+	cmd := exec.Command(p.command[0], p.command[1:]...)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Pdeathsig: syscall.SIGKILL}
+	// The fixed plugin prints only bounded infrastructure diagnostics on stderr.
+	cmd.Stderr = os.Stderr
+	input, err := cmd.StdinPipe()
+	if err != nil {
+		return nil, err
+	}
+	output, err := cmd.StdoutPipe()
+	if err != nil {
+		_ = input.Close()
+		return nil, err
+	}
+	if err = cmd.Start(); err != nil {
+		_ = input.Close()
+		_ = output.Close()
+		return nil, err
+	}
+	child := &adapterProcess{cmd: cmd, input: input, generation: uuid.NewString(), ready: make(chan struct{})}
+	p.process = child
+	go func() {
+		scanner := bufio.NewScanner(output)
+		scanner.Buffer(make([]byte, 4096), 16384)
+		for scanner.Scan() {
+			var reply struct {
+				Type            string `json:"type"`
+				ProtocolVersion int    `json:"protocolVersion"`
+				ID              string `json:"id"`
+				Delivered       bool   `json:"delivered"`
+			}
+			if json.Unmarshal(scanner.Bytes(), &reply) != nil {
+				break
+			}
+			if reply.Type == "ready" && reply.ProtocolVersion == 3 {
+				child.accepting.Store(true)
+				child.readyOnce.Do(func() { close(child.ready) })
+				continue
+			}
+			if reply.ID == "" {
+				break
+			}
+			p.mu.Lock()
+			pending, ok := p.pending[reply.ID]
+			if ok && pending.generation == child.generation {
+				delete(p.pending, reply.ID)
+			} else {
+				ok = false
+			}
+			p.mu.Unlock()
+			if ok {
+				if reply.Delivered {
+					pending.done <- nil
+				} else {
+					pending.done <- errors.New("completion adapter did not confirm delivery")
+				}
+			}
+		}
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		p.retire(child)
+	}()
+	return child, nil
+}
+func (p *ProcessDelivery) retire(child *adapterProcess) {
+	p.mu.Lock()
+	child.accepting.Store(false)
+	child.readyOnce.Do(func() { close(child.ready) })
+	if p.process == child {
+		p.process = nil
+	}
+	for id, pending := range p.pending {
+		if pending.generation == child.generation {
+			delete(p.pending, id)
+			pending.done <- errors.New("completion adapter disconnected")
+		}
+	}
+	p.mu.Unlock()
+	_ = child.input.Close()
+}
+func (p *ProcessDelivery) stop(child *adapterProcess) { _ = child.cmd.Process.Kill(); p.retire(child) }
+func (p *ProcessDelivery) writePacket(ctx context.Context, child *adapterProcess, packet interface{}) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	data, err := json.Marshal(packet)
+	if err != nil {
+		return err
+	}
+	data = append(data, '\n')
+	if pipe, ok := child.input.(*os.File); ok {
+		deadline, _ := ctx.Deadline()
+		_ = pipe.SetWriteDeadline(deadline)
+	}
+	for len(data) > 0 {
+		n, err := child.input.Write(data)
+		if err != nil {
+			p.stop(child)
+			return err
+		}
+		data = data[n:]
+	}
+	return nil
+}
+func (p *ProcessDelivery) Deliver(ctx context.Context, r Request, result Result) error {
+	child, err := p.ensure()
+	if err != nil {
+		return err
+	}
+	if err := p.waitReady(ctx, child); err != nil {
+		return err
+	}
+	id := uuid.NewString()
+	done := make(chan error, 1)
+	p.mu.Lock()
+	if p.process != child || p.closed {
+		p.mu.Unlock()
+		return errors.New("completion adapter replaced")
+	}
+	p.pending[id] = pendingDelivery{generation: child.generation, done: done}
+	p.mu.Unlock()
+	defer func() { p.mu.Lock(); delete(p.pending, id); p.mu.Unlock() }()
+	p.write.Lock()
+	err = p.writePacket(ctx, child, map[string]interface{}{"id": id, "kind": "result", "operationId": r.OperationID, "context": r.CompletionContext, "result": result})
+	p.write.Unlock()
+	if err != nil {
+		return err
+	}
+	select {
+	case err := <-done:
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+func (p *ProcessDelivery) Progress(r Request, output json.RawMessage) {
+	if len(output) > 64*1024 || !p.write.TryLock() {
+		return
+	}
+	defer p.write.Unlock()
+	p.mu.Lock()
+	child := p.process
+	busy := len(p.pending) > 0
+	p.mu.Unlock()
+	if child == nil || busy || !child.accepting.Load() {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	_ = p.writePacket(ctx, child, map[string]interface{}{"kind": "progress", "operationId": r.OperationID, "context": r.CompletionContext, "output": output})
+}
+func (p *ProcessDelivery) Close() {
+	p.mu.Lock()
+	p.closed = true
+	child := p.process
+	p.mu.Unlock()
+	if child != nil {
+		p.stop(child)
+	}
+}
diff --git a/Cubelet/pkg/execution/delivery_process_test.go b/Cubelet/pkg/execution/delivery_process_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..5c787cdbf1c14be6f675f47eea71cc155d787d95
--- /dev/null
+++ b/Cubelet/pkg/execution/delivery_process_test.go
@@ -0,0 +1,96 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+	"time"
+)
+
+// The test binary itself is the trusted plugin; this exercises real pipe,
+// process-loss and readiness behavior without Kafka or a guest process.
+func TestDeliveryPlugin(t *testing.T) {
+	if len(os.Args) < 3 || os.Args[len(os.Args)-2] != "--plugin" {
+		return
+	}
+	mode := os.Args[len(os.Args)-1]
+	if mode == "no-ready" {
+		os.Exit(2)
+	}
+	if mode == "old-ready" {
+		fmt.Println(`{"type":"ready","protocolVersion":2}`)
+	} else {
+		fmt.Println(`{"type":"ready","protocolVersion":3}`)
+	}
+	scanner := bufio.NewScanner(os.Stdin)
+	for scanner.Scan() {
+		if mode == "disconnect" {
+			os.Exit(3)
+		}
+		var packet struct {
+			ID   string `json:"id"`
+			Kind string `json:"kind"`
+		}
+		if json.Unmarshal(scanner.Bytes(), &packet) != nil {
+			os.Exit(4)
+		}
+		if packet.Kind != "result" {
+			continue
+		}
+		data, _ := json.Marshal(map[string]interface{}{"id": packet.ID, "delivered": mode == "ack"})
+		fmt.Println(string(data))
+	}
+	os.Exit(0)
+}
+func plugin(mode string) *ProcessDelivery {
+	return NewProcessDelivery([]string{os.Args[0], "-test.run=^TestDeliveryPlugin$", "--", "--plugin", mode})
+}
+func TestPluginReadinessAndAcknowledgment(t *testing.T) {
+	for _, mode := range []string{"ack", "reject", "disconnect"} {
+		t.Run(mode, func(t *testing.T) {
+			p := plugin(mode)
+			defer p.Close()
+			if err := p.Start(); err != nil {
+				t.Fatal(err)
+			}
+			if !p.Ready() {
+				t.Fatal("ready missing")
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			err := p.Deliver(ctx, request(), Result{Failure: "synthetic"})
+			if (err == nil) != (mode == "ack") {
+				t.Fatalf("mode %s err %v", mode, err)
+			}
+			if mode == "disconnect" {
+				// A replacement accepts delivery only, never execution.
+				p.command = []string{os.Args[0], "-test.run=^TestDeliveryPlugin$", "--", "--plugin", "ack"}
+				if err := p.Deliver(ctx, request(), Result{Failure: "synthetic"}); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
+func TestMissingReadinessCannotAdvertiseExecution(t *testing.T) {
+	p := plugin("no-ready")
+	defer p.Close()
+	if p.Start() == nil || p.Ready() {
+		t.Fatal("failed plugin advertised ready")
+	}
+}
+
+func TestOldPreviewAdapterCannotAdvertiseExecution(t *testing.T) {
+	p := plugin("old-ready")
+	defer p.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	if p.EnsureReady(ctx) == nil || p.Ready() {
+		t.Fatal("old adapter advertised readiness for the new preview protocol")
+	}
+}
diff --git a/Cubelet/pkg/execution/manager.go b/Cubelet/pkg/execution/manager.go
new file mode 100644
index 0000000000000000000000000000000000000000..7e3b7ad57bb8ab10ec894132d94fb70b7524a63e
--- /dev/null
+++ b/Cubelet/pkg/execution/manager.go
@@ -0,0 +1,379 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package execution owns bounded native process lifetimes. It is not a durable
+// scheduler: callers persist intent before handoff and never replay uncertain work.
+package execution
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"regexp"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+type Position struct {
+	Topic     string `json:"topic"`
+	Partition int    `json:"partition"`
+	Offset    string `json:"offset"`
+}
+
+var topicPattern = regexp.MustCompile(`^[A-Za-z0-9._-]{1,249}$`)
+
+func (p Position) offset() (int64, error) {
+	value, err := strconv.ParseInt(p.Offset, 10, 64)
+	if err != nil || value < 0 || strconv.FormatInt(value, 10) != p.Offset ||
+		!topicPattern.MatchString(p.Topic) || p.Partition < 0 || p.Partition > 65535 {
+		return 0, errors.New("invalid_execution_position")
+	}
+	return value, nil
+}
+
+type runtimePosition struct {
+	topic      string
+	partitions map[int]int64
+}
+
+type Request struct {
+	Interrupt          <-chan struct{} `json:"-"`
+	Source             Position        `json:"source"`
+	Probe              bool            `json:"-"`
+	SandboxID          string          `json:"sandboxId"`
+	OperationID        string          `json:"operationId"`
+	RunID              string          `json:"runId"`
+	WriterID           string          `json:"writerId"`
+	Payload            json.RawMessage `json:"payload"`
+	CompletionContext  json.RawMessage `json:"context"`
+	Timeout            time.Duration   `json:"timeout"`
+	MaximumOutputBytes int64           `json:"maximumOutputBytes"`
+}
+
+type Result struct {
+	Output     json.RawMessage `json:"output,omitempty"`
+	Failure    string          `json:"failure,omitempty"`
+	Quarantine bool            `json:"quarantine"`
+}
+
+type Driver interface {
+	// HasRuntime reads the existing native catalog only. It runs under the
+	// admission mutex shared with ForgetRuntime; it must not probe or do I/O.
+	HasRuntime(string) bool
+	// Run joins its native main process and performs scoped stopping on context
+	// cancellation or an explicit guest timeout flag before returning.
+	Run(context.Context, Request, func(json.RawMessage)) Result
+}
+
+type Delivery interface {
+	Progress(Request, json.RawMessage)
+	Deliver(context.Context, Request, Result) error
+}
+
+type operation struct {
+	request     Request
+	fingerprint [32]byte
+	cancel      context.CancelFunc
+	interrupt   chan struct{}
+	finished    bool
+	forgotten   bool
+}
+
+type Manager struct {
+	// Called only for real Tool admission/settlement, never probes.
+	RuntimeActivity func(string) error
+	probes          map[string]probe
+	BootID          string
+	driver          Driver
+	delivery        Delivery
+	mu              sync.Mutex
+	operations      map[string]*operation
+	positions       map[string]*runtimePosition
+	unsafeRuntimes  map[string]bool
+	active          int
+	closed          bool
+	large           chan struct{}
+	wg              sync.WaitGroup
+}
+
+const maximumOutstanding = 32
+const maximumLargeReplies = 8
+const maximumRequestBytes = 1024 * 1024
+const maximumReplyBytes = 64 * 1024 * 1024
+
+func New(driver Driver, delivery Delivery) *Manager {
+	return &Manager{BootID: uuid.NewString(), driver: driver, delivery: delivery, probes: make(map[string]probe),
+		operations: make(map[string]*operation), positions: make(map[string]*runtimePosition), unsafeRuntimes: make(map[string]bool), large: make(chan struct{}, maximumLargeReplies)}
+}
+
+func key(sandbox, id string) string { return sandbox + "/" + id }
+
+func (m *Manager) Submit(boot string, r Request) string {
+	if boot != m.BootID {
+		return "executor_replaced"
+	}
+	if r.SandboxID == "" || len(r.SandboxID) > 128 || r.Timeout <= 0 || r.Timeout > 15*time.Minute ||
+		r.MaximumOutputBytes < 1 || r.MaximumOutputBytes > maximumReplyBytes ||
+		len(r.Payload) > maximumRequestBytes || len(r.CompletionContext) > 16384 ||
+		!json.Valid(r.Payload) || !json.Valid(r.CompletionContext) {
+		return "invalid_request"
+	}
+	for _, id := range []string{r.OperationID, r.RunID, r.WriterID} {
+		if parsed, err := uuid.Parse(id); err != nil || parsed.String() != id {
+			return "invalid_identity"
+		}
+	}
+	offset, err := r.Source.offset()
+	if err != nil {
+		return "invalid_execution_position"
+	}
+	bytes, err := json.Marshal(r)
+	if err != nil {
+		return "invalid_request"
+	}
+	fingerprint := sha256.Sum256(bytes)
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed {
+		return "executor_capacity"
+	}
+	if !m.driver.HasRuntime(r.SandboxID) {
+		return "execution_unavailable"
+	}
+	if m.unsafeRuntimes[r.SandboxID] {
+		return "runtime_quarantined"
+	}
+	id := key(r.SandboxID, r.OperationID)
+	if old := m.operations[id]; old != nil {
+		if old.fingerprint != fingerprint {
+			return "operation_changed"
+		}
+		return ""
+	}
+	if m.active >= maximumOutstanding {
+		return "capacity"
+	}
+	if why := m.advance(r.SandboxID, r.Source, offset, true); why != "" {
+		return why
+	}
+	if m.RuntimeActivity != nil {
+		if err := m.RuntimeActivity(r.SandboxID); err != nil {
+			return "runtime_retention_unavailable"
+		}
+	}
+	r.Payload = append(json.RawMessage(nil), r.Payload...)
+	r.CompletionContext = append(json.RawMessage(nil), r.CompletionContext...)
+	ctx, cancel := context.WithCancel(context.Background())
+	op := &operation{request: r, fingerprint: fingerprint, cancel: cancel, interrupt: make(chan struct{})}
+	m.operations[id] = op
+	m.active++
+	m.wg.Add(1)
+	go m.execute(ctx, op)
+	return ""
+}
+
+func (m *Manager) execute(ctx context.Context, op *operation) {
+	defer m.wg.Done()
+	defer op.cancel()
+	r := op.request
+	r.Interrupt = op.interrupt
+	result := Result{Failure: "execution_not_started", Quarantine: false}
+	large := r.MaximumOutputBytes > 8*1024*1024
+	acquired := false
+	if large {
+		timer := time.NewTimer(30 * time.Second)
+		select {
+		case m.large <- struct{}{}:
+			acquired = true
+		case <-ctx.Done():
+		case <-r.Interrupt:
+			result.Failure = "tool_cancelled_before_start"
+		case <-timer.C:
+			result.Failure = "read_capacity_timeout"
+		}
+		timer.Stop()
+	} else {
+		acquired = true
+	}
+	if acquired && ctx.Err() == nil {
+		select {
+		case <-r.Interrupt:
+			result.Failure = "tool_cancelled_before_start"
+		default:
+			runCtx, stop := context.WithTimeout(ctx, r.Timeout)
+			result = m.driver.Run(runCtx, r, func(output json.RawMessage) { m.delivery.Progress(r, output) })
+			stop()
+		}
+	}
+	m.mu.Lock()
+	if m.RuntimeActivity != nil {
+		_ = m.RuntimeActivity(r.SandboxID)
+	}
+	if op.forgotten {
+		result.Quarantine = false
+		result.Failure = "tool_sandbox_unavailable"
+	}
+	op.finished = true
+	if result.Quarantine {
+		m.unsafeRuntimes[r.SandboxID] = true
+	}
+	m.mu.Unlock()
+	// Delivery retries the same immutable result, never the process. A cancelled
+	// or replaced Worker may discard it; expiry remains UNKNOWN, not success.
+	deliveryCtx, endDelivery := context.WithTimeout(context.Background(), 30*time.Second)
+	for {
+		if err := m.delivery.Deliver(deliveryCtx, r, result); err == nil {
+			break
+		}
+		select {
+		case <-deliveryCtx.Done():
+			goto delivered
+		case <-time.After(250 * time.Millisecond):
+		}
+	}
+delivered:
+	endDelivery()
+	if large && acquired {
+		<-m.large
+	}
+	m.mu.Lock()
+	// The source position fences historical replay; retain no completed IDs.
+	id := key(r.SandboxID, r.OperationID)
+	if m.operations[id] == op {
+		delete(m.operations, id)
+	}
+	m.active--
+	m.mu.Unlock()
+}
+
+// Expiry and new Tool admission share this boundary. Persist closure before
+// releasing the mutex, then perform physical cleanup outside it.
+func (m *Manager) RetireIdleRuntime(sandbox string, close func() (bool, error)) (bool, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, op := range m.operations {
+		if op.request.SandboxID == sandbox && !op.finished {
+			if m.RuntimeActivity != nil {
+				return false, m.RuntimeActivity(sandbox)
+			}
+			return false, nil
+		}
+	}
+	closed, err := close()
+	if closed && err == nil {
+		m.unsafeRuntimes[sandbox] = true
+	}
+	return closed, err
+}
+
+// advance runs under the admission mutex. Fresh Tools are strictly newer;
+// idempotent cancellations may repeat an old position without regressing it.
+func (m *Manager) advance(sandbox string, source Position, offset int64, fresh bool) string {
+	state := m.positions[sandbox]
+	if state == nil {
+		state = &runtimePosition{topic: source.Topic, partitions: make(map[int]int64)}
+		m.positions[sandbox] = state
+	}
+	if state.topic != source.Topic {
+		return "execution_stream_changed"
+	}
+	old, exists := state.partitions[source.Partition]
+	if fresh && exists && offset <= old {
+		return "execution_position_stale"
+	}
+	if !exists || offset > old {
+		state.partitions[source.Partition] = offset
+	}
+	return ""
+}
+
+// Cancel requests cooperative Tool interruption. It never signals a completed
+// operation or asserts that its processes have exited. Catalog presence is
+// checked inside the same mutex as Submit and confirmed-absence cleanup.
+func (m *Manager) Cancel(boot string, r Request) string {
+	if boot != m.BootID {
+		return "executor_replaced"
+	}
+	if r.SandboxID == "" || len(r.SandboxID) > 128 {
+		return "invalid_scope"
+	}
+	for _, id := range []string{r.RunID, r.WriterID} {
+		if parsed, err := uuid.Parse(id); err != nil || parsed.String() != id {
+			return "invalid_scope"
+		}
+	}
+	if r.OperationID != "" {
+		if parsed, err := uuid.Parse(r.OperationID); err != nil || parsed.String() != r.OperationID {
+			return "invalid_scope"
+		}
+	}
+	offset, err := r.Source.offset()
+	if err != nil {
+		return "invalid_execution_position"
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed {
+		return "execution_unavailable"
+	}
+	if !m.driver.HasRuntime(r.SandboxID) {
+		return "execution_unavailable"
+	}
+	if why := m.advance(r.SandboxID, r.Source, offset, false); why != "" {
+		return why
+	}
+	for _, op := range m.operations {
+		if op.finished || op.request.SandboxID != r.SandboxID || op.request.RunID != r.RunID ||
+			op.request.WriterID != r.WriterID || (r.OperationID != "" && op.request.OperationID != r.OperationID) {
+			continue
+		}
+		select {
+		case <-op.interrupt:
+		default:
+			close(op.interrupt)
+		}
+	}
+	return ""
+}
+
+// ForgetRuntime is called only after native destruction/anchored absence. A
+// removed physical identity can never be recreated by this execution endpoint.
+func (m *Manager) ForgetRuntime(sandbox string) {
+	m.mu.Lock()
+	for id, op := range m.operations {
+		if op.request.SandboxID == sandbox {
+			op.forgotten = true
+			op.cancel()
+			delete(m.operations, id)
+		}
+	}
+	delete(m.positions, sandbox)
+	delete(m.unsafeRuntimes, sandbox)
+	m.mu.Unlock()
+}
+
+func (m *Manager) Unsafe(sandbox string) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.unsafeRuntimes[sandbox]
+}
+func (m *Manager) Accepting() bool { m.mu.Lock(); defer m.mu.Unlock(); return !m.closed }
+
+func (m *Manager) Close() {
+	m.mu.Lock()
+	m.closed = true
+	for _, p := range m.probes {
+		p.cancel()
+	}
+	for _, op := range m.operations {
+		if !op.finished {
+			op.cancel()
+		}
+	}
+	m.mu.Unlock()
+	m.wg.Wait()
+}
