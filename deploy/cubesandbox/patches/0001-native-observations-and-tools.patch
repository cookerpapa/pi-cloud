+
+type managedExecutionRequest struct {
+	Source             json.RawMessage `json:"source"`
+	SandboxID          string          `json:"sandboxID"`
+	NodeID             string          `json:"nodeID"`
+	BootID             string          `json:"bootID"`
+	OperationID        string          `json:"operationID"`
+	ProbeID            string          `json:"probeID"`
+	RunID              string          `json:"runID"`
+	WriterID           string          `json:"writerID"`
+	Payload            json.RawMessage `json:"payload"`
+	CompletionContext  json.RawMessage `json:"completionContext"`
+	TimeoutMS          int64           `json:"timeoutMs"`
+	MaximumOutputBytes int64           `json:"maximumOutputBytes"`
+}
+
+func handleManagedExecution(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 2*1024*1024)
+	var input managedExecutionRequest
+	if json.NewDecoder(c.Request.Body).Decode(&input) != nil || !sandboxid.IsFullID(input.SandboxID) || input.NodeID == "" {
+		c.JSON(400, gin.H{"error": "invalid_execution_request"})
+		return
+	}
+	node, ok := localcache.GetNode(input.NodeID)
+	if !ok || !node.Healthy {
+		// The request has not reached an execution endpoint.
+		c.JSON(200, gin.H{"accepted": false, "operationID": input.OperationID, "bootID": input.BootID, "rejection": "node_unavailable", "enabled": false})
+		return
+	}
+	timeout := 5 * time.Second
+	if c.Param("action") == "probe" {
+		timeout = 9 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), timeout)
+	defer cancel()
+	connection, err := grpcconn.GetWorkerConn(ctx, cubelet.GetCubeletAddr(node.IP))
+	if err != nil {
+		c.JSON(502, gin.H{"error": "execution_endpoint_unavailable"})
+		return
+	}
+	defer connection.Close()
+	client := cubebox.NewCubeboxMgrClient(connection.Value())
+	switch c.Param("action") {
+	case "probe":
+		response, err := client.ProbeExecution(ctx, &cubebox.ExecutionProbeRequest{SandboxId: input.SandboxID, BootId: input.BootID, ProbeId: input.ProbeID, RunId: input.RunID, WriterId: input.WriterID, CompletionContext: input.CompletionContext})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_probe_unavailable"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "probeID": response.ProbeId, "accepted": response.Accepted, "rejection": response.Rejection, "output": json.RawMessage(response.Output), "failure": response.Failure})
+	case "capabilities":
+		response, err := client.ExecutionCapabilities(ctx, &cubebox.ExecutionCapabilitiesRequest{SandboxId: input.SandboxID})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_capabilities_unavailable"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "protocolVersion": response.ProtocolVersion, "enabled": response.Enabled, "runtimeBlocked": response.RuntimeBlocked})
+	case "cancel":
+		response, err := client.CancelTool(ctx, &cubebox.CancelToolRequest{SourcePosition: input.Source, SandboxId: input.SandboxID, BootId: input.BootID, OperationId: input.OperationID, RunId: input.RunID, WriterId: input.WriterID})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_cancellation_unknown"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "accepted": response.Accepted, "rejection": response.Rejection})
+	case "submit":
+		response, err := client.SubmitTool(ctx, &cubebox.SubmitToolRequest{SourcePosition: input.Source, SandboxId: input.SandboxID, BootId: input.BootID, OperationId: input.OperationID, RunId: input.RunID, WriterId: input.WriterID, Payload: input.Payload, CompletionContext: input.CompletionContext, TimeoutMs: input.TimeoutMS, MaximumOutputBytes: input.MaximumOutputBytes})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_handoff_unknown"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "operationID": response.OperationId, "accepted": response.Accepted, "rejection": response.Rejection})
+	default:
+		c.JSON(404, gin.H{"error": "unknown_execution_action"})
+	}
+}
