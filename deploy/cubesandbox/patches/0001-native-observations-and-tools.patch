+)
+
+func TestCancellationFramePreservesRequestAndResultReceipt(t *testing.T) {
+	ready, complete, interrupt := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	in, stop := executionInput(context.Background(), ready, complete, []byte(`{"mode":"operation"}`), "op", interrupt)
+	defer stop()
+	scan := bufio.NewScanner(in)
+	close(interrupt) // cancellation may precede guest readiness
+	close(ready)
+	if !scan.Scan() || scan.Text() != `{"mode":"operation"}` {
+		t.Fatal("request missing")
+	}
+	if !scan.Scan() {
+		t.Fatal("cancel frame missing")
+	}
+	var v map[string]string
+	if json.Unmarshal(scan.Bytes(), &v) != nil || v["type"] != "scope.cancel" || v["operationId"] != "op" {
+		t.Fatal("invalid control frame")
+	}
+	close(complete)
+	if !scan.Scan() || scan.Text() != `{"type":"scope.received"}` {
+		t.Fatal("final result receipt lost")
+	}
+	if scan.Scan() {
+		t.Fatal("unexpected extra frame")
+	}
+}
