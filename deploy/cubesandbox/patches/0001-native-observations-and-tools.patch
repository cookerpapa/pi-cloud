+	for i := 0; i < 8; i++ {
+		select {
+		case <-started:
+		case <-time.After(time.Second):
+			t.Fatal("eight independent reads did not start")
+		}
+	}
+	waiting := request()
+	waiting.Source.Offset = "108"
+	waiting.MaximumOutputBytes = maximumReplyBytes
+	if why := m.Submit(m.BootID, waiting); why != "" {
+		t.Fatal(why)
+	}
+	ordinary := request()
+	ordinary.Source.Offset = "109"
+	if why := m.Submit(m.BootID, ordinary); why != "" {
+		t.Fatal(why)
+	}
+	select {
+	case id := <-started:
+		if id != ordinary.OperationID {
+			t.Fatal("large permit released before delivery")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("ordinary work blocked behind replies")
