+
+func (s *service) ProbeExecution(ctx context.Context, r *cubebox.ExecutionProbeRequest) (*cubebox.ExecutionProbeResponse, error) {
+	if s.executions == nil || (len(r.CompletionContext) > 0 && (s.completions == nil || !s.completions.Ready())) {
+		return &cubebox.ExecutionProbeResponse{ProbeId: r.ProbeId, Rejection: "execution_unavailable"}, nil
+	}
+	result, rejection := s.executions.Probe(ctx, r.BootId, execution.Request{
+		SandboxID: r.SandboxId, OperationID: r.ProbeId, RunID: r.RunId, WriterID: r.WriterId, CompletionContext: r.CompletionContext,
+	})
+	return &cubebox.ExecutionProbeResponse{BootId: s.executions.BootID, ProbeId: r.ProbeId, Accepted: rejection == "", Rejection: rejection, Output: result.Output, Failure: result.Failure}, nil
 }
 
