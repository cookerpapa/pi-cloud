+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/google/uuid"
+	"testing"
+)
+
+func probeResult(r Request) Result {
+	data, _ := json.Marshal(map[string]string{"type": "worker.probe_result", "probeId": r.OperationID, "guestBootId": uuid.NewString()})
+	return Result{Output: data}
+}
+func TestDirectAndMailboxProbesShareDriverWithoutToolLedger(t *testing.T) {
+	delivered := make(chan struct{}, 1)
+	m := New(driverFunc(func(_ context.Context, r Request, _ func(json.RawMessage)) Result {
+		if !r.Probe || r.MaximumOutputBytes != 4096 {
+			t.Error("probe bounds missing")
+		}
+		return probeResult(r)
+	}), deliveryFunc(func(_ context.Context, _ Request, _ Result) error { delivered <- struct{}{}; return nil }))
+	r := request()
+	r.CompletionContext = nil
+	result, rejection := m.Probe(context.Background(), m.BootID, r)
+	if rejection != "" || len(result.Output) == 0 {
+		t.Fatalf("direct: %s %+v", rejection, result)
+	}
+	r.OperationID = uuid.NewString()
+	r.CompletionContext = json.RawMessage(`{"kind":"execution_probe"}`)
+	if _, rejection = m.Probe(context.Background(), m.BootID, r); rejection != "" {
+		t.Fatal(rejection)
+	}
+	await(t, delivered)
+	m.Close()
+	if len(m.operations) != 0 || len(m.probes) != 0 {
+		t.Fatal("probes entered a retained Tool ledger")
+	}
+}
+func TestProbeCapacityReplacementAndShutdownNeverQuarantine(t *testing.T) {
+	started := make(chan struct{}, 4)
+	m := New(driverFunc(func(ctx context.Context, _ Request, _ func(json.RawMessage)) Result {
+		started <- struct{}{}
+		<-ctx.Done()
+		return Result{Failure: "diagnostic_timeout", Quarantine: true}
+	}), deliveryFunc(func(context.Context, Request, Result) error { t.Error("failed probe delivered success"); return nil }))
+	r := request()
+	if _, why := m.Probe(context.Background(), "old-boot", r); why != "executor_replaced" {
+		t.Fatal(why)
+	}
+	for i := 0; i < 4; i++ {
+		r.OperationID = uuid.NewString()
+		if _, why := m.Probe(context.Background(), m.BootID, r); why != "" {
+			t.Fatal(why)
+		}
+	}
+	r.OperationID = uuid.NewString()
+	if _, why := m.Probe(context.Background(), m.BootID, r); why != "probe_capacity" {
+		t.Fatal(why)
+	}
+	for i := 0; i < 4; i++ {
+		await(t, started)
+	}
+	m.Close()
+	if m.Unsafe(r.SandboxID) || len(m.operations) != 0 {
+		t.Fatal("diagnostic failure changed execution authority")
+	}
+}
+func TestMalformedAndClosedScopeProbesNeverExecute(t *testing.T) {
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result {
+		t.Error("unexpected guest start")
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	r := request()
+	if err := m.Stop(context.Background(), m.BootID, r.SandboxID, r.RunID, "", ""); err != nil {
+		t.Fatal(err)
+	}
+	if _, why := m.Probe(context.Background(), m.BootID, r); why != "scope_closed" {
+		t.Fatal(why)
+	}
+	r.OperationID = "invalid"
+	if _, why := m.Probe(context.Background(), m.BootID, r); why != "invalid_probe" {
+		t.Fatal(why)
+	}
+}
