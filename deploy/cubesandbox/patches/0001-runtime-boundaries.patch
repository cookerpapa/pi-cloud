@@ -0,0 +1,67 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet/grpcconn"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	cubebox "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"net/http"
+	"strconv"
+	"time"
+)
+
+func handleLifecycleHistory(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	if c.Param("action") == "sources" {
+		sources := []gin.H{}
+		for _, node := range localcache.GetNodes(-1) {
+			sources = append(sources, gin.H{"nodeID": node.ID(), "available": node.Healthy})
+		}
+		c.JSON(200, gin.H{"sources": sources})
+		return
+	}
+	if c.Param("action") != "history" {
+		c.JSON(404, gin.H{"error": "unknown_lifecycle_action"})
+		return
+	}
+	var input struct {
+		NodeID string `json:"nodeID"`
+		Epoch  string `json:"epoch"`
+		After  string `json:"after"`
+		Limit  uint32 `json:"limit"`
+		WaitMS uint32 `json:"waitMs"`
+	}
+	if json.NewDecoder(c.Request.Body).Decode(&input) != nil || input.NodeID == "" || input.Limit < 1 || input.Limit > 256 || input.WaitMS > 20000 {
+		c.JSON(400, gin.H{"error": "invalid_lifecycle_request"})
+		return
+	}
+	after, err := strconv.ParseUint(input.After, 10, 64)
+	if err != nil {
+		c.JSON(400, gin.H{"error": "invalid_lifecycle_cursor"})
+		return
+	}
+	node, ok := localcache.GetNode(input.NodeID)
+	if !ok || !node.Healthy {
+		c.JSON(503, gin.H{"error": "lifecycle_source_unavailable"})
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 25*time.Second)
+	defer cancel()
+	connection, err := grpcconn.GetWorkerConn(ctx, cubelet.GetCubeletAddr(node.IP))
+	if err != nil {
+		c.JSON(503, gin.H{"error": "lifecycle_source_unavailable"})
+		return
+	}
+	defer connection.Close()
+	page, err := cubebox.NewCubeboxMgrClient(connection.Value()).ReadLifecycle(ctx, &cubebox.LifecycleHistoryRequest{Epoch: input.Epoch, After: after, Limit: input.Limit, WaitMs: input.WaitMS})
+	if err != nil {
+		c.JSON(503, gin.H{"error": "lifecycle_history_unavailable"})
+		return
+	}
+	c.Data(200, "application/json", page.Page)
+}
diff --git a/CubeMaster/pkg/service/httpservice/cube/managed_allocation.go b/CubeMaster/pkg/service/httpservice/cube/managed_allocation.go
new file mode 100644
index 0000000..dda25f4
--- /dev/null
+++ b/CubeMaster/pkg/service/httpservice/cube/managed_allocation.go
@@ -0,0 +1,82 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/errorcode"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox/types"
+	"net/http"
+)
+
+func resumeManagedCreate(ctx context.Context, r *allocation.Record) *types.CreateCubeSandboxRes {
+	record, err := sandbox.ReconcileAllocation(ctx, r.ID, false, r.NotAfter, true)
+	if err == nil && record != nil && record.Phase == "ready" && !record.Closed && record.Result != "" {
+		var response types.CreateCubeSandboxRes
+		if json.Unmarshal([]byte(record.Result), &response) == nil {
+			return &response
+		}
+	}
+	return &types.CreateCubeSandboxRes{RequestID: r.ID, Ret: &types.Ret{RetCode: int(errorcode.ErrorCode_ReqCubeAPIFailed), RetMsg: "allocation_creation_unconfirmed"}}
+}
+func handleManagedAllocation(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	var input struct {
+		ID            string `json:"allocationID"`
+		NotAfter      int64  `json:"createBefore"`
+		ObservedAt    int64  `json:"observedAt"`
+		ExecutionBoot string `json:"executionBoot"`
+	}
+	if json.NewDecoder(c.Request.Body).Decode(&input) != nil || !allocation.ValidID(input.ID) || input.NotAfter <= 0 {
+		c.JSON(400, gin.H{"error": "invalid_allocation_request"})
+		return
+	}
+	action := c.Param("action")
+	if action == "renew" {
+		until, err := sandbox.RenewManagedAllocation(c.Request.Context(), input.ID, input.NotAfter, input.ExecutionBoot, input.ObservedAt)
+		if err != nil {
+			c.JSON(409, gin.H{"error": "retention_unconfirmed"})
+			return
+		}
+		c.JSON(200, gin.H{"allocationID": input.ID, "retainUntil": until})
+		return
+	}
+	if action != "get" && action != "close" {
+		c.JSON(404, gin.H{"error": "unknown_allocation_action"})
+		return
+	}
+	r, err := sandbox.ReconcileAllocation(c.Request.Context(), input.ID, action == "close", input.NotAfter, false)
+	if err != nil {
+		c.JSON(503, gin.H{"error": "allocation_unconfirmed"})
+		return
+	}
+	if r == nil {
+		c.JSON(200, gin.H{"allocationID": input.ID, "createBefore": input.NotAfter, "phase": "missing", "closed": false})
+		return
+	}
+	if r.NotAfter != input.NotAfter {
+		c.JSON(409, gin.H{"error": "allocation_parameters_changed"})
+		return
+	}
+	response := gin.H{"allocationID": r.ID, "createBefore": r.NotAfter, "sandboxID": r.SandboxID, "nodeID": r.NodeID, "phase": r.Phase, "closed": r.Closed}
+	if r.RetentionWindow > 0 {
+		response["retentionWindowMs"] = r.RetentionWindow
+		response["retainUntil"] = r.RetainUntil
+	}
+	if r.Phase == "ready" && !r.Closed && r.Result != "" {
+		var created types.CreateCubeSandboxRes
+		var original types.CreateCubeSandboxReq
+		if json.Unmarshal([]byte(r.Result), &created) != nil || json.Unmarshal([]byte(r.Request), &original) != nil {
+			c.JSON(503, gin.H{"error": "allocation_receipt_invalid"})
+			return
+		}
+		response["instance"] = gin.H{"sandboxID": r.SandboxID, "templateID": original.Annotations[constants.CubeAnnotationAppSnapshotTemplateID], "clientID": r.NodeID, "metadata": original.Labels, "trafficAccessToken": created.TrafficAccessToken}
+	}
+	c.JSON(200, response)
+	_ = allocation.Default().Collect(c.Request.Context())
+}
diff --git a/CubeMaster/pkg/service/httpservice/cube/managed_execution.go b/CubeMaster/pkg/service/httpservice/cube/managed_execution.go
new file mode 100644
index 0000000..6355a9f
--- /dev/null
+++ b/CubeMaster/pkg/service/httpservice/cube/managed_execution.go
@@ -0,0 +1,92 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet/grpcconn"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/sandboxid"
+	"github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+)
+
+type managedExecutionRequest struct {
+	Source             json.RawMessage `json:"source"`
+	SandboxID          string          `json:"sandboxID"`
+	NodeID             string          `json:"nodeID"`
+	BootID             string          `json:"bootID"`
+	OperationID        string          `json:"operationID"`
+	ProbeID            string          `json:"probeID"`
+	RunID              string          `json:"runID"`
+	WriterID           string          `json:"writerID"`
+	Payload            json.RawMessage `json:"payload"`
+	CompletionContext  json.RawMessage `json:"completionContext"`
+	TimeoutMS          int64           `json:"timeoutMs"`
+	MaximumOutputBytes int64           `json:"maximumOutputBytes"`
+}
+
+func handleManagedExecution(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 2*1024*1024)
+	var input managedExecutionRequest
+	if json.NewDecoder(c.Request.Body).Decode(&input) != nil || !sandboxid.IsFullID(input.SandboxID) || input.NodeID == "" {
+		c.JSON(400, gin.H{"error": "invalid_execution_request"})
+		return
+	}
+	node, ok := localcache.GetNode(input.NodeID)
+	if !ok || !node.Healthy {
+		// The request has not reached an execution endpoint.
+		c.JSON(200, gin.H{"accepted": false, "operationID": input.OperationID, "bootID": input.BootID, "rejection": "node_unavailable", "enabled": false})
+		return
+	}
+	timeout := 5 * time.Second
+	if c.Param("action") == "probe" {
+		timeout = 9 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), timeout)
+	defer cancel()
+	connection, err := grpcconn.GetWorkerConn(ctx, cubelet.GetCubeletAddr(node.IP))
+	if err != nil {
+		c.JSON(502, gin.H{"error": "execution_endpoint_unavailable"})
+		return
+	}
+	defer connection.Close()
+	client := cubebox.NewCubeboxMgrClient(connection.Value())
+	switch c.Param("action") {
+	case "probe":
+		response, err := client.ProbeExecution(ctx, &cubebox.ExecutionProbeRequest{SandboxId: input.SandboxID, BootId: input.BootID, ProbeId: input.ProbeID, RunId: input.RunID, WriterId: input.WriterID, CompletionContext: input.CompletionContext})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_probe_unavailable"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "probeID": response.ProbeId, "accepted": response.Accepted, "rejection": response.Rejection, "output": json.RawMessage(response.Output), "failure": response.Failure})
+	case "capabilities":
+		response, err := client.ExecutionCapabilities(ctx, &cubebox.ExecutionCapabilitiesRequest{SandboxId: input.SandboxID})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_capabilities_unavailable"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "protocolVersion": response.ProtocolVersion, "enabled": response.Enabled, "runtimeBlocked": response.RuntimeBlocked})
+	case "cancel":
+		response, err := client.CancelTool(ctx, &cubebox.CancelToolRequest{SourcePosition: input.Source, SandboxId: input.SandboxID, BootId: input.BootID, OperationId: input.OperationID, RunId: input.RunID, WriterId: input.WriterID})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_cancellation_unknown"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "accepted": response.Accepted, "rejection": response.Rejection})
+	case "submit":
+		response, err := client.SubmitTool(ctx, &cubebox.SubmitToolRequest{SourcePosition: input.Source, SandboxId: input.SandboxID, BootId: input.BootID, OperationId: input.OperationID, RunId: input.RunID, WriterId: input.WriterID, Payload: input.Payload, CompletionContext: input.CompletionContext, TimeoutMs: input.TimeoutMS, MaximumOutputBytes: input.MaximumOutputBytes})
+		if err != nil {
+			c.JSON(502, gin.H{"error": "execution_handoff_unknown"})
+			return
+		}
+		c.JSON(200, gin.H{"bootID": response.BootId, "operationID": response.OperationId, "accepted": response.Accepted, "rejection": response.Rejection})
+	default:
+		c.JSON(404, gin.H{"error": "unknown_execution_action"})
+	}
+}
