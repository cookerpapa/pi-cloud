+++ b/CubeMaster/pkg/allocation/volumes_test.go
@@ -0,0 +1,204 @@
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/google/uuid"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"strings"
+	"testing"
+	"time"
+)
+
+func volumeFixture(t *testing.T) (*Store, models.VolumeRecord, string) {
+	t.Helper()
+	s := realStore(t)
+	id := uuid.NewString()
+	v := models.VolumeRecord{VolumeID: id, Name: id, Driver: "picloud-posix"}
+	if err := s.DB.Create(&v).Error; err != nil {
+		t.Fatal(err)
+	}
+	return s, v, uuid.NewString()
+}
+func placeWithVolume(t *testing.T, s *Store, v models.VolumeRecord, epoch string) (*Record, error) {
+	t.Helper()
+	ctx := context.Background()
+	id := uuid.NewString()
+	r, err := s.Begin(ctx, id, strings.Repeat("a", 64), time.Now().Add(time.Minute).UnixMilli(), "{}")
+	if err != nil {
+		t.Fatal(err)
+	}
+	entries, _ := json.Marshal([]map[string]string{{"name": v.VolumeID}})
+	raw, _ := json.Marshal(map[string]any{"annotations": map[string]string{"plugin-volume-sources": string(entries)}})
+	placed, err := s.Place(ctx, id, "node-volume", "127.0.0.1", "boot", string(raw), "{}", epoch)
+	if err != nil {
+		return r, err
+	}
+	return placed, nil
+}
+func finishAllocation(t *testing.T, s *Store, r *Record) {
+	t.Helper()
+	ctx := context.Background()
+	if _, err := s.Close(ctx, r.ID, r.NotAfter); err != nil {
+		t.Fatal(err)
+	}
+	// No cleanup receipt is required to reconcile Volume references.
+	if _, err := s.Finish(ctx, r.ID, "absent", ""); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestVolumeStateRecoversLostCleanupReceiptAndSurvivesAllocationGC(t *testing.T) {
+	s, v, epoch := volumeFixture(t)
+	ctx := context.Background()
+	a, err := placeWithVolume(t, s, v, epoch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := placeWithVolume(t, s, v, epoch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nodes, err := s.VolumeNodes(ctx, v.VolumeID)
+	if err != nil || len(nodes) != 1 {
+		t.Fatal(nodes, err)
+	}
+	target := nodes[0]
+	apply := func(revision, count int64, confirmed bool) {
+		t.Helper()
+		if err := s.ApplyVolumeState(ctx, target, VolumeState{VolumeID: v.VolumeID, Epoch: epoch, Revision: revision, Count: count, Confirmed: confirmed}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	apply(10, 2, true)
+	apply(10, 2, true)
+	finishAllocation(t, s, a)
+	apply(11, 1, true)
+	if _, err = s.BeginVolumeDeletion(ctx, v.VolumeID); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.ConfirmVolumeDeletion(ctx, v.VolumeID, uint64(v.ID)); !errors.Is(err, ErrVolumeHeld) {
+		t.Fatal(err)
+	}
+	if _, err = placeWithVolume(t, s, v, epoch); !errors.Is(err, ErrVolumeClosing) {
+		t.Fatal("late create", err)
+	}
+	// Physical VM absence can complete independently of a pending Volume detach.
+	finishAllocation(t, s, b)
+	apply(12, 0, false)
+	if err = s.ConfirmVolumeDeletion(ctx, v.VolumeID, uint64(v.ID)); !errors.Is(err, ErrVolumeHeld) {
+		t.Fatal(err)
+	}
+	apply(13, 0, true)
+	// Delayed creation/detach responses cannot regress the current state.
+	apply(10, 2, true)
+	apply(12, 0, false)
+	if err = s.ApplyVolumeState(ctx, target, VolumeState{VolumeID: v.VolumeID, Epoch: uuid.NewString(), Revision: 100, Confirmed: true}); !errors.Is(err, ErrConflict) {
+		t.Fatal("metadata loss accepted", err)
+	}
+	// Only test data's expiry is advanced to exercise the real collection query.
+	if err = s.DB.Model(&Record{}).Where("id in ?", []string{a.ID, b.ID}).Update("not_after", time.Now().Add(-2*time.Hour).UnixMilli()).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err = s.Collect(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if r, err := s.Get(ctx, a.ID); err != nil || r != nil {
+		t.Fatal(r, err)
+	}
+	nodes, err = s.VolumeNodes(ctx, v.VolumeID)
+	if err != nil || len(nodes) != 1 {
+		t.Fatal(nodes, err)
+	}
+	if err = s.ConfirmVolumeDeletion(ctx, v.VolumeID, uint64(v.ID)); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.FinishVolumeDeletion(ctx, v.VolumeID, uint64(v.ID)); err != nil {
+		t.Fatal(err)
+	}
+	replacement := models.VolumeRecord{VolumeID: v.VolumeID, Name: v.Name, Driver: v.Driver}
+	if err = s.DB.Create(&replacement).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err = s.ApplyVolumeState(ctx, target, VolumeState{VolumeID: v.VolumeID, Epoch: epoch, Revision: 100, Confirmed: true}); !errors.Is(err, ErrConflict) {
+		t.Fatal("old Volume lifetime changed replacement", err)
+	}
+}
+
+func TestPendingCreationHoldPreventsZeroSnapshotFromDeletingVolume(t *testing.T) {
+	s, v, epoch := volumeFixture(t)
+	ctx := context.Background()
+	r, err := placeWithVolume(t, s, v, epoch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nodes, err := s.VolumeNodes(ctx, v.VolumeID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The node has not seen Create yet. Its valid zero state does not retract
+	// the durable Master placement which could still start it.
+	if err = s.ApplyVolumeState(ctx, nodes[0], VolumeState{VolumeID: v.VolumeID, Epoch: epoch, Revision: 0, Confirmed: true}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = s.BeginVolumeDeletion(ctx, v.VolumeID); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.ConfirmVolumeDeletion(ctx, v.VolumeID, uint64(v.ID)); !errors.Is(err, ErrVolumeHeld) {
+		t.Fatal(err)
+	}
+	finishAllocation(t, s, r)
+	if err = s.ConfirmVolumeDeletion(ctx, v.VolumeID, uint64(v.ID)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestUntrackedHistoricalReferenceCannotBecomeZero(t *testing.T) {
+	s, v, _ := volumeFixture(t)
+	if err := s.DB.Model(&v).Update("refcount", 1).Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.BeginVolumeDeletion(context.Background(), v.VolumeID); !errors.Is(err, ErrVolumeHeld) {
+		t.Fatal(err)
+	}
+}
+
+func TestConcurrentPlacementAndDeletionCannotBothAuthorizeEffects(t *testing.T) {
+	for i := 0; i < 8; i++ {
+		s, v, epoch := volumeFixture(t)
+		ctx := context.Background()
+		start := make(chan struct{})
+		placed := make(chan error, 1)
+		deleted := make(chan error, 1)
+		go func() { <-start; _, err := placeWithVolume(t, s, v, epoch); placed <- err }()
+		go func() {
+			<-start
+			_, err := s.BeginVolumeDeletion(ctx, v.VolumeID)
+			if err == nil {
+				var nodes []VolumeNode
+				nodes, err = s.VolumeNodes(ctx, v.VolumeID)
+				for _, node := range nodes {
+					if err != nil {
+						break
+					}
+					err = s.ApplyVolumeState(ctx, node, VolumeState{VolumeID: v.VolumeID, Epoch: epoch, Revision: 0, Confirmed: true})
+				}
+			}
+			if err == nil {
+				err = s.ConfirmVolumeDeletion(ctx, v.VolumeID, uint64(v.ID))
+			}
+			deleted <- err
+		}()
+		close(start)
+		admission, removal := <-placed, <-deleted
+		if admission == nil && removal == nil {
+			t.Fatal("creation and deletion both admitted")
+		}
+		if admission != nil && !errors.Is(admission, ErrVolumeClosing) {
+			t.Fatal(admission)
+		}
+		if removal != nil && !errors.Is(removal, ErrVolumeHeld) {
+			t.Fatal(removal)
+		}
+	}
+}
