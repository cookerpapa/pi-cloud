+	}
+	deadline := r.RetainUntil
+	original := m.Store.db
+	m.Store.db = failedRetentionDB{original}
+	now.Add(15000)
+	if _, e = m.Renew(i, now.Load()); e == nil {
+		t.Fatal("failed update acknowledged")
+	}
+	m.Store.db = original
+	r, e = m.Store.Get(i.ID)
+	if e != nil || r.RetainUntil != deadline {
+		t.Fatal(r, e)
+	}
+}
+
+func TestRetentionOriginalTimeAndClosedIdentity(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	i.RetentionWindow = 900000
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil {
+		t.Fatal(e)
+	}
+	first := r.RetainUntil
+	now.Add(30000)
+	r, e = m.Renew(i, now.Load())
+	if e != nil || r.RetainUntil != first+30000 {
+		t.Fatal(r, e)
+	}
+	r, e = m.Renew(i, now.Load()-20000)
+	if e != nil || r.RetainUntil != first+30000 {
+		t.Fatal(r, e)
+	}
+	now.Add(50000)
+	if _, e = m.Renew(i, now.Load()-50000); !errors.Is(e, ErrStaleActivity) {
+		t.Fatal(e)
+	}
+	now.Store(r.RetainUntil)
+	due, e := m.Store.Due(1)
+	if e != nil || len(due) != 1 {
+		t.Fatal(due, e)
+	}
+	closed, e := m.Store.BeginExpiry(i.ID)
+	if !closed || e != nil {
+		t.Fatal(closed, e)
+	}
+	if _, e = m.Renew(i, now.Load()); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	r, e = m.Close(context.Background(), i, time.Second, absent)
+	if e != nil || r.Phase != "absent" {
+		t.Fatal(r, e)
+	}
+	due, e = m.Store.Due(1)
+	if e != nil || len(due) != 0 {
+		t.Fatal(due, e)
+	}
+}
+func TestRetentionRechecksRenewalAndSurvivesManagerRestart(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	i.RetentionWindow = 900000
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil {
+		t.Fatal(e)
+	}
+	now.Store(r.RetainUntil)
+	if rows, e := m.Store.Due(1); e != nil || len(rows) != 1 {
+		t.Fatal(rows, e)
+	}
+	if _, e = m.Renew(i, now.Load()); e != nil {
+		t.Fatal(e)
+	}
+	if closed, e := m.Store.BeginExpiry(i.ID); e != nil || closed {
+		t.Fatal(closed, e)
+	}
+	next := NewManager(m.Store, "boot-two")
+	if _, e = next.Renew(i, now.Load()); !errors.Is(e, ErrConflict) {
+		t.Fatal(e)
+	}
+	now.Add(900000)
+	if closed, e := next.Store.BeginExpiry(i.ID); e != nil || !closed {
+		t.Fatal(closed, e)
+	}
+}
+func TestDedicatedAllocationNeverAcquiresFiniteRetention(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil || r.RetainUntil != 0 {
+		t.Fatal(r, e)
+	}
+	if _, e = m.Renew(i, now.Load()); !errors.Is(e, ErrConflict) {
+		t.Fatal(e)
+	}
+	now.Add(86400000)
+	if rows, e := m.Store.Due(1); e != nil || len(rows) != 0 {
+		t.Fatal(rows, e)
+	}
+}
diff --git a/Cubelet/pkg/allocation/store.go b/Cubelet/pkg/allocation/store.go
new file mode 100644
index 0000000..4b5e1c7
--- /dev/null
+++ b/Cubelet/pkg/allocation/store.go
@@ -0,0 +1,201 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+	"time"
+)
+
+// Reuse Cubelet's synchronous metadata database. No separate node database,
+// in-memory lifetime tombstone set, or external scheduler is introduced.
+type Database interface {
+	Update(func(*bolt.Tx) error) error
+	View(func(*bolt.Tx) error) error
+}
+type Record struct {
+	ID              string          `json:"allocationID"`
+	SandboxID       string          `json:"sandboxID"`
+	Digest          string          `json:"digest"`
+	NotAfter        int64           `json:"createBefore"`
+	Phase           string          `json:"phase"`
+	Closed          bool            `json:"closed"`
+	StartedBoot     string          `json:"startedBoot,omitempty"`
+	CreateFinished  bool            `json:"createFinished"`
+	Result          json.RawMessage `json:"result,omitempty"`
+	CleanupResult   json.RawMessage `json:"cleanupResult,omitempty"`
+	RetentionWindow int64           `json:"retentionWindowMs,omitempty"`
+	RetainUntil     int64           `json:"retainUntil,omitempty"`
+}
+type Store struct {
+	db  Database
+	now func() time.Time
+}
+
+var bucket = []byte("pi-cloud.allocations.v1")
+var records = []byte("records")
+var expiry = []byte("expiry")
+var floor = []byte("clock-floor")
+var idleExpiry = []byte("idle-expiry")
+
+const retention = int64(time.Hour / time.Millisecond)
+
+var ErrMissing = errors.New("allocation not recorded")
+
+func NewStore(db Database, now func() time.Time) (*Store, error) {
+	if db == nil {
+		return nil, errors.New("allocation metadata unavailable")
+	}
+	if now == nil {
+		now = time.Now
+	}
+	s := &Store{db: db, now: now}
+	err := db.Update(func(tx *bolt.Tx) error {
+		if tx.DB().NoSync {
+			return errors.New("allocation receipts require synchronous node metadata")
+		}
+		b, e := tx.CreateBucketIfNotExists(bucket)
+		if e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(records); e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(expiry); e != nil {
+			return e
+		}
+		_, e = b.CreateBucketIfNotExists(idleExpiry)
+		return e
+	})
+	return s, err
+}
+func decode(v []byte) (*Record, error) {
+	if v == nil {
+		return nil, nil
+	}
+	var r Record
+	err := json.Unmarshal(v, &r)
+	return &r, err
+}
+func (s *Store) Get(id string) (*Record, error) {
+	var r *Record
+	err := s.db.View(func(tx *bolt.Tx) error {
+		var e error
+		r, e = decode(tx.Bucket(bucket).Bucket(records).Get([]byte(id)))
+		return e
+	})
+	return r, err
+}
+func clock(b *bolt.Bucket, now int64) (int64, error) {
+	if v := b.Get(floor); len(v) == 8 && int64(binary.BigEndian.Uint64(v)) > now {
+		now = int64(binary.BigEndian.Uint64(v))
+	}
+	v := make([]byte, 8)
+	binary.BigEndian.PutUint64(v, uint64(now))
+	return now, b.Put(floor, v)
+}
+func expiryKey(r *Record) []byte {
+	k := make([]byte, 8+len(r.ID))
+	binary.BigEndian.PutUint64(k, uint64(r.NotAfter+retention))
+	copy(k[8:], r.ID)
+	return k
+}
+func (s *Store) Update(id string, change func(*Record, int64) (*Record, error)) (*Record, error) {
+	var result *Record
+	err := s.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now, e := clock(b, s.now().UnixMilli())
+		if e != nil {
+			return e
+		}
+		current, e := decode(b.Bucket(records).Get([]byte(id)))
+		if e != nil {
+			return e
+		}
+		if current != nil && current.RetainUntil > 0 {
+			if e = b.Bucket(idleExpiry).Delete(idleKey(current)); e != nil {
+				return e
+			}
+		}
+		result, e = change(current, now)
+		if e != nil {
+			return e
+		}
+		if result == nil {
+			return errors.New("missing allocation mutation")
+		}
+		data, e := json.Marshal(result)
+		if e != nil {
+			return e
+		}
+		if len(data) > 256*1024 {
+			return errors.New("allocation receipt too large")
+		}
+		if e = b.Bucket(records).Put([]byte(id), data); e != nil {
+			return e
+		}
+		if result.RetainUntil > 0 && result.Phase != "absent" {
+			if e = b.Bucket(idleExpiry).Put(idleKey(result), []byte(id)); e != nil {
+				return e
+			}
+		}
+		if result.Closed && result.Phase == "absent" {
+			return b.Bucket(expiry).Put(expiryKey(result), []byte(id))
+		}
+		return nil
+	})
+	return result, err
+}
+
+// Only confirmed closed receipts expire. The durable clock floor prevents a
+// subsequent clock rollback from making their old Create authorization valid.
+func (s *Store) Collect() error {
+	return s.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now, e := clock(b, s.now().UnixMilli())
+		if e != nil {
+			return e
+		}
+		c := b.Bucket(expiry).Cursor()
+		held, e := refcount.ReferencedSandboxes(tx)
+		if e != nil {
+			return e
+		}
+		var postponed [][]byte
+		k, id := c.First()
+		for n := 0; n < 128; n++ {
+			if k == nil || int64(binary.BigEndian.Uint64(k[:8])) > now {
+				break
+			}
+			r, e := decode(b.Bucket(records).Get(id))
+			if e != nil {
+				return e
+			}
+			if r != nil && r.Closed && r.Phase == "absent" && r.NotAfter+retention <= now {
+				if _, referenced := held[r.SandboxID]; referenced {
+					postponed = append(postponed, append([]byte(nil), id...))
+				} else if e = b.Bucket(records).Delete(id); e != nil {
+					return e
+				}
+			}
+			if e = c.Delete(); e != nil {
+				return e
+			}
+			k, id = c.Next()
+		}
+		// Do not let retained holders starve unrelated expired receipts.
+		for _, id := range postponed {
+			k := make([]byte, 8+len(id))
+			binary.BigEndian.PutUint64(k, uint64(now+int64(time.Minute/time.Millisecond)))
+			copy(k[8:], id)
+			if e = b.Bucket(expiry).Put(k, id); e != nil {
+				return e
+			}
+		}
+		return nil
+	})
+}
diff --git a/Cubelet/pkg/allocation/volume_evidence_test.go b/Cubelet/pkg/allocation/volume_evidence_test.go
