@@ -0,0 +1,83 @@
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+type reviewFailOnceDB struct {
+	*bolt.DB
+	fail bool
+}
+
+func (d *reviewFailOnceDB) Update(fn func(*bolt.Tx) error) error {
+	if d.fail {
+		d.fail = false
+		return errors.New("review: node receipt write unavailable")
+	}
+	return d.DB.Update(fn)
+}
+
+// Allocation and Volume metadata have independent durable lifetimes.
+func TestCleanupReceiptLossRetainsQueryableVolumeState(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	db := &reviewFailOnceDB{DB: raw}
+	store, err := NewStore(db, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager := NewManager(store, "review-boot")
+	id := Identity{ID: "a1000000-0000-4000-8000-000000000001", Digest: strings.Repeat("a", 64), NotAfter: time.Now().Add(time.Minute).UnixMilli(), BootID: "review-boot"}
+	if _, err = manager.Create(context.Background(), id, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		return json.RawMessage(`{"created":true}`), true, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	refs, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = refs.Acquire("default", "volume", id.ID, "test"); err != nil {
+		t.Fatal(err)
+	}
+	physicalDeletes := 0
+	_, err = manager.Close(context.Background(), id, time.Second, func(context.Context, Record) (json.RawMessage, bool, error) {
+		physicalDeletes++
+		if _, err = refs.BeginDetach("default", "volume", id.ID, nil); err != nil {
+			t.Fatal(err)
+		}
+		if err = refs.CompleteDetach("default", "volume", id.ID); err != nil {
+			t.Fatal(err)
+		}
+		db.fail = true
+		return json.RawMessage(`{"volumeReference":0}`), true, nil
+	})
+	if err == nil {
+		t.Fatal("receipt write failure was not injected")
+	}
+	// The actual cleanup adapter takes this branch when exact node Observe sees
+	// absence: return r.CleanupResult, true, nil. The first reply was never stored.
+	r, err := manager.Close(context.Background(), id, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) { return r.CleanupResult, true, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Phase != "absent" || !r.Closed || len(r.CleanupResult) != 0 || physicalDeletes != 1 {
+		t.Fatalf("unexpected baseline: %+v deletes=%d", r, physicalDeletes)
+	}
+	state, err := refs.State("default", "volume")
+	if err != nil || state.Count != 0 || !state.Confirmed {
+		t.Fatal(state, err)
+	}
+	t.Log("Physical absence and current Volume state survive loss of the allocation cleanup result")
+}
diff --git a/Cubelet/pkg/allocation/retention.go b/Cubelet/pkg/allocation/retention.go
new file mode 100644
index 0000000..c2fa54a
--- /dev/null
+++ b/Cubelet/pkg/allocation/retention.go
@@ -0,0 +1,109 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"encoding/binary"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+)
+
+var ErrStaleActivity = errors.New("retention activity is stale")
+
+func idleKey(r *Record) []byte {
+	k := make([]byte, 8+len(r.ID))
+	binary.BigEndian.PutUint64(k, uint64(r.RetainUntil))
+	copy(k[8:], r.ID)
+	return k
+}
+
+// The existing synchronous allocation journal is the sole retention clock.
+// Replays retain their original time and cannot renew a later incarnation.
+func (m *Manager) Renew(i Identity, observedAt int64) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	return m.Store.Update(i.ID, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed {
+			return nil, ErrClosed
+		}
+		if i.BootID != m.BootID || r.StartedBoot != i.BootID || r.Digest != i.Digest || r.NotAfter != i.NotAfter {
+			return nil, ErrConflict
+		}
+		if r.RetentionWindow <= 0 || r.Phase != "ready" {
+			return nil, ErrConflict
+		}
+		if observedAt <= 0 || observedAt > now+5000 || now-observedAt > 45000 {
+			return nil, ErrStaleActivity
+		}
+		until := observedAt + r.RetentionWindow
+		if until > r.RetainUntil {
+			r.RetainUntil = until
+		}
+		return r, nil
+	})
+}
+
+func (s *Store) Due(limit int) ([]Record, error) {
+	if limit < 1 || limit > 1024 {
+		return nil, errors.New("invalid retention page")
+	}
+	var result []Record
+	err := s.db.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now := s.now().UnixMilli()
+		if v := b.Get(floor); len(v) == 8 && int64(binary.BigEndian.Uint64(v)) > now {
+			now = int64(binary.BigEndian.Uint64(v))
+		}
+		c := b.Bucket(idleExpiry).Cursor()
+		for k, id := c.First(); k != nil && len(result) < limit; k, id = c.Next() {
+			if int64(binary.BigEndian.Uint64(k[:8])) > now {
+				break
+			}
+			r, err := decode(b.Bucket(records).Get(id))
+			if err != nil {
+				return err
+			}
+			if r != nil {
+				result = append(result, *r)
+			}
+		}
+		return nil
+	})
+	return result, err
+}
+
+// The allocation journal serializes renewal and finite expiry. Tool state is
+// deliberately not an expiry veto; an old enumerated deadline is insufficient.
+func (s *Store) BeginExpiry(id string) (bool, error) {
+	closed := false
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.RetentionWindow > 0 && r.RetainUntil <= now && r.Phase != "absent" {
+			r.Closed = true
+			r.Phase = "closing"
+			closed = true
+		}
+		return r, nil
+	})
+	return closed, err
+}
+
+// Keep one failed physical cleanup from starving later expired allocations.
+func (s *Store) DeferExpiry(id string) error {
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed && r.Phase != "absent" {
+			r.RetainUntil = now + 10000
+		}
+		return r, nil
+	})
+	return err
+}
diff --git a/Cubelet/pkg/allocation/retention_test.go b/Cubelet/pkg/allocation/retention_test.go
new file mode 100644
index 0000000..bbc78b1
--- /dev/null
+++ b/Cubelet/pkg/allocation/retention_test.go
@@ -0,0 +1,122 @@
+package allocation
+
+import (
+	"context"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+	"testing"
+	"time"
+)
+
+type failedRetentionDB struct{ Database }
+
+func (f failedRetentionDB) Update(func(*bolt.Tx) error) error {
+	return errors.New("metadata fsync failed")
+}
+func TestRetentionDoesNotAcknowledgeFailedPersistence(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	i.RetentionWindow = 900000
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil {
+		t.Fatal(e)
+	}
+	deadline := r.RetainUntil
+	original := m.Store.db
+	m.Store.db = failedRetentionDB{original}
+	now.Add(15000)
+	if _, e = m.Renew(i, now.Load()); e == nil {
+		t.Fatal("failed update acknowledged")
+	}
+	m.Store.db = original
+	r, e = m.Store.Get(i.ID)
+	if e != nil || r.RetainUntil != deadline {
+		t.Fatal(r, e)
+	}
+}
+
+func TestRetentionOriginalTimeAndClosedIdentity(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	i.RetentionWindow = 900000
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil {
+		t.Fatal(e)
+	}
+	first := r.RetainUntil
+	now.Add(30000)
+	r, e = m.Renew(i, now.Load())
+	if e != nil || r.RetainUntil != first+30000 {
+		t.Fatal(r, e)
+	}
+	r, e = m.Renew(i, now.Load()-20000)
+	if e != nil || r.RetainUntil != first+30000 {
+		t.Fatal(r, e)
+	}
+	now.Add(50000)
+	if _, e = m.Renew(i, now.Load()-50000); !errors.Is(e, ErrStaleActivity) {
+		t.Fatal(e)
+	}
+	now.Store(r.RetainUntil)
+	due, e := m.Store.Due(1)
+	if e != nil || len(due) != 1 {
+		t.Fatal(due, e)
+	}
+	closed, e := m.Store.BeginExpiry(i.ID)
+	if !closed || e != nil {
+		t.Fatal(closed, e)
+	}
+	if _, e = m.Renew(i, now.Load()); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	r, e = m.Close(context.Background(), i, time.Second, absent)
+	if e != nil || r.Phase != "absent" {
+		t.Fatal(r, e)
+	}
+	due, e = m.Store.Due(1)
+	if e != nil || len(due) != 0 {
+		t.Fatal(due, e)
+	}
+}
+func TestRetentionRechecksRenewalAndSurvivesManagerRestart(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	i.RetentionWindow = 900000
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil {
+		t.Fatal(e)
+	}
+	now.Store(r.RetainUntil)
+	if rows, e := m.Store.Due(1); e != nil || len(rows) != 1 {
+		t.Fatal(rows, e)
+	}
+	if _, e = m.Renew(i, now.Load()); e != nil {
+		t.Fatal(e)
+	}
+	if closed, e := m.Store.BeginExpiry(i.ID); e != nil || closed {
+		t.Fatal(closed, e)
+	}
+	next := NewManager(m.Store, "boot-two")
+	if _, e = next.Renew(i, now.Load()); !errors.Is(e, ErrConflict) {
+		t.Fatal(e)
+	}
+	now.Add(900000)
+	if closed, e := next.Store.BeginExpiry(i.ID); e != nil || !closed {
+		t.Fatal(closed, e)
+	}
+}
+func TestDedicatedAllocationNeverAcquiresFiniteRetention(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil || r.RetainUntil != 0 {
+		t.Fatal(r, e)
+	}
+	if _, e = m.Renew(i, now.Load()); !errors.Is(e, ErrConflict) {
+		t.Fatal(e)
+	}
+	now.Add(86400000)
+	if rows, e := m.Store.Due(1); e != nil || len(rows) != 0 {
+		t.Fatal(rows, e)
+	}
+}
diff --git a/Cubelet/pkg/allocation/store.go b/Cubelet/pkg/allocation/store.go
new file mode 100644
index 0000000..4b5e1c7
--- /dev/null
+++ b/Cubelet/pkg/allocation/store.go
@@ -0,0 +1,201 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+	"time"
+)
+
+// Reuse Cubelet's synchronous metadata database. No separate node database,
+// in-memory lifetime tombstone set, or external scheduler is introduced.
+type Database interface {
+	Update(func(*bolt.Tx) error) error
+	View(func(*bolt.Tx) error) error
+}
+type Record struct {
+	ID              string          `json:"allocationID"`
+	SandboxID       string          `json:"sandboxID"`
+	Digest          string          `json:"digest"`
+	NotAfter        int64           `json:"createBefore"`
+	Phase           string          `json:"phase"`
+	Closed          bool            `json:"closed"`
+	StartedBoot     string          `json:"startedBoot,omitempty"`
+	CreateFinished  bool            `json:"createFinished"`
+	Result          json.RawMessage `json:"result,omitempty"`
+	CleanupResult   json.RawMessage `json:"cleanupResult,omitempty"`
+	RetentionWindow int64           `json:"retentionWindowMs,omitempty"`
+	RetainUntil     int64           `json:"retainUntil,omitempty"`
+}
+type Store struct {
+	db  Database
+	now func() time.Time
+}
+
+var bucket = []byte("pi-cloud.allocations.v1")
+var records = []byte("records")
+var expiry = []byte("expiry")
+var floor = []byte("clock-floor")
+var idleExpiry = []byte("idle-expiry")
+
+const retention = int64(time.Hour / time.Millisecond)
+
+var ErrMissing = errors.New("allocation not recorded")
+
+func NewStore(db Database, now func() time.Time) (*Store, error) {
+	if db == nil {
+		return nil, errors.New("allocation metadata unavailable")
+	}
+	if now == nil {
+		now = time.Now
+	}
+	s := &Store{db: db, now: now}
+	err := db.Update(func(tx *bolt.Tx) error {
+		if tx.DB().NoSync {
+			return errors.New("allocation receipts require synchronous node metadata")
+		}
+		b, e := tx.CreateBucketIfNotExists(bucket)
+		if e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(records); e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(expiry); e != nil {
+			return e
+		}
+		_, e = b.CreateBucketIfNotExists(idleExpiry)
+		return e
+	})
+	return s, err
+}
+func decode(v []byte) (*Record, error) {
+	if v == nil {
+		return nil, nil
+	}
+	var r Record
+	err := json.Unmarshal(v, &r)
+	return &r, err
+}
+func (s *Store) Get(id string) (*Record, error) {
+	var r *Record
+	err := s.db.View(func(tx *bolt.Tx) error {
+		var e error
+		r, e = decode(tx.Bucket(bucket).Bucket(records).Get([]byte(id)))
+		return e
+	})
+	return r, err
+}
+func clock(b *bolt.Bucket, now int64) (int64, error) {
+	if v := b.Get(floor); len(v) == 8 && int64(binary.BigEndian.Uint64(v)) > now {
+		now = int64(binary.BigEndian.Uint64(v))
+	}
+	v := make([]byte, 8)
+	binary.BigEndian.PutUint64(v, uint64(now))
+	return now, b.Put(floor, v)
+}
+func expiryKey(r *Record) []byte {
+	k := make([]byte, 8+len(r.ID))
+	binary.BigEndian.PutUint64(k, uint64(r.NotAfter+retention))
+	copy(k[8:], r.ID)
+	return k
+}
+func (s *Store) Update(id string, change func(*Record, int64) (*Record, error)) (*Record, error) {
+	var result *Record
+	err := s.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now, e := clock(b, s.now().UnixMilli())
+		if e != nil {
+			return e
+		}
+		current, e := decode(b.Bucket(records).Get([]byte(id)))
+		if e != nil {
+			return e
+		}
+		if current != nil && current.RetainUntil > 0 {
+			if e = b.Bucket(idleExpiry).Delete(idleKey(current)); e != nil {
+				return e
+			}
+		}
+		result, e = change(current, now)
+		if e != nil {
+			return e
+		}
+		if result == nil {
+			return errors.New("missing allocation mutation")
+		}
+		data, e := json.Marshal(result)
+		if e != nil {
+			return e
+		}
+		if len(data) > 256*1024 {
+			return errors.New("allocation receipt too large")
+		}
+		if e = b.Bucket(records).Put([]byte(id), data); e != nil {
+			return e
+		}
+		if result.RetainUntil > 0 && result.Phase != "absent" {
+			if e = b.Bucket(idleExpiry).Put(idleKey(result), []byte(id)); e != nil {
+				return e
+			}
+		}
+		if result.Closed && result.Phase == "absent" {
+			return b.Bucket(expiry).Put(expiryKey(result), []byte(id))
+		}
+		return nil
+	})
+	return result, err
+}
+
+// Only confirmed closed receipts expire. The durable clock floor prevents a
+// subsequent clock rollback from making their old Create authorization valid.
+func (s *Store) Collect() error {
+	return s.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now, e := clock(b, s.now().UnixMilli())
+		if e != nil {
+			return e
+		}
+		c := b.Bucket(expiry).Cursor()
+		held, e := refcount.ReferencedSandboxes(tx)
+		if e != nil {
+			return e
+		}
+		var postponed [][]byte
+		k, id := c.First()
+		for n := 0; n < 128; n++ {
+			if k == nil || int64(binary.BigEndian.Uint64(k[:8])) > now {
+				break
+			}
+			r, e := decode(b.Bucket(records).Get(id))
+			if e != nil {
+				return e
+			}
+			if r != nil && r.Closed && r.Phase == "absent" && r.NotAfter+retention <= now {
+				if _, referenced := held[r.SandboxID]; referenced {
+					postponed = append(postponed, append([]byte(nil), id...))
+				} else if e = b.Bucket(records).Delete(id); e != nil {
+					return e
+				}
+			}
+			if e = c.Delete(); e != nil {
+				return e
+			}
+			k, id = c.Next()
+		}
+		// Do not let retained holders starve unrelated expired receipts.
+		for _, id := range postponed {
+			k := make([]byte, 8+len(id))
+			binary.BigEndian.PutUint64(k, uint64(now+int64(time.Minute/time.Millisecond)))
+			copy(k[8:], id)
+			if e = b.Bucket(expiry).Put(k, id); e != nil {
+				return e
+			}
+		}
+		return nil
+	})
+}
diff --git a/Cubelet/pkg/allocation/volume_evidence_test.go b/Cubelet/pkg/allocation/volume_evidence_test.go
new file mode 100644
index 0000000..af0b97a
--- /dev/null
+++ b/Cubelet/pkg/allocation/volume_evidence_test.go
@@ -0,0 +1,76 @@
+package allocation
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+)
+
+func TestVolumeEvidenceOutlivesReceiptTTLWithoutBlockingUnrelatedCollection(t *testing.T) {
+	m, db, now := fixture(t)
+	refs, err := refcount.New(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	ids := make([]Identity, 0, 130)
+	for n := 0; n < 130; n++ {
+		i := identity()
+		i.ID = fmt.Sprintf("12345678-1234-1234-1234-%012x", n)
+		if _, err = m.Create(ctx, i, time.Second, success); err != nil {
+			t.Fatal(err)
+		}
+		if n < 129 {
+			if _, err = refs.Acquire("default", fmt.Sprintf("v%d", n), SandboxID(i.ID), "picloud-posix"); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err = m.Close(ctx, i, time.Second, absent); err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, i)
+	}
+	if _, err = refs.RecoverRefCounts(nil); err != nil {
+		t.Fatal(err)
+	}
+	now.Store(identity().NotAfter + retention + 1)
+	// Each invocation scans at most 128 receipts. Retained evidence is postponed
+	// so unrelated expired allocation 129 can be reclaimed on the next pass.
+	for n := 0; n < 2; n++ {
+		if err = m.Store.Collect(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if r, e := m.Store.Get(ids[129].ID); e != nil || r != nil {
+		t.Fatal(r, e)
+	}
+	if r, e := m.Store.Get(ids[0].ID); e != nil || r == nil {
+		t.Fatal("lost stale holder evidence", r, e)
+	}
+	if _, err = refs.BeginDetach("default", "v0", SandboxID(ids[0].ID), nil); err != nil {
+		t.Fatal(err)
+	}
+	now.Add(60001)
+	if err = m.Store.Collect(); err != nil {
+		t.Fatal(err)
+	}
+	if r, e := m.Store.Get(ids[0].ID); e != nil || r == nil {
+		t.Fatal("lost pending detach evidence", r, e)
+	}
+	if err = refs.CompleteDetach("default", "v0", SandboxID(ids[0].ID)); err != nil {
+		t.Fatal(err)
+	}
+	now.Add(60001)
+	if err = m.Store.Collect(); err != nil {
+		t.Fatal(err)
+	}
+	if r, e := m.Store.Get(ids[0].ID); e != nil || r != nil {
+		t.Fatal(r, e)
+	}
+	if _, err = m.Create(ctx, ids[0], time.Second, success); err != ErrExpired {
+		t.Fatal("late create admitted", err)
+	}
+}
diff --git a/Cubelet/pkg/lifecyclejournal/journal.go b/Cubelet/pkg/lifecyclejournal/journal.go
new file mode 100644
index 0000000..9990fa9
--- /dev/null
+++ b/Cubelet/pkg/lifecyclejournal/journal.go
@@ -0,0 +1,296 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+// Package lifecyclejournal retains raw provider facts, never priced usage.
+package lifecyclejournal
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"github.com/google/uuid"
+	bolt "go.etcd.io/bbolt"
+	"sync"
+	"time"
+)
+
+type Database interface {
+	Update(func(*bolt.Tx) error) error
+	View(func(*bolt.Tx) error) error
+}
+type Identity struct {
+	Kind        string `json:"kind"`
+	ResourceID  string `json:"resourceId"`
+	TenantID    string `json:"tenantId"`
+	WorkspaceID string `json:"workspaceId"`
+}
+type Quantity struct {
+	Kind        string `json:"kind"`
+	CPUMillis   int64  `json:"cpuMillis"`
+	MemoryBytes int64  `json:"memoryBytes"`
+}
+type Sample struct {
+	Resource           Identity
+	Quantity           Quantity
+	Incarnation, State string
+	At, StartedAt      int64
+	Clock              time.Time
+}
+type Event struct {
+	EventID      string   `json:"eventId"`
+	Sequence     uint64   `json:"sequence,string"`
+	Previous     uint64   `json:"previousSequence,string"`
+	Resource     Identity `json:"resource"`
+	Quantity     Quantity `json:"quantity"`
+	Incarnation  string   `json:"incarnation"`
+	State        string   `json:"state"`
+	ObservedAt   string   `json:"observedAt"`
+	OccurredAt   *string  `json:"occurredAt"`
+	SourceBootID string   `json:"sourceBootId"`
+	GapReason    string   `json:"gapReason,omitempty"`
+}
+type Page struct {
+	Epoch   string  `json:"epoch"`
+	Low     uint64  `json:"low,string"`
+	High    uint64  `json:"high,string"`
+	Next    uint64  `json:"next,string"`
+	Gap     bool    `json:"gap"`
+	HasMore bool    `json:"hasMore"`
+	Events  []Event `json:"events"`
+}
+type observation struct {
+	clock  time.Time
+	at     int64
+	failed bool
+}
+type Journal struct {
+	db            Database
+	BootID, Epoch string
+	mu            sync.Mutex
+	changed       chan struct{}
+	observed      map[string]observation
+}
+
+var root = []byte("pi-cloud.lifecycle.v1")
+var current = []byte("current")
+var history = []byte("history")
+
+const maxEvents = 100000
+const maxAge = 7 * 24 * time.Hour
+
+func key(v uint64) []byte { b := make([]byte, 8); binary.BigEndian.PutUint64(b, v); return b }
+func (j *Journal) MarkGap(id string) {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	if id != "" {
+		old := j.observed[id]
+		old.failed = true
+		j.observed[id] = old
+		return
+	}
+	for id, old := range j.observed {
+		old.failed = true
+		j.observed[id] = old
+	}
+}
+
+func New(db Database, bootID string) (*Journal, error) {
+	j := &Journal{db: db, BootID: bootID, changed: make(chan struct{}), observed: map[string]observation{}}
+	err := db.Update(func(tx *bolt.Tx) error {
+		if tx.DB().NoSync {
+			return errors.New("lifecycle history requires synchronous metadata")
+		}
+		b, e := tx.CreateBucketIfNotExists(root)
+		if e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(current); e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(history); e != nil {
+			return e
+		}
+		if b.Get([]byte("epoch")) == nil {
+			if e = b.Put([]byte("epoch"), []byte(uuid.NewString())); e != nil {
+				return e
+			}
+		}
+		j.Epoch = string(b.Get([]byte("epoch")))
+		// Matched development cutover: the old compute interval producer is gone.
+		// Workspace quota collection uses its own database and is unaffected.
+		if tx.Bucket([]byte("pi-cloud.resource-usage.v1")) != nil {
+			return tx.DeleteBucket([]byte("pi-cloud.resource-usage.v1"))
+		}
+		return nil
+	})
+	return j, err
+}
+func (j *Journal) Cursors() ([]Event, error) {
+	result := []Event{}
+	err := j.db.View(func(tx *bolt.Tx) error {
+		return tx.Bucket(root).Bucket(current).ForEach(func(_, v []byte) error {
+			var e Event
+			if err := json.Unmarshal(v, &e); err != nil {
+				return err
+			}
+			result = append(result, e)
+			return nil
+		})
+	})
+	return result, err
+}
+func (j *Journal) Capture(s Sample) error {
+	if s.Resource.Kind != "compute" || s.Resource.ResourceID == "" || s.Incarnation == "" || s.At <= 0 || s.Clock.IsZero() || s.Quantity.CPUMillis <= 0 || s.Quantity.MemoryBytes <= 0 {
+		return errors.New("invalid lifecycle observation")
+	}
+	for _, id := range []string{s.Resource.ResourceID, s.Resource.TenantID, s.Resource.WorkspaceID} {
+		if _, err := uuid.Parse(id); err != nil {
+			return err
+		}
+	}
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	prior := j.observed[s.Resource.ResourceID]
+	gap := ""
+	if prior.failed {
+		gap = "collection_unavailable"
+	}
+	if !prior.clock.IsZero() {
+		wall := s.At - prior.at
+		elapsed := s.Clock.Sub(prior.clock).Milliseconds()
+		if wall-elapsed > 1000 || elapsed-wall > 1000 {
+			gap = "clock_changed"
+		}
+	}
+	written := false
+	err := j.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(root)
+		cb, hb := b.Bucket(current), b.Bucket(history)
+		var previous Event
+		if raw := cb.Get([]byte(s.Resource.ResourceID)); raw != nil {
+			if err := json.Unmarshal(raw, &previous); err != nil {
+				return err
+			}
+			if previous.Resource != s.Resource {
+				return errors.New("lifecycle resource identity changed")
+			}
+			if previous.State == "absent" && s.State != "absent" {
+				return errors.New("closed allocation reappeared")
+			}
+			if previous.SourceBootID != j.BootID {
+				gap = "source_restarted"
+			}
+			if gap == "" && previous.State == s.State && s.State == "absent" && previous.Incarnation == s.Incarnation && previous.Quantity == s.Quantity {
+				return nil
+			}
+		}
+		seq, err := hb.NextSequence()
+		if err != nil {
+			return err
+		}
+		event := Event{EventID: uuid.NewString(), Sequence: seq, Previous: previous.Sequence, Resource: s.Resource, Quantity: s.Quantity,
+			Incarnation: s.Incarnation, State: s.State, ObservedAt: time.UnixMilli(s.At).UTC().Format("2006-01-02T15:04:05.000Z"), SourceBootID: j.BootID, GapReason: gap}
+		// Native StartedAt/FinishedAt include restoration and packaging transitions.
+		// They are not exported as verified physical occurrence timestamps.
+		data, err := json.Marshal(event)
+		if err != nil {
+			return err
+		}
+		if err = hb.Put(key(seq), data); err != nil {
+			return err
+		}
+		if err = cb.Put([]byte(s.Resource.ResourceID), data); err != nil {
+			return err
+		}
+		cutoff := s.Clock.Add(-maxAge)
+		cursor := hb.Cursor()
+		for n := 0; n < 128; n++ {
+			k, v := cursor.First()
+			if k == nil {
+				break
+			}
+			var old Event
+			if err = json.Unmarshal(v, &old); err != nil {
+				return err
+			}
+			at, _ := time.Parse(time.RFC3339Nano, old.ObservedAt)
+			if seq-binary.BigEndian.Uint64(k) < maxEvents && !at.Before(cutoff) {
+				break
+			}
+			if err = cursor.Delete(); err != nil {
+				return err
+			}
+			if old.State == "absent" && at.Before(cutoff) {
+				var latest Event
+				_ = json.Unmarshal(cb.Get([]byte(old.Resource.ResourceID)), &latest)
+				if latest.Sequence == old.Sequence {
+					if err = cb.Delete([]byte(old.Resource.ResourceID)); err != nil {
+						return err
+					}
+				}
+			}
+		}
+		written = true
+		return nil
+	})
+	j.observed[s.Resource.ResourceID] = observation{clock: s.Clock, at: s.At, failed: err != nil}
+	if written && err == nil {
+		close(j.changed)
+		j.changed = make(chan struct{})
+	}
+	if s.State == "absent" && err == nil {
+		delete(j.observed, s.Resource.ResourceID)
+	}
+	return err
+}
+func (j *Journal) History(ctx context.Context, epoch string, after uint64, limit int, wait time.Duration) (Page, error) {
+	if limit < 1 || limit > 256 || wait < 0 || wait > 20*time.Second {
+		return Page{}, errors.New("invalid lifecycle page")
+	}
+	j.mu.Lock()
+	changed := j.changed
+	j.mu.Unlock()
+	read := func() (Page, error) {
+		page := Page{Epoch: j.Epoch, Events: []Event{}, Next: after}
+		err := j.db.View(func(tx *bolt.Tx) error {
+			hb := tx.Bucket(root).Bucket(history)
+			page.High = hb.Sequence()
+			c := hb.Cursor()
+			k, _ := c.First()
+			page.Low = page.High + 1
+			if k != nil {
+				page.Low = binary.BigEndian.Uint64(k)
+			}
+			page.Gap = (epoch != "" && epoch != j.Epoch) || after+1 < page.Low || after > page.High
+			start := after + 1
+			if page.Gap {
+				start = page.Low
+				page.Next = start - 1
+			}
+			for k, v := c.Seek(key(start)); k != nil && len(page.Events) < limit; k, v = c.Next() {
+				var event Event
+				if e := json.Unmarshal(v, &event); e != nil {
+					return e
+				}
+				page.Events = append(page.Events, event)
+				page.Next = event.Sequence
+			}
+			page.HasMore = page.Next < page.High
+			return nil
+		})
+		return page, err
+	}
+	page, err := read()
+	if err != nil || len(page.Events) > 0 || page.Gap || wait == 0 {
+		return page, err
+	}
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case <-changed:
+	case <-timer.C:
+	case <-ctx.Done():
+		return Page{}, ctx.Err()
+	}
+	return read()
+}
