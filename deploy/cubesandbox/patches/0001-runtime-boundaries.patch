+
+func pauseClosureFixture(t *testing.T) (*gomonkey.Patches, *allocation.Record) {
+	t.Helper()
+	p := gomonkey.NewPatches()
+	t.Cleanup(p.Reset)
+	p.ApplyFunc(sandboxlock.WithLock, func(ctx context.Context, _ string, _ sandboxlock.Options, fn func(context.Context) error) error {
+		return fn(ctx)
+	})
+	r := &allocation.Record{ID: "10000000-0000-4000-8000-000000000001", SandboxID: "10000000000040008000000000000001", NodeID: "node-1", NodeIP: "10.0.0.8", Closed: true, Phase: "absent"}
+	return p, r
+}
+
+func TestManagedAbsenceCleansPauseOnRecordedNodeCurrentAddress(t *testing.T) {
+	p, r := pauseClosureFixture(t)
+	removed := false
+	p.ApplyFunc(pausesnap.GetBySandbox, func(context.Context, string) (*pausesnap.Record, error) {
+		if removed {
+			return nil, pausesnap.ErrNotFound
+		}
+		return &pausesnap.Record{NodeID: r.NodeID, SnapshotID: "snap-owned"}, nil
+	})
+	p.ApplyFunc(localcache.GetNode, func(id string) (*node.Node, bool) {
+		require.Equal(t, r.NodeID, id)
+		return &node.Node{InsID: r.NodeID, IP: "10.0.0.9", Healthy: true}, true
+	})
+	p.ApplyFunc(pausesnap.TryDeletePausedOnNode, func(_ context.Context, _ string, sandbox, nodeID, address string) (bool, error) {
+		require.Equal(t, r.SandboxID, sandbox)
+		require.Equal(t, r.NodeID, nodeID)
+		require.Equal(t, "10.0.0.9", address)
+		removed = true
+		return true, nil
+	})
+	require.NoError(t, cleanupManagedPauseSnapshot(context.Background(), r))
+	require.True(t, removed)
+}
+
+func TestManagedAbsenceDoesNotFollowAnotherNode(t *testing.T) {
+	p, r := pauseClosureFixture(t)
+	p.ApplyFunc(pausesnap.GetBySandbox, func(context.Context, string) (*pausesnap.Record, error) {
+		return &pausesnap.Record{NodeID: "different", SnapshotID: "snap-owned"}, nil
+	})
+	p.ApplyFunc(pausesnap.TryDeletePausedOnNode, func(context.Context, string, string, string, string) (bool, error) {
+		t.Fatal("wrong node cleanup attempted")
+		return false, nil
+	})
+	require.ErrorContains(t, cleanupManagedPauseSnapshot(context.Background(), r), "identity is unconfirmed")
+}
+
+func TestPreviouslyAbsentManagedReceiptStillFailsWhilePauseCleanupIsPending(t *testing.T) {
+	p, r := pauseClosureFixture(t)
+	failure := errors.New("pause cleanup unavailable")
+	p.ApplyFunc(allocation.Default, func() *allocation.Store { return &allocation.Store{} })
+	p.ApplyMethod(reflect.TypeOf(&allocation.Store{}), "Get", func(*allocation.Store, context.Context, string) (*allocation.Record, error) { return r, nil })
+	p.ApplyFunc(cleanupManagedPauseSnapshot, func(context.Context, *allocation.Record) error { return failure })
+	p.ApplyFunc(localcache.DeleteSandboxProxyMap, func(context.Context, string) error { t.Fatal("cleanup hooks ran before pause completion"); return nil })
+	got, err := ReconcileAllocation(context.Background(), r.ID, false, 0, false)
+	require.Same(t, r, got)
+	require.ErrorIs(t, err, failure)
+}
+
+func TestManagedAbsenceWithoutPauseNeedsNoNodeContact(t *testing.T) {
+	p, r := pauseClosureFixture(t)
+	p.ApplyFunc(pausesnap.GetBySandbox, func(context.Context, string) (*pausesnap.Record, error) { return nil, pausesnap.ErrNotFound })
+	p.ApplyFunc(localcache.GetNode, func(string) (*node.Node, bool) { t.Fatal("unneeded node lookup"); return nil, false })
+	require.NoError(t, cleanupManagedPauseSnapshot(context.Background(), r))
+}
