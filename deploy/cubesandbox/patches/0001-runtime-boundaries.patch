+)
+
+type probeDriver struct{}
+
+func (probeDriver) HasRuntime(string) bool { return true }
+
+func (probeDriver) Run(_ context.Context, r execution.Request, _ func(json.RawMessage)) execution.Result {
+	if len(r.CompletionContext) > 0 {
+		return execution.Result{Delivered: true}
+	}
+	output, _ := json.Marshal(map[string]string{"type": "worker.probe_result", "probeId": r.OperationID, "guestBootId": uuid.NewString()})
+	return execution.Result{Output: output}
+}
+
+type probeDelivery struct{}
+
+func (probeDelivery) Progress(execution.Request, json.RawMessage)                        {}
+func (probeDelivery) Deliver(context.Context, execution.Request, execution.Result) error { return nil }
+
+func TestExecutionProbesUseDirectOrGuestCallbackWithoutKafkaInCubelet(t *testing.T) {
+	s := &service{executions: execution.New(probeDriver{}, probeDelivery{})}
+	defer s.executions.Close()
+	req := &api.ExecutionProbeRequest{SandboxId: "vm", BootId: s.executions.BootID, ProbeId: uuid.NewString()}
+	reply, err := s.ProbeExecution(context.Background(), req)
+	if err != nil || !reply.Accepted || len(reply.Output) == 0 || reply.ProbeId != req.ProbeId {
+		t.Fatalf("direct probe: %+v %v", reply, err)
+	}
+	req.RunId, req.WriterId = uuid.NewString(), uuid.NewString()
+	req.CompletionContext = []byte(`{"url":"https://completion.test/v1/completions","capability":"fixture"}`)
+	reply, err = s.ProbeExecution(context.Background(), req)
+	if err != nil || !reply.Accepted || len(reply.Output) != 0 {
+		t.Fatalf("Guest callback admission: %+v %v", reply, err)
+	}
+	req.CompletionContext = nil
+	req.BootId = uuid.NewString()
+	reply, err = s.ProbeExecution(context.Background(), req)
+	if err != nil || reply.Accepted || reply.Rejection != "executor_replaced" {
+		t.Fatalf("replacement: %+v %v", reply, err)
+	}
+}
+
+func TestExecutionAdvertisesMatchedProtocol(t *testing.T) {
+	s := &service{executions: execution.New(probeDriver{}, probeDelivery{})}
+	defer s.executions.Close()
+	capabilities, err := s.ExecutionCapabilities(context.Background(), &api.ExecutionCapabilitiesRequest{SandboxId: "vm"})
+	if err != nil || capabilities.ProtocolVersion != 9 {
+		t.Fatalf("capabilities: %+v %v", capabilities, err)
+	}
+}
diff --git a/Cubelet/services/cubebox/lifecycle_history.go b/Cubelet/services/cubebox/lifecycle_history.go
new file mode 100644
index 0000000..43bd097
--- /dev/null
+++ b/Cubelet/services/cubebox/lifecycle_history.go
@@ -0,0 +1,264 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package cubebox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	containerd "github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/lifecyclejournal"
+	cubeboxstore "github.com/tencentcloud/CubeSandbox/Cubelet/pkg/store/cubebox"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/cube/internals/cubes"
+	"github.com/tencentcloud/CubeSandbox/pkgs/CubeLog"
+	cubebox "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	"math"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type lifecycleHistory struct {
+	service         *service
+	journal         *lifecyclejournal.Journal
+	wake            chan struct{}
+	mu              sync.Mutex
+	lifecycle       map[string]string
+	captureFailures atomic.Uint64
+	completedCycles atomic.Uint64
+	collectionMu    sync.Mutex
+}
+
+func (s *service) startLifecycleHistory(ctx context.Context, db lifecyclejournal.Database) error {
+	journal, err := lifecyclejournal.New(db, s.allocations.BootID)
+	if err != nil {
+		return err
+	}
+	history := &lifecycleHistory{service: s, journal: journal, wake: make(chan struct{}, 1), lifecycle: map[string]string{}}
+	s.lifecycleHistory.Store(history)
+	_ = prometheus.Register(prometheus.NewCounterFunc(prometheus.CounterOpts{Name: "picloud_lifecycle_collection_cycles_total", Help: "Complete raw lifecycle capture sweeps, without pricing or delivery.", ConstLabels: prometheus.Labels{"source_id": journal.Epoch, "boot_id": journal.BootID}}, func() float64 { return float64(history.completedCycles.Load()) }))
+	_ = prometheus.Register(prometheus.NewCounterFunc(prometheus.CounterOpts{Name: "picloud_lifecycle_capture_failures_total", Help: "Lifecycle evidence capture failures; never authority for physical cleanup."}, func() float64 { return float64(history.captureFailures.Load()) }))
+	if registry, ok := s.cubeboxMgr.cubeboxManger.(cubes.CubeboxEventListenerRegistry); ok {
+		registry.Register(history)
+	}
+	go history.collectLoop(ctx)
+	return nil
+}
+func (m *lifecycleHistory) OnCubeboxEvent(_ context.Context, event *cubes.CubeboxEvent) error {
+	if event == nil || event.Cubebox == nil {
+		return nil
+	}
+	box := event.Cubebox
+	box.MetaLock.Lock()
+	id := box.Annotations["pi-cloud.allocation.id"]
+	managed := box.Labels["picloud.managed"] == "true"
+	box.MetaLock.Unlock()
+	if !managed || id == "" {
+		return nil
+	}
+	main := box.MainStatus()
+	if main == nil {
+		return nil
+	}
+	status := main.Get()
+	signature := fmt.Sprintf("%d/%d/%d/%d/%d", status.State(), status.StartedAt, status.FinishedAt, status.PausedAt, status.PausingAt)
+	m.mu.Lock()
+	previous := m.lifecycle[box.ID]
+	m.lifecycle[box.ID] = signature
+	m.mu.Unlock()
+	if previous != signature {
+		// A coalesced hint may cover several transitions. Do not invent continuous
+		// running across a lost intermediate pause/resume.
+		if previous != "" {
+			m.journal.MarkGap(id)
+		}
+		select {
+		case m.wake <- struct{}{}:
+		default:
+		}
+	}
+	return nil
+}
+
+// Meter the accepted workload allocation, excluding host/VMM overhead and
+// snapshot rounding. Actual physical running evidence is sampled separately.
+func declaredComputeQuantity(box *cubeboxstore.CubeBox) (lifecyclejournal.Quantity, bool) {
+	result := lifecyclejournal.Quantity{Kind: "compute"}
+	for _, container := range box.AllContainers() {
+		container.MetaLock.Lock()
+		requested := container.Config.GetResources()
+		cpu, cpuErr := resource.ParseQuantity(requested.GetCpu())
+		memory, memErr := resource.ParseQuantity(requested.GetMem())
+		container.MetaLock.Unlock()
+		if cpuErr != nil || memErr != nil || cpu.Sign() <= 0 || memory.Sign() <= 0 {
+			return result, false
+		}
+		cores, bytes := cpu.MilliValue(), memory.Value()
+		if cores <= 0 || bytes <= 0 || cores > math.MaxInt64-result.CPUMillis || bytes > math.MaxInt64-result.MemoryBytes {
+			return result, false
+		}
+		result.CPUMillis += cores
+		result.MemoryBytes += bytes
+	}
+	return result, result.CPUMillis > 0 && result.MemoryBytes > 0
+}
+
+func (m *lifecycleHistory) sample(ctx context.Context, box *cubeboxstore.CubeBox, now time.Time) (lifecyclejournal.Sample, bool) {
+	box.MetaLock.Lock()
+	labels := box.Labels
+	identity := lifecyclejournal.Identity{Kind: "compute", ResourceID: box.Annotations["pi-cloud.allocation.id"], TenantID: labels["picloud.tenant_id"], WorkspaceID: labels["picloud.workspace_id"]}
+	managed := labels["picloud.managed"] == "true"
+	box.MetaLock.Unlock()
+	quantity, validQuantity := declaredComputeQuantity(box)
+	if !validQuantity || !managed || identity.ResourceID == "" || allocation.SandboxID(identity.ResourceID) != box.ID || identity.TenantID == "" || identity.WorkspaceID == "" || quantity.CPUMillis <= 0 || quantity.MemoryBytes <= 0 {
+		return lifecyclejournal.Sample{}, false
+	}
+	main := box.MainStatus()
+	if main == nil {
+		return lifecyclejournal.Sample{}, false
+	}
+	status := main.Get()
+	observation := lifecyclejournal.Sample{Resource: identity, Quantity: quantity, Incarnation: fmt.Sprint(status.StartedAt), At: now.UnixMilli(), StartedAt: status.StartedAt / int64(time.Millisecond), State: "unknown"}
+	switch status.State() {
+	case cubebox.ContainerState_CONTAINER_RUNNING:
+		// Cached lifecycle state alone is insufficient to accrue another interval.
+		first := box.FirstContainer()
+		if first == nil || first.Container == nil {
+			return observation, true
+		}
+		scope, cancel := context.WithTimeout(namespaces.WithNamespace(ctx, box.Namespace), 2*time.Second)
+		defer cancel()
+		task, err := first.Container.Task(scope, nil)
+		if err != nil {
+			return observation, true
+		}
+		physical, err := task.Status(scope)
+		if err == nil && physical.Status == containerd.Running && !status.RollingBack {
+			observation.State = "running"
+		}
+	case cubebox.ContainerState_CONTAINER_PAUSED:
+		observation.State = "paused"
+		// PausedAt is written after snapshot packaging; the VM stopped earlier.
+		// Without the exact physical stop time, the trailing interval is unknown.
+		// Later paused samples consume no compute time.
+
+	case cubebox.ContainerState_CONTAINER_EXITED:
+		observation.State = "absent"
+		// FinishedAt also contains recovery/TaskOOM observation times. It has
+		// no provenance proving the actual exit instant, so keep the tail unknown.
+	}
+	return observation, true
+}
+
+func (m *lifecycleHistory) collect(ctx context.Context) {
+	m.collectionMu.Lock()
+	defer m.collectionMu.Unlock()
+	now := time.Now()
+	known, err := m.journal.Cursors()
+	if err != nil {
+		m.captureFailures.Add(1)
+		m.journal.MarkGap("")
+		CubeLog.Warn("Lifecycle history cursor read unavailable")
+		return
+	}
+	observed := map[string]lifecyclejournal.Sample{}
+	present := map[string]bool{}
+	complete := true
+	for _, box := range m.service.cubeboxMgr.cubeboxManger.List() {
+		present[box.ID] = true
+		sample, ok := m.sample(ctx, box, now)
+		if ok {
+			observed[sample.Resource.ResourceID] = sample
+		} else {
+			box.MetaLock.Lock()
+			managed := box.Labels["picloud.managed"] == "true" && box.Annotations["pi-cloud.allocation.id"] != ""
+			box.MetaLock.Unlock()
+			if managed {
+				complete = false
+			}
+		}
+	}
+	m.mu.Lock()
+	for id := range m.lifecycle {
+		if !present[id] {
+			delete(m.lifecycle, id)
+		}
+	}
+	m.mu.Unlock()
+	for _, cursor := range known {
+		if _, ok := observed[cursor.Resource.ResourceID]; ok {
+			continue
+		}
+		if cursor.State == "absent" {
+			continue
+		}
+		scope, cancel := context.WithTimeout(ctx, 2*time.Second)
+		_, err := m.service.cubeboxMgr.cubeboxManger.Observe(scope, allocation.SandboxID(cursor.Resource.ResourceID))
+		cancel()
+		state := "unknown"
+		if errors.Is(err, utils.ErrorKeyNotFound) {
+			state = "absent"
+		}
+		observed[cursor.Resource.ResourceID] = lifecyclejournal.Sample{Resource: cursor.Resource, Quantity: cursor.Quantity, Incarnation: cursor.Incarnation, At: now.UnixMilli(), State: state}
+	}
+	failed := false
+	for id, sample := range observed {
+		if sample.State == "unknown" {
+			complete = false
+		}
+		sample.Clock = now
+		if err := m.journal.Capture(sample); err != nil {
+			failed = true
+			continue
+		}
+		if sample.State == "absent" {
+			m.mu.Lock()
+			delete(m.lifecycle, allocation.SandboxID(id))
+			m.mu.Unlock()
+		}
+	}
+	if failed {
+		m.captureFailures.Add(1)
+		CubeLog.Warn("Lifecycle history capture deferred; physical cleanup remains available")
+	}
+	if complete && !failed {
+		m.completedCycles.Add(1)
+	}
+}
+
+func (m *lifecycleHistory) collectLoop(ctx context.Context) {
+	ticker := time.NewTicker(30 * time.Second)
+	defer ticker.Stop()
+	m.collect(ctx)
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			m.collect(ctx)
+		case <-m.wake:
+			m.collect(ctx)
+		}
+	}
+}
+func (s *service) ReadLifecycle(ctx context.Context, r *cubebox.LifecycleHistoryRequest) (*cubebox.LifecycleHistoryResponse, error) {
+	history := s.lifecycleHistory.Load()
+	if history == nil {
+		return nil, errors.New("lifecycle history unavailable")
+	}
+	page, err := history.journal.History(ctx, r.Epoch, r.After, int(r.Limit), time.Duration(r.WaitMs)*time.Millisecond)
+	if err != nil {
+		return nil, err
+	}
+	body, err := json.Marshal(page)
+	if err != nil {
+		return nil, err
+	}
+	return &cubebox.LifecycleHistoryResponse{Page: body}, nil
+}
