@@ -0,0 +1,36 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"testing"
+)
+
+func TestCancellationFramePreservesRequestAndResultReceipt(t *testing.T) {
+	ready, complete, interrupt := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	in, stop := executionInput(context.Background(), ready, complete, []byte(`{"mode":"operation"}`), "op", interrupt)
+	defer stop()
+	scan := bufio.NewScanner(in)
+	close(interrupt) // cancellation may precede guest readiness
+	close(ready)
+	if !scan.Scan() || scan.Text() != `{"mode":"operation"}` {
+		t.Fatal("request missing")
+	}
+	if !scan.Scan() {
+		t.Fatal("cancel frame missing")
+	}
+	var v map[string]string
+	if json.Unmarshal(scan.Bytes(), &v) != nil || v["type"] != "scope.cancel" || v["operationId"] != "op" {
+		t.Fatal("invalid control frame")
+	}
+	close(complete)
+	if !scan.Scan() || scan.Text() != `{"type":"scope.received"}` {
+		t.Fatal("final result receipt lost")
+	}
+	if scan.Scan() {
+		t.Fatal("unexpected extra frame")
+	}
+}
diff --git a/Cubelet/pkg/lifecyclejournal/journal.go b/Cubelet/pkg/lifecyclejournal/journal.go
new file mode 100644
index 0000000..9990fa9
--- /dev/null
+++ b/Cubelet/pkg/lifecyclejournal/journal.go
@@ -0,0 +1,296 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+// Package lifecyclejournal retains raw provider facts, never priced usage.
+package lifecyclejournal
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"github.com/google/uuid"
+	bolt "go.etcd.io/bbolt"
+	"sync"
+	"time"
+)
+
+type Database interface {
+	Update(func(*bolt.Tx) error) error
+	View(func(*bolt.Tx) error) error
+}
+type Identity struct {
+	Kind        string `json:"kind"`
+	ResourceID  string `json:"resourceId"`
+	TenantID    string `json:"tenantId"`
+	WorkspaceID string `json:"workspaceId"`
+}
+type Quantity struct {
+	Kind        string `json:"kind"`
+	CPUMillis   int64  `json:"cpuMillis"`
+	MemoryBytes int64  `json:"memoryBytes"`
+}
+type Sample struct {
+	Resource           Identity
+	Quantity           Quantity
+	Incarnation, State string
+	At, StartedAt      int64
+	Clock              time.Time
+}
+type Event struct {
+	EventID      string   `json:"eventId"`
+	Sequence     uint64   `json:"sequence,string"`
+	Previous     uint64   `json:"previousSequence,string"`
+	Resource     Identity `json:"resource"`
+	Quantity     Quantity `json:"quantity"`
+	Incarnation  string   `json:"incarnation"`
+	State        string   `json:"state"`
+	ObservedAt   string   `json:"observedAt"`
+	OccurredAt   *string  `json:"occurredAt"`
+	SourceBootID string   `json:"sourceBootId"`
+	GapReason    string   `json:"gapReason,omitempty"`
+}
+type Page struct {
+	Epoch   string  `json:"epoch"`
+	Low     uint64  `json:"low,string"`
+	High    uint64  `json:"high,string"`
+	Next    uint64  `json:"next,string"`
+	Gap     bool    `json:"gap"`
+	HasMore bool    `json:"hasMore"`
+	Events  []Event `json:"events"`
+}
+type observation struct {
+	clock  time.Time
+	at     int64
+	failed bool
+}
+type Journal struct {
+	db            Database
+	BootID, Epoch string
+	mu            sync.Mutex
+	changed       chan struct{}
+	observed      map[string]observation
+}
+
+var root = []byte("pi-cloud.lifecycle.v1")
+var current = []byte("current")
+var history = []byte("history")
+
+const maxEvents = 100000
+const maxAge = 7 * 24 * time.Hour
+
+func key(v uint64) []byte { b := make([]byte, 8); binary.BigEndian.PutUint64(b, v); return b }
+func (j *Journal) MarkGap(id string) {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	if id != "" {
+		old := j.observed[id]
+		old.failed = true
+		j.observed[id] = old
+		return
+	}
+	for id, old := range j.observed {
+		old.failed = true
+		j.observed[id] = old
+	}
+}
+
+func New(db Database, bootID string) (*Journal, error) {
+	j := &Journal{db: db, BootID: bootID, changed: make(chan struct{}), observed: map[string]observation{}}
+	err := db.Update(func(tx *bolt.Tx) error {
+		if tx.DB().NoSync {
+			return errors.New("lifecycle history requires synchronous metadata")
+		}
+		b, e := tx.CreateBucketIfNotExists(root)
+		if e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(current); e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(history); e != nil {
+			return e
+		}
+		if b.Get([]byte("epoch")) == nil {
+			if e = b.Put([]byte("epoch"), []byte(uuid.NewString())); e != nil {
+				return e
+			}
+		}
+		j.Epoch = string(b.Get([]byte("epoch")))
+		// Matched development cutover: the old compute interval producer is gone.
+		// Workspace quota collection uses its own database and is unaffected.
+		if tx.Bucket([]byte("pi-cloud.resource-usage.v1")) != nil {
+			return tx.DeleteBucket([]byte("pi-cloud.resource-usage.v1"))
+		}
+		return nil
+	})
+	return j, err
+}
+func (j *Journal) Cursors() ([]Event, error) {
+	result := []Event{}
+	err := j.db.View(func(tx *bolt.Tx) error {
+		return tx.Bucket(root).Bucket(current).ForEach(func(_, v []byte) error {
+			var e Event
+			if err := json.Unmarshal(v, &e); err != nil {
+				return err
+			}
+			result = append(result, e)
+			return nil
+		})
+	})
+	return result, err
+}
+func (j *Journal) Capture(s Sample) error {
+	if s.Resource.Kind != "compute" || s.Resource.ResourceID == "" || s.Incarnation == "" || s.At <= 0 || s.Clock.IsZero() || s.Quantity.CPUMillis <= 0 || s.Quantity.MemoryBytes <= 0 {
+		return errors.New("invalid lifecycle observation")
+	}
+	for _, id := range []string{s.Resource.ResourceID, s.Resource.TenantID, s.Resource.WorkspaceID} {
+		if _, err := uuid.Parse(id); err != nil {
+			return err
+		}
+	}
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	prior := j.observed[s.Resource.ResourceID]
+	gap := ""
+	if prior.failed {
+		gap = "collection_unavailable"
+	}
+	if !prior.clock.IsZero() {
+		wall := s.At - prior.at
+		elapsed := s.Clock.Sub(prior.clock).Milliseconds()
+		if wall-elapsed > 1000 || elapsed-wall > 1000 {
+			gap = "clock_changed"
+		}
+	}
+	written := false
+	err := j.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(root)
+		cb, hb := b.Bucket(current), b.Bucket(history)
+		var previous Event
+		if raw := cb.Get([]byte(s.Resource.ResourceID)); raw != nil {
+			if err := json.Unmarshal(raw, &previous); err != nil {
+				return err
+			}
+			if previous.Resource != s.Resource {
+				return errors.New("lifecycle resource identity changed")
+			}
+			if previous.State == "absent" && s.State != "absent" {
+				return errors.New("closed allocation reappeared")
+			}
+			if previous.SourceBootID != j.BootID {
+				gap = "source_restarted"
+			}
+			if gap == "" && previous.State == s.State && s.State == "absent" && previous.Incarnation == s.Incarnation && previous.Quantity == s.Quantity {
+				return nil
+			}
+		}
+		seq, err := hb.NextSequence()
+		if err != nil {
+			return err
+		}
+		event := Event{EventID: uuid.NewString(), Sequence: seq, Previous: previous.Sequence, Resource: s.Resource, Quantity: s.Quantity,
+			Incarnation: s.Incarnation, State: s.State, ObservedAt: time.UnixMilli(s.At).UTC().Format("2006-01-02T15:04:05.000Z"), SourceBootID: j.BootID, GapReason: gap}
+		// Native StartedAt/FinishedAt include restoration and packaging transitions.
+		// They are not exported as verified physical occurrence timestamps.
+		data, err := json.Marshal(event)
+		if err != nil {
+			return err
+		}
+		if err = hb.Put(key(seq), data); err != nil {
+			return err
+		}
+		if err = cb.Put([]byte(s.Resource.ResourceID), data); err != nil {
+			return err
+		}
+		cutoff := s.Clock.Add(-maxAge)
+		cursor := hb.Cursor()
+		for n := 0; n < 128; n++ {
+			k, v := cursor.First()
+			if k == nil {
+				break
+			}
+			var old Event
+			if err = json.Unmarshal(v, &old); err != nil {
+				return err
+			}
+			at, _ := time.Parse(time.RFC3339Nano, old.ObservedAt)
+			if seq-binary.BigEndian.Uint64(k) < maxEvents && !at.Before(cutoff) {
+				break
+			}
+			if err = cursor.Delete(); err != nil {
+				return err
+			}
+			if old.State == "absent" && at.Before(cutoff) {
+				var latest Event
+				_ = json.Unmarshal(cb.Get([]byte(old.Resource.ResourceID)), &latest)
+				if latest.Sequence == old.Sequence {
+					if err = cb.Delete([]byte(old.Resource.ResourceID)); err != nil {
+						return err
+					}
+				}
+			}
+		}
+		written = true
+		return nil
+	})
+	j.observed[s.Resource.ResourceID] = observation{clock: s.Clock, at: s.At, failed: err != nil}
+	if written && err == nil {
+		close(j.changed)
+		j.changed = make(chan struct{})
+	}
+	if s.State == "absent" && err == nil {
+		delete(j.observed, s.Resource.ResourceID)
+	}
+	return err
+}
+func (j *Journal) History(ctx context.Context, epoch string, after uint64, limit int, wait time.Duration) (Page, error) {
+	if limit < 1 || limit > 256 || wait < 0 || wait > 20*time.Second {
+		return Page{}, errors.New("invalid lifecycle page")
+	}
+	j.mu.Lock()
+	changed := j.changed
+	j.mu.Unlock()
+	read := func() (Page, error) {
+		page := Page{Epoch: j.Epoch, Events: []Event{}, Next: after}
+		err := j.db.View(func(tx *bolt.Tx) error {
+			hb := tx.Bucket(root).Bucket(history)
+			page.High = hb.Sequence()
+			c := hb.Cursor()
+			k, _ := c.First()
+			page.Low = page.High + 1
+			if k != nil {
+				page.Low = binary.BigEndian.Uint64(k)
+			}
+			page.Gap = (epoch != "" && epoch != j.Epoch) || after+1 < page.Low || after > page.High
+			start := after + 1
+			if page.Gap {
+				start = page.Low
+				page.Next = start - 1
+			}
+			for k, v := c.Seek(key(start)); k != nil && len(page.Events) < limit; k, v = c.Next() {
+				var event Event
+				if e := json.Unmarshal(v, &event); e != nil {
+					return e
+				}
+				page.Events = append(page.Events, event)
+				page.Next = event.Sequence
+			}
+			page.HasMore = page.Next < page.High
+			return nil
+		})
+		return page, err
+	}
+	page, err := read()
+	if err != nil || len(page.Events) > 0 || page.Gap || wait == 0 {
+		return page, err
+	}
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case <-changed:
+	case <-timer.C:
+	case <-ctx.Done():
+		return Page{}, ctx.Err()
+	}
+	return read()
+}
diff --git a/Cubelet/pkg/lifecyclejournal/journal_test.go b/Cubelet/pkg/lifecyclejournal/journal_test.go
new file mode 100644
index 0000000..b7bff7e
--- /dev/null
+++ b/Cubelet/pkg/lifecyclejournal/journal_test.go
@@ -0,0 +1,98 @@
+package lifecyclejournal
+
+import (
+	"context"
+	"github.com/google/uuid"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func fixture(t *testing.T) (*bolt.DB, *Journal, Sample) {
+	t.Helper()
+	db, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	j, err := New(db, "boot-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	return db, j, Sample{Resource: Identity{Kind: "compute", ResourceID: uuid.NewString(), TenantID: uuid.NewString(), WorkspaceID: uuid.NewString()},
+		Quantity: Quantity{Kind: "compute", CPUMillis: 2000, MemoryBytes: 2 << 30}, Incarnation: "vm-1", State: "running", At: now.UnixMilli(), Clock: now}
+}
+func TestHistoryReconnectRetainsOrderAndMarksRestart(t *testing.T) {
+	db, j, s := fixture(t)
+	if err := j.Capture(s); err != nil {
+		t.Fatal(err)
+	}
+	first, err := j.History(context.Background(), "", 0, 128, 0)
+	if err != nil || len(first.Events) != 1 || first.Gap {
+		t.Fatal(first, err)
+	}
+	restarted, err := New(db, "boot-b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.At += 30000
+	s.Clock = s.Clock.Add(30 * time.Second)
+	if err = restarted.Capture(s); err != nil {
+		t.Fatal(err)
+	}
+	next, err := restarted.History(context.Background(), first.Epoch, first.Next, 128, 0)
+	if err != nil || next.Epoch != first.Epoch || len(next.Events) != 1 || next.Events[0].Previous != first.Next || next.Events[0].GapReason != "source_restarted" {
+		t.Fatal(next, err)
+	}
+}
+func TestHintsAndClockDiscontinuityDoNotInventContinuousCoverage(t *testing.T) {
+	_, j, s := fixture(t)
+	_ = j.Capture(s)
+	j.MarkGap(s.Resource.ResourceID)
+	s.At += 30000
+	s.Clock = s.Clock.Add(30 * time.Second)
+	_ = j.Capture(s)
+	s.At -= 5000
+	s.Clock = s.Clock.Add(time.Second)
+	_ = j.Capture(s)
+	page, err := j.History(context.Background(), j.Epoch, 0, 128, 0)
+	if err != nil || len(page.Events) != 3 || page.Events[1].GapReason != "collection_unavailable" || page.Events[2].GapReason != "clock_changed" {
+		t.Fatal(page, err)
+	}
+}
+func TestRetentionAndReplacedMetadataDeclareGaps(t *testing.T) {
+	_, j, s := fixture(t)
+	_ = j.Capture(s)
+	s.At += int64((8 * 24 * time.Hour) / time.Millisecond)
+	s.Clock = s.Clock.Add(8 * 24 * time.Hour)
+	_ = j.Capture(s)
+	page, err := j.History(context.Background(), j.Epoch, 0, 128, 0)
+	if err != nil || !page.Gap || page.Low != 2 || len(page.Events) != 1 {
+		t.Fatal(page, err)
+	}
+	page, err = j.History(context.Background(), "replaced-metadata", page.Next, 128, 0)
+	if err != nil || !page.Gap {
+		t.Fatal(page, err)
+	}
+}
+func TestLiveWaitUsesTheSameHistoryCursor(t *testing.T) {
+	_, j, s := fixture(t)
+	_ = j.Capture(s)
+	done := make(chan Page, 1)
+	go func() { page, _ := j.History(context.Background(), j.Epoch, 1, 128, time.Second); done <- page }()
+	s.At += 30000
+	s.Clock = s.Clock.Add(30 * time.Second)
+	if err := j.Capture(s); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case page := <-done:
+		if len(page.Events) != 1 || page.Next != 2 {
+			t.Fatal(page)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("live/history handoff lost the observation")
+	}
+}
diff --git a/Cubelet/plugins/cube/internals/createid/managed_resume_test.go b/Cubelet/plugins/cube/internals/createid/managed_resume_test.go
new file mode 100644
index 0000000..483092e
--- /dev/null
+++ b/Cubelet/plugins/cube/internals/createid/managed_resume_test.go
@@ -0,0 +1,39 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package createid
+
+import (
+	"context"
+	"testing"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/constants"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/workflow"
+	cubebox "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+)
+
+func TestManagedAllocationAndNativeResumeKeepTheirIdentity(t *testing.T) {
+	id := "00000000-0000-4000-8000-000000000111"
+	fixed := allocation.SandboxID(id)
+	for _, desired := range []string{"", fixed, "a-different-sandbox"} {
+		opts := &workflow.CreateContext{ReqInfo: &cubebox.RunCubeSandboxRequest{Annotations: map[string]string{
+			"pi-cloud.allocation.id":                   id,
+			"pi-cloud.allocation.sandbox-id":           fixed,
+			constants.MasterAnnotationDesiredSandboxID: desired,
+		}}}
+		err := (&local{}).Create(context.Background(), opts)
+		if desired == "a-different-sandbox" {
+			if err == nil || opts.SandboxID != "" {
+				t.Fatal("resume changed a managed allocation identity")
+			}
+		} else if err != nil || opts.SandboxID != fixed {
+			t.Fatalf("managed identity was not retained: %s %v", opts.SandboxID, err)
+		}
+	}
+	native := &workflow.CreateContext{ReqInfo: &cubebox.RunCubeSandboxRequest{Annotations: map[string]string{
+		constants.MasterAnnotationDesiredSandboxID: "native-resume-id",
+	}}}
