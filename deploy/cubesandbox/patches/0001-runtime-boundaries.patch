@@ -0,0 +1,67 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet/grpcconn"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	cubebox "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"net/http"
+	"strconv"
+	"time"
+)
+
+func handleLifecycleHistory(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	if c.Param("action") == "sources" {
+		sources := []gin.H{}
+		for _, node := range localcache.GetNodes(-1) {
+			sources = append(sources, gin.H{"nodeID": node.ID(), "available": node.Healthy})
+		}
+		c.JSON(200, gin.H{"sources": sources})
+		return
+	}
+	if c.Param("action") != "history" {
+		c.JSON(404, gin.H{"error": "unknown_lifecycle_action"})
+		return
+	}
+	var input struct {
+		NodeID string `json:"nodeID"`
+		Epoch  string `json:"epoch"`
+		After  string `json:"after"`
+		Limit  uint32 `json:"limit"`
+		WaitMS uint32 `json:"waitMs"`
+	}
+	if json.NewDecoder(c.Request.Body).Decode(&input) != nil || input.NodeID == "" || input.Limit < 1 || input.Limit > 256 || input.WaitMS > 20000 {
+		c.JSON(400, gin.H{"error": "invalid_lifecycle_request"})
+		return
+	}
+	after, err := strconv.ParseUint(input.After, 10, 64)
+	if err != nil {
+		c.JSON(400, gin.H{"error": "invalid_lifecycle_cursor"})
+		return
+	}
+	node, ok := localcache.GetNode(input.NodeID)
+	if !ok || !node.Healthy {
+		c.JSON(503, gin.H{"error": "lifecycle_source_unavailable"})
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 25*time.Second)
+	defer cancel()
+	connection, err := grpcconn.GetWorkerConn(ctx, cubelet.GetCubeletAddr(node.IP))
+	if err != nil {
+		c.JSON(503, gin.H{"error": "lifecycle_source_unavailable"})
+		return
+	}
+	defer connection.Close()
+	page, err := cubebox.NewCubeboxMgrClient(connection.Value()).ReadLifecycle(ctx, &cubebox.LifecycleHistoryRequest{Epoch: input.Epoch, After: after, Limit: input.Limit, WaitMs: input.WaitMS})
+	if err != nil {
+		c.JSON(503, gin.H{"error": "lifecycle_history_unavailable"})
+		return
+	}
+	c.Data(200, "application/json", page.Page)
+}
