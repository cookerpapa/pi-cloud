diff --git a/Cubelet/plugins/volume/reference_recovery_test.go b/Cubelet/plugins/volume/reference_recovery_test.go
new file mode 100644
index 0000000..2de73b5
--- /dev/null
+++ b/Cubelet/plugins/volume/reference_recovery_test.go
@@ -0,0 +1,190 @@
+package volume
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+type failReceiptDB struct {
+	*bolt.DB
+	fail bool
+}
+
+func (d *failReceiptDB) Update(f func(*bolt.Tx) error) error {
+	if d.fail {
+		d.fail = false
+		return errors.New("injected receipt failure")
+	}
+	return d.DB.Update(f)
+}
+
+type referencePlugin struct {
+	onAttach func() error
+	onDetach func(*DetachRequest)
+	detaches int
+}
+
+func (*referencePlugin) Name() string                             { return "test" }
+func (*referencePlugin) PluginType() PluginType                   { return PluginTypeBuiltin }
+func (*referencePlugin) Init(context.Context, PluginConfig) error { return nil }
+func (*referencePlugin) Close() error                             { return nil }
+func (p *referencePlugin) Attach(_ context.Context, r *AttachRequest) (*AttachResult, error) {
+	if p.onAttach != nil {
+		if err := p.onAttach(); err != nil {
+			return nil, err
+		}
+	}
+	return &AttachResult{VolumeID: r.VolumeID, HostPath: "/test", Metadata: map[string]string{"path": "/test"}}, nil
+}
+
+func TestFailedAttachCleanupWriteFailureRemainsVisibleAndHeld(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "refs.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	db := &failReceiptDB{DB: raw}
+	store, err := refcount.New(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	attachFailure := errors.New("Attach failed")
+	p := &referencePlugin{onAttach: func() error { db.fail = true; return attachFailure }}
+	m := &Manager{byName: map[string]VolumePlugin{"test": p}, rcStore: store}
+	_, err = m.Attach(context.Background(), &AttachRequest{Namespace: "default", VolumeID: "held", SandboxID: "a", Driver: "test"})
+	if !errors.Is(err, attachFailure) || err.Error() == attachFailure.Error() {
+		t.Fatal("lost cleanup write failure", err)
+	}
+	state, err := store.State("default", "held")
+	if err != nil || state.Count != 1 {
+		t.Fatal("lost conservative holder", state, err)
+	}
+}
+
+func TestVolumeLockWaitHonorsCancellationAndRetiresIdleLocks(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "refs.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	store, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := &Manager{rcStore: store}
+	ctx := context.Background()
+	unlock, err := m.lockVolume(ctx, "blocked")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if unlock != nil {
+			unlock()
+		}
+	}()
+	waiting, cancel := context.WithTimeout(ctx, 30*time.Millisecond)
+	defer cancel()
+	if _, err = m.ObserveReference(waiting, "default", "blocked"); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatal(err)
+	}
+	for i := 0; i < 1000; i++ {
+		if _, err = m.ObserveReference(ctx, "default", fmt.Sprintf("retired-%d", i)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if m.volMu.Len() != 1 {
+		t.Fatal("historical queries retained locks", m.volMu.Len())
+	}
+	unlock()
+	unlock = nil
+	if m.volMu.Len() != 0 {
+		t.Fatal("active lock was not released")
+	}
+}
+func (p *referencePlugin) Detach(_ context.Context, r *DetachRequest) error {
+	p.detaches++
+	if p.onDetach != nil {
+		p.onDetach(r)
+	}
+	return nil
+}
+
+func TestReferenceReconstructionAfterFirstReceiptWriteFails(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "references.db")
+	raw, err := bolt.Open(path, 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db := &failReceiptDB{DB: raw}
+	store, err := refcount.New(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &referencePlugin{}
+	m := &Manager{byName: map[string]VolumePlugin{"test": p}, rcStore: store}
+	ctx := context.Background()
+	for _, id := range []string{"a", "b"} {
+		if _, err = m.Attach(ctx, &AttachRequest{Namespace: "default", VolumeID: "shared", SandboxID: id, Driver: "test"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = m.Detach(ctx, &DetachRequest{Namespace: "default", VolumeID: "shared", SandboxID: "a", Driver: "test", Metadata: map[string]string{"path": "/test"}}); err != nil {
+		t.Fatal(err)
+	}
+	state, err := m.ObserveReference(ctx, "default", "shared")
+	if err != nil || state.Count != 1 || !state.Confirmed {
+		t.Fatal(state, err)
+	}
+	epoch := state.Epoch
+	p.onDetach = func(r *DetachRequest) {
+		if r.RefCount != 0 || r.Metadata["path"] != "/test" {
+			t.Fatal(r)
+		}
+		db.fail = true
+		p.onDetach = nil
+	}
+	if err = m.Detach(ctx, &DetachRequest{Namespace: "default", VolumeID: "shared", SandboxID: "b", Driver: "test", Metadata: map[string]string{"path": "/test"}}); err == nil {
+		t.Fatal("missing fault")
+	}
+	pending, err := store.State("default", "shared")
+	if err != nil || pending.Count != 0 || pending.Confirmed {
+		t.Fatal(pending, err)
+	}
+	if err = raw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	raw, err = bolt.Open(path, 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	store, err = refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.rcStore = store
+	state, err = m.ObserveReference(ctx, "default", "shared")
+	if err != nil || state.Count != 0 || !state.Confirmed || state.Epoch != epoch || state.Revision <= pending.Revision {
+		t.Fatal(state, err)
+	}
+	if p.detaches != 3 {
+		t.Fatal("expected one idempotent pending cleanup retry", p.detaches)
+	}
+	// The zero row is collected; the persistent clock still fences old replies.
+	if _, present, err := store.GetRecord("default", "shared"); err != nil || present {
+		t.Fatal(present, err)
+	}
+	if _, err = m.Attach(ctx, &AttachRequest{Namespace: "default", VolumeID: "shared", SandboxID: "c", Driver: "test"}); err != nil {
+		t.Fatal(err)
+	}
+	next, err := m.ObserveReference(ctx, "default", "shared")
+	if err != nil || next.Count != 1 || next.Revision <= state.Revision {
+		t.Fatal(next, err)
+	}
+}
