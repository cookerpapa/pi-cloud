+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"bytes"
+	"encoding/json"
+	"github.com/agiledragon/gomonkey/v2"
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/node"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestManagedExecutionRejectsPartialIdentityBeforeNodeRouting(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	app := gin.New()
+	app.POST("/execution/:action", handleManagedExecution)
+	response := httptest.NewRecorder()
+	request := httptest.NewRequest("POST", "/execution/submit", bytes.NewBufferString(`{"sandboxID":"partial","nodeID":"node-1"}`))
+	app.ServeHTTP(response, request)
+	if response.Code != 400 {
+		t.Fatalf("status %d", response.Code)
+	}
+}
+func TestManagedExecutionMissingNodeExplicitlyRefusesWithoutClaimingCompletion(t *testing.T) {
+	patch := gomonkey.ApplyFunc(localcache.GetNode, func(string) (*node.Node, bool) { return nil, false })
+	defer patch.Reset()
+	gin.SetMode(gin.TestMode)
+	app := gin.New()
+	app.POST("/execution/:action", handleManagedExecution)
+	response := httptest.NewRecorder()
+	request := httptest.NewRequest("POST", "/execution/submit", bytes.NewBufferString(`{"sandboxID":"aabbccddeeff00112233445566778899","nodeID":"node-1","operationID":"op-1","bootID":"boot-1"}`))
+	app.ServeHTTP(response, request)
+	var body map[string]interface{}
+	if json.Unmarshal(response.Body.Bytes(), &body) != nil {
+		t.Fatal("invalid response")
+	}
+	if response.Code != 200 || body["accepted"] != false || body["operationID"] != "op-1" {
+		t.Fatalf("unexpected refusal %v", body)
+	}
+}
