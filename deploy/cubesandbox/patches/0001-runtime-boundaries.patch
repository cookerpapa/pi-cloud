+var idPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var ErrClosed = errors.New("allocation_closed")
+var ErrExpired = errors.New("allocation_expired")
+var ErrConflict = errors.New("allocation_parameters_changed")
+var ErrUnavailable = errors.New("allocation_catalog_unavailable")
+
+type Record struct {
+	RetainUntil     int64  `gorm:"-" json:"retainUntil,omitempty"`
+	RetentionWindow int64  `gorm:"-" json:"retentionWindowMs,omitempty"`
+	ID              string `gorm:"primaryKey;size:36" json:"allocationID"`
+	Digest          string `gorm:"size:64" json:"-"`
+	NotAfter        int64  `json:"createBefore"`
+	SandboxID       string `gorm:"size:32" json:"sandboxID"`
+	NodeID          string `gorm:"size:256" json:"nodeID,omitempty"`
+	NodeIP          string `gorm:"size:256" json:"-"`
+	NodeBoot        string `gorm:"size:64" json:"-"`
+	Phase           string `gorm:"size:16" json:"phase"`
+	Closed          bool   `json:"closed"`
+	Request         string `json:"-"`
+	NodeRequest     string `json:"-"`
+	Result          string `json:"-"`
+	TrafficToken    string `gorm:"size:64" json:"-"`
+}
+
+func (Record) TableName() string { return "t_pi_cloud_allocation" }
+
+type Store struct{ DB *gorm.DB }
+
+func Default() *Store {
+	db := dao.Default()
+	if db != nil {
+		db = db.Session(&gorm.Session{Logger: logger.Discard})
+	}
+	return &Store{DB: db}
+}
+func ValidID(id string) bool     { return idPattern.MatchString(id) }
+func SandboxID(id string) string { return strings.ReplaceAll(id, "-", "") }
+func (s *Store) Get(ctx context.Context, id string) (*Record, error) {
+	if !ValidID(id) {
+		return nil, ErrConflict
+	}
+	if s.DB == nil {
+		return nil, ErrUnavailable
+	}
+	var r Record
+	e := s.DB.WithContext(ctx).Where("id = ?", id).Take(&r).Error
+	if errors.Is(e, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	return &r, e
+}
+func now(tx *gorm.DB) (int64, error) {
+	var n, floor int64
+	q := "select cast(unix_timestamp(current_timestamp(3))*1000 as signed)"
+	if tx.Dialector.Name() == "postgres" {
+		q = "select (extract(epoch from clock_timestamp())*1000)::bigint"
+	}
+	if e := tx.Raw(q).Scan(&n).Error; e != nil {
+		return 0, e
+	}
+	if e := tx.Raw("select floor_ms from t_pi_cloud_allocation_clock where id=1 for share").Scan(&floor).Error; e != nil {
+		return 0, e
+	}
+	if floor > n {
+		n = floor
+	}
+	return n, nil
+}
+func (s *Store) lock(ctx context.Context, id string, initial Record, change func(*gorm.DB, *Record, int64) error) (*Record, error) {
+	if s.DB == nil {
+		return nil, ErrUnavailable
+	}
+	var r Record
+	err := s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		n, e := now(tx)
+		if e != nil {
+			return e
+		}
+		if e = tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&initial).Error; e != nil {
+			return e
+		}
+		if e = tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id = ?", id).Take(&r).Error; e != nil {
+			return e
+		}
+		if e = change(tx, &r, n); e != nil {
+			return e
+		}
+		return tx.Save(&r).Error
+	})
+	return &r, err
+}
+func (s *Store) Begin(ctx context.Context, id, digest string, deadline int64, request string) (*Record, error) {
+	if !ValidID(id) || len(digest) != 64 || deadline <= 0 || len(request) > MaxPayload {
+		return nil, ErrConflict
+	}
+	token := make([]byte, 32)
+	if _, e := rand.Read(token); e != nil {
+		return nil, e
+	}
+	return s.lock(ctx, id, Record{ID: id, Digest: digest, NotAfter: deadline, SandboxID: SandboxID(id), Phase: "pending", Request: request, TrafficToken: hex.EncodeToString(token)}, func(_ *gorm.DB, r *Record, n int64) error {
+		if r.Closed {
+			return ErrClosed
+		}
+		if r.Digest != digest || r.NotAfter != deadline {
+			return ErrConflict
+		}
+		if r.NodeID == "" && n >= deadline {
+			return ErrExpired
+		}
+		return nil
+	})
+}
+
+// Placement and the exact native request commit before the first node RPC.
+// Competing replicas reuse the winning target; ambiguity never reschedules it.
+func (s *Store) Place(ctx context.Context, id, node, ip, boot, request, resolved, referenceEpoch string) (*Record, error) {
+	if node == "" || ip == "" || boot == "" || len(boot) > 64 || len(node) > 256 || len(ip) > 256 || len(request) > MaxPayload || len(resolved) > MaxPayload {
+		return nil, ErrConflict
+	}
+	r, e := s.Get(ctx, id)
+	if e != nil || r == nil {
+		if e == nil {
+			e = ErrUnavailable
+		}
+		return nil, e
+	}
+	return s.lock(ctx, id, *r, func(tx *gorm.DB, r *Record, n int64) error {
+		if r.Closed {
+			return ErrClosed
+		}
+		if r.NodeID != "" {
+			return nil
+		}
+		if n >= r.NotAfter {
+			return ErrExpired
+		}
+		r.NodeID = node
+		r.NodeIP = ip
+		r.NodeBoot = boot
+		if e := reserveVolumes(tx, r, request, referenceEpoch); e != nil {
+			return e
+		}
+		r.NodeRequest = request
+		r.Request = resolved
+		r.Phase = "creating"
+		return nil
+	})
+}
+func (s *Store) Close(ctx context.Context, id string, deadline int64) (*Record, error) {
+	if !ValidID(id) || deadline <= 0 {
+		return nil, ErrConflict
+	}
+	return s.lock(ctx, id, Record{ID: id, NotAfter: deadline, SandboxID: SandboxID(id), Closed: true, Phase: "absent"}, func(_ *gorm.DB, r *Record, _ int64) error {
+		if r.NotAfter != deadline {
+			return ErrConflict
+		}
+		r.Closed = true
+		if r.NodeID == "" {
+			r.Phase = "absent"
+		} else if r.Phase != "absent" {
+			r.Phase = "closing"
+		}
+		return nil
+	})
+}
+func (s *Store) Finish(ctx context.Context, id, phase, result string) (*Record, error) {
+	if len(result) > MaxPayload || (phase != "ready" && phase != "failed" && phase != "absent") {
+		return nil, ErrConflict
+	}
+	r, e := s.Get(ctx, id)
+	if e != nil || r == nil {
+		if e == nil {
+			e = ErrUnavailable
+		}
+		return nil, e
+	}
+	return s.lock(ctx, id, *r, func(tx *gorm.DB, r *Record, _ int64) error {
+		if phase != "absent" && r.Closed {
+			return ErrClosed
+		}
+		if phase == "absent" {
+			if !r.Closed {
+				return ErrConflict
+			}
+			if err := tx.Where("allocation_id = ?", r.ID).Delete(&VolumeHold{}).Error; err != nil {
+				return err
+			}
+			r.Phase = "absent"
+			r.Request = ""
+			r.NodeRequest = ""
+			r.Result = ""
+			r.TrafficToken = ""
+			return nil
+		}
+		if r.Closed {
+			return ErrClosed
+		}
+		r.Phase = phase
+		r.Result = result
+		return nil
+	})
+}
+func (s *Store) Collect(ctx context.Context) error {
+	if s.DB == nil {
+		return ErrUnavailable
+	}
+	return s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// An exclusive GC floor serializes expiry with admission and remains after
+		// terminal rows are removed. Backward DB clock steps cannot revive tokens.
+		var previous int64
+		if e := tx.Raw("select floor_ms from t_pi_cloud_allocation_clock where id=1 for update").Scan(&previous).Error; e != nil {
+			return e
+		}
+		n, e := now(tx)
+		if e != nil {
+			return e
+		}
+		var ids []string
+		if e = tx.Exec("update t_pi_cloud_allocation_clock set floor_ms=? where id=1", n).Error; e != nil {
+			return e
+		}
+		if e = tx.Model(&Record{}).Where("closed = ? and phase = ? and not_after < ?", true, "absent", n-3_600_000).Order("not_after").Limit(128).Pluck("id", &ids).Error; e != nil {
+			return e
+		}
+		if len(ids) == 0 {
+			return nil
+		}
+		return tx.Where("id in ? and closed = ? and phase = ?", ids, true, "absent").Delete(&Record{}).Error
+	})
+}
diff --git a/CubeMaster/pkg/allocation/store_test.go b/CubeMaster/pkg/allocation/store_test.go
new file mode 100644
index 0000000..f21b9af
--- /dev/null
+++ b/CubeMaster/pkg/allocation/store_test.go
@@ -0,0 +1,147 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"context"
+	"errors"
+	mysqldriver "github.com/go-sql-driver/mysql"
+	"github.com/google/uuid"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"gorm.io/driver/mysql"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+var schemaOnce sync.Once
+var schemaError error
+
+func realStore(t *testing.T) *Store {
+	t.Helper()
+	dsn := os.Getenv("PI_CLOUD_ALLOCATION_MYSQL_DSN")
+	if dsn == "" {
+		t.Skip("explicit disposable MySQL required")
+	}
+	config, err := mysqldriver.ParseDSN(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.DBName != "allocation_test" && !strings.HasPrefix(config.DBName, "pi_cloud_allocation_") {
+		t.Fatal("allocation tests require a disposable database name")
+	}
+	db, e := gorm.Open(mysql.Open(dsn), &gorm.Config{Logger: logger.Discard})
+	if e != nil {
+		t.Fatal(e)
+	}
+	sqlDB, e := db.DB()
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { sqlDB.Close() })
+	schemaOnce.Do(func() {
+		if schemaError = db.AutoMigrate(&models.VolumeRecord{}); schemaError != nil {
+			return
+		}
+		for _, file := range []string{"20261004000000_pi_cloud_allocation.sql", "20261005000000_pi_cloud_volume_state.sql"} {
+			migration, err := os.ReadFile("../../../pkgs/cubedb/migrate/migrations/mysql/" + file)
+			if err != nil {
+				schemaError = err
+				return
+			}
+			if schemaError = db.Exec(strings.Split(string(migration), "-- +goose Down")[0]).Error; schemaError != nil {
+				return
+			}
+		}
+	})
+	if schemaError != nil {
+		t.Fatal(schemaError)
+	}
+	return &Store{DB: db}
+}
+func TestPersistentAllocationAdmissionAndClosure(t *testing.T) {
+	s := realStore(t)
+	ctx := context.Background()
+	id := uuid.NewString()
+	deadline := time.Now().Add(time.Minute).UnixMilli()
+	digest := strings.Repeat("a", 64)
+	var wg sync.WaitGroup
+	tokens := make(chan string, 12)
+	for n := 0; n < 12; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r, e := s.Begin(ctx, id, digest, deadline, `{"spec":"same"}`)
+			if e != nil {
+				t.Error(e)
+				return
+			}
+			tokens <- r.TrafficToken
+		}()
+	}
+	wg.Wait()
+	close(tokens)
+	token := ""
+	for current := range tokens {
+		if token != "" && current != token {
+			t.Fatal("duplicate creation changed proxy credential")
+		}
+		token = current
+	}
+	if _, e := s.Begin(ctx, id, strings.Repeat("b", 64), deadline, "{}"); !errors.Is(e, ErrConflict) {
+		t.Fatal(e)
+	}
+	first, e := s.Place(ctx, id, "node-one", "127.0.0.1", "boot-one", `{"spec":"node-request"}`, "resolved-request", "")
+	if e != nil {
+		t.Fatal(e)
+	}
+	second, e := s.Place(ctx, id, "node-two", "127.0.0.2", "boot-two", "{}", "different", "")
+	if e != nil || second.NodeID != first.NodeID || second.NodeRequest != first.NodeRequest {
+		t.Fatal(e, second)
+	}
+	restarted := &Store{DB: s.DB}
+	r, e := restarted.Close(ctx, id, deadline)
+	if e != nil || !r.Closed || r.Phase != "closing" {
+		t.Fatal(e, r)
+	}
+	if _, e = s.Place(ctx, id, "node-three", "127.0.0.3", "boot-three", "{}", "late", ""); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	if _, e = s.Begin(ctx, id, digest, deadline, "{}"); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	if _, e = s.Finish(ctx, id, "ready", "{}"); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	r, e = s.Finish(ctx, id, "absent", "")
+	if e != nil || r.Phase != "absent" {
+		t.Fatal(e, r)
+	}
+}
+func TestCloseBeforeRegistrationAndExpiredReceipts(t *testing.T) {
+	s := realStore(t)
+	ctx := context.Background()
+	id := uuid.NewString()
+	deadline := time.Now().Add(-2 * time.Hour).UnixMilli()
+	r, e := s.Close(ctx, id, deadline)
+	if e != nil || r.Phase != "absent" || r.NodeID != "" {
+		t.Fatal(e, r)
+	}
+	if _, e = s.Begin(ctx, id, strings.Repeat("a", 64), deadline, "{}"); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	if e = s.Collect(ctx); e != nil {
+		t.Fatal(e)
+	}
+	r, e = s.Get(ctx, id)
+	if e != nil || r != nil {
+		t.Fatal(e, r)
+	}
+	if _, e = s.Begin(ctx, id, strings.Repeat("a", 64), deadline, "{}"); !errors.Is(e, ErrExpired) {
+		t.Fatal(e)
+	}
+}
diff --git a/CubeMaster/pkg/allocation/volumes.go b/CubeMaster/pkg/allocation/volumes.go
new file mode 100644
index 0000000..4d9411b
--- /dev/null
+++ b/CubeMaster/pkg/allocation/volumes.go
@@ -0,0 +1,298 @@
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"sort"
+)
+
+var ErrVolumeHeld = errors.New("Volume references remain active or unconfirmed")
+var ErrVolumeClosing = errors.New("Volume attachment admission is closed")
+
+type VolumeGate struct {
+	VolumeID   string `gorm:"primaryKey;size:128"`
+	Generation uint64
+	Deleting   bool
+}
+
+func (VolumeGate) TableName() string { return "t_pi_cloud_volume_gate" }
+
+type VolumeHold struct {
+	AllocationID string `gorm:"primaryKey;size:36"`
+	VolumeID     string `gorm:"primaryKey;size:128"`
+	Generation   uint64
+	NodeID       string `gorm:"size:256"`
+}
+
+func (VolumeHold) TableName() string { return "t_pi_cloud_volume_hold" }
+
+type VolumeNode struct {
+	VolumeID   string `gorm:"primaryKey;size:128"`
+	NodeID     string `gorm:"primaryKey;size:256"`
+	Generation uint64
+	Epoch      string `gorm:"size:36"`
+	Revision   int64
+	Count      int64
+	Confirmed  bool
+}
+
+func (VolumeNode) TableName() string { return "t_pi_cloud_volume_node" }
+
+type VolumeState struct {
+	VolumeID  string `json:"volumeID"`
+	Epoch     string `json:"epoch"`
+	Revision  int64  `json:"revision"`
+	Count     int64  `json:"count"`
+	Confirmed bool   `json:"confirmed"`
+}
+
+func VolumeNames(wire string) ([]string, error) {
+	var req struct {
+		Annotations map[string]string `json:"annotations"`
+	}
+	if err := json.Unmarshal([]byte(wire), &req); err != nil {
+		return nil, err
+	}
+	var entries []struct {
+		Name string `json:"name"`
+	}
+	if raw := req.Annotations["plugin-volume-sources"]; raw != "" {
+		if err := json.Unmarshal([]byte(raw), &entries); err != nil {
+			return nil, err
+		}
+	}
+	if len(entries) > 64 {
+		return nil, ErrConflict
+	}
+	seen := map[string]bool{}
+	ids := []string{}
+	for _, e := range entries {
+		if e.Name == "" || len(e.Name) > 128 {
+			return nil, ErrConflict
+		}
+		if !seen[e.Name] {
+			ids = append(ids, e.Name)
+			seen[e.Name] = true
+		}
+	}
+	sort.Strings(ids)
+	return ids, nil
+}
+func lockVolume(tx *gorm.DB, id string) (models.VolumeRecord, error) {
+	var v models.VolumeRecord
+	err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("volume_id = ?", id).Take(&v).Error
+	return v, err
+}
+func volumeGate(tx *gorm.DB, v models.VolumeRecord) (VolumeGate, error) {
+	var gate VolumeGate
+	err := tx.Where("volume_id = ?", v.VolumeID).Take(&gate).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		// Historical untracked references are not evidence of zero usage.
+		if v.RefCount != 0 {
+			return gate, ErrVolumeHeld
+		}
+		gate = VolumeGate{VolumeID: v.VolumeID, Generation: uint64(v.ID)}
+		err = tx.Create(&gate).Error
+	}
+	if err == nil && gate.Generation != uint64(v.ID) {
+		err = ErrConflict
+	}
+	return gate, err
+}
+func reserveVolumes(tx *gorm.DB, r *Record, wire, epoch string) error {
+	ids, err := VolumeNames(wire)
+	if err != nil {
+		return err
+	}
+	if len(ids) > 0 && len(epoch) != 36 {
+		return ErrConflict
+	}
+	for _, id := range ids {
+		v, err := lockVolume(tx, id)
+		if err != nil {
+			return err
+		}
+		gate, err := volumeGate(tx, v)
+		if err != nil {
+			return err
+		}
+		if gate.Deleting {
+			return ErrVolumeClosing
+		}
+		node := VolumeNode{VolumeID: id, NodeID: r.NodeID, Generation: uint64(v.ID), Epoch: epoch, Revision: -1}
+		if err = tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&node).Error; err != nil {
+			return err
+		}
+		var stored VolumeNode
+		if err = tx.Where("volume_id = ? and node_id = ?", id, r.NodeID).Take(&stored).Error; err != nil {
+			return err
+		}
+		if stored.Generation != uint64(v.ID) || stored.Epoch != epoch {
+			return ErrVolumeHeld
+		}
+		hold := VolumeHold{AllocationID: r.ID, VolumeID: id, Generation: uint64(v.ID), NodeID: r.NodeID}
+		if err = tx.Create(&hold).Error; err != nil {
+			return err
+		}
+		if err = updateVolumeCount(tx, id); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func updateVolumeCount(tx *gorm.DB, id string) error {
+	var count int64
+	if err := tx.Model(&VolumeNode{}).Where("volume_id = ? and (count > 0 or confirmed = ?)", id, false).Count(&count).Error; err != nil {
+		return err
+	}
+	return tx.Model(&models.VolumeRecord{}).Where("volume_id = ?", id).Update("refcount", count).Error
+}
+func (s *Store) VolumeNodes(ctx context.Context, volumeID string) ([]VolumeNode, error) {
+	var nodes []VolumeNode
+	err := s.DB.WithContext(ctx).Where("volume_id = ?", volumeID).Order("node_id").Find(&nodes).Error
+	return nodes, err
+}
+func (s *Store) AllocationVolumeNodes(ctx context.Context, id string) ([]VolumeNode, error) {
+	var nodes []VolumeNode
+	err := s.DB.WithContext(ctx).Table("t_pi_cloud_volume_node n").Select("n.*").Joins("join t_pi_cloud_volume_hold h on h.volume_id=n.volume_id and h.node_id=n.node_id and h.generation=n.generation").Where("h.allocation_id = ?", id).Order("n.volume_id").Scan(&nodes).Error
+	return nodes, err
+}
+func (s *Store) ApplyVolumeState(ctx context.Context, target VolumeNode, state VolumeState) error {
+	if state.VolumeID != target.VolumeID || state.Epoch != target.Epoch || state.Revision < 0 || state.Count < 0 {
+		return ErrConflict
+	}
+	return s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		v, err := lockVolume(tx, target.VolumeID)
+		if err != nil {
+			return err
+		}
+		if uint64(v.ID) != target.Generation {
+			return ErrConflict
+		}
+		var stored VolumeNode
+		if err = tx.Where("volume_id = ? and node_id = ?", target.VolumeID, target.NodeID).Take(&stored).Error; err != nil {
+			return err
+		}
+		if stored.Generation != target.Generation || stored.Epoch != state.Epoch {
+			return ErrConflict
+		}
+		if state.Revision < stored.Revision {
+			return nil
+		}
+		if state.Revision == stored.Revision {
+			if state.Count != stored.Count || state.Confirmed != stored.Confirmed {
+				return ErrConflict
+			}
+			return nil
+		}
+		stored.Revision = state.Revision
+		stored.Count = state.Count
+		stored.Confirmed = state.Confirmed
+		if err = tx.Save(&stored).Error; err != nil {
+			return err
+		}
+		return updateVolumeCount(tx, target.VolumeID)
+	})
+}
+
+// The gate is committed before querying nodes. Every later managed placement
+// locks the same Volume row and refuses the irreversible deleting state.
+func (s *Store) BeginVolumeDeletion(ctx context.Context, id string) (models.VolumeRecord, error) {
+	var result models.VolumeRecord
+	err := s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		v, e := lockVolume(tx, id)
+		if e != nil {
+			return e
+		}
+		result = v
+		gate, e := volumeGate(tx, v)
+		if e != nil {
+			return e
+		}
+		// An older allocation with no hold record cannot silently disappear at
+		// cutover. Its frozen original request remains evidence of possible use.
+		var old []Record
+		if e = tx.Where("phase <> ? and node_id <> ?", "absent", "").Where("not exists (select 1 from t_pi_cloud_volume_hold h where h.allocation_id=t_pi_cloud_allocation.id)").Find(&old).Error; e != nil {
+			return e
+		}
+		for _, r := range old {
+			ids, e := VolumeNames(r.NodeRequest)
+			if e != nil {
+				return ErrVolumeHeld
+			}
+			for _, name := range ids {
+				if name == id {
+					return ErrVolumeHeld
+				}
+			}
+		}
+		gate.Deleting = true
+		return tx.Save(&gate).Error
+	})
+	return result, err
+}
+func (s *Store) ConfirmVolumeDeletion(ctx context.Context, id string, generation uint64) error {
+	return s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		v, err := lockVolume(tx, id)
+		if err != nil {
+			return err
+		}
+		if uint64(v.ID) != generation {
+			return ErrConflict
+		}
+		var gate VolumeGate
+		if err = tx.Where("volume_id = ?", id).Take(&gate).Error; err != nil {
+			return err
+		}
+		if !gate.Deleting || gate.Generation != generation {
+			return ErrConflict
+		}
+		var held int64
+		if err = tx.Model(&VolumeHold{}).Where("volume_id = ?", id).Count(&held).Error; err != nil {
+			return err
+		}
+		if held != 0 || v.RefCount != 0 {
+			return ErrVolumeHeld
+		}
+		return nil
+	})
+}
+func (s *Store) FinishVolumeDeletion(ctx context.Context, id string, generation uint64) error {
+	return s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		v, err := lockVolume(tx, id)
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if uint64(v.ID) != generation {
+			return ErrConflict
+		}
+		var gate VolumeGate
+		if err = tx.Where("volume_id = ?", id).Take(&gate).Error; err != nil {
+			return err
+		}
+		if !gate.Deleting || gate.Generation != generation {
+			return ErrConflict
+		}
+		var held int64
+		if err = tx.Model(&VolumeHold{}).Where("volume_id = ?", id).Count(&held).Error; err != nil {
+			return err
+		}
+		if held != 0 || v.RefCount != 0 {
+			return ErrVolumeHeld
+		}
+		if err = tx.Where("volume_id = ?", id).Delete(&VolumeNode{}).Error; err != nil {
+			return err
+		}
+		if err = tx.Where("volume_id = ?", id).Delete(&VolumeGate{}).Error; err != nil {
+			return err
+		}
+		return tx.Delete(&v).Error
+	})
+}
diff --git a/CubeMaster/pkg/allocation/volumes_test.go b/CubeMaster/pkg/allocation/volumes_test.go
