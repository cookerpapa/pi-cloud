diff --git a/CubeMaster/pkg/service/sandbox/allocation.go b/CubeMaster/pkg/service/sandbox/allocation.go
new file mode 100644
index 0000000..e3cc4e5
--- /dev/null
+++ b/CubeMaster/pkg/service/sandbox/allocation.go
@@ -0,0 +1,331 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package sandbox
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet/grpcconn"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/errorcode"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/pausesnap"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/sandboxlock"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/sandboxspec"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox/types"
+	"github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	cubeerror "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/errorcode/v1"
+	"google.golang.org/protobuf/encoding/protojson"
+	"strconv"
+	"time"
+)
+
+type nodeAllocation struct {
+	RetainUntil     int64           `json:"retainUntil"`
+	RetentionWindow int64           `json:"retentionWindowMs"`
+	ID              string          `json:"allocationID"`
+	SandboxID       string          `json:"sandboxID"`
+	Digest          string          `json:"digest"`
+	NotAfter        int64           `json:"createBefore"`
+	Phase           string          `json:"phase"`
+	Closed          bool            `json:"closed"`
+	StartedBoot     string          `json:"startedBoot"`
+	Result          json.RawMessage `json:"result"`
+	CleanupResult   json.RawMessage `json:"cleanupResult"`
+}
+
+// Begin runs before template resolution, against the caller's stable parameters.
+func BeginManagedAllocation(ctx context.Context, req *types.CreateCubeSandboxReq) (*allocation.Record, error) {
+	id := req.Labels[allocation.IDLabel]
+	if id == "" {
+		if req.Labels["picloud.managed"] == "true" {
+			return nil, errors.New("managed allocation authorization required")
+		}
+		return nil, nil
+	}
+	deadline, err := strconv.ParseInt(req.Labels[allocation.DeadlineLabel], 10, 64)
+	if err != nil {
+		return nil, err
+	}
+	copy := *req
+	copy.Request = nil
+	raw, err := json.Marshal(copy)
+	if err != nil {
+		return nil, err
+	}
+	sum := sha256.Sum256(raw)
+	return allocation.Default().Begin(ctx, id, hex.EncodeToString(sum[:]), deadline, string(raw))
+}
+func (c *createSandboxContext) prepareAllocation() error {
+	if c.allocation == nil {
+		return nil
+	}
+	a := c.cubeletReq.Annotations
+	if a == nil {
+		a = map[string]string{}
+		c.cubeletReq.Annotations = a
+	}
+	a[allocation.IDAnnotation] = c.allocation.ID
+	a[allocation.DigestAnnotation] = c.allocation.Digest
+	a[allocation.DeadlineAnnotation] = strconv.FormatInt(c.allocation.NotAfter, 10)
+	a[allocation.FixedIDAnnotation] = c.allocation.SandboxID
+	conn, err := grpcconn.GetWorkerConn(c.ctx, cubelet.GetCubeletAddr(c.selectHost.HostIP()))
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	capability, err := cubebox.NewCubeboxMgrClient(conn.Value()).ManageAllocation(c.ctx, &cubebox.AllocationRequest{})
+	if err != nil {
+		return err
+	}
+	var capabilityState struct {
+		ReferenceEpoch string `json:"referenceEpoch"`
+	}
+	if err = json.Unmarshal(capability.Record, &capabilityState); err != nil {
+		return err
+	}
+	if capability.BootId == "" {
+		return errors.New("allocation node boot unavailable")
+	}
+	a["pi-cloud.allocation.node-boot"] = capability.BootId
+	wire, err := protojson.Marshal(c.cubeletReq)
+	if err != nil {
+		return err
+	}
+	resolved, err := json.Marshal(createOriginRequestFromContext(c.ctx))
+	if err != nil {
+		return err
+	}
+	record, err := allocation.Default().Place(c.ctx, c.allocation.ID, c.selectHost.ID(), c.selectHost.HostIP(), capability.BootId, string(wire), string(resolved), capabilityState.ReferenceEpoch)
+	if err != nil {
+		return err
+	}
+	host, ok := localcache.GetNode(record.NodeID)
+	if !ok || !host.Healthy {
+		return errors.New("allocation node unavailable")
+	}
+	c.selectHost = host
+	c.directHost = true
+	c.reschedule = false
+	c.allocation = record
+	var canonical types.CreateCubeSandboxReq
+	if err = json.Unmarshal([]byte(record.Request), &canonical); err != nil {
+		return err
+	}
+	if origin := createOriginRequestFromContext(c.ctx); origin != nil {
+		*origin = canonical
+	}
+	return protojson.Unmarshal([]byte(record.NodeRequest), c.cubeletReq)
+}
+func (c *createSandboxContext) finishAllocation() error {
+	current, err := allocation.Default().Get(c.ctx, c.allocation.ID)
+	if err != nil {
+		return err
+	}
+	if current == nil {
+		return allocation.ErrUnavailable
+	}
+	if current.Closed {
+		return allocation.ErrClosed
+	}
+	// Proxy metadata uses the allocation's original token, including reply recovery.
+	if err = c.setProxyToRedis(); err != nil {
+		return err
+	}
+	origin := createOriginRequestFromContext(c.ctx)
+	if err = sandboxspec.Put(c.ctx, c.masterRsp.SandboxID, origin, sandboxspec.PutOptions{HostID: c.selectHost.ID(), HostIP: c.selectHost.HostIP()}); err != nil {
+		return err
+	}
+	c.masterRsp.Ret = &types.Ret{RetCode: int(errorcode.ErrorCode_Success)}
+	if v := origin.Annotations[constants.CubeAnnotationComponentEnvdVersion]; v != "" {
+		c.masterRsp.ExtInfo[constants.CubeAnnotationComponentEnvdVersion] = v
+	}
+	data, err := json.Marshal(c.masterRsp)
+	if err != nil {
+		return err
+	}
+	_, err = allocation.Default().Finish(c.ctx, c.allocation.ID, "ready", string(data))
+	if errors.Is(err, allocation.ErrClosed) {
+		_ = localcache.DeleteSandboxProxyMap(c.ctx, c.masterRsp.SandboxID)
+		localcache.DeleteSandboxCache(c.masterRsp.SandboxID)
+		_ = runAfterDestroySandboxSuccessHook(c.ctx, c.masterRsp.SandboxID)
+	}
+	if err == nil {
+		_ = RefreshAllocationVolumeReferences(c.ctx, c.allocation.ID)
+	}
+	return err
+}
+
+// Reconcile uses the fixed target and original wire request. A missing receipt
+// is not absence: only the node's idempotent Create may resume that exact request.
+func ReconcileAllocation(ctx context.Context, id string, close bool, deadline int64, resubmit bool) (*allocation.Record, error) {
+	store := allocation.Default()
+	var r *allocation.Record
+	var err error
+	if close {
+		r, err = store.Close(ctx, id, deadline)
+	} else {
+		r, err = store.Get(ctx, id)
+	}
+	if err != nil || r == nil {
+		return r, err
+	}
+	if r.Phase == "absent" && r.NodeID != "" {
+		if err = cleanupManagedPauseSnapshot(ctx, r); err != nil {
+			return r, err
+		}
+		if err = localcache.DeleteSandboxProxyMap(ctx, r.SandboxID); err != nil {
+			return r, err
+		}
+		localcache.DeleteSandboxCache(r.SandboxID)
+		if err = runAfterDestroySandboxSuccessHook(ctx, r.SandboxID); err != nil {
+			return r, err
+		}
+	}
+	if r.NodeID == "" || r.Phase == "absent" {
+		return r, nil
+	}
+	host, ok := localcache.GetNode(r.NodeID)
+	if !ok || !host.Healthy {
+		return r, errors.New("allocation node unavailable")
+	}
+	budget := 5 * time.Second
+	if r.Closed {
+		// The managed profile uses Cubelet's native 60s destroy policy.
+		// Keep transport time outside the physical cleanup lifetime.
+		budget = 65 * time.Second
+	}
+	bounded, cancel := context.WithTimeout(ctx, budget)
+	defer cancel()
+	conn, err := grpcconn.GetWorkerConn(bounded, cubelet.GetCubeletAddr(host.HostIP()))
+	if err != nil {
+		return r, err
+	}
+	defer conn.Close()
+	client := cubebox.NewCubeboxMgrClient(conn.Value())
+	response, err := client.ManageAllocation(bounded, &cubebox.AllocationRequest{AllocationId: r.ID, Digest: r.Digest, CreateBefore: r.NotAfter, Close: r.Closed, ExpectedBoot: r.NodeBoot})
+	if err != nil {
+		return r, err
+	}
+	if response.Failure == "allocation_not_recorded" && !r.Closed && response.BootId == r.NodeBoot {
+		if !resubmit {
+			return r, nil
+		}
+		var request cubebox.RunCubeSandboxRequest
+		if err = protojson.Unmarshal([]byte(r.NodeRequest), &request); err != nil {
+			return r, err
+		}
+		// Destination admission owns idempotency. Never choose another physical node.
+		_, _ = client.Create(bounded, &request)
+		return r, nil
+	}
+	if response.Failure != "" {
+		return r, errors.New("allocation outcome unconfirmed")
+	}
+	var observed nodeAllocation
+	if err = json.Unmarshal(response.Record, &observed); err != nil {
+		return r, err
+	}
+	if observed.ID != r.ID || observed.Digest != r.Digest || observed.NotAfter != r.NotAfter || observed.SandboxID != r.SandboxID || observed.StartedBoot != r.NodeBoot {
+		return r, errors.New("allocation identity changed")
+	}
+	if observed.Closed && !r.Closed {
+		r, err = store.Close(ctx, r.ID, r.NotAfter)
+		if err != nil {
+			return r, err
+		}
+	}
+	var created cubebox.RunCubeSandboxResponse
+	if len(observed.Result) > 0 {
+		if err = protojson.Unmarshal(observed.Result, &created); err != nil {
+			return r, err
+		}
+	}
+	if observed.Closed && observed.Phase == "absent" {
+		if err = cleanupManagedPauseSnapshot(ctx, r); err != nil {
+			return r, err
+		}
+		if err = localcache.DeleteSandboxProxyMap(ctx, r.SandboxID); err != nil {
+			return r, err
+		}
+		localcache.DeleteSandboxCache(r.SandboxID)
+		if err = runAfterDestroySandboxSuccessHook(ctx, r.SandboxID); err != nil {
+			return r, err
+		}
+		// Queryable node state does not depend on the cleanup reply journal.
+		// Failure leaves conservative Volume/node state for Volume GC retries;
+		// confirmed VM absence may still release its independent compute quota.
+		_ = RefreshAllocationVolumeReferences(ctx, r.ID)
+		return store.Finish(ctx, r.ID, "absent", "")
+	}
+	if r.Closed {
+		return r, nil
+	}
+	if observed.Phase == "failed" {
+		return store.Finish(ctx, r.ID, "failed", "")
+	}
+	if observed.Phase != "ready" {
+		return r, nil
+	}
+	if created.Ret == nil || created.Ret.RetCode != cubeerror.ErrorCode_Success {
+		return r, errors.New("invalid allocation completion")
+	}
+	if r.Phase == "ready" && r.Result != "" {
+		r.RetainUntil = observed.RetainUntil
+		r.RetentionWindow = observed.RetentionWindow
+		return r, nil
+	}
+	var origin types.CreateCubeSandboxReq
+	var request cubebox.RunCubeSandboxRequest
+	if err = json.Unmarshal([]byte(r.Request), &origin); err != nil {
+		return r, err
+	}
+	if err = protojson.Unmarshal([]byte(r.NodeRequest), &request); err != nil {
+		return r, err
+	}
+	c := &createSandboxContext{ctx: withCreateOriginRequest(ctx, &origin), allocation: r, selectHost: host, cubeletReq: &request, cubeletRsp: &created,
+		masterRsp: &types.CreateCubeSandboxRes{RequestID: origin.RequestID, Ret: &types.Ret{}, SandboxID: r.SandboxID, SandboxIP: created.SandboxIP, HostID: r.NodeID, HostIP: host.HostIP(), ExtInfo: map[string]string{}}}
+	if err = c.finishAllocation(); err != nil {
+		return r, err
+	}
+	return store.Get(ctx, r.ID)
+}
+
+// A reaped VM may still have a recoverable pause package. Join that source-owned
+// cleanup before publishing allocation absence to the Control Plane.
+func cleanupManagedPauseSnapshot(ctx context.Context, r *allocation.Record) error {
+	return sandboxlock.WithLock(ctx, r.SandboxID, sandboxlock.Options{
+		Value: "allocation-close", TTL: sandboxlock.DeleteTTL,
+	}, func(ctx context.Context) error {
+		paused, err := pausesnap.GetBySandbox(ctx, r.SandboxID)
+		if errors.Is(err, pausesnap.ErrNotFound) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if !r.Closed || paused == nil || paused.SnapshotID == "" || r.NodeID == "" || paused.NodeID != r.NodeID {
+			return errors.New("managed pause cleanup identity is unconfirmed")
+		}
+		host, ok := localcache.GetNode(r.NodeID)
+		if !ok || host == nil || host.ID() != r.NodeID || !host.Healthy || host.HostIP() == "" {
+			return errors.New("managed pause cleanup node is unavailable")
+		}
+		if _, err = pausesnap.TryDeletePausedOnNode(ctx, r.ID, r.SandboxID, r.NodeID, host.HostIP()); err != nil {
+			return err
+		}
+		_, err = pausesnap.GetBySandbox(ctx, r.SandboxID)
+		if errors.Is(err, pausesnap.ErrNotFound) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		return errors.New("managed pause snapshot cleanup remains unconfirmed")
+	})
+}
