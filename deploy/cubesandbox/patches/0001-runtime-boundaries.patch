+func TestRetentionDoesNotAcknowledgeFailedPersistence(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	i.RetentionWindow = 900000
+	r, e := m.Create(context.Background(), i, time.Second, success)
+	if e != nil {
