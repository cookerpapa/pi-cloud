+	for n := 0; n < 130; n++ {
+		i := identity()
+		i.ID = fmt.Sprintf("12345678-1234-1234-1234-%012x", n)
+		if _, err = m.Create(ctx, i, time.Second, success); err != nil {
+			t.Fatal(err)
+		}
+		if n < 129 {
+			if _, err = refs.Acquire("default", fmt.Sprintf("v%d", n), SandboxID(i.ID), "picloud-posix"); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err = m.Close(ctx, i, time.Second, absent); err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, i)
+	}
+	if _, err = refs.RecoverRefCounts(nil); err != nil {
+		t.Fatal(err)
+	}
+	now.Store(identity().NotAfter + retention + 1)
+	// Each invocation scans at most 128 receipts. Retained evidence is postponed
+	// so unrelated expired allocation 129 can be reclaimed on the next pass.
+	for n := 0; n < 2; n++ {
+		if err = m.Store.Collect(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if r, e := m.Store.Get(ids[129].ID); e != nil || r != nil {
+		t.Fatal(r, e)
+	}
+	if r, e := m.Store.Get(ids[0].ID); e != nil || r == nil {
+		t.Fatal("lost stale holder evidence", r, e)
+	}
+	if _, err = refs.BeginDetach("default", "v0", SandboxID(ids[0].ID), nil); err != nil {
+		t.Fatal(err)
+	}
+	now.Add(60001)
+	if err = m.Store.Collect(); err != nil {
+		t.Fatal(err)
+	}
+	if r, e := m.Store.Get(ids[0].ID); e != nil || r == nil {
+		t.Fatal("lost pending detach evidence", r, e)
+	}
+	if err = refs.CompleteDetach("default", "v0", SandboxID(ids[0].ID)); err != nil {
+		t.Fatal(err)
+	}
+	now.Add(60001)
+	if err = m.Store.Collect(); err != nil {
+		t.Fatal(err)
+	}
+	if r, e := m.Store.Get(ids[0].ID); e != nil || r != nil {
+		t.Fatal(r, e)
+	}
+	if _, err = m.Create(ctx, ids[0], time.Second, success); err != ErrExpired {
+		t.Fatal("late create admitted", err)
+	}
+}
diff --git a/Cubelet/pkg/execution/containerd.go b/Cubelet/pkg/execution/containerd.go
new file mode 100644
index 0000000..f6c30e0
--- /dev/null
+++ b/Cubelet/pkg/execution/containerd.go
@@ -0,0 +1,460 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"sync"
+	"syscall"
+	"time"
+
+	containerd "github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/pkg/cio"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/opencontainers/runtime-spec/specs-go"
+)
+
+const guestScopeProgram = "/opt/pi-cloud/bin/cube-tool-scope.mjs"
+const finalCleanupKillTimeout = 5 * time.Second
+const scopeReceiptUnconfirmed uint32 = 76
+const toolSettlementTimeout = 7 * time.Second
+
+type resultHeader struct {
+	ExecutionComplete         bool   `json:"executionComplete"`
+	Delivered                 bool   `json:"delivered"`
+	Type                      string `json:"type"`
+	OperationID               string `json:"operationId"`
+	ToolWorkerProtocolVersion int    `json:"toolWorkerProtocolVersion"`
+	ProbeID                   string `json:"probeId"`
+	Code                      string `json:"code"`
+	Empty                     bool   `json:"empty"`
+}
+
+type ResolvedTask struct {
+	Task      containerd.Task
+	Namespace string
+}
+type TaskResolver func(context.Context, Request) (ResolvedTask, error)
+type ContainerdDriver struct {
+	Resolve        TaskResolver
+	RuntimePresent func(string) bool
+	FIFODirectory  string
+}
+
+func (d *ContainerdDriver) HasRuntime(sandbox string) bool {
+	return d.RuntimePresent != nil && d.RuntimePresent(sandbox)
+}
+
+type toolOutput struct {
+	mu          sync.Mutex
+	line        []byte
+	result      json.RawMessage
+	header      resultHeader
+	completedAt time.Time
+	executedID  string
+	limit       int64
+	failed      chan struct{}
+	once        sync.Once
+	ready       chan struct{}
+	complete    chan struct{}
+	readyOnce   sync.Once
+	progress    func(json.RawMessage)
+}
+
+func (o *toolOutput) Write(p []byte) (int, error) {
+	size := len(p)
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	for len(p) > 0 {
+		n := bytes.IndexByte(p, '\n')
+		part := p
+		if n >= 0 {
+			part = p[:n]
+		}
+		if int64(len(o.line)+len(part)) > o.limit {
+			o.once.Do(func() { close(o.failed) })
+			return 0, errors.New("tool output limit")
+		}
+		o.line = append(o.line, part...)
+		if n < 0 {
+			return size, nil
+		}
+		var marker resultHeader
+		if json.Unmarshal(o.line, &marker) != nil {
+			o.once.Do(func() { close(o.failed) })
+			return 0, errors.New("invalid tool output")
+		}
+		if marker.Type == "scope.ready" {
+			o.readyOnce.Do(func() { close(o.ready) })
+		} else if marker.Type == "scope.executed" {
+			o.executedID = marker.OperationID
+		} else if marker.Type == "worker.delivery_result" || marker.Type == "scope.stop_result" || marker.Type == "worker.probe_result" {
+			if o.result != nil {
+				o.once.Do(func() { close(o.failed) })
+				return 0, errors.New("duplicate tool result")
+			}
+			// Hand the complete immutable frame to the result. Reusing line's
+			// backing array would corrupt it; copying it would double each image.
+			o.result = o.line
+			o.header = marker
+			o.completedAt = time.Now()
+			o.line = nil
+			close(o.complete)
+		} else if marker.Type == "worker.preview" && marker.OperationID != "" && len(o.line) <= 64*1024 {
+			o.progress(append(json.RawMessage(nil), o.line...))
+		}
+		o.line = o.line[:0]
+		p = p[n+1:]
+	}
+	return size, nil
+}
+func (o *toolOutput) resultBytes() json.RawMessage {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	// This private immutable result is transferred to delivery, never mutated.
+	return o.result
+}
+
+func (o *toolOutput) finish() {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if len(o.line) != 0 {
+		o.once.Do(func() { close(o.failed) })
+	}
+}
+
+func (o *toolOutput) resultState() (resultHeader, time.Time) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	return o.header, o.completedAt
+}
+
+func validResult(h resultHeader, r Request) bool {
+	if r.Probe && len(r.CompletionContext) == 0 {
+		return h.Type == "worker.probe_result" && h.ProbeID == r.OperationID
+	}
+	return h.ToolWorkerProtocolVersion == 7 && h.Type == "worker.delivery_result" && h.ExecutionComplete && h.OperationID == r.OperationID
+}
+func (o *toolOutput) executionCompleted(id string) bool {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	return o.executedID == id
+}
+
+func settledScopeExit(code uint32) bool { return code == 0 || code == scopeReceiptUnconfirmed }
+
+// A complete frame observed within the execution budget starts a separate,
+// bounded join. Deadline/result select ordering must not cancel completed work.
+func waitToolExit(ctx context.Context, r Request, output *toolOutput, exits <-chan containerd.ExitStatus) (containerd.ExitStatus, bool, string) {
+	complete := output.complete
+	for {
+		h, at := output.resultState()
+		if !at.IsZero() {
+			if !validResult(h, r) {
+				return containerd.ExitStatus{}, false, "tool_output_invalid"
+			}
+			complete = nil
+			deadline, bounded := ctx.Deadline()
+			if !r.Probe && ctx.Err() != context.Canceled && (!bounded || !at.After(deadline)) {
+				settle, end := context.WithTimeout(context.WithoutCancel(ctx), toolSettlementTimeout)
+				defer end()
+				select {
+				case status, ok := <-exits:
+					return status, ok && status.Error() == nil, ""
+				case <-output.failed:
+					return containerd.ExitStatus{}, false, "tool_output_invalid"
+				case <-settle.Done():
+					return containerd.ExitStatus{}, false, "tool_settlement_unconfirmed"
+				}
+			}
+		}
+		select {
+		case status, ok := <-exits:
+			return status, ok && status.Error() == nil, ""
+		case <-output.failed:
+			return containerd.ExitStatus{}, false, "tool_output_invalid"
+		case <-complete:
+			continue
+		case <-ctx.Done():
+			// Recheck a frame that raced this select before deciding to stop it.
+			_, arrived := output.resultState()
+			deadline, bounded := ctx.Deadline()
+			if !r.Probe && ctx.Err() != context.Canceled && !arrived.IsZero() && bounded && !arrived.After(deadline) {
+				continue
+			}
+			return containerd.ExitStatus{}, false, "tool_cancelled"
+		}
+	}
+}
+
+type boundedOutput struct {
+	mu     sync.Mutex
+	buffer bytes.Buffer
+	limit  int
+}
+
+func (b *boundedOutput) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	n := len(p)
+	if left := b.limit - b.buffer.Len(); left > 0 {
+		if len(p) > left {
+			p = p[:left]
+		}
+		_, _ = b.buffer.Write(p)
+	}
+	return n, nil
+}
+func (b *boundedOutput) Bytes() []byte {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return append([]byte(nil), b.buffer.Bytes()...)
+}
+
+// Only call before Start has been issued. An ambiguous Start reply cannot prove
+// non-execution, even when its original budget has subsequently expired.
+func unstartedFailure(ctx context.Context, r Request) string {
+	if ctx.Err() != nil {
+		return "execution_not_started"
+	}
+	select {
+	case <-r.Interrupt:
+		return "tool_cancelled_before_start"
+	default:
+		return ""
+	}
+}
+
+func (d *ContainerdDriver) Run(ctx context.Context, r Request, progress func(json.RawMessage)) Result {
+	if failure := unstartedFailure(ctx, r); failure != "" {
+		return Result{Failure: failure}
+	}
+	setupParent := context.WithoutCancel(ctx)
+	if r.Probe {
+		setupParent = ctx
+	}
+	setup, cancelSetup := context.WithTimeout(setupParent, 10*time.Second)
+	resolved, err := d.Resolve(setup, r)
+	if err != nil {
+		cancelSetup()
+		return Result{Failure: "tool_sandbox_unavailable"}
+	}
+	task := resolved.Task
+	ctx = namespaces.WithNamespace(ctx, resolved.Namespace)
+	setup = namespaces.WithNamespace(setup, resolved.Namespace)
+	spec, err := task.Spec(setup)
+	if err != nil || spec.Process == nil {
+		cancelSetup()
+		return Result{Failure: "tool_runtime_spec_unavailable"}
+	}
+	processSpec := *spec.Process
+	processSpec.Args = []string{"/usr/local/bin/node", guestScopeProgram, "run", r.OperationID}
+	processSpec.User = specs.User{UID: 0, GID: 0}
+	if r.Probe {
+		status, err := task.Status(setup)
+		if err != nil || status.Status != containerd.Running {
+			cancelSetup()
+			return Result{Failure: "probe_runtime_not_running"}
+		}
+		processSpec.Args[2] = "probe"
+		processSpec.User = specs.User{UID: 1000, GID: 1000}
+	}
+	processSpec.Terminal = true
+	processSpec.Cwd = "/"
+	output := newToolOutput(r.MaximumOutputBytes, progress)
+	input, endInput := rawTerminalInput(ctx, output, r.Payload, r.OperationID, r.Interrupt)
+	defer endInput()
+	process, err := task.Exec(setup, "pc-"+r.OperationID, &processSpec, cio.NewCreator(cio.WithFIFODir(d.FIFODirectory), cio.WithTerminal, cio.WithStreams(input, output, nil)))
+	cancelSetup()
+	if err != nil {
+		return Result{Failure: "tool_start_outcome_unknown", Quarantine: true}
+	}
+	lifetime, endLifetime := context.WithTimeout(context.WithoutCancel(ctx), r.Timeout+30*time.Second)
+	defer endLifetime()
+	defer func() {
+		process.IO().Cancel()
+		_ = process.IO().Close()
+		cleanup, end := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+		defer end()
+		_, _ = process.Delete(cleanup)
+	}()
+	exits, err := process.Wait(lifetime)
+	if err != nil {
+		return Result{Failure: "tool_wait_unavailable", Quarantine: true}
+	}
+	if failure := unstartedFailure(ctx, r); failure != "" {
+		return Result{Failure: failure}
+	}
+	startParent := context.WithoutCancel(ctx)
+	if r.Probe {
+		startParent = ctx
+	}
+	start, endStart := context.WithTimeout(startParent, 10*time.Second)
+	err = process.Start(start)
+	endStart()
+	interrupted := err != nil
+	failure := ""
+	var exit containerd.ExitStatus
+	joined := false
+	if !interrupted {
+		exit, joined, failure = waitToolExit(ctx, r, output, exits)
+		interrupted = failure != ""
+	}
+	if interrupted {
+		if failure == "" {
+			failure = "tool_start_outcome_unknown"
+		}
+		exit, joined = stopMain(context.WithoutCancel(ctx), process, exits)
+	}
+	if !joined {
+		return Result{Failure: "tool_stop_unconfirmed", Quarantine: true}
+	}
+	// Native result frames must drain before classification; a completed background
+	// process keeping an inherited descriptor cannot pin this transport indefinitely.
+	ioDone := make(chan struct{})
+	go func() { process.IO().Wait(); close(ioDone) }()
+	select {
+	case <-ioDone:
+	case <-time.After(time.Second):
+		process.IO().Cancel()
+		<-ioDone
+	}
+	output.finish()
+	data := output.resultBytes()
+	select {
+	case <-output.failed:
+		interrupted = true
+		failure = "tool_output_invalid"
+	default:
+	}
+	marker, _ := output.resultState()
+	valid := validResult(marker, r)
+	if !r.Probe && !output.executionCompleted(r.OperationID) && (interrupted || !settledScopeExit(exit.ExitCode()) || !valid) {
+		if err := d.stopGroup(context.WithoutCancel(ctx), task, processSpec, r.OperationID); err != nil {
+			return Result{Failure: "tool_scope_stop_unconfirmed", Quarantine: true}
+		}
+	}
+	if interrupted {
+		return Result{Failure: failure}
+	}
+	if !settledScopeExit(exit.ExitCode()) || !valid {
+		return Result{Failure: "tool_result_unknown"}
+	}
+	if marker.Type == "worker.delivery_result" {
+		if marker.Delivered {
+			return Result{Delivered: true}
+		}
+		return Result{Failure: "tool_delivery_unconfirmed"}
+	}
+	return Result{Output: data}
+}
+
+func stopMain(ctx context.Context, p containerd.Process, exits <-chan containerd.ExitStatus) (containerd.ExitStatus, bool) {
+	stop, end := context.WithTimeout(ctx, 7*time.Second)
+	defer end()
+	_ = p.Kill(stop, syscall.SIGTERM)
+	select {
+	case status, ok := <-exits:
+		return status, ok && status.Error() == nil
+	case <-time.After(250 * time.Millisecond):
+	}
+	_ = p.Kill(stop, syscall.SIGKILL)
+	select {
+	case status, ok := <-exits:
+		return status, ok && status.Error() == nil
+	case <-stop.Done():
+		return containerd.ExitStatus{}, false
+	}
+}
+
+func (d *ContainerdDriver) stopGroup(ctx context.Context, task containerd.Task, spec specs.Process, id string) error {
+	ctx, end := context.WithTimeout(ctx, 8*time.Second)
+	defer end()
+	// Keep exit observation alive through the existing final cleanup budget.
+	lifetime, endLifetime := context.WithTimeout(context.WithoutCancel(ctx), 8*time.Second+finalCleanupKillTimeout)
+	defer endLifetime()
+	spec.Args = []string{"/usr/local/bin/node", guestScopeProgram, "stop", id}
+	output := newToolOutput(8192, func(json.RawMessage) {})
+	input, endInput := rawTerminalInput(ctx, output, nil, "", nil)
+	defer endInput()
+	p, err := task.Exec(ctx, "ps-"+id, &spec, cio.NewCreator(cio.WithFIFODir(d.FIFODirectory), cio.WithTerminal, cio.WithStreams(input, output, nil)))
+	if err != nil {
+		return err
+	}
+	defer func() {
+		p.IO().Cancel()
+		_ = p.IO().Close()
+		remove, endRemove := context.WithTimeout(context.WithoutCancel(ctx), time.Second)
+		defer endRemove()
+		_, _ = p.Delete(remove)
+	}()
+	exits, err := p.Wait(lifetime)
+	if err != nil {
+		return err
+	}
+	if err = p.Start(ctx); err != nil {
+		return err
+	}
+	var exit containerd.ExitStatus
+	joined := false
+	select {
+	case status, ok := <-exits:
+		exit, joined = status, ok && status.Error() == nil
+	case <-ctx.Done():
+		kill, endKill := context.WithTimeout(context.WithoutCancel(ctx), finalCleanupKillTimeout)
+		defer endKill()
+		header, at := output.resultState()
+		deadline, bounded := ctx.Deadline()
+		if header.Type == "scope.stop_result" && header.Empty && !at.IsZero() && (!bounded || !at.After(deadline)) {
+			// Expired input releases a receipt waiter; join it before signalling.
+			grace := time.NewTimer(250 * time.Millisecond)
+			select {
+			case status, ok := <-exits:
+				exit, joined = status, ok && status.Error() == nil
+			case <-grace.C:
+			}
+			grace.Stop()
+		}
+		if !joined {
+			_ = p.Kill(kill, syscall.SIGKILL)
+			return ctx.Err()
+		}
+	}
+	if !joined || !settledScopeExit(exit.ExitCode()) {
+		return errors.New("scope cleanup failed")
+	}
+	drained := make(chan struct{})
+	go func() { p.IO().Wait(); close(drained) }()
+	select {
+	case <-drained:
+	case <-time.After(time.Second):
+		p.IO().Cancel()
+		<-drained
+	}
+	output.finish()
+	select {
+	case <-output.failed:
+		return errors.New("invalid scope stopping proof")
+	default:
+	}
+	result, _ := output.resultState()
+	if result.Type != "scope.stop_result" || !result.Empty {
+		return errors.New("scope empty proof missing")
+	}
+	return nil
+}
+
+func newToolOutput(limit int64, progress func(json.RawMessage)) *toolOutput {
+	return &toolOutput{limit: limit, failed: make(chan struct{}), ready: make(chan struct{}), complete: make(chan struct{}), progress: progress}
+}
+
+// Raw mode is established by the guest before ready, so request bytes cannot be
+// echoed or line-transformed. The final receipt lets it exit only after the
+// immutable result has reached the native executor (not after Kafka delivery).
+func rawTerminalInput(ctx context.Context, output *toolOutput, payload []byte, operationID string, interruption <-chan struct{}) (io.Reader, func()) {
+	return executionInput(ctx, output.ready, output.complete, payload, operationID, interruption)
+}
diff --git a/Cubelet/pkg/execution/containerd_completion_test.go b/Cubelet/pkg/execution/containerd_completion_test.go
new file mode 100644
index 0000000..b547f26
--- /dev/null
+++ b/Cubelet/pkg/execution/containerd_completion_test.go
@@ -0,0 +1,243 @@
+package execution
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	containerd "github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/pkg/cio"
+	"github.com/opencontainers/runtime-spec/specs-go"
+)
+
+func completedFrame(r Request, lost bool) []byte {
+	data, _ := json.Marshal(map[string]interface{}{"type": "worker.delivery_result", "toolWorkerProtocolVersion": 7, "executionComplete": true, "delivered": !lost, "operationId": r.OperationID})
+	return append(data, '\n')
+}
+
+type completionProcess struct {
+	containerd.Process
+	t           *testing.T
+	io          cio.IO
+	frames      []byte
+	code        uint32
+	receipt     bool
+	exits       chan containerd.ExitStatus
+	kills       atomic.Int32
+	exitDelay   time.Duration
+	waitContext context.Context
+}
+
+func (p *completionProcess) Start(context.Context) error {
+	go func() {
+		defer func() {
+			time.Sleep(p.exitDelay)
+			p.exits <- *containerd.NewExitStatus(p.code, time.Now(), p.waitContext.Err())
+			close(p.exits)
+		}()
+		out, err := os.OpenFile(p.io.Config().Stdout, os.O_WRONLY, 0)
+		if err != nil {
+			p.t.Error(err)
+			return
+		}
+		defer out.Close()
+		if _, err := out.Write(p.frames); err != nil {
+			return
+		}
+		if !p.receipt {
+			return
+		}
+		in, err := os.OpenFile(p.io.Config().Stdin, os.O_RDONLY, 0)
+		if err != nil {
+			p.t.Error(err)
+			return
+		}
+		defer in.Close()
+		scan := bufio.NewScanner(in)
+		for scan.Scan() {
+			if scan.Text() == `{"type":"scope.received"}` {
+				return
+			}
+		}
+	}()
+	return nil
+}
+func (p *completionProcess) Wait(ctx context.Context) (<-chan containerd.ExitStatus, error) {
+	p.waitContext = ctx
+	return p.exits, nil
+}
+func (p *completionProcess) Kill(context.Context, syscall.Signal, ...containerd.KillOpts) error {
+	p.kills.Add(1)
+	return nil
+}
+func (p *completionProcess) IO() cio.IO { return p.io }
+func (p *completionProcess) Delete(context.Context, ...containerd.ProcessDeleteOpts) (*containerd.ExitStatus, error) {
+	return containerd.NewExitStatus(p.code, time.Now(), nil), nil
+}
+
+type completionTask struct {
+	containerd.Task
+	t                *testing.T
+	frames           []byte
+	code             uint32
+	receipt          bool
+	cleanupCode      uint32
+	cleanups         int
+	cleanupExitDelay time.Duration
+}
+
+func (t *completionTask) Spec(context.Context) (*specs.Spec, error) {
+	return &specs.Spec{Process: &specs.Process{}}, nil
+}
+func (t *completionTask) Exec(_ context.Context, id string, _ *specs.Process, creator cio.Creator) (containerd.Process, error) {
+	output, err := creator(id)
+	if err != nil {
+		return nil, err
+	}
+	frames, code, receipt := t.frames, t.code, t.receipt
+	if strings.HasPrefix(id, "ps-") {
+		t.cleanups++
+		frames = []byte("{\"type\":\"scope.ready\"}\n{\"type\":\"scope.stop_result\",\"empty\":true}\n")
+		code, receipt = t.cleanupCode, true
+	}
+	return &completionProcess{t: t.t, io: output, frames: frames, code: code, receipt: receipt, exits: make(chan containerd.ExitStatus, 1), exitDelay: t.cleanupExitDelay}, nil
+}
+
+func TestCompletedScopeReceiptOutcomes(t *testing.T) {
+	for _, c := range []struct {
+		name                                                       string
+		code                                                       uint32
+		lost, badIdentity, partial, duplicate, executed, delivered bool
+		cleanups                                                   int
+	}{
+		{"normal", 0, false, false, false, false, true, true, 0},
+		{"http_ack_lost_keeps_background", 0, true, false, false, false, true, false, 0},
+		{"unfinished_scope_failure", 1, false, false, false, false, false, false, 1},
+		{"wrong_identity", 0, false, true, false, false, false, false, 1},
+		{"partial_after_execution", 0, false, false, true, false, true, false, 0},
+		{"duplicate_after_execution", 0, false, false, false, true, true, false, 0},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			r := request()
+			frame := completedFrame(r, c.lost)
+			if c.badIdentity {
+				frame = completedFrame(request(), false)
+			}
+			frames := []byte("{\"type\":\"scope.ready\"}\n")
+			if c.executed {
+				frames = append(frames, []byte(fmt.Sprintf("{\"type\":\"scope.executed\",\"operationId\":%q}\n", r.OperationID))...)
+			}
+			frames = append(frames, frame...)
+			if c.partial {
+				frames = append(frames, []byte(`{"unfinished":`)...)
+			}
+			if c.duplicate {
+				frames = append(frames, frame...)
+			}
+			task := &completionTask{t: t, frames: frames, code: c.code, cleanupCode: scopeReceiptUnconfirmed}
+			driver := &ContainerdDriver{FIFODirectory: t.TempDir(), Resolve: func(context.Context, Request) (ResolvedTask, error) {
+				return ResolvedTask{Task: task, Namespace: "completion-test"}, nil
+			}}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			result := driver.Run(ctx, r, func(json.RawMessage) {})
+			if result.Delivered != c.delivered || len(result.Output) > 0 || task.cleanups != c.cleanups || result.Quarantine {
+				t.Fatalf("result=%+v cleanups=%d", result, task.cleanups)
+			}
+		})
+	}
+}
+
+func TestCompletedFrameGetsBoundedSettlementAfterExecutionDeadline(t *testing.T) {
+	r := request()
+	output := newToolOutput(4096, func(json.RawMessage) {})
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if _, err := output.Write(completedFrame(r, false)); err != nil {
+		t.Fatal(err)
+	}
+	<-ctx.Done()
+	exits := make(chan containerd.ExitStatus, 1)
+	go func() {
+		time.Sleep(20 * time.Millisecond)
+		exits <- *containerd.NewExitStatus(scopeReceiptUnconfirmed, time.Now(), nil)
+	}()
+	status, joined, failure := waitToolExit(ctx, r, output, exits)
+	if !joined || failure != "" || status.ExitCode() != scopeReceiptUnconfirmed {
+		t.Fatalf("joined=%t failure=%s", joined, failure)
+	}
+}
+
+func TestLateFrameOrCancelledContextDoesNotAcquireSettlementGrace(t *testing.T) {
+	for _, mode := range []string{"late_frame", "context_cancelled", "sync_probe_deadline", "async_probe_deadline"} {
+		t.Run(mode, func(t *testing.T) {
+			r := request()
+			output := newToolOutput(4096, func(json.RawMessage) {})
+			ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+			defer cancel()
+			if mode == "context_cancelled" {
+				cancel()
+			} else {
+				<-ctx.Done()
+			}
+			frame := completedFrame(r, false)
+			if mode == "sync_probe_deadline" {
+				r.Probe = true
+				r.CompletionContext = nil
+				frame = []byte(fmt.Sprintf("{\"type\":\"worker.probe_result\",\"probeId\":%q}\n", r.OperationID))
+			}
+			if mode == "async_probe_deadline" {
+				r.Probe = true
+			}
+			if _, err := output.Write(frame); err != nil {
+				t.Fatal(err)
+			}
+			_, joined, failure := waitToolExit(ctx, r, output, make(chan containerd.ExitStatus))
+			if joined || failure != "tool_cancelled" {
+				t.Fatalf("joined=%t failure=%s", joined, failure)
+			}
+		})
+	}
+}
+
+func TestScopeReceiptCodeRequiresCompleteValidResult(t *testing.T) {
+	for _, frame := range []string{`{"type":"worker.delivery_result"}`, `{"type":"scope.stop_result","empty":true}`} {
+		var h resultHeader
+		if err := json.Unmarshal([]byte(frame), &h); err != nil {
+			t.Fatal(err)
+		}
+		if validResult(h, request()) {
+			t.Fatal("accepted missing/wrong result proof")
+		}
+	}
+}
+
+func TestCompleteFrameDoesNotGrantUnboundedSettlement(t *testing.T) {
+	r := request()
+	output := newToolOutput(4096, func(json.RawMessage) {})
+	if _, err := output.Write(completedFrame(r, false)); err != nil {
+		t.Fatal(err)
+	}
+	started := time.Now()
+	_, joined, failure := waitToolExit(context.Background(), r, output, make(chan containerd.ExitStatus))
+	if joined || failure != "tool_settlement_unconfirmed" || time.Since(started) > 9*time.Second {
+		t.Fatalf("unbounded or false settlement: joined=%t failure=%s", joined, failure)
+	}
+}
+
+func TestStopProofSurvivesReceiptExitJustAfterDeadline(t *testing.T) {
+	task := &completionTask{t: t, cleanupCode: scopeReceiptUnconfirmed, cleanupExitDelay: 400 * time.Millisecond}
+	driver := &ContainerdDriver{FIFODirectory: t.TempDir()}
+	ctx, cancel := context.WithTimeout(context.Background(), 250*time.Millisecond)
+	defer cancel()
+	if err := driver.stopGroup(ctx, task, specs.Process{}, request().OperationID); err != nil {
+		t.Fatalf("lost a completed scope proof to receipt deadline: %v", err)
+	}
+}
diff --git a/Cubelet/pkg/execution/containerd_lifetime_test.go b/Cubelet/pkg/execution/containerd_lifetime_test.go
new file mode 100644
index 0000000..6ff3148
--- /dev/null
+++ b/Cubelet/pkg/execution/containerd_lifetime_test.go
@@ -0,0 +1,173 @@
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	containerd "github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/pkg/cio"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/opencontainers/runtime-spec/specs-go"
+)
+
+type lifetimeProcess struct {
+	containerd.Process
+	start   func(context.Context) error
+	kill    func(context.Context) error
+	deleted *int
+	exits   <-chan containerd.ExitStatus
+}
+
+func (p lifetimeProcess) Start(ctx context.Context) error {
+	if p.start != nil {
+		return p.start(ctx)
+	}
+	return nil
+}
+func (p lifetimeProcess) Kill(ctx context.Context, _ syscall.Signal, _ ...containerd.KillOpts) error {
+	if p.kill != nil {
+		return p.kill(ctx)
+	}
+	return nil
+}
+func (p lifetimeProcess) Wait(context.Context) (<-chan containerd.ExitStatus, error) {
+	return p.exits, nil
+}
+func (p lifetimeProcess) Delete(ctx context.Context, _ ...containerd.ProcessDeleteOpts) (*containerd.ExitStatus, error) {
+	if p.deleted != nil {
+		*p.deleted++
+	}
+	return containerd.NewExitStatus(0, time.Now(), nil), nil
+}
+func (p lifetimeProcess) IO() cio.IO { return namespaceIO{} }
+
+type lifetimeTask struct {
+	containerd.Task
+	spec func(context.Context) (*specs.Spec, error)
+	exec func(string) (containerd.Process, error)
+}
+
+func (t lifetimeTask) Spec(ctx context.Context) (*specs.Spec, error) {
+	if t.spec != nil {
+		return t.spec(ctx)
+	}
+	return &specs.Spec{Process: &specs.Process{}}, nil
+}
+func (t lifetimeTask) Exec(_ context.Context, id string, _ *specs.Process, _ cio.Creator) (containerd.Process, error) {
+	return t.exec(id)
+}
+
+func TestCleanupKillKeepsNamespaceAndIndependentDeadline(t *testing.T) {
+	ctx, cancel := context.WithTimeout(namespaces.WithNamespace(context.Background(), "owned-runtime"), 20*time.Millisecond)
+	defer cancel()
+	killed := false
+	task := lifetimeTask{exec: func(string) (containerd.Process, error) {
+		return lifetimeProcess{
+			exits: make(chan containerd.ExitStatus),
+			kill: func(kill context.Context) error {
+				killed = true
+				deadline, bounded := kill.Deadline()
+				if !bounded || deadline.After(time.Now().Add(6*time.Second)) {
+					t.Error("cleanup Kill is not bounded")
+					return errors.New("invalid Kill budget")
+				}
+				if kill.Err() != nil {
+					t.Error("Kill reused an already expired context")
+				}
+				if ns, _ := namespaces.Namespace(kill); ns != "owned-runtime" {
+					t.Error("cleanup lost native namespace")
+				}
+				<-kill.Done() // A stalled RPC must release the driver when this budget expires.
+				return kill.Err()
+			},
+		}, nil
+	}}
+	started := time.Now()
+	err := (&ContainerdDriver{}).stopGroup(ctx, task, specs.Process{}, request().OperationID)
+	if !killed || !errors.Is(err, context.DeadlineExceeded) || time.Since(started) > 7*time.Second {
+		t.Fatalf("unbounded cleanup or false success: %v", err)
+	}
+}
+
+func TestExpiredOrCancelledPreparationDoesNotStartNativeProcess(t *testing.T) {
+	for _, mode := range []string{"already_expired", "expired_during_setup", "cancelled_during_setup"} {
+		t.Run(mode, func(t *testing.T) {
+			budget := time.Minute
+			if mode == "already_expired" {
+				budget = -time.Second
+			} else if mode == "expired_during_setup" {
+				budget = 20 * time.Millisecond
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), budget)
+			defer cancel()
+			interrupt := make(chan struct{})
+			resolved, starts, deletes := 0, 0, 0
+			task := lifetimeTask{
+				spec: func(context.Context) (*specs.Spec, error) {
+					if mode == "expired_during_setup" {
+						<-ctx.Done()
+					} else if mode == "cancelled_during_setup" {
+						close(interrupt)
+					}
+					return &specs.Spec{Process: &specs.Process{}}, nil
+				},
+				exec: func(string) (containerd.Process, error) {
+					exits := make(chan containerd.ExitStatus, 1)
+					return lifetimeProcess{exits: exits, deleted: &deletes, start: func(context.Context) error {
+						starts++
+						exits <- *containerd.NewExitStatus(1, time.Now(), nil)
+						return nil
+					}}, nil
+				},
+			}
+			driver := &ContainerdDriver{Resolve: func(context.Context, Request) (ResolvedTask, error) {
+				resolved++
+				return ResolvedTask{Task: task, Namespace: "owned-runtime"}, nil
+			}}
+			r := request()
+			r.Interrupt = interrupt
+			result := driver.Run(ctx, r, func(json.RawMessage) {})
+			want := "execution_not_started"
+			if mode == "cancelled_during_setup" {
+				want = "tool_cancelled_before_start"
+			}
+			if result.Failure != want || result.Quarantine || starts != 0 {
+				t.Fatalf("incorrect unstarted result: %+v; starts=%d", result, starts)
+			}
+			if mode == "already_expired" {
+				if resolved != 0 || deletes != 0 {
+					t.Fatal("expired request still acquired a process")
+				}
+			} else if deletes != 1 {
+				t.Fatal("unstarted native handle was not deleted")
+			}
+		})
+	}
+}
+
+func TestLostStartReplyNeverBecomesNotStarted(t *testing.T) {
+	starts := 0
+	task := lifetimeTask{exec: func(id string) (containerd.Process, error) {
+		exits := make(chan containerd.ExitStatus, 1)
+		exits <- *containerd.NewExitStatus(1, time.Now(), nil)
+		return lifetimeProcess{exits: exits, start: func(context.Context) error {
+			if strings.HasPrefix(id, "pc-") {
+				starts++
+				return context.DeadlineExceeded
+			}
+			return nil
+		}}, nil
+	}}
+	driver := &ContainerdDriver{Resolve: func(context.Context, Request) (ResolvedTask, error) {
+		return ResolvedTask{Task: task, Namespace: "owned-runtime"}, nil
+	}}
+	result := driver.Run(context.Background(), request(), func(json.RawMessage) {})
+	if starts != 1 || result.Failure == "" || result.Failure == "execution_not_started" || result.Failure == "tool_cancelled_before_start" {
+		t.Fatalf("lost Start reply lost uncertainty: %+v starts=%d", result, starts)
+	}
+}
