@@ -0,0 +1,81 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cube
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/errorcode"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox/types"
+	"net/http"
+)
+
+func resumeManagedCreate(ctx context.Context, r *allocation.Record) *types.CreateCubeSandboxRes {
+	record, err := sandbox.ReconcileAllocation(ctx, r.ID, false, r.NotAfter, true)
+	if err == nil && record != nil && record.Phase == "ready" && !record.Closed && record.Result != "" {
+		var response types.CreateCubeSandboxRes
+		if json.Unmarshal([]byte(record.Result), &response) == nil {
+			return &response
+		}
+	}
+	return &types.CreateCubeSandboxRes{RequestID: r.ID, Ret: &types.Ret{RetCode: int(errorcode.ErrorCode_ReqCubeAPIFailed), RetMsg: "allocation_creation_unconfirmed"}}
+}
+func handleManagedAllocation(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	var input struct {
+		ID         string `json:"allocationID"`
+		NotAfter   int64  `json:"createBefore"`
+		ObservedAt int64  `json:"observedAt"`
+	}
+	if json.NewDecoder(c.Request.Body).Decode(&input) != nil || !allocation.ValidID(input.ID) || input.NotAfter <= 0 {
+		c.JSON(400, gin.H{"error": "invalid_allocation_request"})
+		return
+	}
+	action := c.Param("action")
+	if action == "renew" {
+		until, err := sandbox.RenewManagedAllocation(c.Request.Context(), input.ID, input.NotAfter, input.ObservedAt)
+		if err != nil {
+			c.JSON(409, gin.H{"error": "retention_unconfirmed"})
+			return
+		}
+		c.JSON(200, gin.H{"allocationID": input.ID, "retainUntil": until})
+		return
+	}
+	if action != "get" && action != "close" {
+		c.JSON(404, gin.H{"error": "unknown_allocation_action"})
+		return
+	}
+	r, err := sandbox.ReconcileAllocation(c.Request.Context(), input.ID, action == "close", input.NotAfter, false)
+	if err != nil {
+		c.JSON(503, gin.H{"error": "allocation_unconfirmed"})
+		return
+	}
+	if r == nil {
+		c.JSON(200, gin.H{"allocationID": input.ID, "createBefore": input.NotAfter, "phase": "missing", "closed": false})
+		return
+	}
+	if r.NotAfter != input.NotAfter {
+		c.JSON(409, gin.H{"error": "allocation_parameters_changed"})
+		return
+	}
+	response := gin.H{"allocationID": r.ID, "createBefore": r.NotAfter, "sandboxID": r.SandboxID, "nodeID": r.NodeID, "phase": r.Phase, "closed": r.Closed}
+	if r.RetentionWindow > 0 {
+		response["retentionWindowMs"] = r.RetentionWindow
+		response["retainUntil"] = r.RetainUntil
+	}
+	if r.Phase == "ready" && !r.Closed && r.Result != "" {
+		var created types.CreateCubeSandboxRes
+		var original types.CreateCubeSandboxReq
+		if json.Unmarshal([]byte(r.Result), &created) != nil || json.Unmarshal([]byte(r.Request), &original) != nil {
+			c.JSON(503, gin.H{"error": "allocation_receipt_invalid"})
+			return
+		}
+		response["instance"] = gin.H{"sandboxID": r.SandboxID, "templateID": original.Annotations[constants.CubeAnnotationAppSnapshotTemplateID], "clientID": r.NodeID, "metadata": original.Labels, "trafficAccessToken": created.TrafficAccessToken}
+	}
+	c.JSON(200, response)
+	_ = allocation.Default().Collect(c.Request.Context())
+}
