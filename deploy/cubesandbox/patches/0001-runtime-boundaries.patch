index 0000000..7b04374
--- /dev/null
+++ b/Cubelet/plugins/volume/stale_reference_test.go
@@ -0,0 +1,229 @@
+package volume
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+)
+
+func TestMissingHistoricalHolderIdentityRemainsUnknown(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "refs.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	store, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = raw.Update(func(tx *bolt.Tx) error {
+		data, e := json.Marshal(refcount.RefCountRecord{Unknown: true, Driver: "picloud-posix"})
+		if e != nil {
+			return e
+		}
+		return tx.Bucket([]byte(refcount.BucketName)).Put([]byte("default\x00lost"), data)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &referencePlugin{}
+	m := &Manager{byName: map[string]VolumePlugin{"picloud-posix": p}, rcStore: store}
+	for n := 0; n < 3; n++ {
+		if _, err = store.RecoverRefCounts(nil); err != nil {
+			t.Fatal(err)
+		}
+		state, e := m.ReconcileReference(context.Background(), "default", "lost", func(context.Context, string) (bool, error) { t.Fatal("invented lost identity"); return true, nil })
+		if e != nil || state.Confirmed || p.detaches != 0 {
+			t.Fatal(state, e)
+		}
+	}
+}
+
+func TestStaleHolderEvidenceSurvivesRestartAndDetachFailure(t *testing.T) {
+	for _, shared := range []bool{false, true} {
+		for _, loseReceipt := range []bool{false, true} {
+			t.Run(fmtCase(shared, loseReceipt), func(t *testing.T) {
+				raw, err := bolt.Open(filepath.Join(t.TempDir(), "refs.db"), 0600, nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer raw.Close()
+				db := &failReceiptDB{DB: raw}
+				store, err := refcount.New(db)
+				if err != nil {
+					t.Fatal(err)
+				}
+				p := &referencePlugin{}
+				m := &Manager{byName: map[string]VolumePlugin{"picloud-posix": p}, rcStore: store}
+				ctx := context.Background()
+				attach := func(id, vol string) error {
+					_, err := m.Attach(ctx, &AttachRequest{Namespace: "default", VolumeID: vol, SandboxID: id, Driver: "picloud-posix"})
+					return err
+				}
+				if err := attach("lost", "shared"); err != nil {
+					t.Fatal(err)
+				}
+				live := map[string]struct{}{}
+				if shared {
+					if err := attach("survivor", "shared"); err != nil {
+						t.Fatal(err)
+					}
+					live["survivor"] = struct{}{}
+				}
+				before, _ := store.State("default", "shared")
+				recovery, err := store.RecoverRefCounts(live)
+				if err != nil || recovery.StaleRefsMarked != 1 {
+					t.Fatal(recovery, err)
+				}
+				rec, _, _ := store.GetRecord("default", "shared")
+				if len(rec.StaleSandboxIDs) != 1 || len(rec.SandboxIDs) != len(live)+1 || rec.Unknown {
+					t.Fatal(rec)
+				}
+				if recovery, err = store.RecoverRefCounts(live); err != nil || recovery.StaleRefsMarked != 0 {
+					t.Fatal(recovery, err)
+				}
+				if err := attach("late", "shared"); err == nil {
+					t.Fatal("late attachment admitted")
+				}
+				if err := attach("other", "unrelated"); err != nil {
+					t.Fatal(err)
+				}
+				uncertain, err := m.ReconcileReference(ctx, "default", "shared", func(context.Context, string) (bool, error) { return false, errors.New("node evidence unavailable") })
+				if err != nil || uncertain.Confirmed || uncertain.Epoch != before.Epoch || uncertain.Revision <= before.Revision {
+					t.Fatal(uncertain, err)
+				}
+				if p.detaches != 0 {
+					t.Fatal("detached without evidence")
+				}
+				if loseReceipt {
+					p.onDetach = func(*DetachRequest) { db.fail = true; p.onDetach = nil }
+				}
+				prove := func(_ context.Context, id string) (bool, error) {
+					if id != "lost" {
+						t.Fatal("surviving holder probed as stale", id)
+					}
+					return true, nil
+				}
+				state, err := m.ReconcileReference(ctx, "default", "shared", prove)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if loseReceipt {
+					if state.Confirmed {
+						t.Fatal("lost receipt was confirmed")
+					}
+					// A new Store/Manager models a node restart after the hook.
+					store, err = refcount.New(db)
+					if err != nil {
+						t.Fatal(err)
+					}
+					m = &Manager{byName: map[string]VolumePlugin{"picloud-posix": p}, rcStore: store}
+					state, err = m.ObserveReference(ctx, "default", "shared")
+				}
+				if err != nil || !state.Confirmed || state.Count != int64(len(live)) {
+					t.Fatal(state, err)
+				}
+				if shared {
+					if err = m.Detach(ctx, &DetachRequest{Namespace: "default", VolumeID: "shared", SandboxID: "survivor", Driver: "picloud-posix"}); err != nil {
+						t.Fatal(err)
+					}
+				}
+				state, err = m.ObserveReference(ctx, "default", "shared")
+				if err != nil || !state.Confirmed || state.Count != 0 {
+					t.Fatal(state, err)
+				}
+				if state.Epoch != before.Epoch || state.Revision <= uncertain.Revision {
+					t.Fatal("nonmonotonic reference state")
+				}
+			})
+		}
+	}
+}
+
+func fmtCase(shared, receipt bool) string {
+	if shared {
+		if receipt {
+			return "shared-lost-receipt"
+		}
+		return "shared"
+	}
+	if receipt {
+		return "last-lost-receipt"
+	}
+	return "last"
+}
+
+func TestStaleHolderAllowsSurvivorDetachButNotUnprovenOrForeignRecovery(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "refs.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	store, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &referencePlugin{}
+	m := &Manager{byName: map[string]VolumePlugin{"test": p}, rcStore: store}
+	for _, id := range []string{"lost", "survivor"} {
+		_, err = m.Attach(context.Background(), &AttachRequest{Namespace: "default", VolumeID: "v", SandboxID: id, Driver: "test"})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err = store.RecoverRefCounts(map[string]struct{}{"survivor": {}}); err != nil {
+		t.Fatal(err)
+	}
+	if err = m.Detach(context.Background(), &DetachRequest{Namespace: "default", VolumeID: "v", SandboxID: "survivor", Driver: "test"}); err != nil {
+		t.Fatal(err)
+	}
+	state, err := m.ReconcileReference(context.Background(), "default", "v", func(context.Context, string) (bool, error) { t.Fatal("foreign plugin recovery"); return true, nil })
+	if err != nil || state.Confirmed || state.Count != 1 || p.detaches != 1 {
+		t.Fatal(state, err, p.detaches)
+	}
+}
+
+func TestStaleHolderReconciliationSerializesLateAttachment(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "refs.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	store, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &referencePlugin{}
+	m := &Manager{byName: map[string]VolumePlugin{"picloud-posix": p}, rcStore: store}
+	_, err = m.Attach(context.Background(), &AttachRequest{Namespace: "default", VolumeID: "v", SandboxID: "lost", Driver: "picloud-posix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	store.RecoverRefCounts(nil)
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	go func() {
+		_, err := m.ReconcileReference(context.Background(), "default", "v", func(context.Context, string) (bool, error) { close(entered); <-release; return true, nil })
+		done <- err
+	}()
+	<-entered
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	_, err = m.Attach(ctx, &AttachRequest{Namespace: "default", VolumeID: "v", SandboxID: "new", Driver: "picloud-posix"})
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatal(err)
+	}
+	close(release)
+	if err = <-done; err != nil {
+		t.Fatal(err)
+	}
+	_, err = m.Attach(context.Background(), &AttachRequest{Namespace: "default", VolumeID: "v", SandboxID: "new", Driver: "picloud-posix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/Cubelet/services/cubebox/allocation.go b/Cubelet/services/cubebox/allocation.go
new file mode 100644
index 0000000..32b5a46
--- /dev/null
+++ b/Cubelet/services/cubebox/allocation.go
@@ -0,0 +1,222 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cubebox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/google/uuid"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume"
+	"github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"github.com/tencentcloud/CubeSandbox/pkgs/proto/services/errorcode/v1"
+	"google.golang.org/protobuf/encoding/protojson"
+	"strconv"
+	"strings"
+)
+
+const allocationIDAnnotation = "pi-cloud.allocation.id"
+const allocationDeadlineAnnotation = "pi-cloud.allocation.create-before"
+const allocationDigestAnnotation = "pi-cloud.allocation.digest"
+
+func (s *service) createAllocation(ctx context.Context, req *cubebox.RunCubeSandboxRequest) (*cubebox.RunCubeSandboxResponse, error) {
+	if s.allocations == nil {
+		return nil, errors.New("allocation metadata unavailable")
+	}
+	a := req.GetAnnotations()
+	deadline, e := strconv.ParseInt(a[allocationDeadlineAnnotation], 10, 64)
+	if e != nil {
+		return nil, e
+	}
+	identity := allocation.Identity{ID: a[allocationIDAnnotation], Digest: a[allocationDigestAnnotation], NotAfter: deadline, BootID: a["pi-cloud.allocation.node-boot"]}
+	if value := req.Labels["picloud.retention_window_ms"]; value != "" {
+		identity.RetentionWindow, e = strconv.ParseInt(value, 10, 64)
+		if e != nil || identity.RetentionWindow < 1000 || identity.RetentionWindow > 86400000 {
+			return nil, errors.New("invalid retention policy")
+		}
+	}
+	record, e := s.allocations.Create(ctx, identity, s.config.createDeadline, func(ctx context.Context) (json.RawMessage, bool, error) {
+		reply, err := s.createNative(ctx, req)
+		if err != nil {
+			return nil, false, err
+		}
+		result, err := protojson.Marshal(reply)
+		return result, reply.GetRet().GetRetCode() == errorcode.ErrorCode_Success, err
+	})
+	if e != nil {
+		return nil, e
+	}
+	if record.Closed {
+		return nil, allocation.ErrClosed
+	}
+	if len(record.Result) == 0 {
+		return nil, errors.New("allocation creation outcome unconfirmed")
+	}
+	var reply cubebox.RunCubeSandboxResponse
+	if e = protojson.Unmarshal(record.Result, &reply); e != nil {
+		return nil, e
+	}
+	return &reply, nil
+}
+func (s *service) cleanupAllocation(ctx context.Context, r allocation.Record) (json.RawMessage, bool, error) {
+	_, err := s.cubeboxMgr.cubeboxManger.Observe(ctx, r.SandboxID)
+	if errors.Is(err, utils.ErrorKeyNotFound) {
+		if !r.CreateFinished && r.StartedBoot != "" && r.StartedBoot != s.allocations.BootID {
+			return nil, false, errors.New("unfinished previous-boot creation requires physical recovery")
+		}
+		return r.CleanupResult, true, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	reply, err := s.destroyNative(ctx, &cubebox.DestroyCubeSandboxRequest{RequestID: uuid.NewString(), SandboxID: r.SandboxID})
+	if err != nil {
+		return nil, false, err
+	}
+	if reply.GetRet().GetRetCode() != errorcode.ErrorCode_Success {
+		return nil, false, errors.New("allocation physical cleanup unconfirmed")
+	}
+	result, err := protojson.Marshal(reply)
+	if err != nil {
+		return nil, false, err
+	}
+	_, err = s.cubeboxMgr.cubeboxManger.Observe(ctx, r.SandboxID)
+	if errors.Is(err, utils.ErrorKeyNotFound) {
+		return result, true, nil
+	}
+	return nil, false, err
+}
+func (s *service) ManageAllocation(ctx context.Context, req *cubebox.AllocationRequest) (*cubebox.AllocationResponse, error) {
+	if s.allocations == nil {
+		return nil, errors.New("allocation metadata unavailable")
+	}
+	if req.AllocationId == "" && !req.Close {
+		rc := volume.Global().RefCountStore()
+		if rc == nil {
+			return nil, errors.New("Volume reference metadata unavailable")
+		}
+		state, err := rc.State("default", "")
+		if err != nil {
+			return nil, err
+		}
+		raw, err := json.Marshal(map[string]string{"referenceEpoch": state.Epoch})
+		return &cubebox.AllocationResponse{BootId: s.allocations.BootID, Record: raw}, err
+	}
+	i := allocation.Identity{ID: req.AllocationId, Digest: req.Digest, NotAfter: req.CreateBefore, BootID: req.ExpectedBoot}
+	if e := i.Validate(); e != nil {
+		return nil, e
+	}
+	var r *allocation.Record
+	var e error
+	if req.ObservedAt > 0 {
+		r, e = s.allocations.Renew(i, req.ObservedAt)
+	} else if req.Close {
+		r, e = s.allocations.Close(ctx, i, s.config.destroyDeadline, s.cleanupAllocation)
+	} else {
+		r, e = s.allocations.Store.Get(i.ID)
+	}
+	if e != nil {
+		return &cubebox.AllocationResponse{Failure: "allocation_unconfirmed"}, nil
+	}
+	if r == nil {
+		return &cubebox.AllocationResponse{Failure: "allocation_not_recorded", BootId: s.allocations.BootID}, nil
+	}
+	if r.Digest != i.Digest || r.NotAfter != i.NotAfter {
+		return nil, allocation.ErrConflict
+	}
+	data, e := json.Marshal(r)
+	if e != nil {
+		return nil, e
+	}
+	return &cubebox.AllocationResponse{Record: data, BootId: s.allocations.BootID}, nil
+}
+
+// Reuse Cubelet's existing maintenance tick and allocation Close journal.
+func (s *service) expireIdleAllocations(ctx context.Context) {
+	if s.allocations == nil {
+		return
+	}
+	// Receipt collection belongs to maintenance, not every renewal request.
+	_ = s.allocations.Store.Collect()
+	rows, err := s.allocations.Store.Due(128)
+	if err != nil {
+		return
+	}
+	for _, r := range rows {
+		s.retentionMu.Lock()
+		if s.retentionClosing || len(s.retentionCleaning) >= 4 {
+			s.retentionMu.Unlock()
+			break
+		}
+		if s.retentionCleaning[r.ID] {
+			s.retentionMu.Unlock()
+			continue
+		}
+		if s.retentionCleaning == nil {
+			s.retentionCleaning = make(map[string]bool)
+		}
+		s.retentionCleaning[r.ID] = true
+		s.retentionWG.Add(1)
+		s.retentionMu.Unlock()
+		go func(r allocation.Record) {
+			defer func() {
+				s.retentionMu.Lock()
+				delete(s.retentionCleaning, r.ID)
+				s.retentionMu.Unlock()
+				s.retentionWG.Done()
+			}()
+			// Finite retention is authority; an unfinished Tool cannot extend it.
+			closed, err := s.allocations.Store.BeginExpiry(r.ID)
+			if err != nil || !closed {
+				return
+			}
+			result, err := s.allocations.Close(ctx, allocation.Identity{ID: r.ID, Digest: r.Digest, NotAfter: r.NotAfter, BootID: r.StartedBoot}, s.config.destroyDeadline, s.cleanupAllocation)
+			if err != nil || result == nil || result.Phase != "absent" {
+				_ = s.allocations.Store.DeferExpiry(r.ID)
+			}
+		}(r)
+	}
+}
+
+// Existing native lifecycle deletion must also retire a managed allocation.
+func (s *service) destroyAllocation(ctx context.Context, req *cubebox.DestroyCubeSandboxRequest) (*cubebox.DestroyCubeSandboxResponse, bool, error) {
+	id, err := uuid.Parse(req.SandboxID)
+	if err != nil || strings.ReplaceAll(id.String(), "-", "") != req.SandboxID {
+		return nil, false, nil
+	}
+	r, err := s.allocations.Store.Get(id.String())
+	if err != nil {
+		return nil, true, err
+	}
+	if r == nil {
+		return nil, false, nil
+	}
+	r, err = s.allocations.Close(ctx, allocation.Identity{ID: r.ID, Digest: r.Digest, NotAfter: r.NotAfter, BootID: r.StartedBoot}, s.config.destroyDeadline, s.cleanupAllocation)
+	if err != nil {
+		return nil, true, err
+	}
+	if r.Phase != "absent" {
+		return nil, true, errors.New("allocation closure pending")
+	}
+	if len(r.CleanupResult) > 0 {
+		var reply cubebox.DestroyCubeSandboxResponse
+		if err = protojson.Unmarshal(r.CleanupResult, &reply); err != nil {
+			return nil, true, err
+		}
+		return &reply, true, nil
+	}
+	return &cubebox.DestroyCubeSandboxResponse{SandboxID: r.SandboxID, RequestID: req.RequestID, Ret: &errorcode.Ret{RetCode: errorcode.ErrorCode_Success}}, true, nil
+}
+
+func (s *service) Close() error {
+	s.retentionMu.Lock()
+	s.retentionClosing = true
+	s.retentionMu.Unlock()
+	if s.cleaner != nil {
+		s.cleaner.heartbeat.Stop()
+	}
+	s.retentionWG.Wait()
+	return nil
+}
diff --git a/Cubelet/services/cubebox/allocation_cleanup_test.go b/Cubelet/services/cubebox/allocation_cleanup_test.go
