+++ b/Cubelet/pkg/execution/delivery_http_test.go
@@ -0,0 +1,76 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: MIT
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"encoding/pem"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestHTTPSFailureDeliveryRetainsIdentityAndRequiresAck(t *testing.T) {
+	var calls atomic.Int32
+	var body []byte
+	var mu sync.Mutex
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		if r.Method != "POST" || r.URL.Path != "/v1/completions" || r.Header.Get("Authorization") != "Bearer scoped-capability" {
+			t.Error("callback scope changed")
+		}
+		bytes, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		if body != nil && string(body) != string(bytes) {
+			t.Error("retry changed failure body")
+		}
+		body = bytes
+		if calls.Add(1) == 1 {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	endpoint, _ := url.Parse(server.URL)
+	target, _ := json.Marshal(destination{URL: server.URL + "/v1/completions", Address: endpoint.Hostname(), CA: string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw})), Capability: "scoped-capability", ExpiresAt: time.Now().Add(time.Minute).UnixMilli()})
+	request := Request{OperationID: "11111111-1111-4111-8111-111111111111", CompletionContext: target}
+	delivery := &HTTPSDelivery{}
+	result := Result{Failure: "tool_start_outcome_unknown"}
+	if err := delivery.Deliver(context.Background(), request, result); err == nil {
+		t.Fatal("unconfirmed callback accepted")
+	}
+	if err := delivery.Deliver(context.Background(), request, result); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if calls.Load() != 2 || !strings.Contains(string(body), request.OperationID) || !strings.Contains(string(body), result.Failure) {
+		t.Fatal("failure identity not delivered")
+	}
+	if err := delivery.Deliver(context.Background(), Request{}, Result{Delivered: true}); err != nil || calls.Load() != 2 {
+		t.Fatal("guest delivered result resent by host")
+	}
+}
+
+func TestHTTPSFailureDeliveryRejectsExpiredOrPlaintextDestination(t *testing.T) {
+	for _, target := range []destination{
+		{URL: "http://127.0.0.1/v1/completions", Address: "127.0.0.1", Capability: "scoped", ExpiresAt: time.Now().Add(time.Minute).UnixMilli()},
+		{URL: "https://127.0.0.1/v1/completions", Address: "127.0.0.1", Capability: "scoped", ExpiresAt: time.Now().Add(-time.Minute).UnixMilli()},
+	} {
+		encoded, _ := json.Marshal(target)
+		if err := (&HTTPSDelivery{}).Deliver(context.Background(), Request{CompletionContext: encoded}, Result{Failure: "unknown"}); err == nil {
+			t.Fatal("invalid callback destination accepted")
+		}
+	}
+}
diff --git a/Cubelet/pkg/execution/manager.go b/Cubelet/pkg/execution/manager.go
new file mode 100644
index 0000000..e4a47d9
--- /dev/null
+++ b/Cubelet/pkg/execution/manager.go
@@ -0,0 +1,363 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package execution owns bounded native process lifetimes. It is not a durable
+// scheduler: callers persist intent before handoff and never replay uncertain work.
+package execution
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"regexp"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+type Position struct {
+	Topic     string `json:"topic"`
+	Partition int    `json:"partition"`
+	Offset    string `json:"offset"`
+}
+
+var topicPattern = regexp.MustCompile(`^[A-Za-z0-9._-]{1,249}$`)
+
+func (p Position) offset() (int64, error) {
+	value, err := strconv.ParseInt(p.Offset, 10, 64)
+	if err != nil || value < 0 || strconv.FormatInt(value, 10) != p.Offset ||
+		!topicPattern.MatchString(p.Topic) || p.Partition < 0 || p.Partition > 65535 {
+		return 0, errors.New("invalid_execution_position")
+	}
+	return value, nil
+}
+
+type runtimePosition struct {
+	topic      string
+	partitions map[int]int64
+}
+
+type Request struct {
+	Interrupt          <-chan struct{} `json:"-"`
+	Source             Position        `json:"source"`
+	Probe              bool            `json:"-"`
+	SandboxID          string          `json:"sandboxId"`
+	OperationID        string          `json:"operationId"`
+	RunID              string          `json:"runId"`
+	WriterID           string          `json:"writerId"`
+	Payload            json.RawMessage `json:"payload"`
+	CompletionContext  json.RawMessage `json:"context"`
+	Timeout            time.Duration   `json:"timeout"`
+	MaximumOutputBytes int64           `json:"maximumOutputBytes"`
+}
+
+type Result struct {
+	Delivered  bool            `json:"-"`
+	Output     json.RawMessage `json:"output,omitempty"`
+	Failure    string          `json:"failure,omitempty"`
+	Quarantine bool            `json:"quarantine"`
+}
+
+type Driver interface {
+	// HasRuntime reads the existing native catalog only. It runs under the
+	// admission mutex shared with ForgetRuntime; it must not probe or do I/O.
+	HasRuntime(string) bool
+	// Run joins its native main process and performs scoped stopping on context
+	// cancellation or an explicit guest timeout flag before returning.
+	Run(context.Context, Request, func(json.RawMessage)) Result
+}
+
+type Delivery interface {
+	Progress(Request, json.RawMessage)
+	Deliver(context.Context, Request, Result) error
+}
+
+type operation struct {
+	request     Request
+	fingerprint [32]byte
+	cancel      context.CancelFunc
+	interrupt   chan struct{}
+	finished    bool
+	forgotten   bool
+}
+
+// TLS CA plus an opaque scoped capability, not a raw Tool result.
+const maximumCompletionContextBytes = 32 * 1024
+
+type Manager struct {
+	// Called only for real Tool admission/settlement, never probes.
+	RuntimeActivity func(string) error
+	probes          map[string]probe
+	BootID          string
+	driver          Driver
+	delivery        Delivery
+	mu              sync.Mutex
+	operations      map[string]*operation
+	positions       map[string]*runtimePosition
+	unsafeRuntimes  map[string]bool
+	active          int
+	closed          bool
+	wg              sync.WaitGroup
+}
+
+const maximumOutstanding = 32
+const maximumRequestBytes = 1024 * 1024
+const maximumReplyBytes = 64 * 1024
+
+func New(driver Driver, delivery Delivery) *Manager {
+	return &Manager{BootID: uuid.NewString(), driver: driver, delivery: delivery, probes: make(map[string]probe),
+		operations: make(map[string]*operation), positions: make(map[string]*runtimePosition), unsafeRuntimes: make(map[string]bool)}
+}
+
+func key(sandbox, id string) string { return sandbox + "/" + id }
+
+func (m *Manager) Submit(boot string, r Request) string {
+	if boot != m.BootID {
+		return "executor_replaced"
+	}
+	if r.SandboxID == "" || len(r.SandboxID) > 128 || r.Timeout <= 0 || r.Timeout > 15*time.Minute ||
+		r.MaximumOutputBytes < 1 || r.MaximumOutputBytes > maximumReplyBytes ||
+		len(r.Payload) > maximumRequestBytes || len(r.CompletionContext) > maximumCompletionContextBytes ||
+		!json.Valid(r.Payload) || !json.Valid(r.CompletionContext) {
+		return "invalid_request"
+	}
+	for _, id := range []string{r.OperationID, r.RunID, r.WriterID} {
+		if parsed, err := uuid.Parse(id); err != nil || parsed.String() != id {
+			return "invalid_identity"
+		}
+	}
+	offset, err := r.Source.offset()
+	if err != nil {
+		return "invalid_execution_position"
+	}
+	bytes, err := json.Marshal(r)
+	if err != nil {
+		return "invalid_request"
+	}
+	fingerprint := sha256.Sum256(bytes)
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed {
+		return "executor_capacity"
+	}
+	if !m.driver.HasRuntime(r.SandboxID) {
+		return "execution_unavailable"
+	}
+	if m.unsafeRuntimes[r.SandboxID] {
+		return "runtime_quarantined"
+	}
+	id := key(r.SandboxID, r.OperationID)
+	if old := m.operations[id]; old != nil {
+		if old.fingerprint != fingerprint {
+			return "operation_changed"
+		}
+		return ""
+	}
+	if m.active >= maximumOutstanding {
+		return "capacity"
+	}
+	if why := m.advance(r.SandboxID, r.Source, offset, true); why != "" {
+		return why
+	}
+	if m.RuntimeActivity != nil {
+		if err := m.RuntimeActivity(r.SandboxID); err != nil {
+			return "runtime_retention_unavailable"
+		}
+	}
+	r.Payload = append(json.RawMessage(nil), r.Payload...)
+	r.CompletionContext = append(json.RawMessage(nil), r.CompletionContext...)
+	ctx, cancel := context.WithCancel(context.Background())
+	op := &operation{request: r, fingerprint: fingerprint, cancel: cancel, interrupt: make(chan struct{})}
+	m.operations[id] = op
+	m.active++
+	m.wg.Add(1)
+	go m.execute(ctx, op)
+	return ""
+}
+
+func (m *Manager) execute(ctx context.Context, op *operation) {
+	defer m.wg.Done()
+	defer op.cancel()
+	r := op.request
+	r.Interrupt = op.interrupt
+	result := Result{Failure: "execution_not_started", Quarantine: false}
+	if ctx.Err() == nil {
+		select {
+		case <-r.Interrupt:
+			result.Failure = "tool_cancelled_before_start"
+		default:
+			runCtx, stop := context.WithTimeout(ctx, r.Timeout)
+			result = m.driver.Run(runCtx, r, func(output json.RawMessage) { m.delivery.Progress(r, output) })
+			stop()
+		}
+	}
+	m.mu.Lock()
+	if m.RuntimeActivity != nil {
+		_ = m.RuntimeActivity(r.SandboxID)
+	}
+	if op.forgotten {
+		result.Quarantine = false
+		result.Failure = "tool_sandbox_unavailable"
+	}
+	op.finished = true
+	if result.Quarantine {
+		m.unsafeRuntimes[r.SandboxID] = true
+	}
+	m.mu.Unlock()
+	// Delivery retries the same immutable result, never the process. A cancelled
+	// or replaced Worker may discard it; expiry remains UNKNOWN, not success.
+	if !result.Delivered {
+		deliveryCtx, endDelivery := context.WithTimeout(context.Background(), 30*time.Second)
+		for {
+			if err := m.delivery.Deliver(deliveryCtx, r, result); err == nil {
+				break
+			}
+			select {
+			case <-deliveryCtx.Done():
+				goto delivered
+			case <-time.After(250 * time.Millisecond):
+			}
+		}
+	delivered:
+		endDelivery()
+	}
+	m.mu.Lock()
+	// The source position fences historical replay; retain no completed IDs.
+	id := key(r.SandboxID, r.OperationID)
+	if m.operations[id] == op {
+		delete(m.operations, id)
+	}
+	m.active--
+	m.mu.Unlock()
+}
+
+// Expiry and new Tool admission share this boundary. Persist closure before
+// releasing the mutex, then perform physical cleanup outside it.
+func (m *Manager) RetireIdleRuntime(sandbox string, close func() (bool, error)) (bool, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, op := range m.operations {
+		if op.request.SandboxID == sandbox && !op.finished {
+			if m.RuntimeActivity != nil {
+				return false, m.RuntimeActivity(sandbox)
+			}
+			return false, nil
+		}
+	}
+	closed, err := close()
+	if closed && err == nil {
+		m.unsafeRuntimes[sandbox] = true
+	}
+	return closed, err
+}
+
+// advance runs under the admission mutex. Fresh Tools are strictly newer;
+// idempotent cancellations may repeat an old position without regressing it.
+func (m *Manager) advance(sandbox string, source Position, offset int64, fresh bool) string {
+	state := m.positions[sandbox]
+	if state == nil {
+		state = &runtimePosition{topic: source.Topic, partitions: make(map[int]int64)}
+		m.positions[sandbox] = state
+	}
+	if state.topic != source.Topic {
+		return "execution_stream_changed"
+	}
+	old, exists := state.partitions[source.Partition]
+	if fresh && exists && offset <= old {
+		return "execution_position_stale"
+	}
+	if !exists || offset > old {
+		state.partitions[source.Partition] = offset
+	}
+	return ""
+}
+
+// Cancel requests cooperative Tool interruption. It never signals a completed
+// operation or asserts that its processes have exited. Catalog presence is
+// checked inside the same mutex as Submit and confirmed-absence cleanup.
+func (m *Manager) Cancel(boot string, r Request) string {
+	if boot != m.BootID {
+		return "executor_replaced"
+	}
+	if r.SandboxID == "" || len(r.SandboxID) > 128 {
+		return "invalid_scope"
+	}
+	for _, id := range []string{r.RunID, r.WriterID} {
+		if parsed, err := uuid.Parse(id); err != nil || parsed.String() != id {
+			return "invalid_scope"
+		}
+	}
+	if r.OperationID != "" {
+		if parsed, err := uuid.Parse(r.OperationID); err != nil || parsed.String() != r.OperationID {
+			return "invalid_scope"
+		}
+	}
+	offset, err := r.Source.offset()
+	if err != nil {
+		return "invalid_execution_position"
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed {
+		return "execution_unavailable"
+	}
+	if !m.driver.HasRuntime(r.SandboxID) {
+		return "execution_unavailable"
+	}
+	if why := m.advance(r.SandboxID, r.Source, offset, false); why != "" {
+		return why
+	}
+	for _, op := range m.operations {
+		if op.finished || op.request.SandboxID != r.SandboxID || op.request.RunID != r.RunID ||
+			op.request.WriterID != r.WriterID || (r.OperationID != "" && op.request.OperationID != r.OperationID) {
+			continue
+		}
+		select {
+		case <-op.interrupt:
+		default:
+			close(op.interrupt)
+		}
+	}
+	return ""
+}
+
+// ForgetRuntime is called only after native destruction/anchored absence. A
+// removed physical identity can never be recreated by this execution endpoint.
+func (m *Manager) ForgetRuntime(sandbox string) {
+	m.mu.Lock()
+	for id, op := range m.operations {
+		if op.request.SandboxID == sandbox {
+			op.forgotten = true
+			op.cancel()
+			delete(m.operations, id)
+		}
+	}
+	delete(m.positions, sandbox)
+	delete(m.unsafeRuntimes, sandbox)
+	m.mu.Unlock()
+}
+
+func (m *Manager) Unsafe(sandbox string) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.unsafeRuntimes[sandbox]
+}
+func (m *Manager) Accepting() bool { m.mu.Lock(); defer m.mu.Unlock(); return !m.closed }
+
+func (m *Manager) Close() {
+	m.mu.Lock()
+	m.closed = true
+	for _, p := range m.probes {
+		p.cancel()
+	}
+	for _, op := range m.operations {
+		if !op.finished {
+			op.cancel()
+		}
+	}
+	m.mu.Unlock()
+	m.wg.Wait()
+}
diff --git a/Cubelet/pkg/execution/manager_test.go b/Cubelet/pkg/execution/manager_test.go
new file mode 100644
index 0000000..cb70f9f
--- /dev/null
+++ b/Cubelet/pkg/execution/manager_test.go
@@ -0,0 +1,328 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/google/uuid"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type driverFunc func(context.Context, Request, func(json.RawMessage)) Result
+
+func (f driverFunc) HasRuntime(string) bool { return true }
+
+func (f driverFunc) Run(c context.Context, r Request, p func(json.RawMessage)) Result {
+	return f(c, r, p)
+}
+
+func TestGuestDeliveredResultsDoNotReturnPayloadOrReserveImageSlots(t *testing.T) {
+	entered := make(chan struct{}, 32)
+	release := make(chan struct{})
+	var deliveries atomic.Int32
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result {
+		entered <- struct{}{}
+		<-release
+		return Result{Delivered: true}
+	}), deliveryFunc(func(context.Context, Request, Result) error { deliveries.Add(1); return nil }))
+	for i := 0; i < 32; i++ {
+		r := request()
+		r.Source.Offset = fmt.Sprint(100 + i)
+		r.MaximumOutputBytes = maximumReplyBytes
+		if why := m.Submit(m.BootID, r); why != "" {
+			t.Fatal(why)
+		}
+	}
+	for i := 0; i < 32; i++ {
+		await(t, entered)
+	}
+	close(release)
+	m.wg.Wait()
+	m.Close()
+	if deliveries.Load() != 0 {
+		t.Fatal("Guest-delivered results passed through host delivery")
+	}
+}
+
+type deliveryFunc func(context.Context, Request, Result) error
+
+func (f deliveryFunc) Deliver(c context.Context, r Request, s Result) error { return f(c, r, s) }
+func (f deliveryFunc) Progress(Request, json.RawMessage)                    {}
+func request() Request {
+	return Request{Source: Position{Topic: "session-log-v13", Partition: 0, Offset: "100"}, SandboxID: "sandbox", OperationID: uuid.NewString(), RunID: uuid.NewString(), WriterID: uuid.NewString(), Payload: json.RawMessage(`{"tool":"read"}`), CompletionContext: json.RawMessage(`{}`), Timeout: time.Second, MaximumOutputBytes: 1024}
+}
+func await(t *testing.T, c <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-c:
+	case <-time.After(2 * time.Second):
+		t.Fatal("deadline")
+	}
+}
+
+func TestHandoffOwnsExecutionAndRetriesOnlyResult(t *testing.T) {
+	var calls, deliveries atomic.Int32
+	ran := make(chan struct{})
+	release := make(chan struct{})
+	delivered := make(chan struct{})
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result {
+		calls.Add(1)
+		close(ran)
+		<-release
+		return Result{Output: json.RawMessage(`{"done":true}`)}
+	}), deliveryFunc(func(context.Context, Request, Result) error {
+		if deliveries.Add(1) == 1 {
+			return errors.New("reply ACK lost")
+		}
+		close(delivered)
+		return nil
+	}))
+	r := request()
+	if got := m.Submit(m.BootID, r); got != "" {
+		t.Fatal(got)
+	}
+	await(t, ran)
+	if got := m.Submit(m.BootID, r); got != "" {
+		t.Fatal(got)
+	}
+	changed := r
+	changed.Payload = json.RawMessage(`{"tool":"write"}`)
+	if got := m.Submit(m.BootID, changed); got != "operation_changed" {
+		t.Fatal(got)
+	}
+	close(release)
+	await(t, delivered)
+	m.Close()
+	if calls.Load() != 1 || deliveries.Load() != 2 {
+		t.Fatalf("execution=%d delivery=%d", calls.Load(), deliveries.Load())
+	}
+}
+
+func TestExplicitToolTimeoutEndsOnlyItsOwnProcess(t *testing.T) {
+	started := make(chan struct{}, 2)
+	ended := make(chan string, 2)
+	m := New(driverFunc(func(ctx context.Context, r Request, _ func(json.RawMessage)) Result {
+		started <- struct{}{}
+		<-ctx.Done()
+		return Result{Failure: "timeout"}
+	}), deliveryFunc(func(_ context.Context, r Request, _ Result) error { ended <- r.OperationID; return nil }))
+	defer m.Close()
+	r := request()
+	r.Timeout = 50 * time.Millisecond
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	sibling := request()
+	sibling.Source.Offset = "101"
+	sibling.Timeout = time.Minute
+	if why := m.Submit(m.BootID, sibling); why != "" {
+		t.Fatal(why)
+	}
+	await(t, started)
+	await(t, started)
+	select {
+	case id := <-ended:
+		if id != r.OperationID {
+			t.Fatal("wrong command timed out")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timeout did not end command")
+	}
+	select {
+	case <-ended:
+		t.Fatal("sibling was cancelled")
+	default:
+	}
+}
+
+func TestExecutorReplacementRejectsWithoutEffects(t *testing.T) {
+	var calls atomic.Int32
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result { calls.Add(1); return Result{} }), deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	if why := m.Submit("old-boot", request()); why != "executor_replaced" {
+		t.Fatal(why)
+	}
+	if calls.Load() != 0 {
+		t.Fatal("stale boot started an effect")
+	}
+}
+
+func TestUnsafeDriverOutcomeBlocksOnlyItsRuntime(t *testing.T) {
+	delivered := make(chan struct{}, 2)
+	m := New(driverFunc(func(_ context.Context, r Request, _ func(json.RawMessage)) Result {
+		return Result{Quarantine: r.SandboxID == "sandbox"}
+	}), deliveryFunc(func(context.Context, Request, Result) error { delivered <- struct{}{}; return nil }))
+	defer m.Close()
+	r := request()
+	if got := m.Submit(m.BootID, r); got != "" {
+		t.Fatal(got)
+	}
+	await(t, delivered)
+	if !m.Unsafe(r.SandboxID) {
+		t.Fatal("uncertain runtime remained admissible")
+	}
+	other := request()
+	other.SandboxID = "other"
+
+	if got := m.Submit(m.BootID, other); got != "" {
+		t.Fatal(got)
+	}
+	await(t, delivered)
+	if m.Unsafe(other.SandboxID) {
+		t.Fatal("unrelated runtime quarantined")
+	}
+}
+
+func TestCompletionRetiresEntriesWithoutReplayingDelayedExecution(t *testing.T) {
+	delivered := make(chan struct{}, 1)
+	var calls atomic.Int32
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result { calls.Add(1); return Result{} }),
+		deliveryFunc(func(context.Context, Request, Result) error { delivered <- struct{}{}; return nil }))
+	defer m.Close()
+	r := request()
+	if got := m.Submit(m.BootID, r); got != "" {
+		t.Fatal(got)
+	}
+	await(t, delivered)
+	m.wg.Wait()
+	m.mu.Lock()
+	retained := len(m.operations)
+	m.mu.Unlock()
+	if retained != 0 {
+		t.Fatal("closed scope retained operation fingerprints")
+	}
+	if got := m.Submit(m.BootID, r); got != "execution_position_stale" {
+		t.Fatal(got)
+	}
+	if calls.Load() != 1 {
+		t.Fatal("execution replayed")
+	}
+	m.ForgetRuntime(r.SandboxID)
+	m.mu.Lock()
+	closures := len(m.positions)
+	m.mu.Unlock()
+	if closures != 0 {
+		t.Fatal("destroyed runtime retained closure state")
+	}
+}
+
+func TestCancellationAcceptsSignalWithoutClaimingProcessExit(t *testing.T) {
+	started, signalled, finish := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	delivered := make(chan struct{})
+	m := New(driverFunc(func(ctx context.Context, r Request, _ func(json.RawMessage)) Result {
+		close(started)
+		select {
+		case <-r.Interrupt:
+		case <-ctx.Done():
+			t.Error("user cancellation used hard teardown")
+			return Result{}
+		}
+		if ctx.Err() != nil {
+			t.Error("lifetime cancelled")
+		}
+		close(signalled)
+		<-finish
+		return Result{Output: json.RawMessage(`{"cancelled":true}`)}
+	}), deliveryFunc(func(context.Context, Request, Result) error { close(delivered); return nil }))
+	defer func() {
+		select {
+		case <-finish:
+		default:
+			close(finish)
+		}
+		m.Close()
+	}()
+	r := request()
+	r.Timeout = time.Minute
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	await(t, started)
+	cancel := r
+	cancel.Source.Offset = "101"
+	if why := m.Cancel(m.BootID, cancel); why != "" {
+		t.Fatal(why)
+	}
+	await(t, signalled)
+	if why := m.Cancel(m.BootID, cancel); why != "" {
+		t.Fatal(why)
+	}
+	select {
+	case <-delivered:
+		t.Fatal("acceptance fabricated final result")
+	default:
+	}
+	close(finish)
+	await(t, delivered)
+}
+
+func TestCancellationAfterExecutionPreservesPendingCompletedReply(t *testing.T) {
+	delivering, release := make(chan struct{}), make(chan struct{})
+	var interrupt <-chan struct{}
+	m := New(driverFunc(func(_ context.Context, r Request, _ func(json.RawMessage)) Result {
+		interrupt = r.Interrupt
+		return Result{Output: json.RawMessage(`{"done":true}`)}
+	}), deliveryFunc(func(context.Context, Request, Result) error { close(delivering); <-release; return nil }))
+	defer func() { close(release); m.Close() }()
+	r := request()
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	await(t, delivering)
+	r.Source.Offset = "101"
+	if why := m.Cancel(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	r.OperationID = "" // abnormal Run retirement has the same finished-operation boundary
+	if why := m.Cancel(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	select {
+	case <-interrupt:
+		t.Fatal("completed operation was interrupted")
+	default:
+	}
+}
+
+func TestCancellationFencesLateSubmitAndLeavesSiblingUntouched(t *testing.T) {
+	started := make(chan struct{})
+	var calls atomic.Int32
+	m := New(driverFunc(func(ctx context.Context, r Request, _ func(json.RawMessage)) Result {
+		calls.Add(1)
+		close(started)
+		select {
+		case <-r.Interrupt:
+			t.Error("sibling interrupted")
+		case <-ctx.Done():
+		}
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	old := request()
+	cancel := old
+	cancel.Source.Offset = "101"
+	if why := m.Cancel(m.BootID, cancel); why != "" {
+		t.Fatal(why)
+	}
+	if why := m.Submit(m.BootID, old); why != "execution_position_stale" {
+		t.Fatal(why)
+	}
+	sibling := request()
+	sibling.Source.Offset = "102"
+	sibling.Timeout = time.Minute
+	if why := m.Submit(m.BootID, sibling); why != "" {
+		t.Fatal(why)
+	}
+	await(t, started)
+	if why := m.Cancel(m.BootID, cancel); why != "" {
+		t.Fatal(why)
+	}
+	if calls.Load() != 1 {
+		t.Fatal("late command executed")
+	}
+}
