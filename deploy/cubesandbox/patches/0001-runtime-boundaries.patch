+	l := observationFixture(t)
+	_, err := l.Observe(context.Background(), observedID)
+	if err == nil || errors.Is(err, utils.ErrorKeyNotFound) || !strings.Contains(err.Error(), "unavailable") {
+		t.Fatalf("missing runtime inspector cannot prove absence: %v", err)
+	}
+}
+
+func TestObserveReturnsRecoveredIdentity(t *testing.T) {
+	l := observationFixture(t)
+	box := &cubeboxstore.CubeBox{Metadata: cubeboxstore.Metadata{ID: observedID, SandboxID: observedID}}
+	l.cubeboxStore.Add(box)
+	got, err := l.Observe(context.Background(), observedID)
+	if err != nil || got != box {
+		t.Fatalf("lost recovered identity: %v", err)
+	}
+}
