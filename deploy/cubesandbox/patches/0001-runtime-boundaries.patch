+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"sync/atomic"
+	"testing"
+)
+
+func TestRetentionExpirySharesToolAdmission(t *testing.T) {
+	entered, release, delivered := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result {
+		close(entered)
+		<-release
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { close(delivered); return nil }))
+	var activity atomic.Int32
+	m.RuntimeActivity = func(string) error { activity.Add(1); return nil }
+	r := request()
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	<-entered
+	closed, err := m.RetireIdleRuntime(r.SandboxID, func() (bool, error) { t.Fatal("live Tool expired"); return true, nil })
+	if closed || err != nil || activity.Load() < 2 {
+		t.Fatal(closed, err, activity.Load())
+	}
+	close(release)
+	<-delivered
+	closed, err = m.RetireIdleRuntime(r.SandboxID, func() (bool, error) { return true, nil })
+	if !closed || err != nil {
+		t.Fatal(closed, err)
+	}
+	next := request()
+	next.SandboxID = r.SandboxID
+	next.Source.Offset = "1000"
+	if why := m.Submit(m.BootID, next); why != "runtime_quarantined" {
+		t.Fatal(why)
+	}
+	m.Close()
+}
+
+func TestRetentionPersistenceFailureRejectsBeforeStartingTool(t *testing.T) {
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result {
+		t.Error("Tool ran without retention admission")
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	m.RuntimeActivity = func(string) error { return errors.New("metadata unavailable") }
+	if why := m.Submit(m.BootID, request()); why != "runtime_retention_unavailable" {
+		t.Fatal(why)
+	}
+}
diff --git a/Cubelet/pkg/execution/terminal_input.go b/Cubelet/pkg/execution/terminal_input.go
new file mode 100644
index 0000000..c65e0cd
--- /dev/null
+++ b/Cubelet/pkg/execution/terminal_input.go
@@ -0,0 +1,48 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+)
+
+// The control frame shares the original raw PTY, after its request and before
+// its final receipt. Interruption never closes the result transport.
+func executionInput(ctx context.Context, ready, complete <-chan struct{}, payload []byte, operationID string, interruption <-chan struct{}) (io.Reader, func()) {
+	reader, writer := io.Pipe()
+	lifetime, cancel := context.WithCancel(ctx)
+	stop := func() { cancel(); _ = reader.Close(); _ = writer.Close() }
+	go func() { <-lifetime.Done(); _ = reader.Close(); _ = writer.Close() }()
+	go func() {
+		defer writer.Close()
+		select {
+		case <-ready:
+		case <-lifetime.Done():
+			return
+		}
+		if payload != nil {
+			if _, err := writer.Write(append(append([]byte(nil), payload...), '\n')); err != nil {
+				return
+			}
+		}
+		for {
+			select {
+			case <-complete:
+				_, _ = writer.Write([]byte("{\"type\":\"scope.received\"}\n"))
+				return
+			case <-interruption:
+				// One operation-scoped control frame, not a process/cgroup kill.
+				frame, _ := json.Marshal(map[string]string{"type": "scope.cancel", "operationId": operationID})
+				if _, err := writer.Write(append(frame, '\n')); err != nil {
+					return
+				}
+				interruption = nil
+			case <-lifetime.Done():
+				return
+			}
+		}
+	}()
+	return reader, stop
+}
