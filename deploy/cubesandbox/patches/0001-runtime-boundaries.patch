+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/google/uuid"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type catalogDriver struct {
+	driverFunc
+	present func(string) bool
+}
+
+func (d catalogDriver) HasRuntime(id string) bool { return d.present(id) }
+
+func TestRemovedRuntimeCannotRecreateAdmissionState(t *testing.T) {
+	var present atomic.Bool
+	present.Store(true)
+	var calls atomic.Int32
+	r := request()
+	m := New(catalogDriver{
+		driverFunc: func(context.Context, Request, func(json.RawMessage)) Result {
+			calls.Add(1)
+			return Result{}
+		},
+		present: func(id string) bool { return id != r.SandboxID || present.Load() },
+	}, deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	present.Store(false) // Native catalog deletion precedes confirmed absence.
+	m.ForgetRuntime(r.SandboxID)
+	r.OperationID = uuid.NewString()
+	r.Source.Offset = "101"
+	for i := 0; i < 100; i++ {
+		if why := m.Submit(m.BootID, r); why != "execution_unavailable" {
+			t.Fatal(why)
+		}
+		if why := m.Cancel(m.BootID, r); why != "execution_unavailable" {
+			t.Fatal(why)
+		}
+	}
+	m.mu.Lock()
+	positions, operations, active := len(m.positions), len(m.operations), m.active
+	m.mu.Unlock()
+	if positions != 0 || operations != 0 || active != 0 || calls.Load() != 1 {
+		t.Fatal("removed identity acquired state or work", positions, operations, active, calls.Load())
+	}
+	fresh := request()
+	fresh.SandboxID = "another-live-vm"
+	if why := m.Submit(m.BootID, fresh); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	if calls.Load() != 2 || !m.Accepting() {
+		t.Fatal("missing VM blocked another VM")
+	}
+}
+
+func TestCatalogCheckAndPositionAdmissionJoinConfirmedAbsence(t *testing.T) {
+	for _, method := range []string{"submit", "cancel"} {
+		t.Run(method, func(t *testing.T) {
+			var present atomic.Bool
+			present.Store(true)
+			checked, release := make(chan struct{}), make(chan struct{})
+			var checkOnce, releaseOnce sync.Once
+			m := New(catalogDriver{
+				driverFunc: func(ctx context.Context, _ Request, _ func(json.RawMessage)) Result {
+					<-ctx.Done()
+					return Result{}
+				},
+				present: func(string) bool {
+					value := present.Load()
+					checkOnce.Do(func() { close(checked); <-release })
+					return value
+				},
+			}, deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+			defer func() { releaseOnce.Do(func() { close(release) }); m.Close() }()
+			r := request()
+			admit := m.Submit
+			if method == "cancel" {
+				admit = m.Cancel
+			}
+			admitted := make(chan string, 1)
+			go func() { admitted <- admit(m.BootID, r) }()
+			await(t, checked)
+			present.Store(false)
+			forgetting, forgotten := make(chan struct{}), make(chan struct{})
+			go func() { close(forgetting); m.ForgetRuntime(r.SandboxID); close(forgotten) }()
+			await(t, forgetting)
+			select {
+			case <-forgotten:
+				t.Fatal("absence crossed an unsettled admission")
+			case <-time.After(20 * time.Millisecond):
+			}
+			releaseOnce.Do(func() { close(release) })
+			select {
+			case why := <-admitted:
+				if why != "" {
+					t.Fatal(why)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("admission did not settle")
+			}
+			await(t, forgotten)
+			m.wg.Wait()
+			if why := admit(m.BootID, r); why != "execution_unavailable" {
+				t.Fatal(why)
+			}
+			m.mu.Lock()
+			positions, operations, active := len(m.positions), len(m.operations), m.active
+			m.mu.Unlock()
+			if positions != 0 || operations != 0 || active != 0 {
+				t.Fatal("forgotten identity was recreated", positions, operations, active)
+			}
+		})
+	}
+}
+
+func TestLaterHandoffRejectsDelayedOldOwnerWithoutCancellingActiveCommand(t *testing.T) {
+	started := make(chan struct{}, 2)
+	ended := make(chan struct{}, 2)
+	m := New(driverFunc(func(ctx context.Context, r Request, _ func(json.RawMessage)) Result {
+		started <- struct{}{}
+		<-ctx.Done()
+		return Result{}
+	}), deliveryFunc(func(context.Context, Request, Result) error { ended <- struct{}{}; return nil }))
+	defer m.Close()
+	old := request()
+	old.Timeout = time.Minute
+	if why := m.Submit(m.BootID, old); why != "" {
+		t.Fatal(why)
+	}
+	await(t, started)
+	sibling := request()
+	sibling.Source.Offset = "102"
+	sibling.Timeout = time.Minute
+	if why := m.Submit(m.BootID, sibling); why != "" {
+		t.Fatal(why)
+	}
+	await(t, started)
+	delayed := request()
+	delayed.Source.Offset = "101"
+	if why := m.Submit(m.BootID, delayed); why != "execution_position_stale" {
+		t.Fatal(why)
+	}
+	// Advancing the partition fences late submissions, not already accepted work.
+	select {
+	case <-ended:
+		t.Fatal("a later handoff cancelled an accepted command")
+	default:
+	}
+}
+func TestMoreThan65536CompletionsRetainOnlyLiveRuntimePositions(t *testing.T) {
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result { return Result{} }),
+		deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	r := request()
+	for i := 0; i < 70000; i++ {
+		p := r.Source
+		p.Offset = strconv.Itoa(i)
+		r.Source = p
+		r.OperationID = uuid.NewString()
+		if why := m.Submit(m.BootID, r); why != "" {
+			t.Fatal(why)
+		}
+		m.wg.Wait()
+	}
+	m.mu.Lock()
+	count := len(m.positions)
+	partitions := len(m.positions[r.SandboxID].partitions)
+	retained := len(m.operations)
+	m.mu.Unlock()
+	if count != 1 || partitions != 1 || retained != 0 || !m.Accepting() {
+		t.Fatal("history exhausted admission")
+	}
+	r.Source.Offset = "70000"
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	if why := m.Submit(m.BootID, r); why != "execution_position_stale" {
+		t.Fatal(why)
+	}
+	m.mu.Lock()
+	retained = len(m.operations)
+	m.mu.Unlock()
+	if retained != 0 {
+		t.Fatal("completed identity retained")
+	}
+	m.ForgetRuntime(r.SandboxID)
+	fresh := request()
+	fresh.SandboxID = "fresh-vm"
+	if why := m.Submit(m.BootID, fresh); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	m.mu.Lock()
+	count = len(m.positions)
+	m.mu.Unlock()
+	if count != 1 {
+		t.Fatal("removed VM position retained")
+	}
+}
+func TestPartitionsAreIndependentButStreamIdentityCannotChange(t *testing.T) {
+	m := New(driverFunc(func(context.Context, Request, func(json.RawMessage)) Result { return Result{} }),
+		deliveryFunc(func(context.Context, Request, Result) error { return nil }))
+	defer m.Close()
+	r := request()
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	r.OperationID = uuid.NewString()
+	r.Source.Partition = 1
+	r.Source.Offset = "0"
+	if why := m.Submit(m.BootID, r); why != "" {
+		t.Fatal(why)
+	}
+	m.wg.Wait()
+	r.OperationID = uuid.NewString()
+	r.Source.Topic = "different-log"
+	if why := m.Submit(m.BootID, r); why != "execution_stream_changed" {
+		t.Fatal(why)
+	}
+	r.Source.Topic = "session-log-v13"
+	for _, value := range []string{"", "-1", "+1", "01", "9223372036854775808"} {
+		r.Source.Offset = value
+		if why := m.Submit(m.BootID, r); why != "invalid_execution_position" {
+			t.Fatal(value, why)
+		}
+	}
+}
diff --git a/Cubelet/pkg/execution/probe.go b/Cubelet/pkg/execution/probe.go
new file mode 100644
index 0000000..53187e7
--- /dev/null
+++ b/Cubelet/pkg/execution/probe.go
@@ -0,0 +1,111 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+type probe struct{ cancel context.CancelFunc }
+
+// Probe shares the native driver, but has no Tool ledger, effect authority or
+// quarantine power. A bounded optional completion uses the existing delivery port.
+func (m *Manager) Probe(parent context.Context, boot string, r Request) (Result, string) {
+	if boot != m.BootID {
+		return Result{}, "executor_replaced"
+	}
+	if r.SandboxID == "" || len(r.SandboxID) > 128 || len(r.CompletionContext) > maximumCompletionContextBytes {
+		return Result{}, "invalid_probe"
+	}
+	if id, err := uuid.Parse(r.OperationID); err != nil || id.String() != r.OperationID {
+		return Result{}, "invalid_probe"
+	}
+	async := len(r.CompletionContext) > 0
+	if async && (!json.Valid(r.CompletionContext) || r.RunID == "" || r.WriterID == "") {
+		return Result{}, "invalid_probe"
+	}
+	for _, id := range []string{r.RunID, r.WriterID} {
+		if id != "" {
+			if parsed, err := uuid.Parse(id); err != nil || parsed.String() != id {
+				return Result{}, "invalid_probe"
+			}
+		}
+	}
+	if async {
+		parent = context.Background()
+	}
+	budget := 5 * time.Second
+	if async {
+		budget = 10 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(parent, budget)
+	id := key(r.SandboxID, r.OperationID)
+	m.mu.Lock()
+	rejection := ""
+	if m.closed || len(m.probes) >= 4 {
+		rejection = "probe_capacity"
+	}
+	if m.unsafeRuntimes[r.SandboxID] {
+		rejection = "runtime_quarantined"
+	}
+	// Probes are fixed read-only diagnostics. They neither advance admission
+	// positions nor require a lifetime history of closed Run identities.
+	if _, exists := m.probes[id]; exists {
+		rejection = "probe_duplicate"
+	}
+	if rejection != "" {
+		m.mu.Unlock()
+		cancel()
+		return Result{}, rejection
+	}
+	m.probes[id] = probe{cancel: cancel}
+	m.wg.Add(1)
+	m.mu.Unlock()
+	r.Probe, r.Timeout, r.MaximumOutputBytes = true, budget, 4096
+	payload := map[string]interface{}{"mode": "probe", "probeId": r.OperationID}
+	if async {
+		payload["delivery"] = json.RawMessage(r.CompletionContext)
+	}
+	r.Payload, _ = json.Marshal(payload)
+	r.CompletionContext = append(json.RawMessage(nil), r.CompletionContext...)
+	run := func() Result {
+		defer m.wg.Done()
+		defer cancel()
+		defer func() { m.mu.Lock(); delete(m.probes, id); m.mu.Unlock() }()
+		result := m.driver.Run(ctx, r, func(json.RawMessage) {})
+		// Loss of a diagnostic process is never authority to quarantine a VM.
+		result.Quarantine = false
+		if ctx.Err() != nil {
+			return Result{Failure: "probe_expired"}
+		}
+		if async {
+			if result.Delivered {
+				return result
+			}
+			return Result{Failure: "probe_callback_unconfirmed"}
+		}
+		var reply struct {
+			Type        string `json:"type"`
+			ProbeID     string `json:"probeId"`
+			GuestBootID string `json:"guestBootId"`
+		}
+		if result.Failure == "" {
+			if json.Unmarshal(result.Output, &reply) != nil || reply.Type != "worker.probe_result" || reply.ProbeID != r.OperationID {
+				return Result{Failure: "probe_reply_invalid"}
+			}
+			if id, err := uuid.Parse(reply.GuestBootID); err != nil || id.String() != reply.GuestBootID {
+				return Result{Failure: "probe_reply_invalid"}
+			}
+		}
+		return result
+	}
+	if async {
+		go run()
+		return Result{}, ""
+	}
+	return run(), ""
+}
