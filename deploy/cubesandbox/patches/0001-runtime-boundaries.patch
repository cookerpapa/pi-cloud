+
+type interruptedAttach struct {
+	volume.VolumePlugin
+	next bool
+}
+
+func (p *interruptedAttach) Attach(ctx context.Context, r *volume.AttachRequest) (*volume.AttachResult, error) {
+	if p.next {
+		p.next = false
+		cancelled, stop := context.WithCancel(ctx)
+		stop()
+		ctx = cancelled
+	}
+	return p.VolumePlugin.Attach(ctx, r)
+}
+
+// The acceptance runner mounts the exact supported script into a disposable
+// container. No operator Workspace or host storage is mounted into this test.
+func TestPosixFailedAttachRecoversWithoutSuccessMetadata(t *testing.T) {
+	pluginPath := os.Getenv("PI_CLOUD_POSIX_PLUGIN")
+	if pluginPath == "" {
+		t.Skip("run scripts/check-cube-allocation.mjs for the actual POSIX contract")
+	}
+	for _, shared := range []bool{false, true} {
+		t.Run(map[bool]string{false: "only-holder", true: "shared-holder"}[shared], func(t *testing.T) {
+			ctx := context.Background()
+			random := make([]byte, 24)
+			if _, err := rand.Read(random); err != nil {
+				t.Fatal(err)
+			}
+			id := "pcw-" + hex.EncodeToString(random)
+			const base = "/data/cube-shared/volume"
+			if err := os.MkdirAll(base, 0755); err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(base, "picloud-posix-"+id)
+			defer os.RemoveAll(path)
+			if output, err := exec.Command(pluginPath, "--op", "create", "--volume-id", id).CombinedOutput(); err != nil {
+				t.Fatalf("create: %v %s", err, output)
+			}
+			keep := filepath.Join(path, "workspace", "keep.txt")
+			if err := os.WriteFile(keep, []byte("owned fixture bytes"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			binaryPlugin := binary.New(id)
+			if err := binaryPlugin.Init(ctx, volume.PluginConfig{BinaryPath: pluginPath}); err != nil {
+				t.Fatal(err)
+			}
+			p := &interruptedAttach{VolumePlugin: binaryPlugin}
+			m := volume.Global()
+			m.Register(p)
+			dbPath := filepath.Join(t.TempDir(), "refs.db")
+			db, err := bolt.Open(dbPath, 0600, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { db.Close() }()
+			refs, err := refcount.New(db)
+			if err != nil {
+				t.Fatal(err)
+			}
+			m.SetRefCountStore(refs)
+			request := func(sandbox string) *volume.AttachRequest {
+				return &volume.AttachRequest{Namespace: "default", VolumeID: id, SandboxID: sandbox, Driver: p.Name(), VolumeBaseDir: base}
+			}
+			var held *volume.AttachResult
+			if shared {
+				held, err = m.Attach(ctx, request("other-vm"))
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			p.next = true
+			if _, err = m.Attach(ctx, request("failed-vm")); err == nil {
+				t.Fatal("Attach should fail after holder registration")
+			}
+			pending, ok, err := refs.GetRecord("default", id)
+			if err != nil || !ok || pending.Pending == nil || len(pending.Pending.Metadata) != 0 {
+				t.Fatal(pending, ok, err)
+			}
+			before, err := refs.State("default", id)
+			if err != nil || before.Confirmed {
+				t.Fatal(before, err)
+			}
+			if err = db.Close(); err != nil {
+				t.Fatal(err)
+			}
+			db, err = bolt.Open(dbPath, 0600, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			refs, err = refcount.New(db)
+			if err != nil {
+				t.Fatal(err)
+			}
+			m.SetRefCountStore(refs)
+			state, err := m.ObserveReference(ctx, "default", id)
+			expected := int64(0)
+			if shared {
+				expected = 1
+			}
+			if err != nil || !state.Confirmed || state.Count != expected || state.Epoch != before.Epoch || state.Revision <= before.Revision {
+				t.Fatal(state, err)
+			}
+			next, err := m.Attach(ctx, request("next-vm"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			detach := func(sandbox string, metadata map[string]string) {
+				t.Helper()
+				if err := m.Detach(ctx, &volume.DetachRequest{Namespace: "default", VolumeID: id, SandboxID: sandbox, Driver: p.Name(), Metadata: metadata}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			detach("next-vm", next.Metadata)
+			if shared {
+				state, err = m.ObserveReference(ctx, "default", id)
+				if err != nil || !state.Confirmed || state.Count != 1 {
+					t.Fatal(state, err)
+				}
+				detach("other-vm", held.Metadata)
+			}
+			state, err = m.ObserveReference(ctx, "default", id)
+			if err != nil || !state.Confirmed || state.Count != 0 {
+				t.Fatal(state, err)
+			}
+			bytes, err := os.ReadFile(keep)
+			if err != nil || string(bytes) != "owned fixture bytes" {
+				t.Fatal("Workspace bytes changed", err)
+			}
+		})
+	}
+}
