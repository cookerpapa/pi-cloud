+)
+
+func TestRawTransportWaitsForReadinessAndReceiptsCompleteResult(t *testing.T) {
+	output := newToolOutput(1024, func(json.RawMessage) {})
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	input, stop := rawTerminalInput(ctx, output, []byte(`{"mode":"operation"}`), "", nil)
+	defer stop()
+	received := make(chan []byte, 1)
+	go func() { data, _ := io.ReadAll(input); received <- data }()
+	select {
+	case <-received:
+		t.Fatal("input sent before ready")
+	default:
+	}
+	if _, err := output.Write([]byte("{\"type\":\"scope.ready\"}\n{\"type\":\"worker.delivery_result\",\"response\":{}")); err != nil {
+		t.Fatal(err)
+	}
+	if len(output.resultBytes()) != 0 {
+		t.Fatal("incomplete output accepted")
+	}
+	if _, err := output.Write([]byte("}\n")); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case data := <-received:
+		if string(data) != "{\"mode\":\"operation\"}\n{\"type\":\"scope.received\"}\n" {
+			t.Fatalf("unexpected input %s", data)
+		}
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+}
+
+func TestReceiptSurvivesSubsequentFrameBufferReuse(t *testing.T) {
+	result := []byte(`{"type":"worker.delivery_result","data":"` + strings.Repeat("x", 8*1024) + `"}`)
+	output := newToolOutput(int64(len(result)+1), func(json.RawMessage) {})
+	for offset := 0; offset < len(result); offset += 4096 {
+		end := offset + 4096
+		if end > len(result) {
+			end = len(result)
+		}
+		if _, err := output.Write(result[offset:end]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := output.Write([]byte("\n")); err != nil {
+		t.Fatal(err)
+	}
+	delivered := output.resultBytes()
+	if _, err := output.Write([]byte("{\"operationId\":\"later-progress\"}\n")); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(delivered, result) || !bytes.Equal(output.resultBytes(), result) {
+		t.Fatal("final result buffer was reused")
+	}
+}
+func TestResultFramingRejectsOverflowAndDuplicateFinal(t *testing.T) {
+	overflow := newToolOutput(8, func(json.RawMessage) {})
+	if _, err := overflow.Write([]byte("123456789")); err == nil {
+		t.Fatal("accepted overflow")
+	}
+	output := newToolOutput(1024, func(json.RawMessage) {})
+	frame := []byte("{\"type\":\"worker.delivery_result\"}\n")
+	if _, err := output.Write(frame); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := output.Write(frame); err == nil {
+		t.Fatal("accepted duplicate result")
+	}
+}
diff --git a/Cubelet/pkg/execution/delivery_http.go b/Cubelet/pkg/execution/delivery_http.go
new file mode 100644
index 0000000..4739180
--- /dev/null
+++ b/Cubelet/pkg/execution/delivery_http.go
@@ -0,0 +1,83 @@
+// Copyright (c) 2026 PiCloud contributors.
+// SPDX-License-Identifier: Apache-2.0
+package execution
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"time"
+)
+
+// HTTPSDelivery forwards bounded executor failures.
+// Successful Tools deliver themselves from the Guest. No Kafka client, tenant
+// database, object-store credentials or child adapter process lives in Cubelet.
+type HTTPSDelivery struct{}
+type destination struct {
+	URL        string `json:"url"`
+	Address    string `json:"address"`
+	CA         string `json:"ca"`
+	Capability string `json:"capability"`
+	ExpiresAt  int64  `json:"expiresAt"`
+}
+
+func (*HTTPSDelivery) Progress(Request, json.RawMessage) {}
+func (*HTTPSDelivery) Deliver(ctx context.Context, r Request, result Result) error {
+	if result.Delivered {
+		return nil
+	}
+	var target destination
+	if json.Unmarshal(r.CompletionContext, &target) != nil || target.ExpiresAt <= time.Now().UnixMilli() ||
+		net.ParseIP(target.Address) == nil || len(target.Capability) > 8192 || target.Capability == "" || len(target.CA) > 16384 {
+		return errors.New("invalid completion destination")
+	}
+	endpoint, err := url.Parse(target.URL)
+	if err != nil || endpoint.Scheme != "https" || endpoint.User != nil || endpoint.Path != "/v1/completions" || endpoint.RawQuery != "" || endpoint.Fragment != "" {
+		return errors.New("invalid completion endpoint")
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM([]byte(target.CA)) {
+		return errors.New("invalid completion CA")
+	}
+	port := endpoint.Port()
+	if port == "" {
+		port = "443"
+	}
+	if _, err := strconv.ParseUint(port, 10, 16); err != nil {
+		return errors.New("invalid completion port")
+	}
+	transport := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots, ServerName: endpoint.Hostname(), MinVersion: tls.VersionTLS12},
+		DialContext: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			return (&net.Dialer{Timeout: 5 * time.Second}).DialContext(ctx, network, net.JoinHostPort(target.Address, port))
+		}}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 10 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	body, err := json.Marshal(map[string]any{"kind": "result", "operationId": r.OperationID, "result": result})
+	if err != nil || len(body) > 128*1024 {
+		return errors.New("executor completion exceeded its bound")
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, target.URL, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	request.Header.Set("Authorization", "Bearer "+target.Capability)
+	request.Header.Set("Content-Type", "application/json")
+	response, err := client.Do(request)
+	if err != nil {
+		return errors.New("completion delivery unavailable")
+	}
+	defer response.Body.Close()
+	_, _ = io.Copy(io.Discard, io.LimitReader(response.Body, 4096))
+	if response.StatusCode != http.StatusNoContent {
+		return errors.New("completion delivery unconfirmed")
+	}
+	return nil
+}
diff --git a/Cubelet/pkg/execution/delivery_http_test.go b/Cubelet/pkg/execution/delivery_http_test.go
new file mode 100644
index 0000000..98ed758
