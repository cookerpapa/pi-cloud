@@ -0,0 +1,83 @@
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+type reviewFailOnceDB struct {
+	*bolt.DB
+	fail bool
+}
+
+func (d *reviewFailOnceDB) Update(fn func(*bolt.Tx) error) error {
+	if d.fail {
+		d.fail = false
+		return errors.New("review: node receipt write unavailable")
+	}
+	return d.DB.Update(fn)
+}
+
+// Allocation and Volume metadata have independent durable lifetimes.
+func TestCleanupReceiptLossRetainsQueryableVolumeState(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	db := &reviewFailOnceDB{DB: raw}
+	store, err := NewStore(db, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager := NewManager(store, "review-boot")
+	id := Identity{ID: "a1000000-0000-4000-8000-000000000001", Digest: strings.Repeat("a", 64), NotAfter: time.Now().Add(time.Minute).UnixMilli(), BootID: "review-boot"}
+	if _, err = manager.Create(context.Background(), id, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		return json.RawMessage(`{"created":true}`), true, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	refs, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = refs.Acquire("default", "volume", id.ID, "test"); err != nil {
+		t.Fatal(err)
+	}
+	physicalDeletes := 0
+	_, err = manager.Close(context.Background(), id, time.Second, func(context.Context, Record) (json.RawMessage, bool, error) {
+		physicalDeletes++
+		if _, err = refs.BeginDetach("default", "volume", id.ID, nil); err != nil {
+			t.Fatal(err)
+		}
+		if err = refs.CompleteDetach("default", "volume", id.ID); err != nil {
+			t.Fatal(err)
+		}
+		db.fail = true
+		return json.RawMessage(`{"volumeReference":0}`), true, nil
+	})
+	if err == nil {
+		t.Fatal("receipt write failure was not injected")
+	}
+	// The actual cleanup adapter takes this branch when exact node Observe sees
+	// absence: return r.CleanupResult, true, nil. The first reply was never stored.
+	r, err := manager.Close(context.Background(), id, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) { return r.CleanupResult, true, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Phase != "absent" || !r.Closed || len(r.CleanupResult) != 0 || physicalDeletes != 1 {
+		t.Fatalf("unexpected baseline: %+v deletes=%d", r, physicalDeletes)
+	}
+	state, err := refs.State("default", "volume")
+	if err != nil || state.Count != 0 || !state.Confirmed {
+		t.Fatal(state, err)
+	}
+	t.Log("Physical absence and current Volume state survive loss of the allocation cleanup result")
+}
diff --git a/Cubelet/pkg/allocation/retention.go b/Cubelet/pkg/allocation/retention.go
new file mode 100644
index 0000000..232ed35
--- /dev/null
+++ b/Cubelet/pkg/allocation/retention.go
@@ -0,0 +1,126 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"encoding/binary"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+)
+
+var ErrStaleActivity = errors.New("retention activity is stale")
+
+func idleKey(r *Record) []byte {
+	k := make([]byte, 8+len(r.ID))
+	binary.BigEndian.PutUint64(k, uint64(r.RetainUntil))
+	copy(k[8:], r.ID)
+	return k
+}
+
+// The existing synchronous allocation journal is the sole retention clock.
+// Replays retain their original time and cannot renew a later incarnation.
+func (m *Manager) Renew(i Identity, observedAt int64) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	return m.Store.Update(i.ID, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed {
+			return nil, ErrClosed
+		}
+		if i.BootID != m.BootID || r.StartedBoot != i.BootID || r.Digest != i.Digest || r.NotAfter != i.NotAfter {
+			return nil, ErrConflict
+		}
+		if r.RetentionWindow <= 0 || r.Phase != "ready" {
+			return nil, ErrConflict
+		}
+		if observedAt <= 0 || observedAt > now+5000 || now-observedAt > 45000 {
+			return nil, ErrStaleActivity
+		}
+		until := observedAt + r.RetentionWindow
+		if until > r.RetainUntil {
+			r.RetainUntil = until
+		}
+		return r, nil
+	})
+}
+
+// Real accepted Tool activity uses the node's clock. Diagnostic probes never call it.
+func (s *Store) Touch(id string) error {
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed {
+			return nil, ErrClosed
+		}
+		if r.RetentionWindow > 0 && now+r.RetentionWindow > r.RetainUntil {
+			r.RetainUntil = now + r.RetentionWindow
+		}
+		return r, nil
+	})
+	return err
+}
+
+func (s *Store) Due(limit int) ([]Record, error) {
+	if limit < 1 || limit > 1024 {
+		return nil, errors.New("invalid retention page")
+	}
+	var result []Record
+	err := s.db.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now := s.now().UnixMilli()
+		if v := b.Get(floor); len(v) == 8 && int64(binary.BigEndian.Uint64(v)) > now {
+			now = int64(binary.BigEndian.Uint64(v))
+		}
+		c := b.Bucket(idleExpiry).Cursor()
+		for k, id := c.First(); k != nil && len(result) < limit; k, id = c.Next() {
+			if int64(binary.BigEndian.Uint64(k[:8])) > now {
+				break
+			}
+			r, err := decode(b.Bucket(records).Get(id))
+			if err != nil {
+				return err
+			}
+			if r != nil {
+				result = append(result, *r)
+			}
+		}
+		return nil
+	})
+	return result, err
+}
+
+// Caller holds the Tool-admission mutex. Only this atomic recheck closes an
+// expired allocation; a previously enumerated deadline is never sufficient.
+func (s *Store) BeginExpiry(id string) (bool, error) {
+	closed := false
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.RetentionWindow > 0 && r.RetainUntil <= now && r.Phase != "absent" {
+			r.Closed = true
+			r.Phase = "closing"
+			closed = true
+		}
+		return r, nil
+	})
+	return closed, err
+}
+
+// Keep one failed physical cleanup from starving later expired allocations.
+func (s *Store) DeferExpiry(id string) error {
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed && r.Phase != "absent" {
+			r.RetainUntil = now + 10000
+		}
+		return r, nil
+	})
+	return err
+}
