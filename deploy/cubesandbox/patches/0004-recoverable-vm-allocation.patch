index 0000000..5d57674
--- /dev/null
+++ b/CubeMaster/pkg/allocation/store.go
@@ -0,0 +1,287 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/CubeDB/dao"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	volrefcount "github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/volume/refcount"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"gorm.io/gorm/logger"
+	"regexp"
+	"strings"
+)
+
+const IDLabel = "picloud.allocation_id"
+const DeadlineLabel = "picloud.create_before"
+const IDAnnotation = "pi-cloud.allocation.id"
+const DigestAnnotation = "pi-cloud.allocation.digest"
+const DeadlineAnnotation = "pi-cloud.allocation.create-before"
+const FixedIDAnnotation = "pi-cloud.allocation.sandbox-id"
+const MaxPayload = 256 * 1024
+
+var idPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var ErrClosed = errors.New("allocation_closed")
+var ErrExpired = errors.New("allocation_expired")
+var ErrConflict = errors.New("allocation_parameters_changed")
+var ErrUnavailable = errors.New("allocation_catalog_unavailable")
+
+type Record struct {
+	ID                string `gorm:"primaryKey;size:36" json:"allocationID"`
+	Digest            string `gorm:"size:64" json:"-"`
+	NotAfter          int64  `json:"createBefore"`
+	SandboxID         string `gorm:"size:32" json:"sandboxID"`
+	NodeID            string `gorm:"size:256" json:"nodeID,omitempty"`
+	NodeIP            string `gorm:"size:256" json:"-"`
+	NodeBoot          string `gorm:"size:64" json:"-"`
+	Phase             string `gorm:"size:16" json:"phase"`
+	Closed            bool   `json:"closed"`
+	Request           string `json:"-"`
+	NodeRequest       string `json:"-"`
+	Result            string `json:"-"`
+	TrafficToken      string `gorm:"size:64" json:"-"`
+	CreateRefsApplied bool   `json:"-"`
+	CloseRefsApplied  bool   `json:"-"`
+}
+
+func (Record) TableName() string { return "t_pi_cloud_allocation" }
+
+type Store struct{ DB *gorm.DB }
+
+func Default() *Store {
+	db := dao.Default()
+	if db != nil {
+		db = db.Session(&gorm.Session{Logger: logger.Discard})
+	}
+	return &Store{DB: db}
+}
+func ValidID(id string) bool     { return idPattern.MatchString(id) }
+func SandboxID(id string) string { return strings.ReplaceAll(id, "-", "") }
+func (s *Store) Get(ctx context.Context, id string) (*Record, error) {
+	if !ValidID(id) {
+		return nil, ErrConflict
+	}
+	if s.DB == nil {
+		return nil, ErrUnavailable
+	}
+	var r Record
+	e := s.DB.WithContext(ctx).Where("id = ?", id).Take(&r).Error
+	if errors.Is(e, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	return &r, e
+}
+func now(tx *gorm.DB) (int64, error) {
+	var n, floor int64
+	q := "select cast(unix_timestamp(current_timestamp(3))*1000 as signed)"
+	if tx.Dialector.Name() == "postgres" {
+		q = "select (extract(epoch from clock_timestamp())*1000)::bigint"
+	}
+	if e := tx.Raw(q).Scan(&n).Error; e != nil {
+		return 0, e
+	}
+	if e := tx.Raw("select floor_ms from t_pi_cloud_allocation_clock where id=1 for share").Scan(&floor).Error; e != nil {
+		return 0, e
+	}
+	if floor > n {
+		n = floor
+	}
+	return n, nil
+}
+func (s *Store) lock(ctx context.Context, id string, initial Record, change func(*gorm.DB, *Record, int64) error) (*Record, error) {
+	if s.DB == nil {
+		return nil, ErrUnavailable
+	}
+	var r Record
+	err := s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		n, e := now(tx)
+		if e != nil {
+			return e
+		}
+		if e = tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&initial).Error; e != nil {
+			return e
+		}
+		if e = tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id = ?", id).Take(&r).Error; e != nil {
+			return e
+		}
+		if e = change(tx, &r, n); e != nil {
+			return e
+		}
+		return tx.Save(&r).Error
+	})
+	return &r, err
+}
+func (s *Store) Begin(ctx context.Context, id, digest string, deadline int64, request string) (*Record, error) {
+	if !ValidID(id) || len(digest) != 64 || deadline <= 0 || len(request) > MaxPayload {
+		return nil, ErrConflict
+	}
+	token := make([]byte, 32)
+	if _, e := rand.Read(token); e != nil {
+		return nil, e
+	}
+	return s.lock(ctx, id, Record{ID: id, Digest: digest, NotAfter: deadline, SandboxID: SandboxID(id), Phase: "pending", Request: request, TrafficToken: hex.EncodeToString(token)}, func(_ *gorm.DB, r *Record, n int64) error {
+		if r.Closed {
+			return ErrClosed
+		}
+		if r.Digest != digest || r.NotAfter != deadline {
+			return ErrConflict
+		}
+		if r.NodeID == "" && n >= deadline {
+			return ErrExpired
+		}
+		return nil
+	})
+}
+
+// Placement and the exact native request commit before the first node RPC.
+// Competing replicas reuse the winning target; ambiguity never reschedules it.
+func (s *Store) Place(ctx context.Context, id, node, ip, boot, request, resolved string) (*Record, error) {
+	if node == "" || ip == "" || boot == "" || len(boot) > 64 || len(node) > 256 || len(ip) > 256 || len(request) > MaxPayload || len(resolved) > MaxPayload {
+		return nil, ErrConflict
+	}
+	r, e := s.Get(ctx, id)
+	if e != nil || r == nil {
+		if e == nil {
+			e = ErrUnavailable
+		}
+		return nil, e
+	}
+	return s.lock(ctx, id, *r, func(_ *gorm.DB, r *Record, n int64) error {
+		if r.Closed {
+			return ErrClosed
+		}
+		if r.NodeID != "" {
+			return nil
+		}
+		if n >= r.NotAfter {
+			return ErrExpired
+		}
+		r.NodeID = node
+		r.NodeIP = ip
+		r.NodeBoot = boot
+		r.NodeRequest = request
+		r.Request = resolved
+		r.Phase = "creating"
+		return nil
+	})
+}
+func (s *Store) Close(ctx context.Context, id string, deadline int64) (*Record, error) {
+	if !ValidID(id) || deadline <= 0 {
+		return nil, ErrConflict
+	}
+	return s.lock(ctx, id, Record{ID: id, NotAfter: deadline, SandboxID: SandboxID(id), Closed: true, Phase: "absent"}, func(_ *gorm.DB, r *Record, _ int64) error {
+		if r.NotAfter != deadline {
+			return ErrConflict
+		}
+		r.Closed = true
+		if r.NodeID == "" {
+			r.Phase = "absent"
+		} else if r.Phase != "absent" {
+			r.Phase = "closing"
+		}
+		return nil
+	})
+}
+func (s *Store) Finish(ctx context.Context, id, phase, result string, createInfo, deleteInfo map[string][]byte) (*Record, error) {
+	if len(result) > MaxPayload || (phase != "ready" && phase != "failed" && phase != "absent") {
+		return nil, ErrConflict
+	}
+	r, e := s.Get(ctx, id)
+	if e != nil || r == nil {
+		if e == nil {
+			e = ErrUnavailable
+		}
+		return nil, e
+	}
+	return s.lock(ctx, id, *r, func(tx *gorm.DB, r *Record, _ int64) error {
+		if phase != "absent" && r.Closed {
+			return ErrClosed
+		}
+		if !r.CreateRefsApplied {
+			if e := applyReferences(tx, createInfo); e != nil {
+				return e
+			}
+			r.CreateRefsApplied = true
+		}
+		if phase == "absent" && !r.CloseRefsApplied {
+			if e := applyReferences(tx, deleteInfo); e != nil {
+				return e
+			}
+			r.CloseRefsApplied = true
+		}
+		if phase == "absent" {
+			if !r.Closed {
+				return ErrConflict
+			}
+			r.Phase = "absent"
+			r.Request = ""
+			r.NodeRequest = ""
+			r.Result = ""
+			r.TrafficToken = ""
+			return nil
+		}
+		if r.Closed {
+			return ErrClosed
+		}
+		r.Phase = phase
+		r.Result = result
+		return nil
+	})
+}
+func applyReferences(tx *gorm.DB, info map[string][]byte) error {
+	raw := info[volrefcount.ExtInfoKey]
+	if len(raw) == 0 {
+		return nil
+	}
+	var events []volrefcount.Event
+	if e := json.Unmarshal(raw, &events); e != nil {
+		return e
+	}
+	for _, event := range events {
+		if event.VolumeID == "" || (event.Referenced != 0 && event.Referenced != 1) {
+			return errors.New("invalid volume reference receipt")
+		}
+		delta := 1
+		if event.Referenced == 0 {
+			delta = -1
+		}
+		if e := tx.Model(&models.VolumeRecord{}).Where("volume_id = ?", event.VolumeID).Update("refcount", gorm.Expr("GREATEST(refcount + ?, 0)", delta)).Error; e != nil {
+			return e
+		}
+	}
+	return nil
+}
+func (s *Store) Collect(ctx context.Context) error {
+	if s.DB == nil {
+		return ErrUnavailable
+	}
+	return s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// An exclusive GC floor serializes expiry with admission and remains after
+		// terminal rows are removed. Backward DB clock steps cannot revive tokens.
+		var previous int64
+		if e := tx.Raw("select floor_ms from t_pi_cloud_allocation_clock where id=1 for update").Scan(&previous).Error; e != nil {
+			return e
+		}
+		n, e := now(tx)
+		if e != nil {
+			return e
+		}
+		var ids []string
+		if e = tx.Exec("update t_pi_cloud_allocation_clock set floor_ms=? where id=1", n).Error; e != nil {
+			return e
+		}
+		if e = tx.Model(&Record{}).Where("closed = ? and phase = ? and not_after < ?", true, "absent", n-3_600_000).Order("not_after").Limit(128).Pluck("id", &ids).Error; e != nil {
+			return e
+		}
+		if len(ids) == 0 {
+			return nil
+		}
+		return tx.Where("id in ? and closed = ? and phase = ?", ids, true, "absent").Delete(&Record{}).Error
+	})
+}
