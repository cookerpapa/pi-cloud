@@ -0,0 +1,157 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package cubebox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/google/uuid"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/api/services/cubebox/v1"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/api/services/errorcode/v1"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume"
+	"google.golang.org/protobuf/encoding/protojson"
+	"strconv"
+	"strings"
+)
+
+const allocationIDAnnotation = "pi-cloud.allocation.id"
+const allocationDeadlineAnnotation = "pi-cloud.allocation.create-before"
+const allocationDigestAnnotation = "pi-cloud.allocation.digest"
+
+func (s *service) createAllocation(ctx context.Context, req *cubebox.RunCubeSandboxRequest) (*cubebox.RunCubeSandboxResponse, error) {
+	if s.allocations == nil {
+		return nil, errors.New("allocation metadata unavailable")
+	}
+	a := req.GetAnnotations()
+	deadline, e := strconv.ParseInt(a[allocationDeadlineAnnotation], 10, 64)
+	if e != nil {
+		return nil, e
+	}
+	identity := allocation.Identity{ID: a[allocationIDAnnotation], Digest: a[allocationDigestAnnotation], NotAfter: deadline, BootID: a["pi-cloud.allocation.node-boot"]}
+	record, e := s.allocations.Create(ctx, identity, s.config.createDeadline, func(ctx context.Context) (json.RawMessage, bool, error) {
+		reply, err := s.createNative(ctx, req)
+		if err != nil {
+			return nil, false, err
+		}
+		result, err := protojson.Marshal(reply)
+		return result, reply.GetRet().GetRetCode() == errorcode.ErrorCode_Success, err
+	})
+	if e != nil {
+		return nil, e
+	}
+	if record.Closed {
+		return nil, allocation.ErrClosed
+	}
+	if len(record.Result) == 0 {
+		return nil, errors.New("allocation creation outcome unconfirmed")
+	}
+	var reply cubebox.RunCubeSandboxResponse
+	if e = protojson.Unmarshal(record.Result, &reply); e != nil {
+		return nil, e
+	}
+	return &reply, nil
+}
+func (s *service) cleanupAllocation(ctx context.Context, r allocation.Record) (json.RawMessage, bool, error) {
+	_, err := s.cubeboxMgr.cubeboxManger.Observe(ctx, r.SandboxID)
+	if errors.Is(err, utils.ErrorKeyNotFound) {
+		if !r.CreateFinished && r.StartedBoot != "" && r.StartedBoot != s.allocations.BootID {
+			return nil, false, errors.New("unfinished previous-boot creation requires physical recovery")
+		}
+		return r.CleanupResult, true, nil
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	reply, err := s.destroyNative(ctx, &cubebox.DestroyCubeSandboxRequest{RequestID: uuid.NewString(), SandboxID: r.SandboxID})
+	if err != nil {
+		return nil, false, err
+	}
+	if reply.GetRet().GetRetCode() != errorcode.ErrorCode_Success {
+		return nil, false, errors.New("allocation physical cleanup unconfirmed")
+	}
+	result, err := protojson.Marshal(reply)
+	if err != nil {
+		return nil, false, err
+	}
+	_, err = s.cubeboxMgr.cubeboxManger.Observe(ctx, r.SandboxID)
+	if errors.Is(err, utils.ErrorKeyNotFound) {
+		return result, true, nil
+	}
+	return nil, false, err
+}
+func (s *service) ManageAllocation(ctx context.Context, req *cubebox.AllocationRequest) (*cubebox.AllocationResponse, error) {
+	if s.allocations == nil {
+		return nil, errors.New("allocation metadata unavailable")
+	}
+	if req.AllocationId == "" && !req.Close {
+		rc := volume.Global().RefCountStore()
+		if rc == nil {
+			return nil, errors.New("Volume reference metadata unavailable")
+		}
+		state, err := rc.State("default", "")
+		if err != nil {
+			return nil, err
+		}
+		raw, err := json.Marshal(map[string]string{"referenceEpoch": state.Epoch})
+		return &cubebox.AllocationResponse{BootId: s.allocations.BootID, Record: raw}, err
+	}
+	i := allocation.Identity{ID: req.AllocationId, Digest: req.Digest, NotAfter: req.CreateBefore, BootID: req.ExpectedBoot}
+	if e := i.Validate(); e != nil {
+		return nil, e
+	}
+	var r *allocation.Record
+	var e error
+	if req.Close {
+		r, e = s.allocations.Close(ctx, i, s.config.destroyDeadline, s.cleanupAllocation)
+	} else {
+		r, e = s.allocations.Store.Get(i.ID)
+	}
+	if e != nil {
+		return &cubebox.AllocationResponse{Failure: "allocation_unconfirmed"}, nil
+	}
+	if r == nil {
+		return &cubebox.AllocationResponse{Failure: "allocation_not_recorded", BootId: s.allocations.BootID}, nil
+	}
+	if r.Digest != i.Digest || r.NotAfter != i.NotAfter {
+		return nil, allocation.ErrConflict
+	}
+	data, e := json.Marshal(r)
+	if e != nil {
+		return nil, e
+	}
+	_ = s.allocations.Store.Collect()
+	return &cubebox.AllocationResponse{Record: data, BootId: s.allocations.BootID}, nil
+}
+
+// Existing native lifecycle deletion must also retire a managed allocation.
+func (s *service) destroyAllocation(ctx context.Context, req *cubebox.DestroyCubeSandboxRequest) (*cubebox.DestroyCubeSandboxResponse, bool, error) {
+	id, err := uuid.Parse(req.SandboxID)
+	if err != nil || strings.ReplaceAll(id.String(), "-", "") != req.SandboxID {
+		return nil, false, nil
+	}
+	r, err := s.allocations.Store.Get(id.String())
+	if err != nil {
+		return nil, true, err
+	}
+	if r == nil {
+		return nil, false, nil
+	}
+	r, err = s.allocations.Close(ctx, allocation.Identity{ID: r.ID, Digest: r.Digest, NotAfter: r.NotAfter, BootID: r.StartedBoot}, s.config.destroyDeadline, s.cleanupAllocation)
+	if err != nil {
+		return nil, true, err
+	}
+	if r.Phase != "absent" {
+		return nil, true, errors.New("allocation closure pending")
+	}
+	if len(r.CleanupResult) > 0 {
+		var reply cubebox.DestroyCubeSandboxResponse
+		if err = protojson.Unmarshal(r.CleanupResult, &reply); err != nil {
+			return nil, true, err
+		}
+		return &reply, true, nil
+	}
+	return &cubebox.DestroyCubeSandboxResponse{SandboxID: r.SandboxID, RequestID: req.RequestID, Ret: &errorcode.Ret{RetCode: errorcode.ErrorCode_Success}}, true, nil
+}
