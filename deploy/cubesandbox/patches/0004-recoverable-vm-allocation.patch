+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+	"regexp"
+	"strings"
+	"time"
+)
+
+var idPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var digestPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var ErrExpired = errors.New("allocation creation authorization expired")
+var ErrConflict = errors.New("allocation request identity changed")
+var ErrClosed = errors.New("allocation is closed")
+
+type Identity struct {
+	ID       string
+	Digest   string
+	NotAfter int64
+	BootID   string
+}
+
+func SandboxID(id string) string { return strings.ReplaceAll(id, "-", "") }
+func (i Identity) Validate() error {
+	if !idPattern.MatchString(i.ID) || !digestPattern.MatchString(i.Digest) || i.NotAfter <= 0 || i.NotAfter > 1<<53 || i.BootID == "" || len(i.BootID) > 64 {
+		return errors.New("invalid allocation identity")
+	}
+	return nil
+}
+
+type Manager struct {
+	Store  *Store
+	BootID string
+	locks  *utils.ResourceLocks
+}
+
+func NewManager(store *Store, boot string) *Manager {
+	return &Manager{Store: store, BootID: boot, locks: utils.NewResourceLocks()}
+}
+
+type Create func(context.Context) (json.RawMessage, bool, error)
+type Cleanup func(context.Context, Record) (json.RawMessage, bool, error)
+
+// One native creation may execute for an allocation. Its lifetime is independent
+// of a caller's HTTP/gRPC response connection, but bounded by Cube's native deadline.
+func (m *Manager) Create(ctx context.Context, i Identity, budget time.Duration, create Create) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	unlock, err := m.locks.LockContext(ctx, i.ID)
+	if err != nil {
+		return nil, err
+	}
+	defer unlock()
+	start := false
+	r, err := m.Store.Update(i.ID, func(r *Record, now int64) (*Record, error) {
+		if r != nil {
+			if r.Closed {
+				return nil, ErrClosed
+			}
+			if r.Digest != i.Digest || r.NotAfter != i.NotAfter || (r.StartedBoot != "" && r.StartedBoot != i.BootID) {
+				return nil, ErrConflict
+			}
+			return r, nil // includes an uncertain creation from a previous node boot
+		}
+		if now >= i.NotAfter {
+			return nil, ErrExpired
+		}
+		if i.BootID != m.BootID {
+			return nil, errors.New("allocation node boot changed")
+		}
+		start = true
+		return &Record{ID: i.ID, SandboxID: SandboxID(i.ID), Digest: i.Digest, NotAfter: i.NotAfter, Phase: "creating", StartedBoot: m.BootID}, nil
+	})
+	if err != nil || !start {
+		return r, err
+	}
+	run, cancel := context.WithTimeout(context.WithoutCancel(ctx), budget)
+	defer cancel()
+	result, success, cause := create(run)
+	r, err = m.Store.Update(i.ID, func(r *Record, _ int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		r.Result = result
+		r.CreateFinished = true
+		if r.Closed {
+			r.Phase = "closing"
+		} else if success && cause == nil {
+			r.Phase = "ready"
+		} else {
+			r.Phase = "failed"
+		}
+		return r, nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+// Close's durable admission precedes its wait for the original creation. A late
+// Create can never reopen this identity, even while physical cleanup is blocked.
+func (m *Manager) Close(ctx context.Context, i Identity, budget time.Duration, cleanup Cleanup) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	r, err := m.Store.Update(i.ID, func(r *Record, _ int64) (*Record, error) {
+		if r == nil {
+			phase := "absent"
+			if i.BootID != m.BootID {
+				phase = "closing"
+			}
+			return &Record{ID: i.ID, SandboxID: SandboxID(i.ID), Digest: i.Digest, NotAfter: i.NotAfter, Closed: true, Phase: phase, StartedBoot: i.BootID}, nil
+		}
+		if r.Digest != i.Digest || r.NotAfter != i.NotAfter || (r.StartedBoot != "" && r.StartedBoot != i.BootID) {
+			return nil, ErrConflict
+		}
+		r.Closed = true
+		if r.Phase != "absent" {
+			r.Phase = "closing"
+		}
+		return r, nil
+	})
+	if err != nil || r.Phase == "absent" {
+		return r, err
+	}
+	unlock, err := m.locks.LockContext(ctx, i.ID)
+	if err != nil {
+		return r, nil
+	}
+	defer unlock()
+	r, err = m.Store.Get(i.ID)
+	if err != nil {
+		return nil, err
+	}
+	if r == nil {
+		return nil, ErrMissing
+	}
+	if r.Phase == "absent" {
+		return r, nil
+	}
+	// Admission is irreversible. Once physical cleanup starts its lifetime is
+	// owned by Cube, bounded by the native destroy policy, not the RPC caller.
+	run, cancel := context.WithTimeout(context.WithoutCancel(ctx), budget)
+	defer cancel()
+	result, absent, err := cleanup(run, *r)
+	if err != nil || !absent {
+		return r, err
+	}
+	return m.Store.Update(i.ID, func(r *Record, _ int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		r.Phase = "absent"
+		r.CleanupResult = result
+		return r, nil
+	})
+}
diff --git a/Cubelet/pkg/allocation/manager_test.go b/Cubelet/pkg/allocation/manager_test.go
new file mode 100644
index 0000000..d191d8f
--- /dev/null
+++ b/Cubelet/pkg/allocation/manager_test.go
@@ -0,0 +1,237 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func fixture(t *testing.T) (*Manager, *bolt.DB, *atomic.Int64) {
+	t.Helper()
+	db, e := bolt.Open(filepath.Join(t.TempDir(), "meta.db"), 0600, nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { db.Close() })
+	now := &atomic.Int64{}
+	now.Store(1_000_000)
+	s, e := NewStore(db, func() time.Time { return time.UnixMilli(now.Load()) })
+	if e != nil {
+		t.Fatal(e)
+	}
+	return NewManager(s, "boot-one"), db, now
+}
+func identity() Identity {
+	return Identity{ID: "12345678-1234-1234-1234-123456789abc", Digest: strings.Repeat("a", 64), NotAfter: 1_300_000, BootID: "boot-one"}
+}
+func success(context.Context) (json.RawMessage, bool, error) {
+	return json.RawMessage(`{"result":"created"}`), true, nil
+}
+func absent(context.Context, Record) (json.RawMessage, bool, error) { return nil, true, nil }
+
+func TestConcurrentCreateAndLostResponseKeepOneNativeExecution(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	var calls atomic.Int32
+	var wg sync.WaitGroup
+	for n := 0; n < 20; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r, e := m.Create(context.Background(), i, time.Second, func(c context.Context) (json.RawMessage, bool, error) {
+				calls.Add(1)
+				time.Sleep(time.Millisecond)
+				return success(c)
+			})
+			if e != nil || r.Phase != "ready" {
+				t.Errorf("create: %v %+v", e, r)
+			}
+		}()
+	}
+	wg.Wait()
+	if calls.Load() != 1 {
+		t.Fatalf("%d effects", calls.Load())
+	}
+	// A new process can return the saved reply, without repeating physical work.
+	next := NewManager(m.Store, "boot-two")
+	r, e := next.Create(context.Background(), i, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		t.Fatal("replayed effect")
+		return nil, false, nil
+	})
+	if e != nil || r.Phase != "ready" {
+		t.Fatalf("restore: %v %+v", e, r)
+	}
+	changed := i
+	changed.Digest = strings.Repeat("b", 64)
+	if _, e = m.Create(context.Background(), changed, time.Second, success); !errors.Is(e, ErrConflict) {
+		t.Fatalf("changed input: %v", e)
+	}
+}
+func TestCloseBeforeCreateRejectsDelayedRequestAcrossRestartAndGC(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	r, e := m.Close(context.Background(), i, time.Second, absent)
+	if e != nil || r.Phase != "absent" {
+		t.Fatal(e, r)
+	}
+	next := NewManager(m.Store, "boot-two")
+	if _, e = next.Create(context.Background(), i, time.Second, success); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	now.Store(i.NotAfter + retention + 1)
+	if e = m.Store.Collect(); e != nil {
+		t.Fatal(e)
+	}
+	r, e = m.Store.Get(i.ID)
+	if e != nil || r != nil {
+		t.Fatal(e, r)
+	}
+	now.Store(1)
+	if _, e = next.Create(context.Background(), i, time.Second, success); !errors.Is(e, ErrExpired) {
+		t.Fatalf("clock rollback admitted old request: %v", e)
+	}
+}
+func TestCloseDuringCreateCannotConfirmAbsenceBeforeCreationJoins(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		_, e := m.Create(context.Background(), i, time.Second, func(c context.Context) (json.RawMessage, bool, error) { close(entered); <-release; return success(c) })
+		if e != nil {
+			t.Error(e)
+		}
+	}()
+	<-entered
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	var clean atomic.Int32
+	cleanup := func(context.Context, Record) (json.RawMessage, bool, error) { clean.Add(1); return nil, true, nil }
+	r, e := m.Close(ctx, i, time.Second, cleanup)
+	if e != nil || r.Phase != "closing" || clean.Load() != 0 {
+		t.Fatal(e, r, clean.Load())
+	}
+	// Another allocation is independent of this slow creator.
+	other := i
+	other.ID = "22345678-1234-1234-1234-123456789abc"
+	if r, e = m.Create(context.Background(), other, time.Second, success); e != nil || r.Phase != "ready" {
+		t.Fatal(e, r)
+	}
+	close(release)
+	<-done
+	r, e = m.Close(context.Background(), i, time.Second, cleanup)
+	if e != nil || r.Phase != "absent" || clean.Load() != 1 {
+		t.Fatal(e, r, clean.Load())
+	}
+	if _, e = m.Create(context.Background(), i, time.Second, success); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+}
+func TestNativeCreationOutlivesResponseCancellationButNotItsOwnDeadline(t *testing.T) {
+	m, _, _ := fixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	r, e := m.Create(ctx, identity(), time.Second, func(c context.Context) (json.RawMessage, bool, error) {
+		cancel()
+		if c.Err() != nil {
+			t.Fatal("response cancellation ended native creation")
+		}
+		return success(c)
+	})
+	if e != nil || r.Phase != "ready" {
+		t.Fatal(e, r)
+	}
+}
+
+func TestCleanupOutlivesCallerButHonorsNativeBudget(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	if _, err := m.Create(context.Background(), i, time.Second, success); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	r, err := m.Close(ctx, i, 25*time.Millisecond, func(c context.Context, _ Record) (json.RawMessage, bool, error) {
+		cancel()
+		if c.Err() != nil {
+			t.Fatal("caller cancelled accepted cleanup")
+		}
+		<-c.Done()
+		return nil, false, c.Err()
+	})
+	if !errors.Is(err, context.DeadlineExceeded) || r.Phase != "closing" || !r.Closed {
+		t.Fatal(r, err)
+	}
+	// Retry the original identity; no new creation or lost terminal result.
+	r, err = m.Close(context.Background(), i, time.Second, absent)
+	if err != nil || r.Phase != "absent" {
+		t.Fatal(r, err)
+	}
+	_, err = m.Close(context.Background(), i, time.Second, func(context.Context, Record) (json.RawMessage, bool, error) {
+		t.Fatal("repeated completed cleanup")
+		return nil, false, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestMissingNodeJournalCannotAdmitAnOldBootCreate(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	i.BootID = "departed"
+	if _, err := m.Create(context.Background(), i, time.Second, success); err == nil {
+		t.Fatal("old boot created a VM")
+	}
+	r, err := m.Close(context.Background(), i, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) {
+		if r.StartedBoot != "departed" || r.CreateFinished {
+			t.Fatal("lost creation identity", r)
+		}
+		return nil, false, errors.New("physical absence unconfirmed")
+	})
+	if err == nil || r.Phase != "closing" {
+		t.Fatal(err, r)
+	}
+}
+func TestInterruptedNativeCreationIsNotReexecutedAndUncertainCleanupRetainsEvidence(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	_, e := m.Store.Update(i.ID, func(*Record, int64) (*Record, error) {
+		return &Record{ID: i.ID, Digest: i.Digest, SandboxID: SandboxID(i.ID), NotAfter: i.NotAfter, Phase: "creating", StartedBoot: "departed"}, nil
+	})
+	i.BootID = "departed"
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, e := m.Create(context.Background(), i, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		t.Fatal("replayed incomplete creation")
+		return nil, false, nil
+	})
+	if e != nil || r.Phase != "creating" {
+		t.Fatal(e, r)
+	}
+	r, e = m.Close(context.Background(), i, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) {
+		if r.CreateFinished || r.StartedBoot != "departed" {
+			t.Fatal(r)
+		}
+		return nil, false, errors.New("physical state unconfirmed")
+	})
+	if e == nil || r.Phase != "closing" {
+		t.Fatal(e, r)
+	}
+	now.Store(i.NotAfter + retention + 1)
+	if e = m.Store.Collect(); e != nil {
+		t.Fatal(e)
+	}
+	r, e = m.Store.Get(i.ID)
+	if e != nil || r == nil || !r.Closed {
+		t.Fatal(e, r)
+	}
+}
