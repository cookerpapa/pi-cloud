+)
+
+func realStore(t *testing.T) *Store {
+	t.Helper()
+	dsn := os.Getenv("PI_CLOUD_ALLOCATION_MYSQL_DSN")
+	if dsn == "" {
+		t.Skip("explicit disposable MySQL required")
+	}
+	config, err := mysqldriver.ParseDSN(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.DBName != "allocation_test" && !strings.HasPrefix(config.DBName, "pi_cloud_allocation_") {
+		t.Fatal("allocation tests require a disposable database name")
+	}
+	db, e := gorm.Open(mysql.Open(dsn), &gorm.Config{Logger: logger.Discard})
+	if e != nil {
+		t.Fatal(e)
+	}
+	sqlDB, e := db.DB()
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { sqlDB.Close() })
+	migration, e := os.ReadFile("../../../CubeDB/migrate/migrations/mysql/20261004000000_pi_cloud_allocation.sql")
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = db.Exec(strings.Split(string(migration), "-- +goose Down")[0]).Error; e != nil {
+		t.Fatal(e)
+	}
+	if e = db.Exec("create table if not exists t_cube_volume (volume_id varchar(128) primary key, refcount bigint not null, updated_at datetime(3))").Error; e != nil {
+		t.Fatal(e)
+	}
+	return &Store{DB: db}
+}
+func TestPersistentAllocationAdmissionAndClosure(t *testing.T) {
+	s := realStore(t)
+	ctx := context.Background()
+	id := uuid.NewString()
+	deadline := time.Now().Add(time.Minute).UnixMilli()
+	digest := strings.Repeat("a", 64)
+	var wg sync.WaitGroup
+	tokens := make(chan string, 12)
+	for n := 0; n < 12; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r, e := s.Begin(ctx, id, digest, deadline, `{"spec":"same"}`)
+			if e != nil {
+				t.Error(e)
+				return
+			}
+			tokens <- r.TrafficToken
+		}()
+	}
+	wg.Wait()
+	close(tokens)
+	token := ""
+	for current := range tokens {
+		if token != "" && current != token {
+			t.Fatal("duplicate creation changed proxy credential")
+		}
+		token = current
+	}
+	if _, e := s.Begin(ctx, id, strings.Repeat("b", 64), deadline, "{}"); !errors.Is(e, ErrConflict) {
+		t.Fatal(e)
+	}
+	first, e := s.Place(ctx, id, "node-one", "127.0.0.1", "boot-one", "node-request", "resolved-request")
+	if e != nil {
+		t.Fatal(e)
+	}
+	second, e := s.Place(ctx, id, "node-two", "127.0.0.2", "boot-two", "different", "different")
+	if e != nil || second.NodeID != first.NodeID || second.NodeRequest != first.NodeRequest {
+		t.Fatal(e, second)
+	}
+	restarted := &Store{DB: s.DB}
+	r, e := restarted.Close(ctx, id, deadline)
+	if e != nil || !r.Closed || r.Phase != "closing" {
+		t.Fatal(e, r)
+	}
+	if _, e = s.Place(ctx, id, "node-three", "127.0.0.3", "boot-three", "late", "late"); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	if _, e = s.Begin(ctx, id, digest, deadline, "{}"); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	if _, e = s.Finish(ctx, id, "ready", "{}", nil, nil); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	r, e = s.Finish(ctx, id, "absent", "", nil, nil)
+	if e != nil || r.Phase != "absent" {
+		t.Fatal(e, r)
+	}
+}
+func TestCloseBeforeRegistrationAndExpiredReceipts(t *testing.T) {
+	s := realStore(t)
+	ctx := context.Background()
+	id := uuid.NewString()
+	deadline := time.Now().Add(-2 * time.Hour).UnixMilli()
+	r, e := s.Close(ctx, id, deadline)
+	if e != nil || r.Phase != "absent" || r.NodeID != "" {
+		t.Fatal(e, r)
+	}
+	if _, e = s.Begin(ctx, id, strings.Repeat("a", 64), deadline, "{}"); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	if e = s.Collect(ctx); e != nil {
+		t.Fatal(e)
+	}
+	r, e = s.Get(ctx, id)
+	if e != nil || r != nil {
+		t.Fatal(e, r)
+	}
+	if _, e = s.Begin(ctx, id, strings.Repeat("a", 64), deadline, "{}"); !errors.Is(e, ErrExpired) {
+		t.Fatal(e)
+	}
+}
+func TestReplyRecoveryAppliesVolumeTransitionsOnceInTheReceiptTransaction(t *testing.T) {
+	s := realStore(t)
+	ctx := context.Background()
+	id, volume := uuid.NewString(), uuid.NewString()
+	deadline := time.Now().Add(time.Minute).UnixMilli()
+	if e := s.DB.Exec("insert into t_cube_volume(volume_id,refcount) values (?,0)", volume).Error; e != nil {
+		t.Fatal(e)
+	}
+	if _, e := s.Begin(ctx, id, strings.Repeat("a", 64), deadline, "{}"); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := s.Place(ctx, id, "node", "127.0.0.1", "boot", "wire", "spec"); e != nil {
+		t.Fatal(e)
+	}
+	event := func(ref int) map[string][]byte {
+		data, _ := json.Marshal([]volrefcount.Event{{VolumeID: volume, Referenced: ref}})
+		return map[string][]byte{volrefcount.ExtInfoKey: data}
+	}
+	for n := 0; n < 3; n++ {
+		if _, e := s.Finish(ctx, id, "ready", "reply", event(1), nil); e != nil {
+			t.Fatal(e)
+		}
+	}
+	var count int
+	if e := s.DB.Raw("select refcount from t_cube_volume where volume_id=?", volume).Scan(&count).Error; e != nil || count != 1 {
+		t.Fatal(e, count)
+	}
+	if _, e := s.Close(ctx, id, deadline); e != nil {
+		t.Fatal(e)
+	}
+	for n := 0; n < 3; n++ {
+		if _, e := s.Finish(ctx, id, "absent", "", event(1), event(0)); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if e := s.DB.Raw("select refcount from t_cube_volume where volume_id=?", volume).Scan(&count).Error; e != nil || count != 0 {
+		t.Fatal(e, count)
+	}
+}
