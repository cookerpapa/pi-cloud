+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+type reviewFailOnceDB struct {
+	*bolt.DB
+	fail bool
+}
+
+func (d *reviewFailOnceDB) Update(fn func(*bolt.Tx) error) error {
+	if d.fail {
+		d.fail = false
+		return errors.New("review: node receipt write unavailable")
+	}
+	return d.DB.Update(fn)
+}
+
+// Allocation and Volume metadata have independent durable lifetimes.
+func TestCleanupReceiptLossRetainsQueryableVolumeState(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	db := &reviewFailOnceDB{DB: raw}
+	store, err := NewStore(db, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager := NewManager(store, "review-boot")
+	id := Identity{ID: "a1000000-0000-4000-8000-000000000001", Digest: strings.Repeat("a", 64), NotAfter: time.Now().Add(time.Minute).UnixMilli(), BootID: "review-boot"}
+	if _, err = manager.Create(context.Background(), id, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		return json.RawMessage(`{"created":true}`), true, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	refs, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = refs.Acquire("default", "volume", id.ID, "test"); err != nil {
+		t.Fatal(err)
+	}
+	physicalDeletes := 0
+	_, err = manager.Close(context.Background(), id, time.Second, func(context.Context, Record) (json.RawMessage, bool, error) {
+		physicalDeletes++
+		if _, err = refs.BeginDetach("default", "volume", id.ID, nil); err != nil {
+			t.Fatal(err)
+		}
+		if err = refs.CompleteDetach("default", "volume", id.ID); err != nil {
+			t.Fatal(err)
+		}
+		db.fail = true
+		return json.RawMessage(`{"volumeReference":0}`), true, nil
+	})
+	if err == nil {
+		t.Fatal("receipt write failure was not injected")
+	}
+	// The actual cleanup adapter takes this branch when exact node Observe sees
+	// absence: return r.CleanupResult, true, nil. The first reply was never stored.
+	r, err := manager.Close(context.Background(), id, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) { return r.CleanupResult, true, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Phase != "absent" || !r.Closed || len(r.CleanupResult) != 0 || physicalDeletes != 1 {
+		t.Fatalf("unexpected baseline: %+v deletes=%d", r, physicalDeletes)
+	}
+	state, err := refs.State("default", "volume")
+	if err != nil || state.Count != 0 || !state.Confirmed {
+		t.Fatal(state, err)
+	}
+	t.Log("Physical absence and current Volume state survive loss of the allocation cleanup result")
+}
diff --git a/Cubelet/pkg/allocation/store.go b/Cubelet/pkg/allocation/store.go
new file mode 100644
index 0000000..3d9ea08
--- /dev/null
+++ b/Cubelet/pkg/allocation/store.go
@@ -0,0 +1,167 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+	"time"
+)
+
+// Reuse Cubelet's synchronous metadata database. No separate node database,
+// in-memory lifetime tombstone set, or external scheduler is introduced.
+type Database interface {
+	Update(func(*bolt.Tx) error) error
+	View(func(*bolt.Tx) error) error
+}
+type Record struct {
+	ID             string          `json:"allocationID"`
+	SandboxID      string          `json:"sandboxID"`
+	Digest         string          `json:"digest"`
+	NotAfter       int64           `json:"createBefore"`
+	Phase          string          `json:"phase"`
+	Closed         bool            `json:"closed"`
+	StartedBoot    string          `json:"startedBoot,omitempty"`
+	CreateFinished bool            `json:"createFinished"`
+	Result         json.RawMessage `json:"result,omitempty"`
+	CleanupResult  json.RawMessage `json:"cleanupResult,omitempty"`
+}
+type Store struct {
+	db  Database
+	now func() time.Time
+}
+
+var bucket = []byte("pi-cloud.allocations.v1")
+var records = []byte("records")
+var expiry = []byte("expiry")
+var floor = []byte("clock-floor")
+
+const retention = int64(time.Hour / time.Millisecond)
+
+var ErrMissing = errors.New("allocation not recorded")
+
+func NewStore(db Database, now func() time.Time) (*Store, error) {
+	if db == nil {
+		return nil, errors.New("allocation metadata unavailable")
+	}
+	if now == nil {
+		now = time.Now
+	}
+	s := &Store{db: db, now: now}
+	err := db.Update(func(tx *bolt.Tx) error {
+		if tx.DB().NoSync {
+			return errors.New("allocation receipts require synchronous node metadata")
+		}
+		b, e := tx.CreateBucketIfNotExists(bucket)
+		if e != nil {
+			return e
+		}
+		if _, e = b.CreateBucketIfNotExists(records); e != nil {
+			return e
+		}
+		_, e = b.CreateBucketIfNotExists(expiry)
+		return e
+	})
+	return s, err
+}
+func decode(v []byte) (*Record, error) {
+	if v == nil {
+		return nil, nil
+	}
+	var r Record
+	err := json.Unmarshal(v, &r)
+	return &r, err
+}
+func (s *Store) Get(id string) (*Record, error) {
+	var r *Record
+	err := s.db.View(func(tx *bolt.Tx) error {
+		var e error
+		r, e = decode(tx.Bucket(bucket).Bucket(records).Get([]byte(id)))
+		return e
+	})
+	return r, err
+}
+func clock(b *bolt.Bucket, now int64) (int64, error) {
+	if v := b.Get(floor); len(v) == 8 && int64(binary.BigEndian.Uint64(v)) > now {
+		now = int64(binary.BigEndian.Uint64(v))
+	}
+	v := make([]byte, 8)
+	binary.BigEndian.PutUint64(v, uint64(now))
+	return now, b.Put(floor, v)
+}
+func expiryKey(r *Record) []byte {
+	k := make([]byte, 8+len(r.ID))
+	binary.BigEndian.PutUint64(k, uint64(r.NotAfter+retention))
+	copy(k[8:], r.ID)
+	return k
+}
+func (s *Store) Update(id string, change func(*Record, int64) (*Record, error)) (*Record, error) {
+	var result *Record
+	err := s.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now, e := clock(b, s.now().UnixMilli())
+		if e != nil {
+			return e
+		}
+		current, e := decode(b.Bucket(records).Get([]byte(id)))
+		if e != nil {
+			return e
+		}
+		result, e = change(current, now)
+		if e != nil {
+			return e
+		}
+		if result == nil {
+			return errors.New("missing allocation mutation")
+		}
+		data, e := json.Marshal(result)
+		if e != nil {
+			return e
+		}
+		if len(data) > 256*1024 {
+			return errors.New("allocation receipt too large")
+		}
+		if e = b.Bucket(records).Put([]byte(id), data); e != nil {
+			return e
+		}
+		if result.Closed && result.Phase == "absent" {
+			return b.Bucket(expiry).Put(expiryKey(result), []byte(id))
+		}
+		return nil
+	})
+	return result, err
+}
+
+// Only confirmed closed receipts expire. The durable clock floor prevents a
+// subsequent clock rollback from making their old Create authorization valid.
+func (s *Store) Collect() error {
+	return s.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now, e := clock(b, s.now().UnixMilli())
+		if e != nil {
+			return e
+		}
+		c := b.Bucket(expiry).Cursor()
+		for n := 0; n < 128; n++ {
+			k, id := c.First()
+			if k == nil || int64(binary.BigEndian.Uint64(k[:8])) > now {
+				return nil
+			}
+			r, e := decode(b.Bucket(records).Get(id))
+			if e != nil {
+				return e
+			}
+			if r != nil && r.Closed && r.Phase == "absent" && r.NotAfter+retention <= now {
+				if e = b.Bucket(records).Delete(id); e != nil {
+					return e
+				}
+			}
+			if e = c.Delete(); e != nil {
+				return e
+			}
+		}
+		return nil
+	})
+}
