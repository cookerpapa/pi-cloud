+)
+
+func TestManagedCleanupGivesPausedDestroyItsNativeBudget(t *testing.T) {
+	sb := newCubeboxWithStatusForTest("paused-managed-delete", cubeboxstore.Status{PausedAt: time.Now().Add(-time.Minute).UnixNano()})
+	sb.FirstContainer().Container = &fakeDestroyContainer{task: &fakeDestroyTask{}}
+	s, _, flow := newDestroyLifecycleServiceForTest(sb)
+	db, err := bolt.Open(filepath.Join(t.TempDir(), "meta.db"), 0600, nil)
+	require.NoError(t, err)
+	defer db.Close()
+	store, err := allocation.NewStore(db, time.Now)
+	require.NoError(t, err)
+	m := allocation.NewManager(store, "test-boot")
+	i := allocation.Identity{ID: "12345678-1234-1234-1234-123456789abc", Digest: strings.Repeat("a", 64), NotAfter: time.Now().Add(time.Minute).UnixMilli(), BootID: "test-boot"}
+	_, err = m.Create(context.Background(), i, time.Second, func(context.Context) (json.RawMessage, bool, error) { return nil, true, nil })
+	require.NoError(t, err)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	r, err := m.Close(ctx, i, s.config.destroyDeadline, func(c context.Context, _ allocation.Record) (json.RawMessage, bool, error) {
+		reply, e := s.destroyNative(c, &cubebox.DestroyCubeSandboxRequest{SandboxID: sb.ID, RequestID: "managed-close"})
+		require.NoError(t, e)
+		require.Equal(t, errorcode.ErrorCode_Success, reply.Ret.RetCode)
+		return nil, true, nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, "absent", r.Phase)
+	require.Equal(t, 1, flow.destroyCalls)
+	require.Greater(t, time.Until(flow.destroyDeadline), 20*time.Second)
+}
