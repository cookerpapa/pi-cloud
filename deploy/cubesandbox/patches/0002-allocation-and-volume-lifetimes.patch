@@ -0,0 +1,64 @@
+package sandbox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/cubelet/grpcconn"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/localcache"
+	"github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"time"
+)
+
+func refreshVolumeNode(ctx context.Context, store *allocation.Store, target allocation.VolumeNode) error {
+	host, ok := localcache.GetNode(target.NodeID)
+	if !ok || !host.Healthy {
+		return errors.New("recorded Volume node unavailable")
+	}
+	bounded, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	conn, err := grpcconn.GetWorkerConn(bounded, cubelet.GetCubeletAddr(host.HostIP()))
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	response, err := cubebox.NewCubeboxMgrClient(conn.Value()).ObserveVolumeReferences(bounded, &cubebox.VolumeReferenceRequest{Namespace: "default", VolumeIds: []string{target.VolumeID}})
+	if err != nil {
+		return err
+	}
+	var states []allocation.VolumeState
+	if err = json.Unmarshal(response.State, &states); err != nil {
+		return err
+	}
+	if len(states) != 1 {
+		return errors.New("Volume reference response changed")
+	}
+	return store.ApplyVolumeState(ctx, target, states[0])
+}
+func RefreshAllocationVolumeReferences(ctx context.Context, id string) error {
+	store := allocation.Default()
+	nodes, err := store.AllocationVolumeNodes(ctx, id)
+	if err != nil {
+		return err
+	}
+	for _, node := range nodes {
+		if err = refreshVolumeNode(ctx, store, node); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func RefreshVolumeReferences(ctx context.Context, store *allocation.Store, id string) error {
+	nodes, err := store.VolumeNodes(ctx, id)
+	if err != nil {
+		return err
+	}
+	for _, node := range nodes {
+		if err = refreshVolumeNode(ctx, store, node); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/Cubelet/pkg/allocation/manager.go b/Cubelet/pkg/allocation/manager.go
new file mode 100644
index 0000000000000000000000000000000000000000..00a1c35d60204ac8d5cfbecd9b07c80661b6bfa0
--- /dev/null
+++ b/Cubelet/pkg/allocation/manager.go
@@ -0,0 +1,169 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+	"regexp"
+	"strings"
+	"time"
+)
+
+var idPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var digestPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var ErrExpired = errors.New("allocation creation authorization expired")
+var ErrConflict = errors.New("allocation request identity changed")
+var ErrClosed = errors.New("allocation is closed")
+
+type Identity struct {
+	ID              string
+	Digest          string
+	NotAfter        int64
+	BootID          string
+	RetentionWindow int64
+}
+
+func SandboxID(id string) string { return strings.ReplaceAll(id, "-", "") }
+func (i Identity) Validate() error {
+	if !idPattern.MatchString(i.ID) || !digestPattern.MatchString(i.Digest) || i.NotAfter <= 0 || i.NotAfter > 1<<53 || i.BootID == "" || len(i.BootID) > 64 || i.RetentionWindow < 0 || i.RetentionWindow > 86400000 {
+		return errors.New("invalid allocation identity")
+	}
+	return nil
+}
+
+type Manager struct {
+	Store  *Store
+	BootID string
+	locks  *utils.ResourceLocks
+}
+
+func NewManager(store *Store, boot string) *Manager {
+	return &Manager{Store: store, BootID: boot, locks: utils.NewResourceLocks()}
+}
+
+type Create func(context.Context) (json.RawMessage, bool, error)
+type Cleanup func(context.Context, Record) (json.RawMessage, bool, error)
+
+// One native creation may execute for an allocation. Its lifetime is independent
+// of a caller's HTTP/gRPC response connection, but bounded by Cube's native deadline.
+func (m *Manager) Create(ctx context.Context, i Identity, budget time.Duration, create Create) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	unlock, err := m.locks.LockContext(ctx, i.ID)
+	if err != nil {
+		return nil, err
+	}
+	defer unlock()
+	start := false
+	r, err := m.Store.Update(i.ID, func(r *Record, now int64) (*Record, error) {
+		if r != nil {
+			if r.Closed {
+				return nil, ErrClosed
+			}
+			if r.Digest != i.Digest || r.NotAfter != i.NotAfter || (r.StartedBoot != "" && r.StartedBoot != i.BootID) {
+				return nil, ErrConflict
+			}
+			return r, nil // includes an uncertain creation from a previous node boot
+		}
+		if now >= i.NotAfter {
+			return nil, ErrExpired
+		}
+		if i.BootID != m.BootID {
+			return nil, errors.New("allocation node boot changed")
+		}
+		start = true
+		r = &Record{ID: i.ID, SandboxID: SandboxID(i.ID), Digest: i.Digest, NotAfter: i.NotAfter, Phase: "creating", StartedBoot: m.BootID, RetentionWindow: i.RetentionWindow}
+		if i.RetentionWindow > 0 {
+			r.RetainUntil = now + i.RetentionWindow
+		}
+		return r, nil
+	})
+	if err != nil || !start {
+		return r, err
+	}
+	run, cancel := context.WithTimeout(context.WithoutCancel(ctx), budget)
+	defer cancel()
+	result, success, cause := create(run)
+	r, err = m.Store.Update(i.ID, func(r *Record, _ int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		r.Result = result
+		r.CreateFinished = true
+		if r.Closed {
+			r.Phase = "closing"
+		} else if success && cause == nil {
+			r.Phase = "ready"
+		} else {
+			r.Phase = "failed"
+		}
+		return r, nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+// Close's durable admission precedes its wait for the original creation. A late
+// Create can never reopen this identity, even while physical cleanup is blocked.
+func (m *Manager) Close(ctx context.Context, i Identity, budget time.Duration, cleanup Cleanup) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	r, err := m.Store.Update(i.ID, func(r *Record, _ int64) (*Record, error) {
+		if r == nil {
+			phase := "absent"
+			if i.BootID != m.BootID {
+				phase = "closing"
+			}
+			return &Record{ID: i.ID, SandboxID: SandboxID(i.ID), Digest: i.Digest, NotAfter: i.NotAfter, Closed: true, Phase: phase, StartedBoot: i.BootID}, nil
+		}
+		if r.Digest != i.Digest || r.NotAfter != i.NotAfter || (r.StartedBoot != "" && r.StartedBoot != i.BootID) {
+			return nil, ErrConflict
+		}
+		r.Closed = true
+		if r.Phase != "absent" {
+			r.Phase = "closing"
+		}
+		return r, nil
+	})
+	if err != nil || r.Phase == "absent" {
+		return r, err
+	}
+	unlock, err := m.locks.LockContext(ctx, i.ID)
+	if err != nil {
+		return r, nil
+	}
+	defer unlock()
+	r, err = m.Store.Get(i.ID)
+	if err != nil {
+		return nil, err
+	}
+	if r == nil {
+		return nil, ErrMissing
+	}
+	if r.Phase == "absent" {
+		return r, nil
+	}
+	// Admission is irreversible. Once physical cleanup starts its lifetime is
+	// owned by Cube, bounded by the native destroy policy, not the RPC caller.
+	run, cancel := context.WithTimeout(context.WithoutCancel(ctx), budget)
+	defer cancel()
+	result, absent, err := cleanup(run, *r)
+	if err != nil || !absent {
+		return r, err
+	}
+	return m.Store.Update(i.ID, func(r *Record, _ int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		r.Phase = "absent"
+		r.CleanupResult = result
+		return r, nil
+	})
+}
