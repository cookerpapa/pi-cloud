@@ -0,0 +1,237 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func fixture(t *testing.T) (*Manager, *bolt.DB, *atomic.Int64) {
+	t.Helper()
+	db, e := bolt.Open(filepath.Join(t.TempDir(), "meta.db"), 0600, nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { db.Close() })
+	now := &atomic.Int64{}
+	now.Store(1_000_000)
+	s, e := NewStore(db, func() time.Time { return time.UnixMilli(now.Load()) })
+	if e != nil {
+		t.Fatal(e)
+	}
+	return NewManager(s, "boot-one"), db, now
+}
+func identity() Identity {
+	return Identity{ID: "12345678-1234-1234-1234-123456789abc", Digest: strings.Repeat("a", 64), NotAfter: 1_300_000, BootID: "boot-one"}
+}
+func success(context.Context) (json.RawMessage, bool, error) {
+	return json.RawMessage(`{"result":"created"}`), true, nil
+}
+func absent(context.Context, Record) (json.RawMessage, bool, error) { return nil, true, nil }
+
+func TestConcurrentCreateAndLostResponseKeepOneNativeExecution(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	var calls atomic.Int32
+	var wg sync.WaitGroup
+	for n := 0; n < 20; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r, e := m.Create(context.Background(), i, time.Second, func(c context.Context) (json.RawMessage, bool, error) {
+				calls.Add(1)
+				time.Sleep(time.Millisecond)
+				return success(c)
+			})
+			if e != nil || r.Phase != "ready" {
+				t.Errorf("create: %v %+v", e, r)
+			}
+		}()
+	}
+	wg.Wait()
+	if calls.Load() != 1 {
+		t.Fatalf("%d effects", calls.Load())
+	}
+	// A new process can return the saved reply, without repeating physical work.
+	next := NewManager(m.Store, "boot-two")
+	r, e := next.Create(context.Background(), i, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		t.Fatal("replayed effect")
+		return nil, false, nil
+	})
+	if e != nil || r.Phase != "ready" {
+		t.Fatalf("restore: %v %+v", e, r)
+	}
+	changed := i
+	changed.Digest = strings.Repeat("b", 64)
+	if _, e = m.Create(context.Background(), changed, time.Second, success); !errors.Is(e, ErrConflict) {
+		t.Fatalf("changed input: %v", e)
+	}
+}
+func TestCloseBeforeCreateRejectsDelayedRequestAcrossRestartAndGC(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	r, e := m.Close(context.Background(), i, time.Second, absent)
+	if e != nil || r.Phase != "absent" {
+		t.Fatal(e, r)
+	}
+	next := NewManager(m.Store, "boot-two")
+	if _, e = next.Create(context.Background(), i, time.Second, success); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+	now.Store(i.NotAfter + retention + 1)
+	if e = m.Store.Collect(); e != nil {
+		t.Fatal(e)
+	}
+	r, e = m.Store.Get(i.ID)
+	if e != nil || r != nil {
+		t.Fatal(e, r)
+	}
+	now.Store(1)
+	if _, e = next.Create(context.Background(), i, time.Second, success); !errors.Is(e, ErrExpired) {
+		t.Fatalf("clock rollback admitted old request: %v", e)
+	}
+}
+func TestCloseDuringCreateCannotConfirmAbsenceBeforeCreationJoins(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		_, e := m.Create(context.Background(), i, time.Second, func(c context.Context) (json.RawMessage, bool, error) { close(entered); <-release; return success(c) })
+		if e != nil {
+			t.Error(e)
+		}
+	}()
+	<-entered
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	var clean atomic.Int32
+	cleanup := func(context.Context, Record) (json.RawMessage, bool, error) { clean.Add(1); return nil, true, nil }
+	r, e := m.Close(ctx, i, time.Second, cleanup)
+	if e != nil || r.Phase != "closing" || clean.Load() != 0 {
+		t.Fatal(e, r, clean.Load())
+	}
+	// Another allocation is independent of this slow creator.
+	other := i
+	other.ID = "22345678-1234-1234-1234-123456789abc"
+	if r, e = m.Create(context.Background(), other, time.Second, success); e != nil || r.Phase != "ready" {
+		t.Fatal(e, r)
+	}
+	close(release)
+	<-done
+	r, e = m.Close(context.Background(), i, time.Second, cleanup)
+	if e != nil || r.Phase != "absent" || clean.Load() != 1 {
+		t.Fatal(e, r, clean.Load())
+	}
+	if _, e = m.Create(context.Background(), i, time.Second, success); !errors.Is(e, ErrClosed) {
+		t.Fatal(e)
+	}
+}
+func TestNativeCreationOutlivesResponseCancellationButNotItsOwnDeadline(t *testing.T) {
+	m, _, _ := fixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	r, e := m.Create(ctx, identity(), time.Second, func(c context.Context) (json.RawMessage, bool, error) {
+		cancel()
+		if c.Err() != nil {
+			t.Fatal("response cancellation ended native creation")
+		}
+		return success(c)
+	})
+	if e != nil || r.Phase != "ready" {
+		t.Fatal(e, r)
+	}
+}
+
+func TestCleanupOutlivesCallerButHonorsNativeBudget(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	if _, err := m.Create(context.Background(), i, time.Second, success); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	r, err := m.Close(ctx, i, 25*time.Millisecond, func(c context.Context, _ Record) (json.RawMessage, bool, error) {
+		cancel()
+		if c.Err() != nil {
+			t.Fatal("caller cancelled accepted cleanup")
+		}
+		<-c.Done()
+		return nil, false, c.Err()
+	})
+	if !errors.Is(err, context.DeadlineExceeded) || r.Phase != "closing" || !r.Closed {
+		t.Fatal(r, err)
+	}
+	// Retry the original identity; no new creation or lost terminal result.
+	r, err = m.Close(context.Background(), i, time.Second, absent)
+	if err != nil || r.Phase != "absent" {
+		t.Fatal(r, err)
+	}
+	_, err = m.Close(context.Background(), i, time.Second, func(context.Context, Record) (json.RawMessage, bool, error) {
+		t.Fatal("repeated completed cleanup")
+		return nil, false, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestMissingNodeJournalCannotAdmitAnOldBootCreate(t *testing.T) {
+	m, _, _ := fixture(t)
+	i := identity()
+	i.BootID = "departed"
+	if _, err := m.Create(context.Background(), i, time.Second, success); err == nil {
+		t.Fatal("old boot created a VM")
+	}
+	r, err := m.Close(context.Background(), i, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) {
+		if r.StartedBoot != "departed" || r.CreateFinished {
+			t.Fatal("lost creation identity", r)
+		}
+		return nil, false, errors.New("physical absence unconfirmed")
+	})
+	if err == nil || r.Phase != "closing" {
+		t.Fatal(err, r)
+	}
+}
+func TestInterruptedNativeCreationIsNotReexecutedAndUncertainCleanupRetainsEvidence(t *testing.T) {
+	m, _, now := fixture(t)
+	i := identity()
+	_, e := m.Store.Update(i.ID, func(*Record, int64) (*Record, error) {
+		return &Record{ID: i.ID, Digest: i.Digest, SandboxID: SandboxID(i.ID), NotAfter: i.NotAfter, Phase: "creating", StartedBoot: "departed"}, nil
+	})
+	i.BootID = "departed"
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, e := m.Create(context.Background(), i, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		t.Fatal("replayed incomplete creation")
+		return nil, false, nil
+	})
+	if e != nil || r.Phase != "creating" {
+		t.Fatal(e, r)
+	}
+	r, e = m.Close(context.Background(), i, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) {
+		if r.CreateFinished || r.StartedBoot != "departed" {
+			t.Fatal(r)
+		}
+		return nil, false, errors.New("physical state unconfirmed")
+	})
+	if e == nil || r.Phase != "closing" {
+		t.Fatal(e, r)
+	}
+	now.Store(i.NotAfter + retention + 1)
+	if e = m.Store.Collect(); e != nil {
+		t.Fatal(e)
+	}
+	r, e = m.Store.Get(i.ID)
+	if e != nil || r == nil || !r.Closed {
+		t.Fatal(e, r)
+	}
+}
diff --git a/Cubelet/pkg/allocation/receipt_recovery_test.go b/Cubelet/pkg/allocation/receipt_recovery_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7ba382c62b372e052bb354a03af37787c977809c
--- /dev/null
+++ b/Cubelet/pkg/allocation/receipt_recovery_test.go
@@ -0,0 +1,83 @@
+package allocation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	bolt "go.etcd.io/bbolt"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+type reviewFailOnceDB struct {
+	*bolt.DB
+	fail bool
+}
+
+func (d *reviewFailOnceDB) Update(fn func(*bolt.Tx) error) error {
+	if d.fail {
+		d.fail = false
+		return errors.New("review: node receipt write unavailable")
+	}
+	return d.DB.Update(fn)
+}
+
+// Allocation and Volume metadata have independent durable lifetimes.
+func TestCleanupReceiptLossRetainsQueryableVolumeState(t *testing.T) {
+	raw, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	db := &reviewFailOnceDB{DB: raw}
+	store, err := NewStore(db, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager := NewManager(store, "review-boot")
+	id := Identity{ID: "a1000000-0000-4000-8000-000000000001", Digest: strings.Repeat("a", 64), NotAfter: time.Now().Add(time.Minute).UnixMilli(), BootID: "review-boot"}
+	if _, err = manager.Create(context.Background(), id, time.Second, func(context.Context) (json.RawMessage, bool, error) {
+		return json.RawMessage(`{"created":true}`), true, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	refs, err := refcount.New(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = refs.Acquire("default", "volume", id.ID, "test"); err != nil {
+		t.Fatal(err)
+	}
+	physicalDeletes := 0
+	_, err = manager.Close(context.Background(), id, time.Second, func(context.Context, Record) (json.RawMessage, bool, error) {
+		physicalDeletes++
+		if _, err = refs.BeginDetach("default", "volume", id.ID, nil); err != nil {
+			t.Fatal(err)
+		}
+		if err = refs.CompleteDetach("default", "volume", id.ID); err != nil {
+			t.Fatal(err)
+		}
+		db.fail = true
+		return json.RawMessage(`{"volumeReference":0}`), true, nil
+	})
+	if err == nil {
+		t.Fatal("receipt write failure was not injected")
+	}
+	// The actual cleanup adapter takes this branch when exact node Observe sees
+	// absence: return r.CleanupResult, true, nil. The first reply was never stored.
+	r, err := manager.Close(context.Background(), id, time.Second, func(_ context.Context, r Record) (json.RawMessage, bool, error) { return r.CleanupResult, true, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Phase != "absent" || !r.Closed || len(r.CleanupResult) != 0 || physicalDeletes != 1 {
+		t.Fatalf("unexpected baseline: %+v deletes=%d", r, physicalDeletes)
+	}
+	state, err := refs.State("default", "volume")
+	if err != nil || state.Count != 0 || !state.Confirmed {
+		t.Fatal(state, err)
+	}
+	t.Log("Physical absence and current Volume state survive loss of the allocation cleanup result")
+}
diff --git a/Cubelet/pkg/allocation/retention.go b/Cubelet/pkg/allocation/retention.go
new file mode 100644
index 0000000000000000000000000000000000000000..232ed35484c2fab2093fc712f397b3efc1eec7a0
--- /dev/null
+++ b/Cubelet/pkg/allocation/retention.go
@@ -0,0 +1,126 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package allocation
+
+import (
+	"encoding/binary"
+	"errors"
+	bolt "go.etcd.io/bbolt"
+)
+
+var ErrStaleActivity = errors.New("retention activity is stale")
+
+func idleKey(r *Record) []byte {
+	k := make([]byte, 8+len(r.ID))
+	binary.BigEndian.PutUint64(k, uint64(r.RetainUntil))
+	copy(k[8:], r.ID)
+	return k
+}
+
+// The existing synchronous allocation journal is the sole retention clock.
+// Replays retain their original time and cannot renew a later incarnation.
+func (m *Manager) Renew(i Identity, observedAt int64) (*Record, error) {
+	if err := i.Validate(); err != nil {
+		return nil, err
+	}
+	return m.Store.Update(i.ID, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed {
+			return nil, ErrClosed
+		}
+		if i.BootID != m.BootID || r.StartedBoot != i.BootID || r.Digest != i.Digest || r.NotAfter != i.NotAfter {
+			return nil, ErrConflict
+		}
+		if r.RetentionWindow <= 0 || r.Phase != "ready" {
+			return nil, ErrConflict
+		}
+		if observedAt <= 0 || observedAt > now+5000 || now-observedAt > 45000 {
+			return nil, ErrStaleActivity
+		}
+		until := observedAt + r.RetentionWindow
+		if until > r.RetainUntil {
+			r.RetainUntil = until
+		}
+		return r, nil
+	})
+}
+
+// Real accepted Tool activity uses the node's clock. Diagnostic probes never call it.
+func (s *Store) Touch(id string) error {
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed {
+			return nil, ErrClosed
+		}
+		if r.RetentionWindow > 0 && now+r.RetentionWindow > r.RetainUntil {
+			r.RetainUntil = now + r.RetentionWindow
+		}
+		return r, nil
+	})
+	return err
+}
+
+func (s *Store) Due(limit int) ([]Record, error) {
+	if limit < 1 || limit > 1024 {
+		return nil, errors.New("invalid retention page")
+	}
+	var result []Record
+	err := s.db.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket(bucket)
+		now := s.now().UnixMilli()
+		if v := b.Get(floor); len(v) == 8 && int64(binary.BigEndian.Uint64(v)) > now {
+			now = int64(binary.BigEndian.Uint64(v))
+		}
+		c := b.Bucket(idleExpiry).Cursor()
+		for k, id := c.First(); k != nil && len(result) < limit; k, id = c.Next() {
+			if int64(binary.BigEndian.Uint64(k[:8])) > now {
+				break
+			}
+			r, err := decode(b.Bucket(records).Get(id))
+			if err != nil {
+				return err
+			}
+			if r != nil {
+				result = append(result, *r)
+			}
+		}
+		return nil
+	})
+	return result, err
+}
+
+// Caller holds the Tool-admission mutex. Only this atomic recheck closes an
+// expired allocation; a previously enumerated deadline is never sufficient.
+func (s *Store) BeginExpiry(id string) (bool, error) {
+	closed := false
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.RetentionWindow > 0 && r.RetainUntil <= now && r.Phase != "absent" {
+			r.Closed = true
+			r.Phase = "closing"
+			closed = true
+		}
+		return r, nil
+	})
+	return closed, err
+}
+
+// Keep one failed physical cleanup from starving later expired allocations.
+func (s *Store) DeferExpiry(id string) error {
+	_, err := s.Update(id, func(r *Record, now int64) (*Record, error) {
+		if r == nil {
+			return nil, ErrMissing
+		}
+		if r.Closed && r.Phase != "absent" {
+			r.RetainUntil = now + 10000
+		}
+		return r, nil
+	})
+	return err
+}
