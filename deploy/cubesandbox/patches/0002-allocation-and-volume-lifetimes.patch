new file mode 100644
index 0000000000000000000000000000000000000000..7764b2d0a957aded0d53630b5dab269e65afdf8a
--- /dev/null
+++ b/Cubelet/plugins/volume/refcount/state.go
@@ -0,0 +1,113 @@
+package refcount
+
+import (
+	"encoding/binary"
+	"fmt"
+	"github.com/google/uuid"
+	bolt "go.etcd.io/bbolt"
+)
+
+var stateBucket = []byte("volume_reference_state")
+var epochKey = []byte("epoch")
+var revisionKey = []byte("revision")
+
+// One persistent incarnation and monotonic clock survive collection of zero
+// records. A recreated/lost metadata file has a different incarnation.
+func initializeState(tx *bolt.Tx) error {
+	b, err := tx.CreateBucketIfNotExists(stateBucket)
+	if err != nil {
+		return err
+	}
+	if b.Get(epochKey) == nil {
+		return b.Put(epochKey, []byte(uuid.NewString()))
+	}
+	return nil
+}
+func advanceState(tx *bolt.Tx) error {
+	b := tx.Bucket(stateBucket)
+	var n uint64
+	if v := b.Get(revisionKey); len(v) == 8 {
+		n = binary.BigEndian.Uint64(v)
+	}
+	if n >= 1<<63-1 {
+		return fmt.Errorf("Volume reference revision exhausted")
+	}
+	data := make([]byte, 8)
+	binary.BigEndian.PutUint64(data, n+1)
+	return b.Put(revisionKey, data)
+}
+
+type State struct {
+	VolumeID  string `json:"volumeID"`
+	Epoch     string `json:"epoch"`
+	Revision  uint64 `json:"revision"`
+	Count     int64  `json:"count"`
+	Confirmed bool   `json:"confirmed"`
+}
+
+func (s *Store) State(namespace, volumeID string) (State, error) {
+	result := State{VolumeID: volumeID}
+	err := s.db.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket(stateBucket)
+		if b == nil {
+			return fmt.Errorf("Volume reference incarnation unavailable")
+		}
+		result.Epoch = string(b.Get(epochKey))
+		if v := b.Get(revisionKey); len(v) == 8 {
+			result.Revision = binary.BigEndian.Uint64(v)
+		}
+		rec, err := getRecord(tx.Bucket([]byte(BucketName)), key(namespace, volumeID))
+		if err != nil {
+			return err
+		}
+		result.Count = rec.Count
+		result.Confirmed = !rec.Unknown && rec.Pending == nil && len(rec.StaleSandboxIDs) == 0
+		return nil
+	})
+	return result, err
+}
+
+// Allocation receipt collection shares this Bolt transaction. Preserve the
+// original evidence until every Volume holder/pending detach has released it.
+func ReferencedSandboxes(tx *bolt.Tx) (map[string]struct{}, error) {
+	result := make(map[string]struct{})
+	b := tx.Bucket([]byte(BucketName))
+	if b == nil {
+		return result, nil
+	}
+	err := b.ForEach(func(k, _ []byte) error {
+		rec, err := getRecord(b, k)
+		if err != nil {
+			return err
+		}
+		for id := range rec.SandboxIDs {
+			result[id] = struct{}{}
+		}
+		if rec.Pending != nil {
+			result[rec.Pending.SandboxID] = struct{}{}
+		}
+		return nil
+	})
+	return result, err
+}
+func (s *Store) CompleteDetach(namespace, volumeID, sandboxID string) error {
+	return s.db.Update(func(tx *bolt.Tx) error {
+		b := tx.Bucket([]byte(BucketName))
+		k := key(namespace, volumeID)
+		rec, err := getRecord(b, k)
+		if err != nil {
+			return err
+		}
+		if rec.Pending == nil || rec.Pending.SandboxID != sandboxID {
+			return fmt.Errorf("Volume detach identity changed")
+		}
+		rec.Pending = nil
+		if rec.Count == 0 && !rec.Unknown {
+			if err := advanceState(tx); err != nil {
+				return err
+			}
+			return b.Delete(k)
+		}
+		return putRecord(b, k, rec)
+	})
+}
