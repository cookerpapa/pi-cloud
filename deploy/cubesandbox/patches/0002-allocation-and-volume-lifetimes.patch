+func TestVolumeHolderRequiresClosedAllocationAndExactPhysicalAbsence(t *testing.T) {
+	db, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	store, err := allocation.NewStore(db, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager := allocation.NewManager(store, "boot")
+	catalog := &observationCatalog{failure: utils.ErrorKeyNotFound}
+	s := &service{allocations: manager, cubeboxMgr: &local{cubeboxManger: catalog}}
+	id := "12345678-1234-1234-1234-123456789abc"
+	sandbox := allocation.SandboxID(id)
+	proof := func(want bool) {
+		t.Helper()
+		got, _ := s.closedVolumeHolderAbsent(context.Background(), sandbox)
+		if got != want {
+			t.Fatalf("got proof %v, want %v", got, want)
+		}
+	}
+	proof(false)
+	_, err = store.Update(id, func(*allocation.Record, int64) (*allocation.Record, error) {
+		return &allocation.Record{ID: id, SandboxID: sandbox, Digest: strings.Repeat("a", 64), NotAfter: time.Now().UnixMilli() + 60000, StartedBoot: "boot", Phase: "ready", CreateFinished: true}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof(false)
+	_, err = store.Update(id, func(r *allocation.Record, _ int64) (*allocation.Record, error) {
+		r.Closed = true
+		r.Phase = "closing"
+		return r, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof(false)
+	_, err = store.Update(id, func(r *allocation.Record, _ int64) (*allocation.Record, error) { r.Phase = "absent"; return r, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof(true)
+	catalog.failure = errors.New("runtime recovery incomplete")
+	proof(false)
+	catalog.failure = nil
+	proof(false)
+	if ok, _ := s.closedVolumeHolderAbsent(context.Background(), "1234"); ok {
+		t.Fatal("partial sandbox identity accepted")
+	}
+}
diff --git a/Cubelet/services/cubebox/volume_references.go b/Cubelet/services/cubebox/volume_references.go
new file mode 100644
index 0000000000000000000000000000000000000000..f2cb0d78ea28f4f1ff652d64017c1f8fe9770e1d
--- /dev/null
+++ b/Cubelet/services/cubebox/volume_references.go
@@ -0,0 +1,55 @@
+package cubebox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/google/uuid"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/allocation"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/utils"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/volume/refcount"
+	"github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"strings"
+)
+
+func (s *service) ObserveVolumeReferences(ctx context.Context, r *cubebox.VolumeReferenceRequest) (*cubebox.VolumeReferenceResponse, error) {
+	if r.Namespace != "default" || len(r.VolumeIds) > 64 {
+		return nil, errors.New("invalid Volume reference query")
+	}
+	states := make([]refcount.State, 0, len(r.VolumeIds))
+	for _, id := range r.VolumeIds {
+		if id == "" || len(id) > 128 || strings.ContainsRune(id, 0) {
+			return nil, errors.New("invalid Volume identity")
+		}
+		state, err := volume.Global().ReconcileReference(ctx, r.Namespace, id, s.closedVolumeHolderAbsent)
+		if err != nil {
+			return nil, err
+		}
+		states = append(states, state)
+	}
+	raw, err := json.Marshal(states)
+	return &cubebox.VolumeReferenceResponse{State: raw}, err
+}
+
+func (s *service) closedVolumeHolderAbsent(ctx context.Context, sandboxID string) (bool, error) {
+	if s.allocations == nil {
+		return false, errors.New("allocation metadata unavailable")
+	}
+	id, err := uuid.Parse(sandboxID)
+	if err != nil || allocation.SandboxID(id.String()) != sandboxID {
+		return false, nil
+	}
+	record, err := s.allocations.Store.Get(id.String())
+	if err != nil {
+		return false, err
+	}
+	if record == nil || record.SandboxID != sandboxID || !record.Closed || record.Phase != "absent" {
+		return false, nil
+	}
+	_, err = s.cubeboxMgr.cubeboxManger.Observe(ctx, sandboxID)
+	if errors.Is(err, utils.ErrorKeyNotFound) {
+		return true, nil
+	}
+	return false, err
+}
