{
  "name": "pi-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "fastify": "5.12.4",
    "pi-security-brace-expansion": "npm:brace-expansion@5.0.12",
    "pi-security-protobufjs": "npm:protobufjs@7.6.5",
    "pi-security-undici": "npm:undici@8.10.2"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "fast-uri@3": "3.1.8",
    "fast-uri@4": "4.1.5",
    "@grpc/grpc-js": "1.14.5"
  },
  "scripts": {
    "postinstall": "node scripts/harden-pi-dependencies.mjs",
    "dependencies:harden": "node scripts/harden-pi-dependencies.mjs && npm rebuild @confluentinc/kafka-javascript",
    "dependencies:check": "node scripts/harden-pi-dependencies.mjs --check",
    "ci": "npm run dependencies:harden && npm run format:check && npm run docs:check && npm run production:install:check && npm run runtime-policy:check && npm run helm:check && npm run observability:check && npm run image:closure-check && npm run build && npm run check && npm run eval:faults && npm run security:audit",
    "build": "npm run build --workspaces --if-present",
    "cubesandbox:template-check": "node scripts/run-cubesandbox-template-check.mjs",
    "cubesandbox:live-check": "node scripts/run-cubesandbox-provider-live-check.mjs",
    "cubesandbox:init": "node scripts/init-cubesandbox-runtime.mjs",
    "cubesandbox:images": "node scripts/prefetch-cubesandbox-images.mjs",
    "cubesandbox:cluster-install": "node scripts/install-cubesandbox-k3s.mjs",
    "cubesandbox:template-register": "node scripts/register-cubesandbox-tool-template.mjs",
    "cubesandbox:config": "node scripts/production-kubernetes.mjs config",
    "cubesandbox:build": "node scripts/production-kubernetes.mjs build",
    "cubesandbox:up": "node scripts/production-kubernetes.mjs deploy",
    "cubesandbox:ps": "node scripts/production-kubernetes.mjs status",
    "cubesandbox:logs": "node scripts/production-kubernetes.mjs logs",
    "cubesandbox:down": "node scripts/production-kubernetes.mjs down",
    "helm:check": "node scripts/check-helm-pi-worker-pool.mjs && node scripts/check-helm-platform.mjs && node scripts/check-distributed-values-policy.mjs && node scripts/check-distributed-preflight.mjs && node scripts/check-helm-self-hosted.mjs",
    "observability:check": "node scripts/check-observability.mjs",
    "image:closure-check": "node scripts/check-supervisor-image-closure.mjs",
    "image:context-check": "node scripts/check-docker-build-context.mjs",
    "kubernetes:distributed:render": "node scripts/distributed-kubernetes.mjs render",
    "kubernetes:distributed:preflight": "node scripts/distributed-kubernetes.mjs preflight",
    "kubernetes:distributed:deploy": "node scripts/distributed-kubernetes.mjs deploy",
    "kubernetes:distributed:status": "node scripts/distributed-kubernetes.mjs status",
    "runtime-policy:check": "node scripts/check-runtime-time-budgets.mjs && node scripts/check-cubesandbox-template-retention.mjs",
    "benchmark:postgres-session-projection": "tsx scripts/run-postgres-session-projection-benchmark.ts",
    "eval:postgres-session-projection": "tsx scripts/run-postgres-session-projection-benchmark.ts",
    "eval:kafka-accepted-facts": "node scripts/run-kafka-accepted-fact-load.mjs",
    "production:init": "node scripts/init-production.mjs",
    "production:config": "node scripts/production-kubernetes.mjs config",
    "production:build": "node scripts/production-kubernetes.mjs build",
    "production:up": "node scripts/production-kubernetes.mjs deploy",
    "production:deploy": "node scripts/run-production-deploy.mjs",
    "production:install:check": "node scripts/test-self-hosted-install.mjs && bash -n install.sh scripts/install-self-hosted.sh",
    "production:ps": "node scripts/production-kubernetes.mjs status",
    "production:logs": "node scripts/production-kubernetes.mjs logs",
    "production:down": "node scripts/production-kubernetes.mjs down",
    "gitlab:init": "node scripts/gitlab-lab.mjs init",
    "gitlab:up": "node scripts/gitlab-lab.mjs up",
    "gitlab:down": "node scripts/gitlab-lab.mjs down",
    "gitlab:ps": "node scripts/gitlab-lab.mjs ps",
    "gitlab:logs": "node scripts/gitlab-lab.mjs logs",
    "gitlab:password": "node scripts/gitlab-lab.mjs password",
    "production:token": "node scripts/print-production-token.mjs",
    "production:provider-gateway:key": "node scripts/print-provider-gateway-management-key.mjs",
    "production:provider-gateway:codex-login": "node scripts/production-kubernetes.mjs exec cli-proxy-api -- ./CLIProxyAPI -config /run/pi-cloud-secrets/cli-proxy-config.yaml -codex-device-login -no-browser",
    "production:provider-gateway:deepseek-native": "node scripts/configure-deepseek-native-responses.mjs",
    "production:tenant": "node scripts/production-kubernetes.mjs exec control-plane -- node /app/node_modules/tsx/dist/cli.mjs --tsconfig /app/packages/control-plane/tsconfig.json /app/packages/control-plane/src/tenant-admin.ts",
    "production:administrator": "node scripts/set-production-administrator.mjs",
    "production:check": "node --import tsx scripts/run-live-cubesandbox-production-check.mjs",
    "production:product-surface-check": "node --import tsx scripts/run-live-product-surface-check.mjs",
    "production:snake-preview-check": "node --import tsx scripts/run-live-snake-preview-check.mjs",
    "production:native-tool-check": "node --import tsx scripts/run-live-native-tool-check.mjs",
    "production:execution-probe-check": "node --import tsx scripts/run-live-execution-probe-check.mjs",
    "production:vite-preview-check": "node --import tsx scripts/run-live-vite-preview-check.mjs",
    "production:preview-isolation-check": "node --import tsx scripts/run-live-preview-isolation-check.mjs",
    "production:browser-ui-check": "node --import tsx scripts/run-live-browser-ui-check.mjs",
    "browser:presentation:check": "node scripts/run-browser-presentation-check.mjs",
    "web:deployment:check": "npm run build --workspace @pi-cloud/web-ui && node scripts/run-web-deployment-check.mjs",
    "production:directory-picker-check": "node --import tsx scripts/run-live-directory-picker-check.mjs",
    "production:subagents-check": "node --import tsx scripts/run-live-subagent-production-check.mjs",
    "production:session-family-check": "node --import tsx scripts/run-live-session-family-check.mjs",
    "production:code-host-check": "node --import tsx scripts/run-live-code-host-issue-check.mjs",
    "production:development-environment-check": "node --import tsx scripts/run-live-development-environment-check.mjs",
    "production:semantic-check": "node --import tsx scripts/run-live-cubesandbox-production-check.mjs",
    "production:worker-pool-check": "node --import tsx scripts/run-live-pi-worker-pool-check.mjs",
    "production:control-plane-restart-check": "node --import tsx scripts/run-live-control-plane-restart-check.mjs",
    "production:kafka-restart-check": "node --import tsx scripts/run-live-control-plane-restart-check.mjs",
    "production:multi-tenant-model-load": "node --import tsx scripts/run-live-multi-tenant-model-load.mjs",
    "production:long-context-check": "node --import tsx scripts/run-live-long-context-compaction-check.mjs",
    "production:provider-capability-check": "node --import tsx scripts/run-live-provider-capability-check.mjs",
    "production:model-settings-check": "node --import tsx scripts/run-live-model-settings-check.mjs",
    "production:hosted-search-replay-check": "node --import tsx scripts/run-live-hosted-search-replay-probe.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "format": "git ls-files --cached --others --exclude-standard -z | xargs -0 -r prettier --write --ignore-unknown",
    "format:check": "git ls-files --cached --others --exclude-standard -z | xargs -0 -r prettier --check --ignore-unknown",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:acceptance-helpers": "vitest run scripts/lib --maxWorkers=1",
    "fake-model:start": "npm run start --workspace @pi-cloud/fake-model-server",
    "db:migrate": "npm run migrate --workspace @pi-cloud/database",
    "db:migrate:down": "npm run migrate:down --workspace @pi-cloud/database",
    "demo": "npm run production:deploy",
    "docs:check": "node scripts/check-documentation.mjs",
    "check": "npm run typecheck && npm test && npm run test:acceptance-helpers",
    "security:audit": "node scripts/run-security-audit.mjs",
    "eval:faults": "node scripts/run-with-test-postgres.mjs -- node scripts/run-fault-eval.mjs",
    "eval:load": "node scripts/run-control-plane-load.mjs",
    "production:image-check": "node --import tsx scripts/run-live-image-attachment-check.mjs",
    "production:gpt6-check": "node scripts/run-live-gpt6-capability-check.mjs",
    "production:user-upload-check": "node --import tsx scripts/run-live-user-upload-check.mjs",
    "production:up:observability": "PI_CLOUD_OBSERVABILITY_ENABLED=1 node scripts/production-kubernetes.mjs deploy",
    "production:config:observability": "PI_CLOUD_OBSERVABILITY_ENABLED=1 node scripts/production-kubernetes.mjs config"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "@pi-cloud/database": "0.1.0",
    "@pi-cloud/pi-session-postgres": "0.1.0",
    "@types/node": "24.12.4",
    "kysely": "0.29.4",
    "prettier": "3.9.5",
    "ssh2": "1.17.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "ws": "8.21.1",
    "yaml": "2.9.0",
    "semver": "7.8.5"
  }
}
