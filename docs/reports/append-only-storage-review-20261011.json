  "findings": [
    {
      "id": "R11L-01",
      "category": "recovery-hardening",
      "severity": "P2",
      "status": "confirmed in isolated corruption fixtures; unimplemented",
      "summary": "Index rebuild does not verify batch completeness or the stored fingerprint."
    },
    {
      "id": "O11L-01",
      "category": "performance",
      "status": "measured; prototype only",
      "summary": "Cold document lookup and materialization read the creation body three times; reuse of scanned metadata removes one SQL and one body transfer."
    },
    {
      "id": "D11L-01",
      "category": "architecture-decision",
      "status": "requires retention-policy discussion",
      "summary": "All intermediate native writes remain in canonical PG history until Session deletion, unlike native Pi backend reclamation of obsolete current-only state."
    },
    {
      "id": "N11L-01",
      "category": "documentation",
      "status": "corrected in this review",
      "summary": "ADR-0147 streaming/recovery clauses predate Durable1.0 and must not be presented as current."
    }
  ],
