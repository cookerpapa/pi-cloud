        "with advanced_epoch as ( update pi_sessions set lease_epoch=$1 where tenant_id=$2::uuid and id=$3 and lease_epoch=$4::bigint returning id ) insert into session_leases(tenant_id,pi_session_id,lease_id,sandbox_id, fencing_token,valid_until,acquired_at,renewed_at) select $5::uuid,id,$6::uuid,$7::uuid, $8, clock_timestamp()+$9*interval '1 millisecond', clock_timestamp(),clock_timestamp() from advanced_epoch returning *": 1,
        "with \"started_turn\" as ( update turns set state='running',started_at=$1 where tenant_id=$2::uuid and id=$3::uuid and state='queued' returning id ), \"started_session\" as ( update sessions set state='running',row_version=row_version+1, updated_at=$4,last_active_at=$5 where tenant_id=$6::uuid and id=$7::uuid and state in ('cold','idle') returning id ), started_run as ( update runs set state='running',ready_at=null,started_at=$8, updated_at=$9,last_heartbeat_at=$10,row_version=row_version+1, sandbox_id=$11::uuid,lease_id=$12::uuid, fencing_token=$13,last_event_seq=$14, output_publication=$15::jsonb,native_output_drained=false where tenant_id=$16::uuid and id=$17::uuid and state='queued' and ready_at is not null and queued_steer_id is null and not input_paused and lease_id is null and row_version=$18::bigint and exists(select 1 from session_leases l where l.lease_id=$19::uuid and l.tenant_id=$20::uuid and l.pi_session_id=$21 and l.sandbox_id=$22::uuid and l.fencing_token=$23 and l.released_at is null and l.valid_until>clock_timestamp() and l.writer_failed_at is null and l.writer_sealed_at is null) returning id ), recorded_transition as ( insert into run_transitions(id,tenant_id,run_id,from_state,to_state,reason,occurred_at) select $24::uuid,$25::uuid,id, 'queued','running','execution_admitted',$26 from started_run returning id ) select (select count(*)::int from \"started_turn\") as turns, (select count(*)::int from \"started_session\") as sessions, (select count(*)::int from started_run) as runs, (select count(*)::int from recorded_transition) as transitions": 1,
        "commit": 1
      }
