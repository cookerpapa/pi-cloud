    "queue_snapshot": {
      "roundTrips": 1,
      "statements": {
        "select \"s\".\"row_version\", exists(select 1 from runs paused where paused.tenant_id=s.tenant_id and paused.session_id=s.id and paused.state='queued' and paused.input_paused) as \"hasPausedInputs\", (select payload->>'version' as \"version\" from \"outbox\" where \"tenant_id\" = \"s\".\"tenant_id\" and \"aggregate_id\" = \"s\".\"id\" and \"topic\" = 'session.control.changed.v1' and payload->>'entity' = 'input_queue' order by (payload->>'version')::bigint desc limit $1) as \"viewVersion\", (select \"turn_id\" from \"runs\" where \"tenant_id\" = \"s\".\"tenant_id\" and \"session_id\" = \"s\".\"id\" and \"state\" = $2 limit $3) as \"activeTurnId\", (select coalesce(json_agg(agg), '[]') from (select \"r\".\"id\", \"r\".\"turn_id\", \"r\".\"mailbox_position\", \"r\".\"created_at\", \"r\".\"queued_steer_id\", \"r\".\"input_paused\", \"t\".\"input_text\", \"t\".\"input_uploads\" from \"runs\" as \"r\" inner join \"turns\" as \"t\" on \"t\".\"id\" = \"r\".\"turn_id\" where \"r\".\"tenant_id\" = \"s\".\"tenant_id\" and \"r\".\"session_id\" = \"s\".\"id\" and r.state='queued' and \"r\".\"lease_id\" is null and \"t\".\"state\" = $4 and \"r\".\"mailbox_position\" > $5 order by \"r\".\"mailbox_position\" asc limit $6) as agg) as \"items\" from \"sessions\" as \"s\" where \"s\".\"tenant_id\" = $7 and \"s\".\"id\" = $8 and \"s\".\"pruned_at\" is null": 1
