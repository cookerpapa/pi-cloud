    "admit": {
      "roundTrips": 11,
      "statements": {
        "begin": 1,
        "with \"claim_candidate\" as materialized (select \"candidate\".* from \"runs\" as \"candidate\" inner join \"agent_revisions\" as \"candidate_agent\" on \"candidate_agent\".\"id\" = \"candidate\".\"agent_revision_id\" inner join \"sessions\" as \"candidate_session\" on \"candidate_session\".\"tenant_id\" = \"candidate\".\"tenant_id\" and \"candidate_session\".\"id\" = \"candidate\".\"session_id\" inner join \"tenant_runtime_policies\" as \"candidate_policy\" on \"candidate_policy\".\"tenant_id\" = \"candidate\".\"tenant_id\" where \"candidate\".\"id\" = $1 and \"candidate\".\"available_at\" <= clock_timestamp() and candidate.state = 'queued' and candidate.ready_at is not null and \"candidate\".\"queued_steer_id\" is null and \"candidate\".\"input_paused\" = $2 and \"candidate_session\".\"state\" in ($3, $4) and true and not exists(select 1 from subagent_executions e where e.child_run_id=\"candidate\".\"id\" and not exists( select 1 from active_execution_scopes parent where parent.run_id=e.parent_run_id and parent.accepting_effects and parent.valid_until>clock_timestamp() )) and \"candidate_policy\".\"enabled\" = $5 and \"candidate_agent\".\"runtime_kind\" = $6 and exists( select 1 from pi_sessions p left join session_leases l on l.tenant_id=p.tenant_id and l.pi_session_id=p.id and l.released_at is null where p.tenant_id=\"candidate_session\".\"tenant_id\" and p.id=\"candidate_session\".\"pi_session_id\" and ((l.lease_id is null and p.unsealed_runs=0) or (l.valid_until>clock_timestamp() and l.sandbox_id=$7::uuid and l.writer_failed_at is null and l.writer_sealed_at is null)) ) order by \"candidate\".\"available_at\" asc, \"candidate\".\"queued_at\" asc, \"candidate\".\"id\" asc limit $8 for update of \"candidate\" skip locked) select \"run\".\"tenant_id\" as \"tenantId\", \"run\".\"agent_revision_id\" as \"agentRevisionId\", \"run\".\"environment_version_id\" as \"environmentVersionId\", \"run\".\"project_id\" as \"environmentProjectId\", \"run\".\"idempotency_key\" as \"idempotencyKey\", \"run\".\"mailbox_position\" as \"mailboxPosition\", \"turn\".\"id\" as \"turnId\", \"turn\".\"state\" as \"turnState\", \"turn\".\"input_kind\" as \"inputKind\", null as \"inputText\", \"turn\".\"model_profile_id\" as \"modelProfileId\", \"turn\".\"provider\" as \"provider\", \"turn\".\"model_id\" as \"modelId\", \"turn\".\"thinking_level\" as \"thinkingLevel\", \"turn\".\"service_tier\" as \"serviceTier\", \"turn\".\"credential_binding_id\" as \"credentialBindingId\", \"turn\".\"credential_binding_version\" as \"credentialBindingVersion\", \"session_row\".\"id\" as \"sessionId\", \"session_row\".\"pi_session_id\" as \"piSessionId\", \"session_row\".\"pi_session_lane\" as \"piSessionLane\", \"session_row\".\"state\" as \"sessionState\", \"session_row\".\"session_kind\" as \"sessionKind\", \"workspace_row\".\"seed_kind\" as \"workspaceSeedKind\", \"session_row\".\"execution_mode\" as \"executionMode\", \"session_row\".\"project_id\" as \"projectId\", \"session_row\".\"workspace_id\" as \"workspaceId\", \"session_row\".\"next_event_seq\" as \"nextEventSeq\", \"run\".\"id\" as \"runId\", \"run\".\"trace_id\" as \"traceId\", \"run\".\"tool_capability_snapshot\" as \"toolCapabilitySnapshot\", \"run\".\"agent_system_prompt\" as \"agentSystemPrompt\", \"run\".\"working_directory\" as \"workingDirectory\", \"run\".\"compute_session_id\" as \"computeSessionId\", \"run\".\"sandbox_profile_key\" as \"sandboxProfileKey\", \"run\".\"queued_at\" as \"runQueuedAt\", \"run\".\"state\" as \"runState\", \"run\".\"row_version\" as \"runVersion\" from \"claim_candidate\" as \"run\" inner join \"turns\" as \"turn\" on \"turn\".\"tenant_id\" = \"run\".\"tenant_id\" and \"turn\".\"session_id\" = \"run\".\"session_id\" and \"turn\".\"id\" = \"run\".\"turn_id\" inner join \"sessions\" as \"session_row\" on \"session_row\".\"tenant_id\" = \"run\".\"tenant_id\" and \"session_row\".\"id\" = \"run\".\"session_id\" inner join \"workspaces\" as \"workspace_row\" on \"workspace_row\".\"tenant_id\" = \"session_row\".\"tenant_id\" and \"workspace_row\".\"id\" = \"session_row\".\"workspace_id\" where \"workspace_row\".\"deleted_at\" is null and \"session_row\".\"workspace_id\" = \"run\".\"workspace_id\" and \"session_row\".\"project_id\" = \"run\".\"project_id\" and \"workspace_row\".\"project_id\" = \"run\".\"project_id\" and \"session_row\".\"agent_revision_id\" = \"run\".\"agent_revision_id\" and \"turn\".\"state\" = $9": 1,
        "select \"input_text\", \"input_uploads\" from \"turns\" where \"tenant_id\" = $1 and \"id\" = $2 and \"state\" = $3": 1,
