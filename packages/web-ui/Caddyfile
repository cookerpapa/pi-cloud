{
	admin off
	auto_https off
}

:8080, :8081 {
	encode zstd gzip

	@preview expression "{http.request.host}.matches('^p-[0-9a-f]{24}[.].+$')"
	handle @preview {
		reverse_proxy {$PI_CLOUD_PREVIEW_UPSTREAM:control-plane:3001}
	}

	handle /healthz {
		respond "ok" 200
	}

	# Only this code-owned response is a template; never evaluate user Preview content.
	handle /ui-config.json {
		header Content-Type application/json
		header Cache-Control no-store
		templates {
			mime application/json
		}
		respond <<JSON
		{"productUrl": {{env "PI_CLOUD_PUBLIC_ORIGIN_BASE_URL" | toJson}}, "adminUrl": {{env "PI_CLOUD_ADMIN_ORIGIN_BASE_URL" | toJson}}, "managementUrls": {
		"providerGateway": {{env "PI_CLOUD_PROVIDER_MANAGEMENT_URL" | toJson}},
		"grafana": {{env "PI_CLOUD_GRAFANA_URL" | toJson}},
		"prometheus": {{env "PI_CLOUD_PROMETHEUS_URL" | toJson}},
		"alertmanager": {{env "PI_CLOUD_ALERTMANAGER_URL" | toJson}},
		"jaeger": {{env "PI_CLOUD_JAEGER_URL" | toJson}}}}
		JSON
	}

	handle /internal/* {
		respond 404
	}

	handle /health/* {
		respond 404
	}

	handle /v1/* {
		reverse_proxy {$PI_CLOUD_CONTROL_PLANE_UPSTREAM:control-plane:3000}
	}

	handle {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
			Permissions-Policy "camera=(), geolocation=(), microphone=()"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

:8318 {
	encode zstd gzip
	reverse_proxy cli-proxy-api:8317
}
