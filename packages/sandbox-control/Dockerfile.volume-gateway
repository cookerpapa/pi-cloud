FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS quota-builder
ARG PI_CLOUD_GOPROXY=https://goproxy.cn|https://proxy.golang.org|direct
ENV GOPROXY=${PI_CLOUD_GOPROXY}
COPY scripts/install-host-os-security-updates.sh /tmp/install-host-os-security-updates.sh
RUN sh /tmp/install-host-os-security-updates.sh \
    && apt-get update && apt-get install -y --no-install-recommends xfslibs-dev=6.1.0-1 uuid-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/install-host-os-security-updates.sh
WORKDIR /source
COPY deploy/resource-metering /source/resource-metering
COPY deploy/workspace-quota /source/workspace-quota
COPY deploy/file-exchange /source/file-exchange
WORKDIR /source/workspace-quota
RUN CGO_ENABLED=1 GOTOOLCHAIN=local go build -trimpath -ldflags '-s -w' -o /out/workspace-quota ./cmd/workspace-quota \
    && CGO_ENABLED=0 GOTOOLCHAIN=local go -C /source/file-exchange build -trimpath -ldflags '-s -w' -o /out/file-exchange .

FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS os-base
COPY scripts/install-node-os-security-updates.sh scripts/install-host-os-security-updates.sh /tmp/
RUN sh /tmp/install-host-os-security-updates.sh && sh /tmp/install-node-os-security-updates.sh \
    && rm /tmp/install-node-os-security-updates.sh /tmp/install-host-os-security-updates.sh
RUN test "$(flock --version)" = "flock from util-linux 2.38.1"

FROM os-base AS dependencies
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ENV npm_config_registry=${NPM_CONFIG_REGISTRY}
WORKDIR /app
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY scripts/retry-npm-command.sh scripts/retry-npm-command.sh
COPY packages/session-attachments/package.json packages/session-attachments/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/event-log/package.json packages/event-log/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/sandbox-control/package.json packages/sandbox-control/package.json
COPY packages/workspace-runtime/package.json packages/workspace-runtime/package.json
RUN sh scripts/retry-npm-command.sh ci --omit=dev --ignore-scripts \
    && npm cache clean --force

FROM os-base
ARG PI_CLOUD_VERSION=development
ARG PI_CLOUD_REVISION=unknown
LABEL org.opencontainers.image.title="PiCloud Workspace volume gateway" \
      org.opencontainers.image.description="Workspace bytes and Git credentials" \
      org.opencontainers.image.version="${PI_CLOUD_VERSION}" \
      org.opencontainers.image.revision="${PI_CLOUD_REVISION}"
ENV NODE_ENV=production
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -eu; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i \
        -e 's|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
        -e 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
        /etc/apt/sources.list.d/debian.sources; \
    fi; \
    installed=0; \
    attempt=1; \
    while [ "$attempt" -le 3 ]; do \
      if apt-get \
          -o Acquire::Retries=3 \
          -o Acquire::http::Timeout=30 \
          update \
        && apt-get \
          -o Acquire::Retries=3 \
          -o Acquire::http::Timeout=30 \
          install --yes --no-install-recommends git; then \
        installed=1; \
        break; \
      fi; \
      dpkg --configure -a || true; \
      sleep "$((attempt * 2))"; \
      attempt="$((attempt + 1))"; \
    done; \
    test "$installed" = 1
WORKDIR /app
COPY --from=dependencies /app/node_modules /app/node_modules
COPY --from=quota-builder /out/workspace-quota /app/bin/workspace-quota
COPY --from=quota-builder /out/file-exchange /opt/pi-cloud/bin/file-exchange
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY packages/session-attachments/package.json packages/session-attachments/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/event-log/package.json packages/event-log/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/observability/src packages/observability/src
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/protocol/src packages/protocol/src
COPY packages/sandbox-control/package.json packages/sandbox-control/package.json
COPY packages/sandbox-control/tsconfig.json packages/sandbox-control/tsconfig.json
COPY packages/sandbox-control/src/filesystem-workspace-volume-gateway-lock.ts packages/sandbox-control/src/filesystem-workspace-volume-gateway-lock.ts
COPY packages/sandbox-control/src/persistent-volume-workspace-volume-gateway.ts packages/sandbox-control/src/persistent-volume-workspace-volume-gateway.ts
COPY packages/sandbox-control/src/postgres-workspace-persistence.ts packages/sandbox-control/src/postgres-workspace-persistence.ts
COPY packages/sandbox-control/src/upload-http.ts packages/sandbox-control/src/upload-http.ts
COPY packages/sandbox-control/src/workspace-file-transfer-grant.ts packages/sandbox-control/src/workspace-file-transfer-grant.ts
COPY packages/sandbox-control/src/workspace-file-transfer-http.ts packages/sandbox-control/src/workspace-file-transfer-http.ts
COPY packages/sandbox-control/src/workspace-persistence.ts packages/sandbox-control/src/workspace-persistence.ts
COPY packages/sandbox-control/src/workspace-quota-client.ts packages/sandbox-control/src/workspace-quota-client.ts
COPY packages/sandbox-control/src/workspace-volume-gateway-contract.ts packages/sandbox-control/src/workspace-volume-gateway-contract.ts
COPY packages/sandbox-control/src/workspace-volume-gateway-main.ts packages/sandbox-control/src/workspace-volume-gateway-main.ts
COPY packages/sandbox-control/src/workspace-volume-gateway-transport.ts packages/sandbox-control/src/workspace-volume-gateway-transport.ts
COPY packages/sandbox-control/src/workspace-volume-gateway.ts packages/sandbox-control/src/workspace-volume-gateway.ts
COPY packages/workspace-runtime/package.json packages/workspace-runtime/package.json
COPY packages/workspace-runtime/src packages/workspace-runtime/src
RUN cd /app/packages/sandbox-control \
    && node --import tsx --input-type=module --eval "await import('./src/workspace-volume-gateway.ts'); await import('./src/postgres-workspace-persistence.ts'); await import('./src/workspace-quota-client.ts'); await import('undici')" \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
STOPSIGNAL SIGTERM
USER 1000:1000
ENTRYPOINT ["node", "/app/node_modules/tsx/dist/cli.mjs", "--tsconfig", "/app/packages/sandbox-control/tsconfig.json"]
CMD ["/app/packages/sandbox-control/src/workspace-volume-gateway-main.ts"]
